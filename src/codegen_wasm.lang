// src/codegen_wasm.lang - direct WebAssembly binary backend
//
// This intentionally begins as a narrow, executable backend rather than a
// second textual lowering. The reader-capable slice covers scalar functions,
// structured control flow, strings, pointers, globals, imports, and structs.
// Unsupported language features fail closed with source-aware diagnostics.

struct WasmBuf {
    data *u8;
    len i64;
    cap i64;
}

var wasm_module *WasmBuf = nil;
var wasm_section *WasmBuf = nil;
var wasm_body *WasmBuf = nil;

var wasm_funcs *u8 = nil;       // definition declaration pointers
var wasm_func_count i64 = 0;
var wasm_imports *u8 = nil;     // extern function declaration pointers
var wasm_import_count i64 = 0;
var wasm_func_marks *u8 = nil;
var wasm_import_marks *u8 = nil;
var wasm_globals *u8 = nil;     // global variable declaration pointers
var wasm_global_count i64 = 0;
var wasm_structs *u8 = nil;     // struct declaration pointers
var wasm_struct_count i64 = 0;
var wasm_strings *u8 = nil;     // [data:8][len:8][offset:8]
var wasm_string_count i64 = 0;
var wasm_data_end i64 = 1024;
var wasm_locals *u8 = nil;      // [name:8][len:8][index:8][type:8][decl:8]
var wasm_local_count i64 = 0;
var wasm_param_count i64 = 0;
var wasm_bindings *u8 = nil;    // active [name:8][len:8][local index:8]
var wasm_binding_count i64 = 0;
var wasm_control_depth i64 = 0;
// Active loops: [label:8][label_len:8][break_depth:8][continue_depth:8]
var wasm_loops *u8 = nil;
var wasm_loop_count i64 = 0;
var wasm_had_error i64 = 0;
var wasm_current_decl *u8 = nil;
var wasm_included_files *u8 = nil;
var wasm_i64_type *u8 = nil;
var wasm_u8_type *u8 = nil;
var wasm_u8_ptr_type *u8 = nil;

func wasm_buf_new(cap i64) *WasmBuf {
    var b *WasmBuf = alloc(24);
    b.data = alloc(cap);
    b.len = 0;
    b.cap = cap;
    return b;
}

func wasm_put(b *WasmBuf, value i64) void {
    if b.len >= b.cap {
        if wasm_had_error == 0 { eprintln("error: wasm output buffer overflow"); }
        wasm_had_error = 1;
        return;
    }
    *(b.data + b.len) = value;
    b.len = b.len + 1;
}

func wasm_put_bytes(b *WasmBuf, data *u8, len i64) void {
    var i i64 = 0;
    while i < len {
        wasm_put(b, *(data + i));
        i = i + 1;
    }
}

func wasm_put_uleb(b *WasmBuf, value i64) void {
    while value >= 128 {
        wasm_put(b, (value & 127) | 128);
        value = value >> 7;
    }
    wasm_put(b, value);
}

func wasm_put_sleb(b *WasmBuf, value i64) void {
    var more i64 = 1;
    while more != 0 {
        var byte i64 = value & 127;
        value = value >> 7;
        if (value == 0 && (byte & 64) == 0) ||
           (value == 0 - 1 && (byte & 64) != 0) {
            more = 0;
        } else {
            byte = byte | 128;
        }
        wasm_put(b, byte);
    }
}

func wasm_put_name(b *WasmBuf, name *u8, len i64) void {
    wasm_put_uleb(b, len);
    wasm_put_bytes(b, name, len);
}

func wasm_emit_section(id i64, payload *WasmBuf) void {
    wasm_put(wasm_module, id);
    wasm_put_uleb(wasm_module, payload.len);
    wasm_put_bytes(wasm_module, payload.data, payload.len);
    payload.len = 0;
}

func wasm_name_eq(a *u8, a_len i64, b *u8, b_len i64) i64 {
    if a_len != b_len { return 0; }
    var i i64 = 0;
    while i < a_len {
        if *(a + i) != *(b + i) { return 0; }
        i = i + 1;
    }
    return 1;
}

func wasm_error(message *u8) void {
    if wasm_had_error == 0 {
        if node_origin_source(cg_diagnostic_node) == nil {
            cg_diagnostic_node = wasm_current_decl;
        }
        cg_error_prefix();
        eprintln(message);
    }
    wasm_had_error = 1;
}

func wasm_type_is_void(t *u8) i64 {
    if t == nil { return 1; }
    if type_kind(t) != TYPE_BASE { return 0; }
    return wasm_name_eq(base_type_name(t), base_type_name_len(t), "void", 4);
}

func wasm_type_is_value(t *u8) i64 {
    if t == nil { return 0; }
    if type_kind(t) == TYPE_PTR { return 1; }
    if type_kind(t) != TYPE_BASE { return 0; }
    var name *u8 = base_type_name(t);
    var len i64 = base_type_name_len(t);
    if wasm_name_eq(name, len, "bool", 4) != 0 { return 1; }
    if len == 2 && (*name == 'i' || *name == 'u') && *(name + 1) == '8' { return 1; }
    if len == 3 && (*name == 'i' || *name == 'u') {
        if (*(name + 1) == '1' && *(name + 2) == '6') ||
           (*(name + 1) == '3' && *(name + 2) == '2') ||
           (*(name + 1) == '6' && *(name + 2) == '4') { return 1; }
    }
    return 0;
}

func wasm_type_size(t *u8) i64 {
    if t == nil { return 8; }
    if type_kind(t) == TYPE_PTR { return 8; }
    if type_kind(t) != TYPE_BASE { return 8; }
    var name *u8 = base_type_name(t);
    var len i64 = base_type_name_len(t);
    if wasm_name_eq(name, len, "i8", 2) != 0 || wasm_name_eq(name, len, "u8", 2) != 0 ||
       wasm_name_eq(name, len, "bool", 4) != 0 { return 1; }
    if wasm_name_eq(name, len, "i16", 3) != 0 || wasm_name_eq(name, len, "u16", 3) != 0 { return 2; }
    if wasm_name_eq(name, len, "i32", 3) != 0 || wasm_name_eq(name, len, "u32", 3) != 0 { return 4; }
    var struct_decl *u8 = wasm_find_struct(name, len);
    if struct_decl != nil { return wasm_struct_size(struct_decl); }
    return 8;
}

func wasm_find_struct(name *u8, name_len i64) *u8 {
    var i i64 = 0;
    while i < wasm_struct_count {
        var p **u8 = wasm_structs + i * 8;
        var decl *u8 = *p;
        if wasm_name_eq(struct_decl_name(decl), struct_decl_name_len(decl), name, name_len) != 0 {
            return decl;
        }
        i = i + 1;
    }
    return nil;
}

func wasm_struct_size(decl *u8) i64 {
    if decl == nil { return 0; }
    var size i64 = 0;
    var fields *u8 = struct_decl_fields(decl);
    var i i64 = 0;
    while i < struct_decl_field_count(decl) {
        var field *u8 = get_struct_field(fields, i);
        var field_size i64 = wasm_type_size(struct_field_type(field));
        if field_size < 8 { field_size = 8; }
        size = size + field_size;
        i = i + 1;
    }
    return size;
}

func wasm_struct_for_type(t *u8) *u8 {
    if t == nil { return nil; }
    if type_kind(t) == TYPE_PTR { t = ptr_type_elem(t); }
    if t == nil || type_kind(t) != TYPE_BASE { return nil; }
    return wasm_find_struct(base_type_name(t), base_type_name_len(t));
}

func wasm_field_offset(decl *u8, name *u8, name_len i64) i64 {
    if decl == nil { return 0 - 1; }
    var offset i64 = 0;
    var fields *u8 = struct_decl_fields(decl);
    var i i64 = 0;
    while i < struct_decl_field_count(decl) {
        var field *u8 = get_struct_field(fields, i);
        if wasm_name_eq(struct_field_name(field), struct_field_name_len(field), name, name_len) != 0 {
            return offset;
        }
        var size i64 = wasm_type_size(struct_field_type(field));
        if size < 8 { size = 8; }
        offset = offset + size;
        i = i + 1;
    }
    return 0 - 1;
}

func wasm_field_type(decl *u8, name *u8, name_len i64) *u8 {
    if decl == nil { return nil; }
    var fields *u8 = struct_decl_fields(decl);
    var i i64 = 0;
    while i < struct_decl_field_count(decl) {
        var field *u8 = get_struct_field(fields, i);
        if wasm_name_eq(struct_field_name(field), struct_field_name_len(field), name, name_len) != 0 {
            return struct_field_type(field);
        }
        i = i + 1;
    }
    return nil;
}

func wasm_func_get(index i64) *u8 {
    var p **u8 = wasm_funcs + index * 8;
    return *p;
}

func wasm_import_get(index i64) *u8 {
    var p **u8 = wasm_imports + index * 8;
    return *p;
}

func wasm_func_decl_by_index(index i64) *u8 {
    if index < wasm_import_count { return wasm_import_get(index); }
    return wasm_func_get(index - wasm_import_count);
}

func wasm_find_func(name *u8, name_len i64) i64 {
    var i i64 = 0;
    while i < wasm_import_count {
        var imported *u8 = wasm_import_get(i);
        if wasm_name_eq(func_decl_name(imported), func_decl_name_len(imported), name, name_len) != 0 {
            return i;
        }
        i = i + 1;
    }
    i = 0;
    while i < wasm_func_count {
        var decl *u8 = wasm_func_get(i);
        if wasm_name_eq(func_decl_name(decl), func_decl_name_len(decl), name, name_len) != 0 {
            return wasm_import_count + i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

func wasm_find_func_arity(name *u8, name_len i64, arity i64) i64 {
    // Readers and host imports may legitimately share a name. For example, a
    // one-argument reader named `read` coexists with libc's three-argument
    // `read`. Resolve the complete call shape, preferring a local definition.
    var i i64 = 0;
    while i < wasm_func_count {
        var decl *u8 = wasm_func_get(i);
        if wasm_name_eq(func_decl_name(decl), func_decl_name_len(decl), name, name_len) != 0 &&
           func_decl_param_count(decl) == arity {
            return wasm_import_count + i;
        }
        i = i + 1;
    }
    i = 0;
    while i < wasm_import_count {
        var imported *u8 = wasm_import_get(i);
        if wasm_name_eq(func_decl_name(imported), func_decl_name_len(imported), name, name_len) != 0 &&
           func_decl_param_count(imported) == arity {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

func wasm_find_defined_func(name *u8, name_len i64) i64 {
    var i i64 = 0;
    while i < wasm_func_count {
        var decl *u8 = wasm_func_get(i);
        if wasm_name_eq(func_decl_name(decl), func_decl_name_len(decl), name, name_len) != 0 {
            return wasm_import_count + i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

func wasm_local_add(name *u8, name_len i64, local_type *u8, decl *u8) i64 {
    var index i64 = wasm_local_count;
    var entry *u8 = wasm_locals + index * 40;
    var np **u8 = entry;
    *np = name;
    var lp *i64 = entry + 8;
    *lp = name_len;
    var ip *i64 = entry + 16;
    *ip = index;
    var tp **u8 = entry + 24;
    *tp = local_type;
    var decl_p **u8 = entry + 32;
    *decl_p = decl;
    wasm_local_count = wasm_local_count + 1;
    return index;
}

func wasm_find_local(name *u8, name_len i64) i64 {
    var i i64 = wasm_binding_count - 1;
    while i >= 0 {
        var entry *u8 = wasm_bindings + i * 24;
        var np **u8 = entry;
        var lp *i64 = entry + 8;
        if wasm_name_eq(*np, *lp, name, name_len) != 0 {
            var ip *i64 = entry + 16;
            return *ip;
        }
        i = i - 1;
    }
    return 0 - 1;
}

func wasm_local_type(index i64) *u8 {
    var tp **u8 = wasm_locals + index * 40 + 24;
    return *tp;
}

func wasm_bind_local(name *u8, name_len i64, index i64) void {
    var entry *u8 = wasm_bindings + wasm_binding_count * 24;
    var np **u8 = entry;
    *np = name;
    var lp *i64 = entry + 8;
    *lp = name_len;
    var ip *i64 = entry + 16;
    *ip = index;
    wasm_binding_count = wasm_binding_count + 1;
}

func wasm_push_loop(label *u8, label_len i64,
                    break_depth i64, continue_depth i64) void {
    if wasm_loop_count >= LIMIT_LOOP_DEPTH {
        wasm_error("too many nested loops in direct wasm output");
        return;
    }
    var entry *u8 = wasm_loops + wasm_loop_count * 32;
    var label_slot **u8 = entry;
    *label_slot = label;
    var len_slot *i64 = entry + 8;
    *len_slot = label_len;
    var break_slot *i64 = entry + 16;
    *break_slot = break_depth;
    var continue_slot *i64 = entry + 24;
    *continue_slot = continue_depth;
    wasm_loop_count = wasm_loop_count + 1;
}

func wasm_loop_branch_depth(label *u8, label_len i64, is_continue i64) i64 {
    var i i64 = wasm_loop_count - 1;
    while i >= 0 {
        var entry *u8 = wasm_loops + i * 32;
        var label_slot **u8 = entry;
        var len_slot *i64 = entry + 8;
        if label_len == 0 ||
           wasm_name_eq(*label_slot, *len_slot, label, label_len) != 0 {
            var target_slot *i64 = entry + 16;
            if is_continue != 0 { target_slot = entry + 24; }
            return wasm_control_depth - *target_slot;
        }
        i = i - 1;
    }
    wasm_error("loop control label not found in direct wasm output");
    return -1;
}

func wasm_local_for_decl(decl *u8) i64 {
    var i i64 = wasm_param_count;
    while i < wasm_local_count {
        var dp **u8 = wasm_locals + i * 40 + 32;
        if *dp == decl { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

func wasm_global_get(index i64) *u8 {
    var p **u8 = wasm_globals + index * 8;
    return *p;
}

func wasm_find_global(name *u8, name_len i64) i64 {
    var i i64 = wasm_global_count - 1;
    while i >= 0 {
        var decl *u8 = wasm_global_get(i);
        if wasm_name_eq(var_decl_name(decl), var_decl_name_len(decl), name, name_len) != 0 {
            return i;
        }
        i = i - 1;
    }
    return 0 - 1;
}

func wasm_add_string(data *u8, len i64) i64 {
    var i i64 = 0;
    while i < wasm_string_count {
        var entry *u8 = wasm_strings + i * 24;
        var dp **u8 = entry;
        var lp *i64 = entry + 8;
        if wasm_name_eq(*dp, *lp, data, len) != 0 {
            var op *i64 = entry + 16;
            return *op;
        }
        i = i + 1;
    }
    var offset i64 = wasm_data_end;
    var entry *u8 = wasm_strings + wasm_string_count * 24;
    var dp **u8 = entry;
    *dp = data;
    var lp *i64 = entry + 8;
    *lp = len;
    var op *i64 = entry + 16;
    *op = offset;
    wasm_string_count = wasm_string_count + 1;
    wasm_data_end = wasm_data_end + len + 1;
    if wasm_data_end >= 1024 * 1024 { wasm_error("direct wasm string data exceeds 1 MiB"); }
    return offset;
}

func wasm_collect_locals(stmt *u8) void {
    if stmt == nil { return; }
    var kind i64 = node_kind(stmt);
    if kind == NODE_VAR_DECL {
        if wasm_type_is_value(var_decl_type(stmt)) == 0 {
            wasm_error("direct wasm currently supports only scalar and pointer locals");
            return;
        }
        wasm_local_add(var_decl_name(stmt), var_decl_name_len(stmt), var_decl_type(stmt), stmt);
    } else if kind == NODE_BLOCK_STMT {
        var stmts *u8 = block_stmt_stmts(stmt);
        var i i64 = 0;
        while i < block_stmt_count(stmt) {
            var p **u8 = stmts + i * 8;
            wasm_collect_locals(*p);
            i = i + 1;
        }
    } else if kind == NODE_IF_STMT {
        wasm_collect_locals(if_stmt_then(stmt));
        wasm_collect_locals(if_stmt_else(stmt));
    } else if kind == NODE_WHILE_STMT {
        wasm_collect_locals(while_stmt_body(stmt));
    }
}

func wasm_parse_integer(text *u8, len i64) i64 {
    var value i64 = 0;
    var i i64 = 0;
    while i < len {
        var c u8 = *(text + i);
        if c >= '0' && c <= '9' { value = value * 10 + (c - '0'); }
        i = i + 1;
    }
    return value;
}

func wasm_expr_type(expr *u8) *u8 {
    if expr == nil { return nil; }
    var kind i64 = node_kind(expr);
    if kind == NODE_NUMBER_EXPR || kind == NODE_BOOL_EXPR { return wasm_i64_type; }
    if kind == NODE_STRING_EXPR { return wasm_u8_ptr_type; }
    if kind == NODE_NIL_EXPR { return wasm_u8_ptr_type; }
    if kind == NODE_GROUP_EXPR { return wasm_expr_type(group_expr_expr(expr)); }
    if kind == NODE_CAST_EXPR { return cast_expr_type(expr); }
    if kind == NODE_BITCAST_EXPR { return bitcast_expr_type(expr); }
    if kind == NODE_IDENT_EXPR {
        var local i64 = wasm_find_local(ident_expr_name(expr), ident_expr_name_len(expr));
        if local >= 0 { return wasm_local_type(local); }
        var global i64 = wasm_find_global(ident_expr_name(expr), ident_expr_name_len(expr));
        if global >= 0 { return var_decl_type(wasm_global_get(global)); }
        return nil;
    }
    if kind == NODE_UNARY_EXPR {
        var inner_type *u8 = wasm_expr_type(unary_expr_expr(expr));
        if unary_expr_op(expr) == TOKEN_STAR && inner_type != nil && type_kind(inner_type) == TYPE_PTR {
            return ptr_type_elem(inner_type);
        }
        return inner_type;
    }
    if kind == NODE_INDEX_EXPR {
        var base_type *u8 = wasm_expr_type(index_expr_base(expr));
        if base_type != nil && type_kind(base_type) == TYPE_PTR { return ptr_type_elem(base_type); }
        return nil;
    }
    if kind == NODE_FIELD_EXPR {
        var decl *u8 = wasm_struct_for_type(wasm_expr_type(field_expr_expr(expr)));
        return wasm_field_type(decl, field_expr_field(expr), field_expr_field_len(expr));
    }
    if kind == NODE_BINARY_EXPR {
        var left_type *u8 = wasm_expr_type(binary_expr_left(expr));
        if left_type != nil && type_kind(left_type) == TYPE_PTR &&
           (binary_expr_op(expr) == TOKEN_PLUS || binary_expr_op(expr) == TOKEN_MINUS) {
            return left_type;
        }
        return wasm_i64_type;
    }
    if kind == NODE_CALL_EXPR {
        var callee *u8 = call_expr_func(expr);
        if callee != nil && node_kind(callee) == NODE_IDENT_EXPR {
            var index i64 = wasm_find_func_arity(
                ident_expr_name(callee), ident_expr_name_len(callee), call_expr_arg_count(expr)
            );
            if index >= 0 { return func_decl_ret_type(wasm_func_decl_by_index(index)); }
        }
    }
    return nil;
}

func wasm_emit_address(expr *u8, out *WasmBuf) *u8 {
    if expr == nil { wasm_error("missing memory address in direct wasm"); return nil; }
    if node_kind(expr) == NODE_UNARY_EXPR && unary_expr_op(expr) == TOKEN_STAR {
        var pointer *u8 = unary_expr_expr(expr);
        var pointer_type *u8 = wasm_expr_type(pointer);
        wasm_emit_expr(pointer, out);
        wasm_put(out, 167);  // i32.wrap_i64
        if pointer_type != nil && type_kind(pointer_type) == TYPE_PTR {
            return ptr_type_elem(pointer_type);
        }
        return nil;
    }
    if node_kind(expr) == NODE_INDEX_EXPR {
        var base *u8 = index_expr_base(expr);
        var base_type *u8 = wasm_expr_type(base);
        var elem_type *u8 = nil;
        if base_type != nil && type_kind(base_type) == TYPE_PTR { elem_type = ptr_type_elem(base_type); }
        wasm_emit_expr(base, out);
        wasm_emit_expr(index_expr_index(expr), out);
        var size i64 = wasm_type_size(elem_type);
        if size > 1 {
            wasm_put(out, 66); wasm_put_sleb(out, size);
            wasm_put(out, 126);  // i64.mul
        }
        wasm_put(out, 124);  // i64.add
        wasm_put(out, 167);  // i32.wrap_i64
        return elem_type;
    }
    if node_kind(expr) == NODE_FIELD_EXPR {
        var base *u8 = field_expr_expr(expr);
        var decl *u8 = wasm_struct_for_type(wasm_expr_type(base));
        var offset i64 = wasm_field_offset(decl, field_expr_field(expr), field_expr_field_len(expr));
        if offset < 0 {
            wasm_error("unknown struct field in direct wasm");
            return nil;
        }
        wasm_emit_expr(base, out);
        if offset > 0 {
            wasm_put(out, 66); wasm_put_sleb(out, offset);
            wasm_put(out, 124);  // i64.add
        }
        wasm_put(out, 167);  // i32.wrap_i64
        return wasm_field_type(decl, field_expr_field(expr), field_expr_field_len(expr));
    }
    wasm_error("direct wasm cannot take this memory address yet");
    return nil;
}

func wasm_emit_load(value_type *u8, out *WasmBuf) void {
    var size i64 = wasm_type_size(value_type);
    var signed i64 = 0;
    if value_type != nil && type_kind(value_type) == TYPE_BASE {
        var name *u8 = base_type_name(value_type);
        var len i64 = base_type_name_len(value_type);
        if wasm_name_eq(name, len, "i8", 2) != 0 ||
           wasm_name_eq(name, len, "i16", 3) != 0 ||
           wasm_name_eq(name, len, "i32", 3) != 0 { signed = 1; }
    }
    if size == 1 {
        if signed != 0 { wasm_put(out, 48); } else { wasm_put(out, 49); }
    } else if size == 2 {
        if signed != 0 { wasm_put(out, 50); } else { wasm_put(out, 51); }
    } else if size == 4 {
        if signed != 0 { wasm_put(out, 52); } else { wasm_put(out, 53); }
    } else { wasm_put(out, 41); }             // i64.load
    wasm_put_uleb(out, 0);  // conservative alignment
    wasm_put_uleb(out, 0);  // offset
}

func wasm_emit_store(value_type *u8, out *WasmBuf) void {
    var size i64 = wasm_type_size(value_type);
    if size == 1 { wasm_put(out, 60); }       // i64.store8
    else if size == 2 { wasm_put(out, 61); }  // i64.store16
    else if size == 4 { wasm_put(out, 62); }  // i64.store32
    else { wasm_put(out, 55); }               // i64.store
    wasm_put_uleb(out, 0);
    wasm_put_uleb(out, 0);
}

func wasm_emit_truth(expr *u8, out *WasmBuf) void {
    wasm_emit_expr(expr, out);
    wasm_put(out, 80);  // i64.eqz
    wasm_put(out, 69);  // i32.eqz: nonzero becomes true
}

func wasm_emit_expr(expr *u8, out *WasmBuf) void {
    if expr == nil { wasm_put(out, 66); wasm_put_sleb(out, 0); return; }
    var kind i64 = node_kind(expr);

    if kind == NODE_NUMBER_EXPR {
        wasm_put(out, 66);  // i64.const
        wasm_put_sleb(out, wasm_parse_integer(number_expr_value(expr), number_expr_value_len(expr)));
        return;
    }
    if kind == NODE_BOOL_EXPR {
        wasm_put(out, 66);
        wasm_put_sleb(out, bool_expr_value(expr));
        return;
    }
    if kind == NODE_STRING_EXPR {
        var offset i64 = wasm_add_string(string_expr_value(expr), string_expr_value_len(expr));
        wasm_put(out, 66);
        wasm_put_sleb(out, offset);
        return;
    }
    if kind == NODE_NIL_EXPR {
        wasm_put(out, 66);
        wasm_put_sleb(out, 0);
        return;
    }
    if kind == NODE_GROUP_EXPR {
        wasm_emit_expr(group_expr_expr(expr), out);
        return;
    }
    if kind == NODE_CAST_EXPR {
        wasm_emit_expr(cast_expr_expr(expr), out);
        return;
    }
    if kind == NODE_BITCAST_EXPR {
        wasm_emit_expr(bitcast_expr_expr(expr), out);
        return;
    }
    if kind == NODE_IDENT_EXPR {
        var local i64 = wasm_find_local(ident_expr_name(expr), ident_expr_name_len(expr));
        if local >= 0 {
            wasm_put(out, 32);  // local.get
            wasm_put_uleb(out, local);
            return;
        }
        var global i64 = wasm_find_global(ident_expr_name(expr), ident_expr_name_len(expr));
        if global >= 0 {
            wasm_put(out, 35);  // global.get
            wasm_put_uleb(out, global);
            return;
        }
        wasm_error("unknown value in direct wasm function");
        wasm_put(out, 66); wasm_put_sleb(out, 0);
        return;
    }
    if kind == NODE_UNARY_EXPR {
        var unary_op i64 = unary_expr_op(expr);
        if unary_op == TOKEN_MINUS {
            wasm_put(out, 66); wasm_put_sleb(out, 0);
            wasm_emit_expr(unary_expr_expr(expr), out);
            wasm_put(out, 125);  // i64.sub
        } else if unary_op == TOKEN_BANG {
            wasm_emit_expr(unary_expr_expr(expr), out);
            wasm_put(out, 80);   // i64.eqz
            wasm_put(out, 173);  // i64.extend_i32_u
        } else if unary_op == TOKEN_STAR {
            var loaded_type *u8 = wasm_emit_address(expr, out);
            wasm_emit_load(loaded_type, out);
        } else {
            wasm_error("unsupported unary operator in direct wasm");
            wasm_put(out, 66); wasm_put_sleb(out, 0);
        }
        return;
    }
    if kind == NODE_BINARY_EXPR {
        var op i64 = binary_expr_op(expr);
        if op == TOKEN_AMPAMP || op == TOKEN_PIPEPIPE {
            wasm_emit_truth(binary_expr_left(expr), out);
            wasm_put(out, 173);
            wasm_emit_truth(binary_expr_right(expr), out);
            wasm_put(out, 173);
            if op == TOKEN_AMPAMP { wasm_put(out, 131); }
            else { wasm_put(out, 132); }
            return;
        }
        var left_type *u8 = wasm_expr_type(binary_expr_left(expr));
        var right_type *u8 = wasm_expr_type(binary_expr_right(expr));
        wasm_emit_expr(binary_expr_left(expr), out);
        wasm_emit_expr(binary_expr_right(expr), out);
        if left_type != nil && type_kind(left_type) == TYPE_PTR &&
           (op == TOKEN_PLUS || op == TOKEN_MINUS) {
            if right_type != nil && type_kind(right_type) == TYPE_PTR {
                wasm_error("pointer difference is not supported by direct wasm yet");
            } else {
                var elem_size i64 = wasm_type_size(ptr_type_elem(left_type));
                if elem_size > 1 {
                    wasm_put(out, 66); wasm_put_sleb(out, elem_size);
                    wasm_put(out, 126);  // i64.mul
                }
            }
        }
        if op == TOKEN_PLUS { wasm_put(out, 124); }
        else if op == TOKEN_MINUS { wasm_put(out, 125); }
        else if op == TOKEN_STAR { wasm_put(out, 126); }
        else if op == TOKEN_SLASH { wasm_put(out, 127); }
        else if op == TOKEN_PERCENT { wasm_put(out, 129); }
        else if op == TOKEN_AMP { wasm_put(out, 131); }
        else if op == TOKEN_PIPE { wasm_put(out, 132); }
        else if op == TOKEN_CARET { wasm_put(out, 133); }
        else if op == TOKEN_LTLT { wasm_put(out, 134); }
        else if op == TOKEN_GTGT { wasm_put(out, 135); }
        else if op == TOKEN_EQEQ { wasm_put(out, 81); wasm_put(out, 173); }
        else if op == TOKEN_BANGEQ { wasm_put(out, 82); wasm_put(out, 173); }
        else if op == TOKEN_LT { wasm_put(out, 83); wasm_put(out, 173); }
        else if op == TOKEN_GT { wasm_put(out, 85); wasm_put(out, 173); }
        else if op == TOKEN_LTEQ { wasm_put(out, 87); wasm_put(out, 173); }
        else if op == TOKEN_GTEQ { wasm_put(out, 89); wasm_put(out, 173); }
        else { wasm_error("unsupported binary operator in direct wasm"); }
        return;
    }
    if kind == NODE_INDEX_EXPR {
        var indexed_type *u8 = wasm_emit_address(expr, out);
        wasm_emit_load(indexed_type, out);
        return;
    }
    if kind == NODE_FIELD_EXPR {
        var field_type *u8 = wasm_emit_address(expr, out);
        wasm_emit_load(field_type, out);
        return;
    }
    if kind == NODE_CALL_EXPR {
        var callee *u8 = call_expr_func(expr);
        if node_kind(callee) != NODE_IDENT_EXPR {
            wasm_error("direct wasm currently supports only direct function calls");
            wasm_put(out, 66); wasm_put_sleb(out, 0);
            return;
        }
        var index i64 = wasm_find_func_arity(
            ident_expr_name(callee), ident_expr_name_len(callee), call_expr_arg_count(expr)
        );
        if index < 0 {
            if node_origin_source(expr) != nil { cg_diagnostic_node = expr; }
            if wasm_find_func(ident_expr_name(callee), ident_expr_name_len(callee)) >= 0 {
                wasm_error("wrong argument count in direct wasm call");
            } else {
                wasm_error("unknown function in direct wasm call");
            }
            wasm_put(out, 66); wasm_put_sleb(out, 0);
            return;
        }
        var args *u8 = call_expr_args(expr);
        var i i64 = 0;
        while i < call_expr_arg_count(expr) {
            var p **u8 = args + i * 8;
            wasm_emit_expr(*p, out);
            i = i + 1;
        }
        wasm_put(out, 16);  // call
        wasm_put_uleb(out, index);
        return;
    }

    wasm_error("expression is not supported by the direct wasm backend yet");
    wasm_put(out, 66); wasm_put_sleb(out, 0);
}

func wasm_expr_has_value(expr *u8) i64 {
    if expr == nil { return 0; }
    if node_kind(expr) == NODE_CALL_EXPR {
        var callee *u8 = call_expr_func(expr);
        if callee != nil && node_kind(callee) == NODE_IDENT_EXPR {
            var index i64 = wasm_find_func_arity(
                ident_expr_name(callee), ident_expr_name_len(callee), call_expr_arg_count(expr)
            );
            if index >= 0 { return 1 - wasm_type_is_void(func_decl_ret_type(wasm_func_decl_by_index(index))); }
        }
    }
    return 1;
}

func wasm_emit_stmt(stmt *u8, out *WasmBuf) void {
    if stmt == nil { return; }
    var kind i64 = node_kind(stmt);
    if kind == NODE_BLOCK_STMT {
        var saved_bindings i64 = wasm_binding_count;
        var stmts *u8 = block_stmt_stmts(stmt);
        var i i64 = 0;
        while i < block_stmt_count(stmt) {
            var p **u8 = stmts + i * 8;
            wasm_emit_stmt(*p, out);
            i = i + 1;
        }
        wasm_binding_count = saved_bindings;
        return;
    }
    if kind == NODE_VAR_DECL {
        var local i64 = wasm_local_for_decl(stmt);
        if var_decl_init(stmt) != nil { wasm_emit_expr(var_decl_init(stmt), out); }
        else { wasm_put(out, 66); wasm_put_sleb(out, 0); }
        wasm_put(out, 33);  // local.set
        wasm_put_uleb(out, local);
        wasm_bind_local(var_decl_name(stmt), var_decl_name_len(stmt), local);
        return;
    }
    if kind == NODE_ASSIGN_STMT {
        var target *u8 = assign_stmt_target(stmt);
        if node_kind(target) == NODE_UNARY_EXPR || node_kind(target) == NODE_INDEX_EXPR ||
           node_kind(target) == NODE_FIELD_EXPR {
            var stored_type *u8 = wasm_emit_address(target, out);
            wasm_emit_expr(assign_stmt_value(stmt), out);
            wasm_emit_store(stored_type, out);
            return;
        }
        if node_kind(target) != NODE_IDENT_EXPR {
            wasm_error("direct wasm cannot assign this target yet");
            return;
        }
        var local i64 = wasm_find_local(ident_expr_name(target), ident_expr_name_len(target));
        if local >= 0 {
            wasm_emit_expr(assign_stmt_value(stmt), out);
            wasm_put(out, 33);
            wasm_put_uleb(out, local);
            return;
        }
        var global i64 = wasm_find_global(ident_expr_name(target), ident_expr_name_len(target));
        if global < 0 { wasm_error("unknown assignment target in direct wasm function"); return; }
        wasm_emit_expr(assign_stmt_value(stmt), out);
        wasm_put(out, 36);  // global.set
        wasm_put_uleb(out, global);
        return;
    }
    if kind == NODE_EXPR_STMT {
        var expr *u8 = expr_stmt_expr(stmt);
        wasm_emit_expr(expr, out);
        if wasm_expr_has_value(expr) != 0 { wasm_put(out, 26); }  // drop
        return;
    }
    if kind == NODE_RETURN_STMT {
        if return_stmt_value(stmt) != nil { wasm_emit_expr(return_stmt_value(stmt), out); }
        wasm_put(out, 15);  // return
        return;
    }
    if kind == NODE_IF_STMT {
        var saved_bindings i64 = wasm_binding_count;
        wasm_emit_truth(if_stmt_cond(stmt), out);
        wasm_put(out, 4); wasm_put(out, 64);  // if, empty block type
        wasm_control_depth = wasm_control_depth + 1;
        wasm_emit_stmt(if_stmt_then(stmt), out);
        wasm_binding_count = saved_bindings;
        if if_stmt_else(stmt) != nil {
            wasm_put(out, 5);  // else
            wasm_emit_stmt(if_stmt_else(stmt), out);
            wasm_binding_count = saved_bindings;
        }
        wasm_put(out, 11);  // end
        wasm_control_depth = wasm_control_depth - 1;
        return;
    }
    if kind == NODE_WHILE_STMT {
        var saved_bindings i64 = wasm_binding_count;
        wasm_put(out, 2); wasm_put(out, 64);  // outer break block
        wasm_control_depth = wasm_control_depth + 1;
        var break_depth i64 = wasm_control_depth;
        wasm_put(out, 3); wasm_put(out, 64);  // loop
        wasm_control_depth = wasm_control_depth + 1;
        var continue_depth i64 = wasm_control_depth;
        wasm_push_loop(while_stmt_label(stmt), while_stmt_label_len(stmt),
                       break_depth, continue_depth);
        wasm_emit_truth(while_stmt_cond(stmt), out);
        wasm_put(out, 69);                    // i32.eqz
        wasm_put(out, 13);
        wasm_put_uleb(out, wasm_control_depth - break_depth);  // br_if outer
        wasm_emit_stmt(while_stmt_body(stmt), out);
        wasm_binding_count = saved_bindings;
        wasm_put(out, 12);
        wasm_put_uleb(out, wasm_control_depth - continue_depth);  // br loop
        wasm_loop_count = wasm_loop_count - 1;
        wasm_put(out, 11);
        wasm_control_depth = wasm_control_depth - 1;
        wasm_put(out, 11);
        wasm_control_depth = wasm_control_depth - 1;
        return;
    }
    if kind == NODE_BREAK_STMT {
        var depth i64 = wasm_loop_branch_depth(
            break_stmt_label(stmt), break_stmt_label_len(stmt), 0
        );
        if depth >= 0 { wasm_put(out, 12); wasm_put_uleb(out, depth); }
        return;
    }
    if kind == NODE_CONTINUE_STMT {
        var depth i64 = wasm_loop_branch_depth(
            continue_stmt_label(stmt), continue_stmt_label_len(stmt), 1
        );
        if depth >= 0 { wasm_put(out, 12); wasm_put_uleb(out, depth); }
        return;
    }
    wasm_error("statement is not supported by the direct wasm backend yet");
}

func wasm_reader_function(decl *u8) *u8 {
    var reader_fn *u8 = func_decl_alloc();
    func_decl_set_name(reader_fn, reader_decl_name(decl));
    func_decl_set_name_len(reader_fn, reader_decl_name_len(decl));
    var params *u8 = alloc(24);
    param_set_name(params, reader_decl_param_name(decl));
    param_set_name_len(params, reader_decl_param_len(decl));
    param_set_type(params, wasm_u8_ptr_type);
    func_decl_set_params(reader_fn, params);
    func_decl_set_param_count(reader_fn, 1);
    func_decl_set_ret_type(reader_fn, wasm_u8_ptr_type);
    func_decl_set_body(reader_fn, reader_decl_body(decl));
    func_decl_set_is_extern(reader_fn, 0);
    func_decl_set_is_pub(reader_fn, reader_decl_is_pub(decl));
    node_copy_origin(reader_fn, decl);
    return reader_fn;
}

func wasm_collect_decl(decl *u8) void {
    wasm_current_decl = decl;
    cg_diagnostic_node = decl;
    var kind i64 = node_kind(decl);
    if kind == NODE_FUNC_DECL {
        if func_decl_is_extern(decl) != 0 {
            if wasm_import_count >= LIMIT_FUNCS {
                wasm_error("too many extern functions for direct wasm output");
            } else {
                var import_slot **u8 = wasm_imports + wasm_import_count * 8;
                *import_slot = decl;
                wasm_import_count = wasm_import_count + 1;
            }
        } else if wasm_func_count >= LIMIT_FUNCS {
            wasm_error("too many functions for direct wasm output");
        } else {
            var slot **u8 = wasm_funcs + wasm_func_count * 8;
            *slot = decl;
            wasm_func_count = wasm_func_count + 1;
        }
        return;
    }
    if kind == NODE_READER_DECL {
        if wasm_func_count >= LIMIT_FUNCS {
            wasm_error("too many readers for direct wasm output");
        } else {
            var reader_slot **u8 = wasm_funcs + wasm_func_count * 8;
            *reader_slot = wasm_reader_function(decl);
            wasm_func_count = wasm_func_count + 1;
        }
        return;
    }
    if kind == NODE_VAR_DECL {
        if var_decl_is_extern(decl) != 0 {
            wasm_error("extern globals are not supported by the direct wasm backend yet");
        } else if wasm_type_is_value(var_decl_type(decl)) == 0 {
            wasm_error("direct wasm currently supports only scalar and pointer globals");
        } else if wasm_global_count >= LIMIT_GLOBALS {
            wasm_error("too many globals for direct wasm output");
        } else {
            var global_slot **u8 = wasm_globals + wasm_global_count * 8;
            *global_slot = decl;
            wasm_global_count = wasm_global_count + 1;
        }
        return;
    }
    if kind == NODE_STRUCT_DECL {
        if wasm_struct_count >= LIMIT_STRUCTS {
            wasm_error("too many structs for direct wasm output");
        } else {
            var struct_slot **u8 = wasm_structs + wasm_struct_count * 8;
            *struct_slot = decl;
            wasm_struct_count = wasm_struct_count + 1;
        }
        return;
    }
    if kind == NODE_INCLUDE_DECL {
        var path *u8 = include_decl_path(decl);
        var path_len i64 = include_decl_path_len(decl);
        // compiler.wasm already owns the #parser{} generator. A reader module
        // needs only the generated parser's token/PNode runtime.
        if wasm_name_eq(path, path_len, "std/parser_reader.lang", 22) != 0 {
            path = "std/parser_runtime.lang";
            path_len = 23;
        }
        var path_z *u8 = str_dup_n(path, path_len);
        if map_has(wasm_included_files, path_z) != 0 { return; }
        map_set(wasm_included_files, path_z, 1);
        var source *u8 = alloc(1024 * 1024);
        var n i64 = read_file_contents(path, path_len, source, 1024 * 1024 - 1);
        if n < 0 {
            wasm_error("cannot open include file for direct wasm output");
            return;
        }
        var included *u8 = parse_program_from_named_string(source, path_z);
        if included == nil {
            wasm_error("cannot parse include file for direct wasm output");
            return;
        }
        var decls *u8 = program_decls(included);
        var i i64 = 0;
        while i < program_decl_count(included) {
            wasm_collect_decl(get_decl(decls, i));
            i = i + 1;
        }
        return;
    }
    if kind == NODE_READER_EXPR {
        // Browser compilers cannot fork a reader helper. Readers shipped in
        // compiler_readers_web.lang expand directly inside compiler.wasm.
        var name *u8 = reader_expr_name(decl);
        var name_len i64 = reader_expr_name_len(decl);
        var output *u8 = compiler_expand_direct_reader(
            name, name_len, reader_expr_content(decl)
        );
        if output == nil {
            wasm_error("reader macro is not available to the direct wasm compiler");
            return;
        }
        var generated *u8 = parse_ast_from_reader_string(
            output, node_origin_source(decl), reader_expr_content(decl)
        );
        if generated == nil {
            wasm_error("embedded reader did not return valid AST");
            return;
        }
        var generated_decls *u8 = program_decls(generated);
        var generated_i i64 = 0;
        while generated_i < program_decl_count(generated) {
            var generated_decl *u8 = get_decl(generated_decls, generated_i);
            node_copy_origin(generated_decl, decl);
            wasm_collect_decl(generated_decl);
            generated_i = generated_i + 1;
        }
        return;
    }
    if kind == NODE_REQUIRE_DECL {
        wasm_error("require is not supported by direct wasm yet");
        return;
    }
    if kind != NODE_MODULES_DECL {
        wasm_error("declaration is not supported by the direct wasm backend yet");
    }
}

func wasm_collect_functions(prog *u8) void {
    wasm_funcs = alloc(LIMIT_FUNCS * 8);
    wasm_func_count = 0;
    wasm_imports = alloc(LIMIT_FUNCS * 8);
    wasm_import_count = 0;
    wasm_globals = alloc(LIMIT_GLOBALS * 8);
    wasm_global_count = 0;
    wasm_structs = alloc(LIMIT_STRUCTS * 8);
    wasm_struct_count = 0;
    wasm_strings = alloc(LIMIT_STRINGS * 24);
    wasm_string_count = 0;
    wasm_data_end = 1024;
    wasm_included_files = map_new();
    var decls *u8 = program_decls(prog);
    var i i64 = 0;
    while i < program_decl_count(prog) {
        wasm_collect_decl(get_decl(decls, i));
        i = i + 1;
    }
}

func wasm_mark_expr(expr *u8) void {
    if expr == nil { return; }
    var kind i64 = node_kind(expr);
    if kind == NODE_CALL_EXPR {
        var callee *u8 = call_expr_func(expr);
        if callee != nil && node_kind(callee) == NODE_IDENT_EXPR {
            var index i64 = wasm_find_func_arity(
                ident_expr_name(callee), ident_expr_name_len(callee), call_expr_arg_count(expr)
            );
            if index >= 0 { wasm_mark_function(index); }
        }
        var args *u8 = call_expr_args(expr);
        var i i64 = 0;
        while i < call_expr_arg_count(expr) {
            var p **u8 = args + i * 8;
            wasm_mark_expr(*p);
            i = i + 1;
        }
        return;
    }
    if kind == NODE_BINARY_EXPR {
        wasm_mark_expr(binary_expr_left(expr));
        wasm_mark_expr(binary_expr_right(expr));
    } else if kind == NODE_UNARY_EXPR {
        wasm_mark_expr(unary_expr_expr(expr));
    } else if kind == NODE_GROUP_EXPR {
        wasm_mark_expr(group_expr_expr(expr));
    } else if kind == NODE_CAST_EXPR {
        wasm_mark_expr(cast_expr_expr(expr));
    } else if kind == NODE_BITCAST_EXPR {
        wasm_mark_expr(bitcast_expr_expr(expr));
    } else if kind == NODE_INDEX_EXPR {
        wasm_mark_expr(index_expr_base(expr));
        wasm_mark_expr(index_expr_index(expr));
    } else if kind == NODE_FIELD_EXPR {
        wasm_mark_expr(field_expr_expr(expr));
    } else if kind == NODE_LET_EXPR {
        wasm_mark_expr(let_expr_init(expr));
        wasm_mark_expr(let_expr_body(expr));
    } else if kind == NODE_BLOCK_EXPR {
        var stmts *u8 = block_expr_stmts(expr);
        var i i64 = 0;
        while i < block_expr_count(expr) {
            var p **u8 = stmts + i * 8;
            wasm_mark_stmt(*p);
            i = i + 1;
        }
        wasm_mark_expr(block_expr_tail(expr));
    }
}

func wasm_mark_stmt(stmt *u8) void {
    if stmt == nil { return; }
    var kind i64 = node_kind(stmt);
    if kind == NODE_BLOCK_STMT {
        var stmts *u8 = block_stmt_stmts(stmt);
        var i i64 = 0;
        while i < block_stmt_count(stmt) {
            var p **u8 = stmts + i * 8;
            wasm_mark_stmt(*p);
            i = i + 1;
        }
    } else if kind == NODE_VAR_DECL {
        wasm_mark_expr(var_decl_init(stmt));
    } else if kind == NODE_ASSIGN_STMT {
        wasm_mark_expr(assign_stmt_target(stmt));
        wasm_mark_expr(assign_stmt_value(stmt));
    } else if kind == NODE_EXPR_STMT {
        wasm_mark_expr(expr_stmt_expr(stmt));
    } else if kind == NODE_RETURN_STMT {
        wasm_mark_expr(return_stmt_value(stmt));
    } else if kind == NODE_IF_STMT {
        wasm_mark_expr(if_stmt_cond(stmt));
        wasm_mark_stmt(if_stmt_then(stmt));
        wasm_mark_stmt(if_stmt_else(stmt));
    } else if kind == NODE_WHILE_STMT {
        wasm_mark_expr(while_stmt_cond(stmt));
        wasm_mark_stmt(while_stmt_body(stmt));
    }
}

func wasm_mark_function(index i64) void {
    if index < wasm_import_count {
        if *(wasm_import_marks + index) != 0 { return; }
        *(wasm_import_marks + index) = 1;
        return;
    }
    var defined_index i64 = index - wasm_import_count;
    if *(wasm_func_marks + defined_index) != 0 { return; }
    *(wasm_func_marks + defined_index) = 1;
    wasm_mark_stmt(func_decl_body(wasm_func_get(defined_index)));
}

func wasm_prune_unreachable() void {
    wasm_func_marks = alloc(wasm_func_count);
    wasm_import_marks = alloc(wasm_import_count);
    var main_index i64 = wasm_find_defined_func("main", 4);
    if main_index < 0 { wasm_error("direct wasm output requires a main function"); return; }
    wasm_mark_function(main_index);

    var new_imports *u8 = alloc(LIMIT_FUNCS * 8);
    var new_import_count i64 = 0;
    var i i64 = 0;
    while i < wasm_import_count {
        if *(wasm_import_marks + i) != 0 {
            var dst **u8 = new_imports + new_import_count * 8;
            *dst = wasm_import_get(i);
            new_import_count = new_import_count + 1;
        }
        i = i + 1;
    }

    var new_funcs *u8 = alloc(LIMIT_FUNCS * 8);
    var new_func_count i64 = 0;
    i = 0;
    while i < wasm_func_count {
        if *(wasm_func_marks + i) != 0 {
            var dst **u8 = new_funcs + new_func_count * 8;
            *dst = wasm_func_get(i);
            new_func_count = new_func_count + 1;
        }
        i = i + 1;
    }
    wasm_imports = new_imports;
    wasm_import_count = new_import_count;
    wasm_funcs = new_funcs;
    wasm_func_count = new_func_count;
}

func wasm_emit_type_section() void {
    wasm_section.len = 0;
    wasm_put_uleb(wasm_section, wasm_import_count + wasm_func_count);
    var i i64 = 0;
    while i < wasm_import_count + wasm_func_count {
        var decl *u8 = wasm_func_decl_by_index(i);
        wasm_current_decl = decl;
        wasm_put(wasm_section, 96);  // func type
        var count i64 = func_decl_param_count(decl);
        wasm_put_uleb(wasm_section, count);
        var params *u8 = func_decl_params(decl);
        var j i64 = 0;
        while j < count {
            var p *u8 = params + j * 24;
            if wasm_type_is_value(param_type(p)) == 0 {
                wasm_error("direct wasm currently supports only scalar and pointer parameters");
            }
            wasm_put(wasm_section, 126);  // i64
            j = j + 1;
        }
        if wasm_type_is_void(func_decl_ret_type(decl)) != 0 {
            wasm_put_uleb(wasm_section, 0);
        } else {
            if wasm_type_is_value(func_decl_ret_type(decl)) == 0 {
                wasm_error("direct wasm currently supports only scalar, pointer, or void returns");
            }
            wasm_put_uleb(wasm_section, 1);
            wasm_put(wasm_section, 126);
        }
        i = i + 1;
    }
    wasm_emit_section(1, wasm_section);
}

func wasm_emit_import_section() void {
    if wasm_import_count == 0 { return; }
    wasm_put_uleb(wasm_section, wasm_import_count);
    var i i64 = 0;
    while i < wasm_import_count {
        var decl *u8 = wasm_import_get(i);
        wasm_put_name(wasm_section, "lang", 4);
        wasm_put_name(wasm_section, func_decl_name(decl), func_decl_name_len(decl));
        wasm_put(wasm_section, 0);  // function import
        wasm_put_uleb(wasm_section, i);  // matching type index
        i = i + 1;
    }
    wasm_emit_section(2, wasm_section);
}

func wasm_emit_function_section() void {
    wasm_put_uleb(wasm_section, wasm_func_count);
    var i i64 = 0;
    while i < wasm_func_count {
        wasm_put_uleb(wasm_section, wasm_import_count + i);
        i = i + 1;
    }
    wasm_emit_section(3, wasm_section);
}

func wasm_emit_memory_section() void {
    wasm_put_uleb(wasm_section, 1);  // one memory
    wasm_put(wasm_section, 0);       // minimum only
    wasm_put_uleb(wasm_section, 32); // 2 MiB; heap begins at 1 MiB
    wasm_emit_section(5, wasm_section);
}

func wasm_const_value(expr *u8) i64 {
    if expr == nil || node_kind(expr) == NODE_NIL_EXPR { return 0; }
    if node_kind(expr) == NODE_NUMBER_EXPR {
        return wasm_parse_integer(number_expr_value(expr), number_expr_value_len(expr));
    }
    if node_kind(expr) == NODE_BOOL_EXPR { return bool_expr_value(expr); }
    if node_kind(expr) == NODE_STRING_EXPR {
        return wasm_add_string(string_expr_value(expr), string_expr_value_len(expr));
    }
    if node_kind(expr) == NODE_GROUP_EXPR { return wasm_const_value(group_expr_expr(expr)); }
    if node_kind(expr) == NODE_UNARY_EXPR && unary_expr_op(expr) == TOKEN_MINUS {
        return 0 - wasm_const_value(unary_expr_expr(expr));
    }
    wasm_error("global initializer is not constant in direct wasm");
    return 0;
}

func wasm_emit_global_section() void {
    // User globals are canonical i64 values. The final i32 global marks the
    // beginning of host-managed heap space.
    wasm_put_uleb(wasm_section, wasm_global_count + 1);
    var i i64 = 0;
    while i < wasm_global_count {
        var decl *u8 = wasm_global_get(i);
        wasm_current_decl = decl;
        wasm_put(wasm_section, 126);  // i64
        wasm_put(wasm_section, 1);    // mutable
        wasm_put(wasm_section, 66);   // i64.const
        wasm_put_sleb(wasm_section, wasm_const_value(var_decl_init(decl)));
        wasm_put(wasm_section, 11);   // end initializer
        i = i + 1;
    }
    wasm_put(wasm_section, 127);  // i32
    wasm_put(wasm_section, 0);    // immutable
    wasm_put(wasm_section, 65);   // i32.const
    wasm_put_sleb(wasm_section, 1024 * 1024);
    wasm_put(wasm_section, 11);
    wasm_emit_section(6, wasm_section);
}

func wasm_emit_export_section() void {
    var main_index i64 = wasm_find_defined_func("main", 4);
    if main_index < 0 {
        wasm_error("direct wasm output requires a main function");
        return;
    }
    wasm_put_uleb(wasm_section, 3);
    wasm_put_name(wasm_section, "memory", 6);
    wasm_put(wasm_section, 2);  // memory export
    wasm_put_uleb(wasm_section, 0);
    wasm_put_name(wasm_section, "main", 4);
    wasm_put(wasm_section, 0);  // function export
    wasm_put_uleb(wasm_section, main_index);
    wasm_put_name(wasm_section, "__heap_base", 11);
    wasm_put(wasm_section, 3);  // global export
    wasm_put_uleb(wasm_section, wasm_global_count);
    wasm_emit_section(7, wasm_section);
}

func wasm_emit_function_body(decl *u8) void {
    wasm_current_decl = decl;
    wasm_body.len = 0;
    wasm_locals = alloc(LIMIT_LOCALS * 40);
    wasm_bindings = alloc(LIMIT_LOCALS * 24);
    wasm_local_count = 0;
    wasm_binding_count = 0;
    wasm_control_depth = 0;
    wasm_loops = alloc(LIMIT_LOOP_DEPTH * 32);
    wasm_loop_count = 0;

    var params *u8 = func_decl_params(decl);
    var i i64 = 0;
    while i < func_decl_param_count(decl) {
        var p *u8 = params + i * 24;
        var param_index i64 = wasm_local_add(param_name(p), param_name_len(p), param_type(p), nil);
        wasm_bind_local(param_name(p), param_name_len(p), param_index);
        i = i + 1;
    }
    wasm_param_count = wasm_local_count;
    wasm_collect_locals(func_decl_body(decl));

    var added i64 = wasm_local_count - wasm_param_count;
    if added > 0 {
        wasm_put_uleb(wasm_body, 1);  // one local group
        wasm_put_uleb(wasm_body, added);
        wasm_put(wasm_body, 126);    // i64
    } else {
        wasm_put_uleb(wasm_body, 0);
    }

    wasm_emit_stmt(func_decl_body(decl), wasm_body);
    if wasm_type_is_void(func_decl_ret_type(decl)) == 0 {
        // A valid default for paths not terminated by an explicit return.
        wasm_put(wasm_body, 66);
        wasm_put_sleb(wasm_body, 0);
    }
    wasm_put(wasm_body, 11);  // function end

    wasm_put_uleb(wasm_section, wasm_body.len);
    wasm_put_bytes(wasm_section, wasm_body.data, wasm_body.len);
}

func wasm_emit_code_section() void {
    wasm_put_uleb(wasm_section, wasm_func_count);
    var i i64 = 0;
    while i < wasm_func_count {
        wasm_emit_function_body(wasm_func_get(i));
        i = i + 1;
    }
    wasm_emit_section(10, wasm_section);
}

func wasm_emit_data_section() void {
    if wasm_string_count == 0 { return; }
    wasm_put_uleb(wasm_section, wasm_string_count);
    var i i64 = 0;
    while i < wasm_string_count {
        var entry *u8 = wasm_strings + i * 24;
        var data_p **u8 = entry;
        var len_p *i64 = entry + 8;
        var offset_p *i64 = entry + 16;
        wasm_put(wasm_section, 0);   // active segment, memory 0
        wasm_put(wasm_section, 65);  // i32.const
        wasm_put_sleb(wasm_section, *offset_p);
        wasm_put(wasm_section, 11);
        wasm_put_uleb(wasm_section, *len_p + 1);
        wasm_put_bytes(wasm_section, *data_p, *len_p);
        wasm_put(wasm_section, 0);   // C string terminator
        i = i + 1;
    }
    wasm_emit_section(11, wasm_section);
}

func generate_wasm(prog *u8, output_file *u8) void {
    cg_has_wasm_backend = 1;
    cg_generate_wasm_fn = &generate_wasm;
    wasm_had_error = 0;
    wasm_module = wasm_buf_new(8 * 1024 * 1024);
    wasm_section = wasm_buf_new(8 * 1024 * 1024);
    wasm_body = wasm_buf_new(8 * 1024 * 1024);

    wasm_i64_type = base_type_alloc();
    base_type_set_name(wasm_i64_type, "i64");
    base_type_set_name_len(wasm_i64_type, 3);
    wasm_u8_type = base_type_alloc();
    base_type_set_name(wasm_u8_type, "u8");
    base_type_set_name_len(wasm_u8_type, 2);
    wasm_u8_ptr_type = ptr_type_alloc();
    ptr_type_set_elem(wasm_u8_ptr_type, wasm_u8_type);

    wasm_collect_functions(prog);
    wasm_prune_unreachable();
    if wasm_had_error != 0 { os_unlink(output_file); exit(1); }

    // \0asm followed by binary format version 1.
    wasm_put(wasm_module, 0); wasm_put(wasm_module, 97);
    wasm_put(wasm_module, 115); wasm_put(wasm_module, 109);
    wasm_put(wasm_module, 1); wasm_put(wasm_module, 0);
    wasm_put(wasm_module, 0); wasm_put(wasm_module, 0);

    wasm_emit_type_section();
    wasm_emit_import_section();
    wasm_emit_function_section();
    wasm_emit_memory_section();
    wasm_emit_global_section();
    wasm_emit_export_section();
    wasm_emit_code_section();
    wasm_emit_data_section();

    if wasm_had_error != 0 {
        os_unlink(output_file);
        eprintln("error: direct wasm compilation failed");
        exit(1);
    }

    var fd i64 = file_open(output_file, O_WRONLY_CREAT_TRUNC);
    if fd < 0 {
        eprint("Error: cannot open output file: ");
        eprintln(output_file);
        exit(1);
    }
    file_write(fd, wasm_module.data, wasm_module.len);
    file_close(fd);
}
