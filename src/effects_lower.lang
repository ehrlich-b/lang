// Portable one-shot deep effects, lowered to ordinary AST before codegen.
// Suspended locals live in heap environments; the native/Wasm call stack is
// never captured. Every transition has an ordinary branch/call/return edge.
// The runtime trampoline dispatches generated functions, not source AST.

struct EffBinding { name *u8; len i64; typ *u8; depth i64; offset i64; }
struct EffBlock { id i64; stmts *u8; closed i64; }
struct EffFunction {
    decl *u8; id i64; marked i64; replacement *u8;
    bindings *u8; blocks *u8; cursor *EffBlock; bytes i64;
    loops *u8; synthetic i64; origin *u8;
}
struct EffLoop { name *u8; len i64; stop *EffBlock; again *EffBlock; }

var effects_decls *u8 = nil;
var effects_functions *u8 = nil;
var effects_extras *u8 = nil;
var effects_had_error i64 = 0;
var effects_i64 *u8 = nil;
var effects_byte_ptr *u8 = nil;
var effects_frame_ptr *u8 = nil;
var effects_handler_ptr *u8 = nil;
var effects_next_id i64 = 1;

func eff_eq(a *u8, an i64, b *u8, bn i64) i64 {
    if an != bn { return 0; }
    var i i64 = 0;
    while i < an { if *(a+i) != *(b+i) { return 0; } i = i+1; }
    return 1;
}
func eff_type(name *u8) *u8 {
    var t *u8 = base_type_alloc();
    base_type_set_name(t, name); base_type_set_name_len(t, strlen(name));
    return t;
}
func eff_ptr(t *u8) *u8 { var p *u8 = ptr_type_alloc(); ptr_type_set_elem(p,t); return p; }
func eff_ident(name *u8) *u8 {
    var n *u8 = ident_expr_alloc(); ident_expr_set_name(n,name);
    ident_expr_set_name_len(n,strlen(name)); return n;
}
func eff_num(v i64) *u8 {
    var text *u8 = alloc(32); itoa(v,text);
    var n *u8 = number_expr_alloc(); number_expr_set_value(n,text);
    number_expr_set_value_len(n,strlen(text)); return n;
}
func eff_bin(op i64, a *u8, b *u8) *u8 {
    var n *u8 = binary_expr_alloc(); binary_expr_set_op(n,op);
    binary_expr_set_left(n,a); binary_expr_set_right(n,b); return n;
}
func eff_un(op i64, a *u8) *u8 {
    var n *u8 = unary_expr_alloc(); unary_expr_set_op(n,op); unary_expr_set_expr(n,a); return n;
}
func eff_cast(t *u8, a *u8) *u8 {
    var n *u8 = cast_expr_alloc(); cast_expr_set_type(n,t); cast_expr_set_expr(n,a); return n;
}
func eff_field(base *u8, name *u8) *u8 {
    var n *u8 = alloc(32); node_set_kind(n,NODE_FIELD_EXPR);
    var p **u8=n+8; *p=base; p=n+16; *p=name;
    var len *i64=n+24; *len=strlen(name); return n;
}
func eff_f(name *u8) *u8 { return eff_field(eff_ident("__eff_f"),name); }
func eff_call(name *u8, args *u8) *u8 {
    var n *u8 = call_expr_alloc(); call_expr_set_func(n,eff_ident(name));
    var data *u8 = alloc(vec_len(args)*8); var i i64 = 0;
    while i < vec_len(args) { var p **u8 = data+i*8; *p=vec_get(args,i); i=i+1; }
    call_expr_set_args(n,data); call_expr_set_arg_count(n,vec_len(args)); return n;
}
func eff_args1(a *u8) *u8 { var v *u8=vec_new(1); vec_push(v,a); return v; }
func eff_args2(a *u8,b *u8) *u8 { var v *u8=eff_args1(a); vec_push(v,b); return v; }
func eff_args3(a *u8,b *u8,c *u8) *u8 { var v *u8=eff_args2(a,b); vec_push(v,c); return v; }
func eff_assign(a *u8,b *u8) *u8 {
    var n *u8=assign_stmt_alloc(); assign_stmt_set_target(n,a); assign_stmt_set_value(n,b); return n;
}
func eff_expr_stmt(a *u8) *u8 { var n *u8=expr_stmt_alloc(); expr_stmt_set_expr(n,a); return n; }
func eff_return(a *u8) *u8 { var n *u8=return_stmt_alloc(); return_stmt_set_value(n,a); return n; }
func eff_block(v *u8) *u8 {
    var n *u8=block_stmt_alloc(); var data *u8=alloc(vec_len(v)*8); var i i64=0;
    while i<vec_len(v) { var p **u8=data+i*8; *p=vec_get(v,i); i=i+1; }
    block_stmt_set_stmts(n,data); block_stmt_set_count(n,vec_len(v)); return n;
}
func eff_if(c *u8,a *u8,b *u8) *u8 {
    if a!=nil && node_kind(a)!=NODE_BLOCK_STMT { a=eff_block(eff_args1(a)); }
    if b!=nil && node_kind(b)!=NODE_BLOCK_STMT { b=eff_block(eff_args1(b)); }
    var n *u8=if_stmt_alloc(); if_stmt_set_cond(n,c); if_stmt_set_then(n,a); if_stmt_set_else(n,b); return n;
}
func eff_var(name *u8,t *u8,value *u8) *u8 {
    var n *u8=var_decl_alloc(); var_decl_set_name(n,name); var_decl_set_name_len(n,strlen(name));
    var_decl_set_type(n,t); var_decl_set_init(n,value); return n;
}
func eff_name(prefix *u8,id i64) *u8 { var text *u8=alloc(32); itoa(id,text); return str_concat(prefix,text); }
func eff_func(name *u8,params *u8,count i64,ret *u8,body *u8) *u8 {
    var n *u8=func_decl_alloc(); func_decl_set_name(n,name); func_decl_set_name_len(n,strlen(name));
    func_decl_set_params(n,params); func_decl_set_param_count(n,count);
    func_decl_set_ret_type(n,ret); func_decl_set_body(n,body); return n;
}
func eff_param(name *u8,t *u8) *u8 {
    var p *u8=alloc(24); param_set_name(p,name); param_set_name_len(p,strlen(name)); param_set_type(p,t); return p;
}
func eff_error(f *EffFunction,node *u8,message *u8) void {
    if effects_had_error==0 {
        cg_diagnostic_node=node;
        if node_origin_source(node)==nil && f!=nil { cg_diagnostic_node=f.origin; }
        cg_error_prefix(); eprintln(message);
    }
    effects_had_error=1;
}
func effects_init() void {
    effects_decls=vec_new(128); effects_functions=vec_new(64); effects_extras=vec_new(64);
    effects_had_error=0; effects_next_id=1;
    effects_i64=eff_type("i64"); effects_byte_ptr=eff_ptr(eff_type("u8"));
    effects_frame_ptr=eff_ptr(eff_type("__EffFrame"));
    effects_handler_ptr=eff_ptr(eff_type("__EffHandler"));
}
func effects_add_decl(decl *u8) void {
    if decl==nil { return; }
    var i i64=0;
    while i<vec_len(effects_decls) { if vec_get(effects_decls,i)==decl { return; } i=i+1; }
    vec_push(effects_decls,decl);
    if node_kind(decl)==NODE_FUNC_DECL && func_decl_is_extern(decl)==0 {
        var f *EffFunction=alloc(96);
        f.decl=decl; f.id=0; f.marked=0; f.replacement=nil;
        f.bindings=nil; f.blocks=nil; f.cursor=nil; f.bytes=8;
        f.loops=nil; f.synthetic=0; f.origin=decl;
        vec_push(effects_functions,f);
    }
}
func eff_find_func(name *u8,len i64,arity i64) *EffFunction {
    var i i64=0;
    while i<vec_len(effects_functions) {
        var f *EffFunction=vec_get(effects_functions,i);
        if f.decl!=nil && eff_eq(name,len,func_decl_name(f.decl),func_decl_name_len(f.decl))!=0 &&
           func_decl_param_count(f.decl)==arity { return f; }
        i=i+1;
    }
    return nil;
}
func eff_marked_name(name *u8,len i64) i64 {
    var i i64=0;
    while i<vec_len(effects_functions) {
        var f *EffFunction=vec_get(effects_functions,i);
        if f.decl!=nil && f.marked!=0 && eff_eq(name,len,func_decl_name(f.decl),func_decl_name_len(f.decl))!=0 { return 1; }
        i=i+1;
    }
    return 0;
}
func eff_shadowed(names *u8,name *u8,len i64) i64 {
    var i i64=vec_len(names)-1;
    while i>=0 { var n *u8=vec_get(names,i); if eff_eq(name,len,ident_expr_name(n),ident_expr_name_len(n))!=0 { return 1; } i=i-1; }
    return 0;
}
func eff_shadow(names *u8,name *u8,len i64) void { vec_push(names,eff_ident(str_dup_n(name,len))); }
func eff_unshadow(names *u8,count i64) void { while vec_len(names)>count { vec_pop(names); } }
func eff_find_decl(kind i64,name *u8,len i64) *u8 {
    var i i64=0;
    while i<vec_len(effects_decls) {
        var d *u8=vec_get(effects_decls,i); var dn *u8=nil; var dl i64=0;
        if node_kind(d)==kind {
            if kind==NODE_VAR_DECL { dn=var_decl_name(d); dl=var_decl_name_len(d); }
            if kind==NODE_FUNC_DECL { dn=func_decl_name(d); dl=func_decl_name_len(d); }
            if kind==NODE_EFFECT_DECL { dn=effect_decl_name(d); dl=effect_decl_name_len(d); }
            if kind==NODE_STRUCT_DECL { dn=struct_decl_name(d); dl=struct_decl_name_len(d); }
            if kind==NODE_ENUM_DECL { dn=enum_decl_name(d); dl=enum_decl_name_len(d); }
            if dn!=nil && eff_eq(name,len,dn,dl)!=0 { return d; }
        }
        i=i+1;
    }
    return nil;
}

// This scanner intentionally crosses every expression/statement edge, so a
// yield in an argument, short-circuit operand, or loop condition is visible.
func eff_scan(node *u8,names *u8) i64 {
    if node==nil { return 0; }
    var k i64=node_kind(node);
    if k==NODE_PERFORM_EXPR || k==NODE_HANDLE_EXPR || k==NODE_RESUME_EXPR { return 1; }
    // Mark bridges that take an effectful function's address as well as direct
    // callers. The value lowering below rejects that unsupported escape, so a
    // callback bridge cannot silently call a wrapper with no dynamic handler.
    if k==NODE_IDENT_EXPR { return eff_shadowed(names,ident_expr_name(node),ident_expr_name_len(node))==0 && eff_marked_name(ident_expr_name(node),ident_expr_name_len(node))!=0; }
    if k==NODE_BLOCK_STMT {
        var saved i64=vec_len(names); var i i64=0; while i<block_stmt_count(node) {
            var p **u8=block_stmt_stmts(node)+i*8; if eff_scan(*p,names)!=0 { return 1; } i=i+1;
        }
        eff_unshadow(names,saved);
    }
    if k==NODE_VAR_DECL {
        var need i64=eff_scan(var_decl_init(node),names); eff_shadow(names,var_decl_name(node),var_decl_name_len(node)); return need;
    }
    if k==NODE_IF_STMT { return eff_scan(if_stmt_cond(node),names) || eff_scan(if_stmt_then(node),names) || eff_scan(if_stmt_else(node),names); }
    if k==NODE_WHILE_STMT { return eff_scan(while_stmt_cond(node),names) || eff_scan(while_stmt_body(node),names); }
    if k==NODE_RETURN_STMT { return eff_scan(return_stmt_value(node),names); }
    if k==NODE_EXPR_STMT { return eff_scan(expr_stmt_expr(node),names); }
    if k==NODE_ASSIGN_STMT { return eff_scan(assign_stmt_target(node),names) || eff_scan(assign_stmt_value(node),names); }
    if k==NODE_BINARY_EXPR { return eff_scan(binary_expr_left(node),names) || eff_scan(binary_expr_right(node),names); }
    if k==NODE_UNARY_EXPR { return eff_scan(unary_expr_expr(node),names); }
    if k==NODE_GROUP_EXPR { return eff_scan(group_expr_expr(node),names); }
    if k==NODE_CAST_EXPR { return eff_scan(cast_expr_expr(node),names); }
    if k==NODE_BITCAST_EXPR { return eff_scan(bitcast_expr_expr(node),names); }
    if k==NODE_FIELD_EXPR { return eff_scan(field_expr_expr(node),names); }
    if k==NODE_INDEX_EXPR { return eff_scan(index_expr_base(node),names) || eff_scan(index_expr_index(node),names); }
    if k==NODE_CALL_EXPR {
        var callee *u8=call_expr_func(node);
        if node_kind(callee)==NODE_IDENT_EXPR && eff_shadowed(names,ident_expr_name(callee),ident_expr_name_len(callee))==0 {
            var f *EffFunction=eff_find_func(ident_expr_name(callee),ident_expr_name_len(callee),call_expr_arg_count(node));
            if f!=nil && f.marked!=0 { return 1; }
        }
        if eff_scan(callee,names)!=0 { return 1; }
        var i i64=0; while i<call_expr_arg_count(node) {
            var p **u8=call_expr_args(node)+i*8; if eff_scan(*p,names)!=0 { return 1; } i=i+1;
        }
    }
    if k==NODE_LET_EXPR {
        if eff_scan(let_expr_init(node),names)!=0 { return 1; }
        var saved i64=vec_len(names); eff_shadow(names,let_expr_name(node),let_expr_name_len(node));
        var need i64=eff_scan(let_expr_body(node),names); eff_unshadow(names,saved); return need;
    }
    if k==NODE_LAMBDA_EXPR {
        var saved i64=vec_len(names); var i i64=0;
        while i<lambda_expr_param_count(node) { var p *u8=lambda_expr_params(node)+i*24; eff_shadow(names,param_name(p),param_name_len(p)); i=i+1; }
        var need i64=eff_scan(lambda_expr_body(node),names); eff_unshadow(names,saved); return need;
    }
    if k==NODE_BLOCK_EXPR {
        var saved i64=vec_len(names); var i i64=0; while i<block_expr_count(node) {
            var p **u8=block_expr_stmts(node)+i*8; if eff_scan(*p,names)!=0 { return 1; } i=i+1;
        }
        var need i64=eff_scan(block_expr_tail(node),names); eff_unshadow(names,saved); return need;
    }
    if k==NODE_MATCH_EXPR {
        if eff_scan(match_expr_scrutinee(node),names)!=0 { return 1; }
        var i i64=0; while i<match_expr_arm_count(node) {
            var arm *u8=get_match_arm(match_expr_arms(node),i); var pat *u8=match_arm_pattern(arm); var saved i64=vec_len(names);
            if node_kind(pat)==NODE_PATTERN_VARIANT && pattern_variant_binding_len(pat)>0 { eff_shadow(names,pattern_variant_binding(pat),pattern_variant_binding_len(pat)); }
            var need i64=eff_scan(match_arm_body(arm),names); eff_unshadow(names,saved); if need!=0 { return 1; } i=i+1;
        }
    }
    if k==NODE_ARRAY_LITERAL {
        var i i64=0; while i<array_literal_count(node) {
            var p **u8=array_literal_elems(node)+i*8; if eff_scan(*p,names)!=0 { return 1; } i=i+1;
        }
    }
    return 0;
}

func eff_needs(node *u8) i64 { return eff_scan(node,vec_new(8)); }
func eff_function_needs(d *u8) i64 {
    var names *u8=vec_new(8); var i i64=0;
    while i<func_decl_param_count(d) { var p *u8=func_decl_params(d)+i*24; eff_shadow(names,param_name(p),param_name_len(p)); i=i+1; }
    return eff_scan(func_decl_body(d),names);
}

func eff_new_block(f *EffFunction) *EffBlock {
    var b *EffBlock=alloc(24); b.id=vec_len(f.blocks); b.stmts=vec_new(8); b.closed=0;
    if b.id>=8192 { eff_error(f,f.origin,"portable effects exceeded 8192 control states in one function"); }
    vec_push(f.blocks,b); return b;
}
func eff_append(f *EffFunction,s *u8) void { if f.cursor.closed==0 { vec_push(f.cursor.stmts,s); } }
func eff_jump(f *EffFunction,to *EffBlock) void {
    eff_append(f,eff_assign(eff_f("pc"),eff_num(to.id)));
    eff_append(f,eff_return(eff_ident("__eff_f"))); f.cursor.closed=1;
}
func eff_finish(f *EffFunction,value *u8) void {
    eff_append(f,eff_return(eff_call("__eff_finish",eff_args2(eff_ident("__eff_f"),eff_cast(effects_i64,value)))));
    f.cursor.closed=1;
}
func eff_setup(f *EffFunction) void {
    f.bindings=vec_new(32); f.blocks=vec_new(16); f.loops=vec_new(8); f.bytes=8;
    f.cursor=eff_new_block(f);
}
func eff_bind(f *EffFunction,name *u8,len i64,t *u8) *EffBinding {
    if (len>=6 && eff_eq(name,6,"__eff_",6)!=0) || (len>=5 && eff_eq(name,5,"__Eff",5)!=0) {
        eff_error(f,f.origin,"names beginning __eff_ or __Eff are reserved in a module using effects");
    }
    var b *EffBinding=alloc(40); b.name=name; b.len=len; b.typ=t; b.depth=0; b.offset=f.bytes;
    f.bytes=f.bytes+((eff_size(t,0)+7)/8)*8;
    if f.bytes>65536 { eff_error(f,f.origin,"portable effects exceeded 65536 bytes of lexical frame storage"); }
    vec_push(f.bindings,b); return b;
}
func eff_lookup(f *EffFunction,name *u8,len i64) *EffBinding {
    var i i64=vec_len(f.bindings)-1;
    while i>=0 { var b *EffBinding=vec_get(f.bindings,i); if eff_eq(name,len,b.name,b.len)!=0 { return b; } i=i-1; }
    return nil;
}
func eff_env(depth i64) *u8 {
    var env *u8=eff_f("env"); var i i64=0;
    while i<depth { env=eff_un(TOKEN_STAR,eff_cast(eff_ptr(effects_byte_ptr),env)); i=i+1; }
    return env;
}
func eff_cell(b *EffBinding) *u8 {
    if eff_aggregate(b.typ)!=0 { return eff_aggregate_value(b); }
    var storage *u8=b.typ;
    // Lang's integral local/parameter ABI stores a whole i64 even for i8/bool.
    // Preserve that representation; explicit casts and pointed memory retain
    // their existing width behavior. Pointer cells retain their pointer type.
    if storage!=nil && type_kind(storage)==TYPE_BASE && eff_scalar(storage)!=0 { storage=effects_i64; }
    return eff_un(TOKEN_STAR,eff_cast(eff_ptr(storage),eff_bin(TOKEN_PLUS,eff_env(b.depth),eff_num(b.offset))));
}
func eff_scalar(t *u8) i64 {
    if t==nil { return 1; }
    if type_kind(t)==TYPE_PTR || type_kind(t)==TYPE_FUNC || type_kind(t)==TYPE_CLOSURE { return 1; }
    if type_kind(t)!=TYPE_BASE { return 0; }
    var n *u8=base_type_name(t); var len i64=base_type_name_len(t);
    if eff_eq(n,len,"bool",4)!=0 || eff_eq(n,len,"void",4)!=0 { return 1; }
    if eff_eq(n,len,"i8",2)!=0 || eff_eq(n,len,"u8",2)!=0 ||
       eff_eq(n,len,"i16",3)!=0 || eff_eq(n,len,"u16",3)!=0 ||
       eff_eq(n,len,"i32",3)!=0 || eff_eq(n,len,"u32",3)!=0 ||
       eff_eq(n,len,"i64",3)!=0 || eff_eq(n,len,"u64",3)!=0 { return 1; }
    return 0;
}
func eff_aggregate(t *u8) i64 {
    if t==nil { return 0; }
    if type_kind(t)==TYPE_ARRAY { return 1; }
    if type_kind(t)!=TYPE_BASE { return 0; }
    return eff_find_decl(NODE_STRUCT_DECL,base_type_name(t),base_type_name_len(t))!=nil ||
           eff_find_decl(NODE_ENUM_DECL,base_type_name(t),base_type_name_len(t))!=nil;
}
func eff_size(t *u8,depth i64) i64 {
    if t==nil { return 8; }
    if depth>=32 { eff_error(nil,nil,"portable effect frame type nesting exceeds 32"); return 8; }
    if type_kind(t)==TYPE_ARRAY {
        var count i64=array_type_size(t); var stride i64=eff_size(array_type_elem(t),depth+1);
        if count<=0 || stride<=0 || stride>65536 || count>65536/stride {
            eff_error(nil,t,"portable effect arrays require positive extents and at most 65536 bytes"); return 8;
        }
        return count*stride;
    }
    if type_kind(t)!=TYPE_BASE { return 8; }
    var name *u8=base_type_name(t); var len i64=base_type_name_len(t);
    var s *u8=eff_find_decl(NODE_STRUCT_DECL,name,len);
    if s!=nil {
        var bytes i64=0; var i i64=0;
        while i<struct_decl_field_count(s) {
            var size i64=eff_size(struct_field_type(get_struct_field(struct_decl_fields(s),i)),depth+1);
            if size>1 { bytes=((bytes+7)/8)*8; }
            if size<0 || size>65536-bytes { eff_error(nil,s,"portable effect struct layout exceeds 65536 bytes"); return 8; }
            bytes=bytes+size; i=i+1;
        }
        return ((bytes+7)/8)*8;
    }
    var e *u8=eff_find_decl(NODE_ENUM_DECL,name,len);
    if e!=nil {
        var max i64=8; var i i64=0;
        while i<enum_decl_variant_count(e) {
            var v *u8=get_enum_variant(enum_decl_variants(e),i); var sz i64=0;
            if enum_variant_type(v)!=nil { sz=eff_size(enum_variant_type(v),depth+1); }
            if sz>max { max=sz; } i=i+1;
        }
        if max>65528 { eff_error(nil,e,"portable effect enum layout exceeds 65536 bytes"); return 8; }
        return 8+max;
    }
    if eff_eq(name,len,"i8",2)!=0 || eff_eq(name,len,"u8",2)!=0 || eff_eq(name,len,"bool",4)!=0 { return 1; }
    if eff_eq(name,len,"i16",3)!=0 || eff_eq(name,len,"u16",3)!=0 { return 2; }
    if eff_eq(name,len,"i32",3)!=0 || eff_eq(name,len,"u32",3)!=0 || eff_eq(name,len,"f32",3)!=0 { return 4; }
    return 8;
}
func eff_address(b *EffBinding) *u8 { return eff_bin(TOKEN_PLUS,eff_env(b.depth),eff_num(b.offset)); }
func eff_aggregate_value(b *EffBinding) *u8 {
    var t *u8=b.typ; if type_kind(t)==TYPE_ARRAY { t=array_type_elem(t); }
    return eff_cast(eff_ptr(t),eff_address(b));
}
func eff_store(f *EffFunction,b *EffBinding,value *u8) void {
    if eff_aggregate(b.typ)!=0 {
        eff_append(f,eff_expr_stmt(eff_call("memcpy",eff_args3(eff_address(b),value,eff_num(eff_size(b.typ,0))))));
    } else { eff_append(f,eff_assign(eff_cell(b),value)); }
}
func eff_void(t *u8) i64 { return t==nil || (type_kind(t)==TYPE_BASE && eff_eq(base_type_name(t),base_type_name_len(t),"void",4)!=0); }
func eff_expr_type(f *EffFunction,n *u8) *u8 {
    if n==nil { return effects_i64; }
    var k i64=node_kind(n);
