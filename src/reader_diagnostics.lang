// The compiler grants a reader-local source key exactly one immutable input.
// This adapter is shared by read, embedded compilers, and reader expansion.
var reader_host_key *u8 = nil;
var reader_host_text *u8 = nil;
var reader_host_source i64 = 0;
var reader_host_base i64 = 0;
var reader_host_origin i64 = 0;
var reader_host_errors i64 = 0;
var reader_host_category i64 = 0;

func reader_host_begin(key *u8, text *u8, path *u8, node *u8) void {
    reader_host_key = key; reader_host_text = text;
    reader_host_errors = 0; reader_host_base = 0;
    reader_host_origin = node_origin_id(node);
    if path == nil { path = "<reader-input>"; }
    var origin *PhaseOrigin = phase_origin_get(reader_host_origin);
    if origin != nil {
        var source *PhaseSource = phase_source_get(origin.source);
        var len i64 = strlen(text);
        if origin.end - origin.start == len &&
           memcmp(source.text + origin.start, text, len) != 0 {
            reader_host_source = origin.source; reader_host_base = origin.start;
        } else { reader_host_source = phase_source_register(path, text); }
    } else { reader_host_source = phase_source_register(path, text); }
    reader_diagnostic_collect = 1; reader_diagnostic_invalid = 0;
    reader_diagnostic_reports = vec_new(4);
}
func reader_host_json_string(b *PhaseBuffer, text *u8) void {
    phase_buffer_text(b, "\"");
    var len i64 = strlen(text); var i i64 = 0;
    var hex *u8 = "0123456789abcdef";
    var escape *u8 = alloc(6); memcpy(escape, "\\u00", 4);
    // Keep byte-loop locals outside the loop for unoptimized native hosts.
    var c i64 = 0; var width i64 = 0;
    // Short-circuit operators also allocate temporary slots at the expression
    // site in unoptimized LLVM. Reuse flags rather than putting them in loops.
    var quoted i64 = 0; var escaped i64 = 0;
    while i < len {
        c = *(text + i);
        width = ___compiler_diagnostic_utf8_width(text + i, len - i);
        quoted = c == 34;
        if c == 92 { quoted = 1; }
        escaped = c < 32;
        if width == 0 { escaped = 1; }
        if quoted {
            phase_buffer_text(b, "\\"); phase_buffer_append(b, text + i, 1); i = i + 1;
        } else if escaped {
            *(escape + 4) = *(hex + c / 16); *(escape + 5) = *(hex + c % 16);
            phase_buffer_append(b, escape, 6); i = i + 1;
        } else { phase_buffer_append(b, text + i, width); i = i + width; }
    }
    phase_buffer_text(b, "\"");
}
func reader_host_json_origin(b *PhaseBuffer, id i64, depth i64) void {
    var o *PhaseOrigin = phase_origin_get(id);
    if o == nil || depth > 64 { return; }
    var s *PhaseSource = phase_source_get(o.source);
    phase_buffer_text(b, "{\"source_id\":"); phase_buffer_int(b, s.id);
    phase_buffer_text(b, ",\"path\":"); reader_host_json_string(b, s.name);
    phase_buffer_text(b, ",\"span\":{\"start\":"); phase_buffer_int(b, o.start);
    phase_buffer_text(b, ",\"end\":"); phase_buffer_int(b, o.end);
    phase_buffer_text(b, "}}");
    if o.expansion_parent != 0 && depth < 64 {
        phase_buffer_text(b, ","); reader_host_json_origin(b, o.expansion_parent, depth + 1);
    }
    if o.include_parent != 0 && depth < 64 {
        phase_buffer_text(b, ","); reader_host_json_origin(b, o.include_parent, depth + 1);
    }
}
func reader_host_details() void {
    if ___compiler_diagnostic_json == 0 { return; }
    var b *PhaseBuffer = phase_buffer_new(1048576, "<reader-diagnostic>");
    phase_buffer_text(b, ",\"source_id\":"); phase_buffer_int(b, reader_host_source);
    phase_buffer_text(b, ",\"category\":");
    if reader_host_category == 0 { phase_buffer_text(b, "\"guest\""); }
    else { phase_buffer_text(b, "\"reader\""); }
    phase_buffer_text(b, ",\"origin_chain\":[");
    reader_host_json_origin(b, reader_host_origin, 0); phase_buffer_text(b, "]");
    ___compiler_diagnostic_extra = b.data;
}
// Drain copied records before the caller is allowed to parse an AST value.
func reader_host_finish() void {
    reader_diagnostic_collect = 0;
    if reader_diagnostic_invalid != 0 { reader_host_protocol(); }
    var i i64 = 0;
    while i < vec_len(reader_diagnostic_reports) {
        var report *ReaderReport = vec_get(reader_diagnostic_reports, i);
        reader_host_accept(report.diagnostic, report.text); i = i + 1;
    }
}
func reader_host_protocol() void {
    reader_host_errors = reader_host_errors + 1; reader_host_category = 1;
    var s *PhaseSource = phase_source_get(reader_host_source);
    ___compiler_diagnostic_context("reader-diagnostic-invalid", s.name, -1, -1);
    reader_host_details();
    if ___compiler_diagnostic_json != 0 { eprintln("invalid reader diagnostic"); }
    else { eprint(s.name); eprintln(": invalid reader diagnostic"); ___compiler_diagnostic_extra = nil; }
}
func reader_host_accept(d *ReaderDiagnostic, text *u8) void {
    if reader_diagnostic_valid(d, reader_host_text) == 0 {
        reader_host_protocol(); return;
    }
    if streq(d.source, reader_host_key) == 0 || streq(text, reader_host_text) == 0 {
        reader_host_protocol(); return;
    }
    reader_host_errors = reader_host_errors + 1; reader_host_category = d.category;
    var source *PhaseSource = phase_source_get(reader_host_source);
    // A reader implementation failure is identified separately, never pinned
    // to an invented guest token. The invocation remains in the origin chain.
    var start i64 = -1; var end i64 = -1;
    if d.category == 0 && d.start >= 0 {
        start = d.start + reader_host_base; end = d.end + reader_host_base;
    }
    ___compiler_diagnostic_context(d.code, source.name, start, end);
    reader_host_details();
    var display *ReaderDiagnostic = alloc(48);
    display.code = d.code; display.message = d.message; display.source = source.name;
    display.start = start; display.end = end; display.category = d.category;
    if ___compiler_diagnostic_json != 0 { eprintln(d.message); }
    else { reader_diagnostic_text(display, source.text); ___compiler_diagnostic_extra = nil; }
}
func reader_host_decode(bytes *PhaseBuffer) void {
    var pos i64 = 0;
    while pos < bytes.len {
        // Stderr also carries documented debug output and legacy diagnostics.
        // Only the reserved RDI1 marker starts a record; forward every other
        // byte directly, without interpreting it as AST or JSON diagnostic data.
        var plain i64 = pos;
        while pos < bytes.len {
            if bytes.len - pos >= 4 {
                if memcmp(bytes.data + pos, "RDI1", 4) != 0 { break; }
            }
            pos = pos + 1;
        }
        if pos > plain { file_write(2, bytes.data + plain, pos - plain); }
        if pos == bytes.len { return; }
        if bytes.len - pos < 28 { reader_host_protocol(); return; }
        var p *u8 = bytes.data + pos;
        var code i64 = reader_diagnostic_u32(p + 16);
        var key i64 = reader_diagnostic_u32(p + 20);
        var message i64 = reader_diagnostic_u32(p + 24);
        if code > 256 || key > 4096 || message > 1048576 ||
           code + key + message > bytes.len - pos - 28 { reader_host_protocol(); return; }
        var d *ReaderDiagnostic = alloc(48);
        d.category = reader_diagnostic_u32(p + 4);
        d.start = reader_diagnostic_u32(p + 8) - 1;
        d.end = reader_diagnostic_u32(p + 12) - 1;
        d.code = str_dup_n(p + 28, code);
        d.source = str_dup_n(p + 28 + code, key);
        d.message = str_dup_n(p + 28 + code + key, message);
        if strlen(d.code) != code || strlen(d.source) != key || strlen(d.message) != message {
            reader_host_protocol(); return;
        }
        reader_host_accept(d, reader_host_text);
        pos = pos + 28 + code + key + message;
    }
}
func reader_host_embedded(fnptr *u8, content *u8, key *u8, path *u8, node *u8) *u8 {
    reader_host_begin(key, content, path, node);
    // Capture both channels before accepting any AST, including direct writes.
    var out_pipe *u8 = alloc(8); var err_pipe *u8 = alloc(8);
    if os_pipe(out_pipe) < 0 { reader_host_protocol(); cg_had_error = 1; return nil; }
    var out_read *i32 = out_pipe; var out_write *i32 = out_pipe + 4;
    if os_pipe(err_pipe) < 0 {
        os_close(*out_read); os_close(*out_write);
        reader_host_protocol(); cg_had_error = 1; return nil;
    }
    var err_read *i32 = err_pipe; var err_write *i32 = err_pipe + 4;
    // Only the adapter signals normal return; stdout and exit status cannot.
    var done_pipe *u8 = alloc(8);
    if os_pipe(done_pipe) < 0 {
        os_close(*out_read); os_close(*out_write);
        os_close(*err_read); os_close(*err_write);
        reader_host_protocol(); cg_had_error = 1; return nil;
    }
    var done_read *i32 = done_pipe; var done_write *i32 = done_pipe + 4;
    var pid i64 = os_fork();
    if pid == 0 {
        if os_dup2(*out_write, 1) < 0 || os_dup2(*err_write, 2) < 0 { os__exit(1); }
        os_close(*out_read); os_close(*out_write);
        os_close(*err_read); os_close(*err_write);
        os_close(*done_read);
        // Emit API reports immediately so even os__exit preserves diagnostics.
        // The parent validates keys/ranges and every direct stderr byte.
        reader_diagnostic_collect = 0; reader_diagnostic_wire = 1;
        reader_diagnostic_snapshot = str_dup(content);
        var reader_fn fn(*u8) *u8 = fnptr;
        var output *u8 = reader_fn(content);
        file_write(*done_write, "1", 1); os_close(*done_write);
        if output == nil { os__exit(1); }
        print(output); os__exit(0);
    }
    os_close(*out_write); os_close(*err_write); os_close(*done_write);
    reader_diagnostic_collect = 0;
    if pid < 0 {
        os_close(*out_read); os_close(*err_read); os_close(*done_read);
        reader_host_protocol(); cg_had_error = 1; return nil;
    }
    // Drain concurrently so neither channel can deadlock the child.
    var captured *PhaseBuffer = phase_capture_channels(*out_read, *err_read);
    os_close(*out_read);
    var status *i64 = alloc(8);
    var waited i64 = os_waitpid(pid, status, 0);
    var done *u8 = alloc(1);
    var completed i64 = os_read(*done_read, done, 1); os_close(*done_read);
    reader_host_decode(phase_worker_stderr);
    if reader_host_errors != 0 { cg_had_error = 1; return nil; }
    if completed != 1 || *done != 49 {
        // A legacy reader may terminate after explaining its failure on stderr.
        // A successful exit still cannot impersonate a normal reader return.
        if waited == pid && phase_process_status(*status) != 0 {
            cg_had_error = 1; return nil;
        }
        reader_host_protocol(); cg_had_error = 1; return nil;
    }
    if waited != pid || phase_process_status(*status) != 0 { cg_had_error = 1; return nil; }
    return captured.data;
}

func reader_host_worker(program *u8, content *u8, len i64, key *u8, path *u8, node *u8) *u8 {
    var text *u8 = str_dup_n(content, len);
    reader_host_begin(key, text, path, node);
    phase_worker_capture_stderr = 1; phase_worker_stderr = nil;
    var output *u8 = phase_worker_call(program, text, len);
    phase_worker_capture_stderr = 0; reader_diagnostic_collect = 0;
    if phase_worker_stderr != nil { reader_host_decode(phase_worker_stderr); }
    if reader_host_errors != 0 { cg_had_error = 1; phase_worker_status = -1; return nil; }
    return output;
}
