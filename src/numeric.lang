// Reader-independent exact numeric profile, transported by an intrinsic call.
// Metadata are literal strings: operation, result type, operand type.
func numeric_is_call(expr *u8) i64 {
    if expr == nil || node_kind(expr) != NODE_CALL_EXPR { return 0; }
    var callee *u8 = call_expr_func(expr);
    return callee != nil && node_kind(callee) == NODE_IDENT_EXPR &&
        ident_expr_name_len(callee) == 14 && memcmp(ident_expr_name(callee), "__core_numeric", 14);
}
func numeric_fail(expr *u8, message *u8) void {
    if node_origin_source(expr) == nil && node_origin_source(cg_diagnostic_node) == nil {
        eprint(phase_diagnostic_source); eprint(": error: ");
    } else { cg_error_prefix_at(expr); }
    eprint("numeric: "); eprintln(message); exit(1);
}
func numeric_arg(expr *u8, index i64) *u8 {
    var p **u8 = call_expr_args(expr) + index * 8; return *p;
}
func numeric_meta(expr *u8, index i64) *u8 {
    if call_expr_arg_count(expr) < 3 { numeric_fail(expr, "expected operation, result type and operand type"); }
    var arg *u8 = numeric_arg(expr, index);
    if arg == nil || node_kind(arg) != NODE_STRING_EXPR { numeric_fail(expr, "metadata must be literal strings"); }
    var text *u8 = string_expr_value(arg); var len i64 = string_expr_value_len(arg);
    if strlen(text) != len { numeric_fail(expr, "invalid metadata string"); }
    return str_dup_n(text, len);
}
func numeric_bits(name *u8) i64 {
    if streq(name, "i8") || streq(name, "u8") { return 8; }
    if streq(name, "i16") || streq(name, "u16") { return 16; }
    if streq(name, "i32") || streq(name, "u32") || streq(name, "f32") { return 32; }
    if streq(name, "i64") || streq(name, "u64") || streq(name, "f64") { return 64; }
    return 0;
}
func numeric_float(name *u8) i64 { return streq(name, "f32") || streq(name, "f64"); }
func numeric_compare(op *u8) i64 {
    return streq(op, "eq") || streq(op, "ne") || streq(op, "lt") || streq(op, "le") || streq(op, "gt") || streq(op, "ge");
}
func numeric_type(name *u8) *u8 {
    var t *u8 = base_type_alloc(); base_type_set_name(t, name); base_type_set_name_len(t, strlen(name)); return t;
}
func numeric_validate(expr *u8) void {
    var op *u8 = numeric_meta(expr, 0); var dst *u8 = numeric_meta(expr, 1); var src *u8 = numeric_meta(expr, 2);
    var arity i64 = 2; var valid i64 = 0;
    if streq(op, "trap") || streq(op, "unreachable") {
        if !streq(dst, "void") || !streq(src, "void") { numeric_fail(expr, "trap requires void types"); }
        arity = 0; valid = 1;
    } else {
        if numeric_bits(dst) == 0 || numeric_bits(src) == 0 { numeric_fail(expr, "unsupported numeric type (expected i/u8/16/32/64 or f32/f64)"); }
        if streq(op, "convert") || streq(op, "convert_checked") || streq(op, "bitcast") {
            arity = 1; valid = 1;
            if streq(op, "bitcast") && numeric_bits(src) != numeric_bits(dst) { numeric_fail(expr, "bitcast requires equal widths"); }
        } else if numeric_compare(op) {
            valid = 1;
            if !streq(dst, "i64") { numeric_fail(expr, "comparison result must be i64 (zero or one)"); }
        } else {
            if !streq(dst, src) { numeric_fail(expr, "arithmetic result and operand types must match"); }
            if numeric_float(src) {
                valid = streq(op, "add") || streq(op, "sub") || streq(op, "mul") || streq(op, "div") || streq(op, "rem");
            } else {
                valid = streq(op, "add_wrap") || streq(op, "sub_wrap") || streq(op, "mul_wrap") ||
                    streq(op, "add_checked") || streq(op, "sub_checked") || streq(op, "mul_checked") ||
                    streq(op, "div") || streq(op, "rem") || streq(op, "shl") || streq(op, "shr") ||
                    streq(op, "and") || streq(op, "or") || streq(op, "xor");
            }
        }
    }
    if valid == 0 { numeric_fail(expr, "unknown or incompatible operation"); }
    if call_expr_arg_count(expr) != arity + 3 { numeric_fail(expr, "incorrect operand count"); }
}

// Validate explicitly declared legacy representations too. Named aggregates and
// function values retain the bootstrap ABI; unknown names never become i64.
func numeric_validate_legacy_type(t *u8, node *u8) void {
    if t == nil { return; } // legacy inferred declarations
    var kind i64 = type_kind(t);
    if kind == TYPE_PTR { numeric_validate_legacy_type(ptr_type_elem(t), node); return; }
    if kind == TYPE_ARRAY { numeric_validate_legacy_type(array_type_elem(t), node); return; }
    if kind == TYPE_FUNC || kind == TYPE_CLOSURE {
        var params *u8 = func_type_params(t); var count i64 = func_type_param_count(t);
        if kind == TYPE_CLOSURE { params = closure_type_params(t); count = closure_type_param_count(t); }
        var i i64 = 0;
        while i < count { numeric_validate_legacy_type(vec_get(params, i), node); i = i + 1; }
        if kind == TYPE_FUNC { numeric_validate_legacy_type(func_type_ret(t), node); }
        else { numeric_validate_legacy_type(closure_type_ret(t), node); }
        return;
    }
    if kind == TYPE_BASE {
        var name *u8 = str_dup_n(base_type_name(t), base_type_name_len(t));
        if numeric_bits(name) != 0 || streq(name, "bool") || streq(name, "void") { return; }
        if find_struct(name, strlen(name)) != nil || find_enum(name, strlen(name)) != nil { return; }
    }
    numeric_fail(node, "unknown or unsupported declared type");
}

func numeric_validate_signature(decl *u8) void {
    if func_decl_name_len(decl) == 14 && memcmp(func_decl_name(decl), "__core_numeric", 14) { numeric_fail(decl, "reserved intrinsic name"); }
    numeric_validate_legacy_type(func_decl_ret_type(decl), decl);
    var params *u8 = func_decl_params(decl); var i i64 = 0;
    while i < func_decl_param_count(decl) {
        numeric_validate_legacy_type(param_type(params + i * 24), decl); i = i + 1;
    }
}

// Validate numeric metadata and declared representations independently of CFG
// emission. In particular, a return must not hide an invalid operation/type.
// Quoted code and unexpanded reader text are data until expansion.
func numeric_validate_tree(node *u8) void {
    if node == nil { return; }
    var k i64 = node_kind(node);
    var children *u8 = nil; var count i64 = 0;
    if k == NODE_BLOCK_STMT { children = block_stmt_stmts(node); count = block_stmt_count(node); }
    else if k == NODE_BLOCK_EXPR {
        children = block_expr_stmts(node); count = block_expr_count(node);
        numeric_validate_tree(block_expr_tail(node));
    } else if k == NODE_CALL_EXPR {
        if numeric_is_call(node) { numeric_validate(node); }
        numeric_validate_tree(call_expr_func(node));
        children = call_expr_args(node); count = call_expr_arg_count(node);
    } else if k == NODE_ARRAY_LITERAL { children = array_literal_elems(node); count = array_literal_count(node); }
    else if k == NODE_PERFORM_EXPR { children = perform_expr_args(node); count = perform_expr_arg_count(node); }
    else if k == NODE_VAR_DECL {
        numeric_validate_legacy_type(var_decl_type(node), node); numeric_validate_tree(var_decl_init(node));
    } else if k == NODE_RETURN_STMT { numeric_validate_tree(return_stmt_value(node)); }
    else if k == NODE_EXPR_STMT { numeric_validate_tree(expr_stmt_expr(node)); }
    else if k == NODE_BINARY_EXPR {
        numeric_validate_tree(binary_expr_left(node)); numeric_validate_tree(binary_expr_right(node));
    } else if k == NODE_ASSIGN_STMT {
        numeric_validate_tree(assign_stmt_target(node)); numeric_validate_tree(assign_stmt_value(node));
    } else if k == NODE_UNARY_EXPR { numeric_validate_tree(unary_expr_expr(node)); }
    else if k == NODE_GROUP_EXPR { numeric_validate_tree(group_expr_expr(node)); }
    else if k == NODE_INDEX_EXPR {
        numeric_validate_tree(index_expr_base(node)); numeric_validate_tree(index_expr_index(node));
    } else if k == NODE_FIELD_EXPR { numeric_validate_tree(field_expr_expr(node)); }
    else if k == NODE_CAST_EXPR {
        numeric_validate_legacy_type(cast_expr_type(node), node); numeric_validate_tree(cast_expr_expr(node));
    } else if k == NODE_BITCAST_EXPR {
        numeric_validate_legacy_type(bitcast_expr_type(node), node); numeric_validate_tree(bitcast_expr_expr(node));
    } else if k == NODE_IF_STMT {
        numeric_validate_tree(if_stmt_cond(node)); numeric_validate_tree(if_stmt_then(node)); numeric_validate_tree(if_stmt_else(node));
    } else if k == NODE_WHILE_STMT {
        numeric_validate_tree(while_stmt_cond(node)); numeric_validate_tree(while_stmt_body(node));
    } else if k == NODE_LET_EXPR {
        numeric_validate_legacy_type(let_expr_type(node), node);
        numeric_validate_tree(let_expr_init(node)); numeric_validate_tree(let_expr_body(node));
    } else if k == NODE_LAMBDA_EXPR {
        numeric_validate_legacy_type(lambda_expr_ret_type(node), node);
        var params *u8 = lambda_expr_params(node); var pi i64 = 0;
        while pi < lambda_expr_param_count(node) {
            numeric_validate_legacy_type(param_type(params + pi * 24), node); pi = pi + 1;
        }
        numeric_validate_tree(lambda_expr_body(node));
    } else if k == NODE_MATCH_EXPR {
        numeric_validate_tree(match_expr_scrutinee(node)); var mi i64 = 0;
        while mi < match_expr_arm_count(node) {
            numeric_validate_tree(match_arm_body(get_match_arm(match_expr_arms(node), mi))); mi = mi + 1;
        }
    } else if k == NODE_HANDLE_EXPR {
        numeric_validate_tree(handle_expr_body(node)); numeric_validate_tree(handle_expr_ret_body(node));
        var hi i64 = 0;
        while hi < handle_expr_case_count(node) {
            numeric_validate_tree(effect_case_body(vec_get(handle_expr_cases(node), hi))); hi = hi + 1;
        }
    } else if k == NODE_RESUME_EXPR {
        numeric_validate_tree(resume_expr_k(node)); numeric_validate_tree(resume_expr_value(node));
    }
    var i i64 = 0;
    while i < count { var p **u8 = children + i * 8; numeric_validate_tree(*p); i = i + 1; }
}
