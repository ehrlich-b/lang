// src/standalone.lang - Template for standalone compilers
//
// Usage: Generate source that:
//   1. Includes reader source (so the reader gets compiled to /tmp)
//   2. Defines reader_transform() glue function
//   3. Includes this file
//
// This template provides the compiler infrastructure and main().

include "src/lexer.lang"
include "src/parser.lang"
include "src/codegen.lang"
include "src/codegen_llvm.lang"
include "src/sexpr_reader.lang"

// codegen's require handling consults this composition-mode flag. The full
// compiler owns it in main.lang; a generated standalone compiler never runs
// `-r`, so its value is always false.
var add_reader_mode i64 = 0;

// Standalone compilers resolve modules from source; unlike self-aware kernels,
// they do not carry a table of embedded module ASTs.
func find_kernel_builtin(name *u8, name_len i64) *u8 {
    return nil;
}

func standalone_read_file(path *u8) *u8 {
    var fd i64 = file_open(path, 0);
    if fd < 0 {
        eprint("Error: cannot open file: ");
        eprintln(path);
        return nil;
    }
    var buf *u8 = alloc(1048576);
    var n i64 = file_read(fd, buf, 1048576);
    file_close(fd);
    if n < 0 {
        eprintln("Error: cannot read file");
        return nil;
    }
    *(buf + n) = 0;
    return buf;
}

func standalone_get_arg(argv **u8, i i64) *u8 {
    var base *u8 = argv;
    var p **u8 = base + (i * 8);  // Manual byte offset on *u8
    return *p;
}

func standalone_combine_programs(programs *u8) *u8 {
    var total i64 = 0;
    var i i64 = 0;
    while i < vec_len(programs) {
        var prog *u8 = vec_get(programs, i);
        total = total + program_decl_count(prog);
        i = i + 1;
    }

    var decls *u8 = alloc(total * 8);
    var out_i i64 = 0;
    i = 0;
    while i < vec_len(programs) {
        var prog *u8 = vec_get(programs, i);
        var source_decls *u8 = program_decls(prog);
        var j i64 = 0;
        while j < program_decl_count(prog) {
            var slot **u8 = decls + out_i * 8;
            *slot = get_decl(source_decls, j);
            out_i = out_i + 1;
            j = j + 1;
        }
        i = i + 1;
    }

    var combined *u8 = alloc(16);
    var decls_slot **u8 = combined;
    *decls_slot = decls;
    var count_slot *i64 = combined + 8;
    *count_slot = total;
    return combined;
}

// reader_transform is defined by the generated glue code
// It calls the reader function directly (e.g., lisp(content))

func standalone_help() void {
    print(reader_compiler_name);
    println(" - compiler generated by lang");
    println("");
    print("Usage: ");
    print(reader_compiler_name);
    println(" <file>... [-o output]");
    println("");
    println("Options:");
    println("  -o <file>  Write LLVM IR or assembly to this path");
    println("  -h, --help Show this help");
}

func main(argc i64, argv **u8) i64 {
    if argc < 2 {
        standalone_help();
        return 0;
    }

    var output_file *u8 = nil;
    var input_files *u8 = vec_new(16);

    // First pass: parse arguments
    var i i64 = 1;
    while i < argc {
        var arg *u8 = standalone_get_arg(argv, i);

        if streq(arg, "--help") || streq(arg, "-h") {
            standalone_help();
            return 0;
        } else if *arg == '-' && *(arg + 1) == 'o' && *(arg + 2) == 0 {
            i = i + 1;
            if i >= argc {
                eprintln("Error: -o needs an output path");
                return 1;
            }
            output_file = standalone_get_arg(argv, i);
        } else if *arg == '-' {
            eprint("Error: unknown option: ");
            eprintln(arg);
            return 1;
        } else {
            vec_push(input_files, arg);
        }
        i = i + 1;
    }

    if vec_len(input_files) == 0 {
        eprintln("Error: no input files");
        return 1;
    }

    var programs *u8 = vec_new(vec_len(input_files) + 2);

    // Runtime declarations are Lang AST embedded when this compiler is minted;
    // they bypass the custom source reader.
    if reader_runtime_ast != nil && *reader_runtime_ast != 0 {
        var runtime_prog *u8 = parse_ast_from_string(reader_runtime_ast);
        if runtime_prog == nil {
            eprintln("Error: failed to parse embedded runtime AST");
            return 1;
        }
        vec_push(programs, runtime_prog);
    }

    // Normal mode: compile input files
    i = 0;
    while i < vec_len(input_files) {
        var arg *u8 = vec_get(input_files, i);
        // Input file - read and transform through reader
        var content *u8 = standalone_read_file(arg);
        if content == nil {
            return 1;
        }

        // Transform through reader → S-expression AST
        var ast *u8 = reader_transform(content);
        if ast == nil {
            return 1;
        }

        var reader_prog *u8 = parse_ast_from_reader_string(ast, arg, content);
        if reader_prog == nil {
            eprint("Error: failed to parse reader output for ");
            eprintln(arg);
            return 1;
        }
        vec_push(programs, reader_prog);
        i = i + 1;
    }

    // Add ___main wrapper as AST (must match main.lang's version for fixed point)
    // Skip for LLVM backend - clang provides entry point
    var is_llvm i64 = cg_backend_is_llvm();
    if is_llvm == 0 {
        var wrapper_ast *u8 = "(program (func ___main ((param argc (type_base i64)) (param argv (type_ptr (type_ptr (type_base u8)))) (param envp (type_ptr (type_ptr (type_base u8))))) (type_base i64) (block (return (call (ident main) (ident argc) (ident argv))))))";
        var wrapper_prog *u8 = parse_ast_from_string(wrapper_ast);
        if wrapper_prog == nil { return 1; }
        vec_push(programs, wrapper_prog);
    }

    var prog *u8 = standalone_combine_programs(programs);

    if output_file == nil {
        if cg_backend_is_llvm() != 0 { output_file = "a.ll"; }
        else { output_file = "a.s"; }
    }

    // Check backend
    if cg_backend_is_llvm() != 0 {
        generate_llvm(prog, output_file);
    } else {
        generate(prog, output_file);
    }

    print("Wrote ");
    println(output_file);

    return 0;
}
