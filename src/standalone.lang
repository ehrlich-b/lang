// src/standalone.lang - Template for standalone compilers
//
// Usage: Generate source that:
//   1. Includes reader source (so the reader gets compiled to /tmp)
//   2. Defines reader_transform() glue function
//   3. Includes this file
//
// This template provides the compiler infrastructure and main().

include "src/lexer.lang"
include "src/parser.lang"
include "src/codegen.lang"
include "src/codegen_llvm.lang"
include "src/sexpr_reader.lang"
include "src/native_host.lang"

// codegen's require handling consults this composition-mode flag. The full
// compiler owns it in main.lang; a generated standalone compiler never runs
// `-r`, so its value is always false.
var add_reader_mode i64 = 0;

// Standalone compilers resolve modules from source; unlike self-aware kernels,
// they do not carry a table of embedded module ASTs.
func find_kernel_builtin(name *u8, name_len i64) *u8 {
    return nil;
}

func standalone_read_file(path *u8) *u8 {
    var text *u8 = phase_read_file(path);
    if text == nil { eprint("Error: cannot open file: "); eprintln(path); }
    return text;
}

func standalone_get_arg(argv **u8, i i64) *u8 {
    var base *u8 = argv;
    var p **u8 = base + (i * 8);  // Manual byte offset on *u8
    return *p;
}

func standalone_combine_programs(programs *u8) *u8 {
    var total i64 = 0;
    var i i64 = 0;
    while i < vec_len(programs) {
        var prog *u8 = vec_get(programs, i);
        total = total + program_decl_count(prog);
        i = i + 1;
    }

    var decls *u8 = alloc(total * 8);
    var out_i i64 = 0;
    i = 0;
    while i < vec_len(programs) {
        var prog *u8 = vec_get(programs, i);
        var source_decls *u8 = program_decls(prog);
        var j i64 = 0;
        while j < program_decl_count(prog) {
            var slot **u8 = decls + out_i * 8;
            *slot = get_decl(source_decls, j);
            out_i = out_i + 1;
            j = j + 1;
        }
        i = i + 1;
    }

    var combined *u8 = alloc(16);
    var decls_slot **u8 = combined;
    *decls_slot = decls;
    var count_slot *i64 = combined + 8;
    *count_slot = total;
    return combined;
}

// reader_transform is defined by the generated glue code
// It calls the reader function directly (e.g., lisp(content))

// Minted and embedded readers share the complete native diagnostic boundary.
func standalone_transform(content *u8, path *u8) *u8 {
    return reader_host_embedded(&reader_transform, content, reader_compiler_name, path, nil);
}

func standalone_help() void {
    print(reader_compiler_name);
    println(" - compiler generated by lang");
    println("");
    print("Usage: ");
    print(reader_compiler_name);
    println(" <file>... [--emit=llvm|native] [-o output]");
    println("");
    println("Options:");
    println("  --emit=llvm    Write LLVM IR without a native toolchain");
    println("  --emit=native  Build Linux x86-64 at -O0 using LANG_CLANG or clang in PATH");
    println("  -o <file>      Output path (default: a.ll/a.s, or a.out for native)");
    println("  -h, --help Show this help");
}

func standalone_emit(input_files *u8, output_file *u8, use_llvm i64) i64 {
    var i i64 = 0;
    var programs *u8 = vec_new(vec_len(input_files) + 2);

    // Runtime declarations are Lang AST embedded when this compiler is minted;
    // they bypass the custom source reader.
    if reader_runtime_ast != nil && *reader_runtime_ast != 0 {
        var runtime_prog *u8 = parse_ast_from_string(reader_runtime_ast);
        if runtime_prog == nil {
            eprintln("Error: failed to parse embedded runtime AST");
            return 1;
        }
        vec_push(programs, runtime_prog);
    }

    // Normal mode: compile input files
    i = 0;
    while i < vec_len(input_files) {
        var arg *u8 = vec_get(input_files, i);
        // Input file - read and transform through reader
        var content *u8 = standalone_read_file(arg);
        if content == nil {
            return 1;
        }

        // Transform through reader → S-expression AST
        var ast *u8 = standalone_transform(content, arg);
        if reader_host_errors != 0 { return 1; }
        if ast == nil {
            eprint(arg); eprintln(": error: reader phase failed");
            return 1;
        }

        var reader_prog *u8 = parse_ast_from_reader_string(ast, arg, content);
        if reader_prog == nil {
            eprint("Error: failed to parse reader output for ");
            eprintln(arg);
            return 1;
        }
        vec_push(programs, reader_prog);
        i = i + 1;
    }

    // Add ___main wrapper as AST (must match main.lang's version for fixed point)
    // Skip for LLVM backend - clang provides entry point
    var is_llvm i64 = use_llvm;
    if is_llvm == 0 {
        var wrapper_ast *u8 = "(program (func ___main ((param argc (type_base i64)) (param argv (type_ptr (type_ptr (type_base u8)))) (param envp (type_ptr (type_ptr (type_base u8))))) (type_base i64) (block (return (call (ident main) (ident argc) (ident argv))))))";
        var wrapper_prog *u8 = parse_ast_from_string(wrapper_ast);
        if wrapper_prog == nil { return 1; }
        vec_push(programs, wrapper_prog);
    }

    var prog *u8 = standalone_combine_programs(programs);

    if use_llvm != 0 { generate_llvm(prog, output_file); }
    else { generate(prog, output_file); }
    return 0;
}

func main(argc i64, argv **u8) i64 {
    if argc < 2 { standalone_help(); return 0; }
    var output_file *u8 = nil;
    var input_files *u8 = vec_new(16);
    // An omitted mode retains the original backend-dependent IR/assembly output.
    var emit *u8 = nil;
    var invalid i64 = 0;
    var native i64 = 0;
    var i i64 = 1;
    while i < argc {
        var arg *u8 = standalone_get_arg(argv, i);
        if streq(arg, "--diagnostics=json") { ___compiler_diagnostic_enable(); }
        else if streq(arg, "--help") || streq(arg, "-h") { standalone_help(); return 0; }
        else if streq(arg, "-o") {
            if output_file != nil { eprintln("Error: duplicate -o"); invalid = 1; }
            if i + 1 >= argc || *standalone_get_arg(argv, i + 1) == '-' {
                eprintln("Error: -o needs an output path"); invalid = 1;
            } else {
                i = i + 1;
                if output_file == nil { output_file = standalone_get_arg(argv, i); }
            }
        } else if str_starts_with(arg, "--emit=") {
            if streq(arg + 7, "native") { native = 1; }
            if emit != nil { eprintln("Error: duplicate --emit"); invalid = 1; }
            else { emit = arg + 7; }
            if native_build_emit_valid(arg + 7, 0) == 0 {
                eprintln("Error: --emit must be native or llvm"); invalid = 1;
            }
        } else if *arg == '-' {
            eprint("Error: unknown option: "); eprintln(arg); invalid = 1;
        } else { vec_push(input_files, arg); }
        i = i + 1;
    }
    if vec_len(input_files) == 0 { eprintln("Error: no input files"); invalid = 1; }
    var use_llvm i64 = cg_backend_is_llvm();
    if emit != nil && streq(emit, "llvm") { use_llvm = 1; }
    if output_file == nil {
        if native != 0 { output_file = "a.out"; }
        else if use_llvm != 0 { output_file = "a.ll"; }
        else { output_file = "a.s"; }
    }
    if *output_file == 0 { eprintln("Error: empty output path"); return 1; }
    if native == 0 {
        if invalid != 0 { return 1; }
        var result i64 = standalone_emit(input_files, output_file, use_llvm);
        if result == 0 { print("Wrote "); println(output_file); }
        return result;
    }
    // Share output protection, tool selection, -O0, object/link phases and
    // atomic publication with `lang build`. Parent cleanup also covers fatal
    // reader/validator/codegen exits in the child.
    if native_build_prepare_output(output_file, input_files) != 0 { return 1; }
    if invalid != 0 { return 1; }
    var source *u8 = vec_get(input_files, 0);
    if native_build_profile(source, reader_build_arch) != 0 { return 1; }
    var work *u8 = mkdtemp(str_concat(output_file, ".lang-build-XXXXXX"));
    if work == nil { eprintln("Error: cannot reserve native build directory"); return 1; }
    var pid i64 = os_fork();
    if pid == 0 {
        cg_langos_override = "linux";
        os__exit(standalone_emit(input_files, str_concat(work, "/guest.ll"), 1));
    }
    var result i64 = native_build_wait(pid, "LLVM emission");
    if result != 0 { native_build_source_error(source, "reader/validation/LLVM emission"); }
    if result == 0 { result = native_build_link(work, source, "clang"); }
    result = native_build_publish(work, str_concat(work, "/program"), output_file, result);
    if result == 0 { print("Built "); println(output_file); }
    return result;
}
