// Selective, defunctionalized CPS over registered (reader-expanded) core AST.
// Each step is ordinary core: frame accesses, a PC dispatch and a native return.
// Native functions are neither rewritten nor wrapped. No machine stack is saved.
include "src/effects_runtime.lang"

var cps_functions *u8 = nil;
var cps_machines *u8 = nil;
var cps_generated *u8 = nil;
var cps_enabled i64 = 0;
var cps_i64 *u8 = nil;
var cps_frame_type *u8 = nil;
var cps_token_name *u8 = nil;
var cps_loops *u8 = nil;

func cps_fail(n *u8, message *u8) void {
    cg_error_prefix_at(n); eprint("CPS: "); eprintln(message); exit(1);
}
func cps_num(value i64) *u8 {
    var text *u8 = alloc(32); itoa(value, text);
    var n *u8 = number_expr_alloc(); number_expr_set_value(n, text); number_expr_set_value_len(n, strlen(text)); return n;
}
func cps_id(name *u8) *u8 {
    var n *u8 = ident_expr_alloc(); ident_expr_set_name(n, name); ident_expr_set_name_len(n, strlen(name)); return n;
}
func cps_ptr(t *u8) *u8 { var n *u8 = ptr_type_alloc(); ptr_type_set_elem(n, t); return n; }
func cps_cast(t *u8, value *u8) *u8 {
    var n *u8 = cast_expr_alloc(); cast_expr_set_type(n, t); cast_expr_set_expr(n, value); return n;
}
func cps_unary(op i64, value *u8) *u8 {
    var n *u8 = unary_expr_alloc(); unary_expr_set_op(n, op); unary_expr_set_expr(n, value); return n;
}
func cps_binary(op i64, left *u8, right *u8) *u8 {
    var n *u8 = binary_expr_alloc(); binary_expr_set_op(n, op); binary_expr_set_left(n, left); binary_expr_set_right(n, right); return n;
}
func cps_index(base *u8, index i64) *u8 {
    var n *u8 = index_expr_alloc(); index_expr_set_base(n, base); index_expr_set_index(n, cps_num(index)); return n;
}
func cps_array(v *u8) *u8 {
    var a *u8 = alloc(vec_len(v) * 8 + 8); var i i64 = 0;
    while i < vec_len(v) { var p *i64 = a + i * 8; *p = vec_get(v, i); i = i + 1; } return a;
}
func cps_call(name *u8, args *u8) *u8 {
    var n *u8 = call_expr_alloc(); call_expr_set_func(n, cps_id(name)); call_expr_set_args(n, cps_array(args)); call_expr_set_arg_count(n, vec_len(args)); return n;
}
func cps_args1(a *u8) *u8 { var v *u8 = vec_new(4); vec_push(v, a); return v; }
func cps_args2(a *u8, b *u8) *u8 { var v *u8 = cps_args1(a); vec_push(v, b); return v; }
func cps_assign(target *u8, value *u8) *u8 {
    var n *u8 = assign_stmt_alloc(); assign_stmt_set_target(n, target); assign_stmt_set_value(n, value); return n;
}
func cps_return(value *u8) *u8 { var n *u8 = return_stmt_alloc(); return_stmt_set_value(n, value); return n; }
func cps_block(v *u8) *u8 {
    var n *u8 = block_stmt_alloc(); block_stmt_set_stmts(n, cps_array(v)); block_stmt_set_count(n, vec_len(v)); return n;
}
func cps_if(cond *u8, yes *u8, no *u8) *u8 {
    var n *u8 = if_stmt_alloc(); if_stmt_set_cond(n, cond); if_stmt_set_then(n, yes); if_stmt_set_else(n, no); return n;
}
func cps_var(name *u8, t *u8, value *u8) *u8 {
    var n *u8 = var_decl_alloc(); var_decl_set_name(n, name); var_decl_set_name_len(n, strlen(name)); var_decl_set_type(n, t); var_decl_set_init(n, value); var_decl_set_is_extern(n, 0); var_decl_set_is_pub(n, 0); return n;
}
func cps_frame() *u8 { return cps_id("___frame"); }
func cps_field(i i64) *u8 { return cps_index(cps_frame(), i); }
func cps_as_frame(e *u8) *u8 { return cps_cast(cps_frame_type, e); }
func cps_address(e *u8) *u8 {
    if node_kind(e) == NODE_UNARY_EXPR && unary_expr_op(e) == TOKEN_STAR { return unary_expr_expr(e); }
    return cps_unary(TOKEN_AMP, e);
}
func cps_step_name(m *i64) *u8 {
    var suffix *u8 = alloc(32); itoa(m[0], suffix); return str_concat("___cps_step_", suffix);
}
// Compiler-side machine: id, parent, lexical bindings, states, slots, entry.
func cps_machine(parent *i64) *i64 {
    var m *i64 = alloc(48); m[0] = vec_len(cps_machines); m[1] = parent;
    m[2] = vec_new(16); m[3] = vec_new(16); m[4] = 16; m[5] = 0;
    if parent != nil {
        var i i64 = 0; while i < vec_len(cast(*u8, parent[2])) { vec_push(cast(*u8, m[2]), vec_get(cast(*u8, parent[2]), i)); i = i + 1; }
    }
    vec_push(cps_machines, m); return m;
}
func cps_slot(m *i64, t *u8) *u8 {
    var slot i64 = m[4]; m[4] = slot + 1;
    return cps_unary(TOKEN_STAR, cps_cast(cps_ptr(t), cps_address(cps_index(cps_frame(), slot))));
}
// Binding: name, length, type, slot, defining machine. Cross-frame accesses
// follow lexical environments, retaining the original owner's storage.
func cps_bind(m *i64, name *u8, len i64, t *u8) *u8 {
    if t != nil && llvm_is_float_type(t) { cps_fail(nil, "floating CPS cells are not yet supported"); }
    var b *i64 = alloc(40); b[0] = name; b[1] = len; b[2] = t; b[3] = m[4]; b[4] = m;
    m[4] = m[4] + 1; vec_push(cast(*u8, m[2]), b); return b;
}
func cps_lookup(m *i64, name *u8, len i64) *i64 {
    var v *u8 = cast(*u8, m[2]); var i i64 = vec_len(v);
    while i > 0 { i = i - 1; var b *i64 = vec_get(v, i); if str_eq_n(cast(*u8, b[0]), b[1], name, len) { return b; } } return nil;
}
func cps_binding_ref(m *i64, b *i64) *u8 {
    if b[4] == 0 { return cps_id(str_dup_n(cast(*u8, b[0]), b[1])); }
    var f *u8 = cps_frame(); var current *i64 = m;
    while current != b[4] { f = cps_as_frame(cps_index(f, 5)); current = cast(*i64, current[1]); }
    return cps_unary(TOKEN_STAR, cps_cast(cps_ptr(cast(*u8, b[2])), cps_address(cps_index(f, b[3]))));
}
func cps_state(m *i64, statements *u8) i64 {
    var states *u8 = cast(*u8, m[3]); var id i64 = vec_len(states); vec_push(states, cps_block(statements)); return id;
}
func cps_jump(next i64) *u8 {
    var v *u8 = cps_args1(cps_assign(cps_field(1), cps_num(next))); vec_push(v, cps_return(cps_frame())); return v;
}
func cps_store_state(m *i64, dest *u8, value *u8, next i64) i64 {
    var v *u8 = cps_args1(cps_assign(dest, value)); vec_push(v, cps_assign(cps_field(1), cps_num(next))); vec_push(v, cps_return(cps_frame())); return cps_state(m, v);
}

// Enumerate executable children; quotations and unexpanded text remain data.
func cps_children(n *u8) *u8 {
    var v *u8 = vec_new(4); if n == nil { return v; } var k i64 = node_kind(n); var a *u8 = nil; var count i64 = 0;
    if k == NODE_BLOCK_STMT { a = block_stmt_stmts(n); count = block_stmt_count(n); }
    else if k == NODE_BLOCK_EXPR { a = block_expr_stmts(n); count = block_expr_count(n); vec_push(v, block_expr_tail(n)); }
    else if k == NODE_CALL_EXPR { vec_push(v, call_expr_func(n)); a = call_expr_args(n); count = call_expr_arg_count(n); }
    else if k == NODE_PERFORM_EXPR { a = perform_expr_args(n); count = perform_expr_arg_count(n); }
    else if k == NODE_VAR_DECL { vec_push(v, var_decl_init(n)); }
    else if k == NODE_RETURN_STMT { vec_push(v, return_stmt_value(n)); }
    else if k == NODE_EXPR_STMT { vec_push(v, expr_stmt_expr(n)); }
    else if k == NODE_BINARY_EXPR { vec_push(v, binary_expr_left(n)); vec_push(v, binary_expr_right(n)); }
    else if k == NODE_ASSIGN_STMT { vec_push(v, assign_stmt_target(n)); vec_push(v, assign_stmt_value(n)); }
    else if k == NODE_UNARY_EXPR { vec_push(v, unary_expr_expr(n)); }
    else if k == NODE_GROUP_EXPR { vec_push(v, group_expr_expr(n)); }
    else if k == NODE_INDEX_EXPR { vec_push(v, index_expr_base(n)); vec_push(v, index_expr_index(n)); }
    else if k == NODE_FIELD_EXPR { vec_push(v, field_expr_expr(n)); }
    else if k == NODE_CAST_EXPR { vec_push(v, cast_expr_expr(n)); }
    else if k == NODE_BITCAST_EXPR { vec_push(v, bitcast_expr_expr(n)); }
    else if k == NODE_INT_COMPARE || k == NODE_INT_CONVERT { vec_push(v, integer_expr_left(n)); vec_push(v, integer_expr_right(n)); }
    else if k == NODE_IF_STMT { vec_push(v, if_stmt_cond(n)); vec_push(v, if_stmt_then(n)); vec_push(v, if_stmt_else(n)); }
    else if k == NODE_WHILE_STMT { vec_push(v, while_stmt_cond(n)); vec_push(v, while_stmt_body(n)); }
    else if k == NODE_LET_EXPR { vec_push(v, let_expr_init(n)); vec_push(v, let_expr_body(n)); }
    else if k == NODE_LAMBDA_EXPR { vec_push(v, lambda_expr_body(n)); }
    else if k == NODE_MATCH_EXPR { vec_push(v, match_expr_scrutinee(n)); var i i64 = 0; while i < match_expr_arm_count(n) { vec_push(v, match_arm_body(get_match_arm(match_expr_arms(n), i))); i = i + 1; } }
    else if k == NODE_HANDLE_EXPR { vec_push(v, handle_expr_body(n)); vec_push(v, handle_expr_ret_body(n)); var i i64 = 0; while i < handle_expr_case_count(n) { vec_push(v, effect_case_body(handle_expr_cases(n) + i * 56)); i = i + 1; } }
    else if k == NODE_RESUME_EXPR { vec_push(v, resume_expr_k(n)); vec_push(v, resume_expr_value(n)); }
    else if k == NODE_ARRAY_LITERAL { a = array_literal_elems(n); count = array_literal_count(n); }
    var i i64 = 0; while i < count { var p **u8 = a + i * 8; vec_push(v, *p); i = i + 1; } return v;
}
// Expand reader expressions before computing the effect call graph. A group
// node fits in the original reader allocation and retains the invocation origin.
func cps_expand_readers(n *u8) void {
    if n == nil { return; }
    if node_kind(n) == NODE_READER_EXPR {
        var name *u8 = reader_expr_name(n); var len i64 = reader_expr_name_len(n);
        var content *u8 = reader_expr_content(n);
        var embedded *u8 = find_embedded_reader_func(name, len);
        var path *u8 = nil;
        if embedded == nil {
            if find_reader(name, len) == nil { cps_fail(n, "expression reader not found"); }
            path = build_reader_cache_path(name, len);
        }
        var output *u8 = compiler_invoke_reader(n, embedded, path);
        if output == nil || strlen(output) == 0 { cps_fail(n, "expression reader failed"); }
        var expanded *u8 = parse_ast_expression_from_reader_string(output, node_origin_source(n), content);
        if expanded == nil { cps_fail(n, "expression reader returned invalid AST"); }
        llvm_debug_bind_reader(n, content);
        node_set_kind(n, NODE_GROUP_EXPR); group_expr_set_expr(n, expanded);
    }
    var v *u8 = cps_children(n); var i i64 = 0;
    while i < vec_len(v) { cps_expand_readers(vec_get(v, i)); i = i + 1; }
}
// LLVM expands macros during emission, after CPS has validated the program.
// In a module with visible suspensions, unexpanded calls can hide references
// or aliases from validation. Otherwise inspect their expansions for effects.
func cps_check_macros(n *u8, has_suspensions i64) void {
    if n == nil { return; }
    if node_kind(n) == NODE_CALL_EXPR {
        var f *u8 = call_expr_func(n);
        if node_kind(f) == NODE_IDENT_EXPR {
            var macro_def *u8 = find_macro(ident_expr_name(f), ident_expr_name_len(f));
            if macro_def != nil {
                if has_suspensions { cps_fail(n, "unexpanded macro call is unsupported in the scoped CPS profile"); }
                var expanded *u8 = interp_call_macro(macro_def, call_expr_args(n), call_expr_arg_count(n));
                if cps_has_effect(expanded) { cps_fail(n, "unexpanded macro call is unsupported in the scoped CPS profile"); }
                cps_check_macros(expanded, 0);
                return;
            }
        }
    }
    var v *u8 = cps_children(n); var i i64 = 0;
    while i < vec_len(v) { cps_check_macros(vec_get(v, i), has_suspensions); i = i + 1; }
}
func cps_has_effect(n *u8) i64 {
    if n == nil { return 0; } var k i64 = node_kind(n);
    if k == NODE_HANDLE_EXPR || k == NODE_PERFORM_EXPR || k == NODE_RESUME_EXPR { return 1; }
    if k == NODE_CALL_EXPR { var f *u8 = call_expr_func(n); if node_kind(f) == NODE_IDENT_EXPR { if map_has(cps_functions, str_dup_n(ident_expr_name(f), ident_expr_name_len(f))) { return 1; } } }
    var v *u8 = cps_children(n); var i i64 = 0; while i < vec_len(v) { if cps_has_effect(vec_get(v, i)) { return 1; } i = i + 1; } return 0;
}
func cps_expr_type(m *i64, n *u8) *u8 {
    if n == nil { return cps_i64; } var k i64 = node_kind(n);
    if k == NODE_IDENT_EXPR { var b *i64 = cps_lookup(m, ident_expr_name(n), ident_expr_name_len(n)); if b != nil { return cast(*u8, b[2]); } var t *u8 = get_expr_type(n); if t != nil { return t; } }
    if k == NODE_CAST_EXPR { return cast_expr_type(n); }
    if k == NODE_BITCAST_EXPR { return bitcast_expr_type(n); }
    if k == NODE_BINARY_EXPR {
        var op i64 = binary_expr_op(n);
        if op == TOKEN_EQEQ || op == TOKEN_BANGEQ || op == TOKEN_LT || op == TOKEN_GT || op == TOKEN_LTEQ || op == TOKEN_GTEQ || op == TOKEN_AMPAMP || op == TOKEN_PIPEPIPE { return cps_i64; }
        return cps_expr_type(m, binary_expr_left(n));
    }
    if k == NODE_UNARY_EXPR {
        var t *u8 = cps_expr_type(m, unary_expr_expr(n));
        if unary_expr_op(n) == TOKEN_AMP { return cps_ptr(t); }
        if unary_expr_op(n) == TOKEN_STAR { return get_pointed_type(t); }
        return t;
    }
    if k == NODE_INDEX_EXPR {
        var t *u8 = cps_expr_type(m, index_expr_base(n));
        if t != nil && type_kind(t) == TYPE_ARRAY { return array_type_elem(t); }
        if t != nil && type_kind(t) == TYPE_PTR { return ptr_type_elem(t); }
    }
    if k == NODE_FIELD_EXPR {
        var t *u8 = cps_expr_type(m, field_expr_expr(n));
        if t != nil && type_kind(t) == TYPE_PTR { t = ptr_type_elem(t); }
        if t != nil && type_kind(t) == TYPE_BASE {
            var d *u8 = find_struct(base_type_name(t), base_type_name_len(t));
            if d != nil { return get_field_type(d, field_expr_field(n), field_expr_field_len(n)); }
        }
    }
    if k == NODE_LET_EXPR { return cps_expr_type(m, let_expr_body(n)); }
    if k == NODE_STRING_EXPR { return cps_ptr(cps_base("u8")); }
    if k == NODE_GROUP_EXPR { return cps_expr_type(m, group_expr_expr(n)); }
    if k == NODE_CALL_EXPR { var f *u8 = call_expr_func(n); if node_kind(f) == NODE_IDENT_EXPR { var d *u8 = find_func(ident_expr_name(f), ident_expr_name_len(f)); if d != nil && !is_void_type(func_decl_ret_type(d)) { return func_decl_ret_type(d); } } }
    return cps_i64;
}
// An lvalue rooted in a native aggregate still names step-local storage.
// Stop at pointer indirection: the pointee is not the pointer cell itself.
func cps_check_address(m *i64, n *u8) void {
    var k i64 = node_kind(n);
    if k == NODE_GROUP_EXPR { cps_check_address(m, group_expr_expr(n)); }
    else if k == NODE_IDENT_EXPR {
        var b *i64 = cps_lookup(m, ident_expr_name(n), ident_expr_name_len(n));
        if b != nil { cps_fail(n, "address of a suspending local has an unproved escape lifetime"); }
    }
    else if k == NODE_INDEX_EXPR {
        var t *u8 = cps_expr_type(m, index_expr_base(n));
        if t != nil && type_kind(t) == TYPE_ARRAY { cps_check_address(m, index_expr_base(n)); }
    }
    else if k == NODE_FIELD_EXPR {
        var t *u8 = cps_expr_type(m, field_expr_expr(n));
        if t != nil && type_kind(t) != TYPE_PTR { cps_check_address(m, field_expr_expr(n)); }
    }
}
// Native arrays/structs may be indexed/selected in their region, but may not
// decay into aliases stored in frame cells or passed to opaque native calls.
func cps_rewrite_storage(m *i64, n *u8) *u8 {
    if node_kind(n) == NODE_GROUP_EXPR { return cps_rewrite_storage(m, group_expr_expr(n)); }
    if node_kind(n) == NODE_IDENT_EXPR {
        var b *i64 = cps_lookup(m, ident_expr_name(n), ident_expr_name_len(n));
        if b != nil && b[4] == 0 && cps_native_local(cast(*u8, b[2])) { return n; }
    }
    if node_kind(n) == NODE_INDEX_EXPR {
        var r *u8 = index_expr_alloc(); index_expr_set_base(r, cps_rewrite_storage(m, index_expr_base(n))); index_expr_set_index(r, cps_rewrite(m, index_expr_index(n))); return r;
    }
    if node_kind(n) == NODE_FIELD_EXPR {
        var r *u8 = alloc(32); memcpy(r, n, 32); var p **u8 = r + 8; *p = cps_rewrite_storage(m, field_expr_expr(n)); return r;
    }
    return cps_rewrite(m, n);
}
// Rewrite a non-suspending subtree, preserving its native expression forms.
func cps_rewrite(m *i64, n *u8) *u8 {
    if n == nil { return n; } var k i64 = node_kind(n);
    if k == NODE_IDENT_EXPR {
        if cps_token_name != nil && str_eq_n(ident_expr_name(n), ident_expr_name_len(n), cps_token_name, strlen(cps_token_name)) { cps_fail(n, "continuation may only occur as its clause's tail resume operand"); }
        var b *i64 = cps_lookup(m, ident_expr_name(n), ident_expr_name_len(n));
        if b != nil {
            var t *u8 = cast(*u8, b[2]);
            if cps_aggregate_local(t) { cps_fail(n, "native aggregate alias has an unproved escape lifetime"); }
            return cps_binding_ref(m, b);
        } return n;
    }
    if k == NODE_UNARY_EXPR {
        var inner *u8 = unary_expr_expr(n);
        if unary_expr_op(n) == TOKEN_AMP { cps_check_address(m, inner); }
        var r *u8 = cps_unary(unary_expr_op(n), cps_rewrite(m, inner)); node_copy_origin(r, n); return r;
    }
    if k == NODE_BINARY_EXPR { var r *u8 = cps_binary(binary_expr_op(n), cps_rewrite(m, binary_expr_left(n)), cps_rewrite(m, binary_expr_right(n))); node_copy_origin(r, n); return r; }
    if k == NODE_GROUP_EXPR { return cps_rewrite(m, group_expr_expr(n)); }
    if k == NODE_CALL_EXPR {
        var a *u8 = vec_new(4); var i i64 = 0; while i < call_expr_arg_count(n) { var p **u8 = call_expr_args(n) + i * 8; vec_push(a, cps_rewrite(m, *p)); i = i + 1; }
        var r *u8 = call_expr_alloc(); call_expr_set_func(r, cps_rewrite(m, call_expr_func(n))); call_expr_set_args(r, cps_array(a)); call_expr_set_arg_count(r, vec_len(a)); node_copy_origin(r, n); return r;
    }
    if k == NODE_CAST_EXPR {
        if cps_native_local(cps_expr_type(m, cast_expr_expr(n))) { cps_fail(n, "native aggregate alias has an unproved escape lifetime"); }
        return cps_cast(cast_expr_type(n), cps_rewrite(m, cast_expr_expr(n)));
    }
    if k == NODE_BITCAST_EXPR {
        if cps_native_local(cps_expr_type(m, bitcast_expr_expr(n))) { cps_fail(n, "native aggregate alias has an unproved escape lifetime"); }
        var r *u8 = bitcast_expr_alloc(); bitcast_expr_set_type(r, bitcast_expr_type(n)); bitcast_expr_set_expr(r, cps_rewrite(m, bitcast_expr_expr(n))); return r; }
    if k == NODE_INDEX_EXPR || k == NODE_FIELD_EXPR {
        var t *u8 = cps_expr_type(m, n);
        if cps_aggregate_local(t) { cps_fail(n, "native aggregate alias has an unproved escape lifetime"); }
        return cps_rewrite_storage(m, n);
    }
    if k == NODE_INT_COMPARE || k == NODE_INT_CONVERT { return integer_expr_alloc(k, integer_expr_op(n), integer_expr_src(n), integer_expr_dst(n), cps_rewrite(m, integer_expr_left(n)), cps_rewrite(m, integer_expr_right(n))); }
    if k == NODE_LET_EXPR {
        var r *u8 = let_expr_alloc(); memcpy(r, n, 48);
        let_expr_set_init(r, cps_rewrite(m, let_expr_init(n)));
        var env *u8 = cast(*u8, m[2]); var saved i64 = vec_len(env);
        var b *i64 = cps_bind(m, let_expr_name(n), let_expr_name_len(n), let_expr_type(n)); b[4] = 0;
        let_expr_set_body(r, cps_rewrite(m, let_expr_body(n))); while vec_len(env) > saved { vec_pop(env); } return r;
    }
    if k == NODE_LAMBDA_EXPR {
        if cps_captures_frame(m, lambda_expr_body(n)) { cps_fail(n, "native closures cannot capture a suspending activation"); } return n;
    }
    if k == NODE_MATCH_EXPR {
        var r *u8 = match_expr_alloc(); var scrutinee *u8 = match_expr_scrutinee(n);
        // Match consumes its aggregate address synchronously in this step;
        // it cannot store the address in a frame or pass it to native code.
        if node_kind(scrutinee) == NODE_UNARY_EXPR && unary_expr_op(scrutinee) == TOKEN_AMP && cps_native_local(cps_expr_type(m, unary_expr_expr(scrutinee))) {
