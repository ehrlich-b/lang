}

// The i64 type node, built once. Used where an expression has no inferable
// type but lang's semantics say i64 (integer literals, most call results).
var llvm_i64_type_cache *u8 = nil;
func llvm_i64_type() *u8 {
    if llvm_i64_type_cache == nil {
        llvm_i64_type_cache = base_type_alloc();
        base_type_set_name(llvm_i64_type_cache, "i64");
        base_type_set_name_len(llvm_i64_type_cache, 3);
    }
    return llvm_i64_type_cache;
}

// Decimal literals are emitted as LLVM doubles unless a surrounding typed
// operation says otherwise. Give casts of a bare literal (for example
// `cast(i8, 5.7)`) the concrete source type their SSA operand already has.
var llvm_f64_type_cache *u8 = nil;
func llvm_f64_type() *u8 {
    if llvm_f64_type_cache == nil {
        llvm_f64_type_cache = base_type_alloc();
        base_type_set_name(llvm_f64_type_cache, "f64");
        base_type_set_name_len(llvm_f64_type_cache, 3);
    }
    return llvm_f64_type_cache;
}

// Fixed-array allocation, type emission and literal stores consume shared
// scalar storage layouts. Other legacy arrays retain their internal
// representation; this does not admit them
// to the shared API or qualify an aggregate/relocation ABI.
func llvm_storage_size(t *u8, node *u8) i64 {
    // Void is an invalid storage leaf even for an empty array.
    var leaf *u8 = t;
    while leaf != nil && type_kind(leaf) == TYPE_ARRAY { leaf = array_type_elem(leaf); }
    var is_void i64 = 0;
    if leaf != nil && type_kind(leaf) == TYPE_BASE {
        is_void = base_type_name_len(leaf) == 4 && memcmp(base_type_name(leaf), "void", 4);
    }
    if layout_is_scalar_storage(t) == 0 && is_void == 0 { return get_type_size(t); }
    var profile *u8 = "llvm-linux-x86_64";
    if llvm_is_wasm { profile = "llvm-wasm32"; }
    // macOS output is cross-target compatibility only, outside this tranche.
    if llvm_is_arm64 { return get_type_size(t); }
    var storage StorageLayout;
    var status i64 = layout_query(t, profile, &storage);
    if status != LAYOUT_OK {
        // A genuinely spanless node uses the plain error prefix rather than
        // inheriting an unrelated diagnostic's provenance.
        cg_diagnostic_node = nil;
        cg_error_prefix_at(node); eprint("layout: "); eprintln(layout_error(status)); exit(1);
    }
    return storage.size;
}

// Parameter slots use the legacy integer/address calling convention, so they
// bypass llvm_emit_type. Check their array storage through the same policy as
// object storage before lowering the signature; this does not select an ABI.
func llvm_validate_parameter_type(t *u8, node *u8) void {
    if t == nil { return; }
    var kind i64 = type_kind(t);
    if kind == TYPE_ARRAY {
        var storage_size i64 = llvm_storage_size(t, node);
    } else if kind == TYPE_FUNC || kind == TYPE_CLOSURE {
        var params *u8 = func_type_params(t);
        var count i64 = func_type_param_count(t);
        if kind == TYPE_CLOSURE {
            params = closure_type_params(t);
            count = closure_type_param_count(t);
        }
        var i i64 = 0;
        while i < count {
            llvm_validate_parameter_type(vec_get(params, i), node);
            i = i + 1;
        }
    }
}

func llvm_validate_parameters(params *u8, count i64, node *u8) void {
    var i i64 = 0;
    while i < count {
        llvm_validate_parameter_type(param_type(params + i * 24), node);
        i = i + 1;
    }
}

func llvm_validate_callable(expr *u8, node *u8) void {
    if node_kind(expr) == NODE_GROUP_EXPR {
        llvm_validate_callable(group_expr_expr(expr), node);
    } else if node_kind(expr) == NODE_LAMBDA_EXPR {
        // Lambda parameter records are not the type vector of TYPE_FUNC.
        llvm_validate_parameters(lambda_expr_params(expr),
                                 lambda_expr_param_count(expr), expr);
    } else {
        llvm_validate_parameter_type(get_expr_type(expr), node);
    }
}

// Byte size of a struct/enum type, or 0 if the type isn't an aggregate.
// Aggregates live in memory and are passed around as addresses.
func llvm_aggregate_type_size(t *u8) i64 {
    if t == nil { return 0; }
    if type_kind(t) != TYPE_BASE { return 0; }
    var tname *u8 = base_type_name(t);
    var tname_len i64 = base_type_name_len(t);
    var sd *u8 = find_struct(tname, tname_len);
    if sd != nil { return get_struct_size(sd); }
    var ed *u8 = find_enum(tname, tname_len);
    if ed != nil { return get_enum_size(ed); }
    return 0;
}

// Check if a value string contains a decimal point (is a float literal)
func llvm_is_float_literal(val *u8) i64 {
    if val == nil {
        return 0;
    }
    var i i64 = 0;
    while *(val + i) != 0 {
        if *(val + i) == 46 {  // '.'
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Array element context supplies f32 for integer literals, including a
// parenthesized or negated literal. Other integer expressions require an
// explicit conversion; array context does not supply general coercions.
func llvm_is_integer_literal(expr *u8) i64 {
    if expr == nil { return 0; }
    if node_kind(expr) == NODE_GROUP_EXPR {
        return llvm_is_integer_literal(group_expr_expr(expr));
    }
    if node_kind(expr) == NODE_UNARY_EXPR && unary_expr_op(expr) == TOKEN_MINUS {
        return llvm_is_integer_literal(unary_expr_expr(expr));
    }
    if node_kind(expr) != NODE_NUMBER_EXPR { return 0; }
    var text *u8 = str_dup_n(number_expr_value(expr), number_expr_value_len(expr));
    return !llvm_is_float_literal(text);
}

func llvm_is_numeric_literal(expr *u8) i64 {
    if expr == nil { return 0; }
    if node_kind(expr) == NODE_GROUP_EXPR {
        return llvm_is_numeric_literal(group_expr_expr(expr));
    }
    if node_kind(expr) == NODE_UNARY_EXPR && unary_expr_op(expr) == TOKEN_MINUS {
        return llvm_is_numeric_literal(unary_expr_expr(expr));
    }
    return node_kind(expr) == NODE_NUMBER_EXPR;
}

// A dereferenced f32 is a float SSA value. Legacy storage and call sites
// cannot supply an implicit integer/double conversion for it.
func llvm_validate_f32_pointer_read(expr *u8, destination *u8) void {
    if expr == nil { return; }
    while node_kind(expr) == NODE_GROUP_EXPR { expr = group_expr_expr(expr); }
    if node_kind(expr) == NODE_UNARY_EXPR && unary_expr_op(expr) == TOKEN_STAR &&
       llvm_is_f32_type(llvm_get_expr_type(expr)) && !llvm_is_f32_type(destination) {
        numeric_fail(expr, "f32 pointer read requires an f32 destination or an explicit numeric conversion");
    }
}

func llvm_f32_array_numeric_call(expr *u8) i64 {
    while node_kind(expr) == NODE_GROUP_EXPR { expr = group_expr_expr(expr); }
    if !numeric_is_call(expr) { return 0; }
    numeric_validate(expr);
    // llvm_get_expr_type describes the double carrier for numeric results.
    return streq(numeric_meta(expr, 1), "f32");
}

func llvm_validate_f32_array_elements(init *u8, elem_type *u8, global_init i64) void {
    if !llvm_is_f32_type(elem_type) { return; }
    var elems *u8 = array_literal_elems(init);
    var i i64 = 0;
    // Validate the entire literal, even elements beyond the storage count.
    while i < array_literal_count(init) {
        var p **u8 = elems + i * 8;
        if !llvm_is_numeric_literal(*p) {
            if global_init {
                numeric_fail(*p, "f32 global array element requires a numeric literal");
            } else if !llvm_numeric_native_f32(*p) && !llvm_f32_array_numeric_call(*p) {
                numeric_fail(*p, "f32 array element requires a numeric literal or an explicit f32 value");
            }
        } else {
            // Check range even for local integer literals and excess elements.
            llvm_f32_literal_value(*p);
        }
        i = i + 1;
    }
}

// Produce binary32 bits using decimal digit arithmetic only. Integer division
// and fractional multiplication by two supply exact bits through 2^-150;
// remaining decimal digits supply sticky. Round once, ties to even, including
// subnormals. No intermediate binary64 value can cause double rounding.
func llvm_f32_decimal_bits(expr *u8, text *u8) i64 {
    var len i64 = strlen(text);
    var digits *u8 = str_dup(text);
    var point i64 = 0;
    while point < len && *(digits + point) != '.' { point = point + 1; }
    // Index 150 is 2^0; index 1 is the least subnormal bit, 2^-149.
    var bits *u8 = alloc(278);
    var clear i64 = 0;
    while clear < 278 { *(bits + clear) = 0; clear = clear + 1; }
    var count i64 = 0;
    var nonzero i64 = 1;
    while nonzero {
        var carry i64 = 0;
        nonzero = 0;
        var i i64 = 0;
        while i < point {
            var digit i64 = carry * 10 + (*(digits + i) - '0');
            *(digits + i) = '0' + digit / 2;
            carry = digit % 2;
            if *(digits + i) != '0' { nonzero = 1; }
            i = i + 1;
        }
        if count >= 128 { numeric_fail(expr, "f32 array decimal literal is outside finite range"); }
        *(bits + 150 + count) = carry;
        count = count + 1;
    }
    var position i64 = 1;
    while position <= 150 {
        var carry i64 = 0;
        var i i64 = len - 1;
        while i > point {
            var digit i64 = (*(digits + i) - '0') * 2 + carry;
            *(digits + i) = '0' + digit % 10;
            carry = digit / 10;
            i = i - 1;
        }
        *(bits + 150 - position) = carry;
        position = position + 1;
    }
    var sticky i64 = 0;
    var i i64 = point + 1;
    while i < len {
        if *(digits + i) != '0' { sticky = 1; }
        i = i + 1;
    }
    var top i64 = 277;
    while top >= 0 && *(bits + top) == 0 { top = top - 1; }
    var shift i64 = top - 23;
    if shift < 1 { shift = 1; }
    var mantissa i64 = 0;
    i = top;
    while i >= shift {
        mantissa = mantissa * 2 + *(bits + i);
        i = i - 1;
    }
    i = shift - 2;
    while i >= 0 {
        if *(bits + i) != 0 { sticky = 1; }
        i = i - 1;
    }
    if *(bits + shift - 1) != 0 && (sticky || (mantissa & 1)) {
        mantissa = mantissa + 1;
    }
    var result i64 = mantissa;
    if top >= 24 { result = (top - 24) * 8388608 + mantissa; }
    if result >= 2139095040 { numeric_fail(expr, "f32 array decimal literal is outside finite range"); }
    free(digits); free(bits);
    return result;
}

// LLVM requires a typed floating constant, not an integer token after `float`.
// Use the existing host cast to round i64 directly to f32, then widen exactly
// to double for LLVM's hexadecimal float spelling. This also works with the
// bootstrap compiler, without relying on removed sitofp constant expressions.
func llvm_f32_literal_value(expr *u8) *u8 {
    if llvm_is_numeric_literal(expr) == 0 {
        numeric_fail(expr, "f32 global array element requires a numeric literal");
    }
    var negative i64 = 0;
    while node_kind(expr) != NODE_NUMBER_EXPR {
        if node_kind(expr) == NODE_GROUP_EXPR { expr = group_expr_expr(expr); }
        else { negative = !negative; expr = unary_expr_expr(expr); }
    }
    var text *u8 = str_dup_n(number_expr_value(expr), number_expr_value_len(expr));
    if *text == '-' { negative = !negative; text = text + 1; }
    var bits i64 = 0;
    if llvm_is_float_literal(text) {
        var word i64 = llvm_f32_decimal_bits(expr, text);
        // Widen the finite binary32 encoding exactly for LLVM hex spelling.
        // Integer operations also work with the trusted bootstrap's carriers.
        var exponent i64 = word >> 23;
        var mantissa i64 = word & 8388607;
        if exponent == 0 && mantissa != 0 {
            exponent = 1;
            while mantissa < 8388608 {
                mantissa = mantissa * 2;
                exponent = exponent - 1;
            }
            mantissa = mantissa - 8388608;
        }
        if word != 0 { bits = ((exponent + 896) << 52) | (mantissa << 29); }
        if negative { bits = bits | -9223372036854775808; }
    } else {
        // Accumulate negatively so INT_MIN is representable without overflow.
        var value i64 = 0;
        while *text != 0 {
            var digit i64 = *text - '0';
            var last i64 = 7;
            if negative { last = 8; }
            if value < -922337203685477580 || (value == -922337203685477580 && digit > last) {
                numeric_fail(expr, "f32 array integer literal is outside i64 range");
            }
            value = value * 10 - digit;
            text = text + 1;
        }
        if !negative { value = 0 - value; }
        var rounded f32 = cast(f32, value);
        var widened f64 = cast(f64, rounded);
        bits = bitcast(i64, widened);
    }
    var result *u8 = alloc(19);
    *result = '0'; *(result + 1) = 'x';
    var digits *u8 = "0123456789ABCDEF";
    var i i64 = 0;
    while i < 16 {
        *(result + 2 + i) = *(digits + ((bits >> ((15 - i) * 4)) & 15));
        i = i + 1;
    }
    *(result + 18) = 0;
    return result;
}

// Check if type is a signed integer (i8, i16, i32, i64, i128)
func llvm_is_signed_int(t *u8) i64 {
    if t == nil { return 0; }
    if type_kind(t) != TYPE_BASE { return 0; }
    var name *u8 = base_type_name(t);
    return *name == 'i';  // i8, i16, i32, i64, i128 start with 'i'
}

// Check if type is an unsigned integer (u8, u16, u32, u64, u128)
func llvm_is_unsigned_int(t *u8) i64 {
    if t == nil { return 0; }
    if type_kind(t) != TYPE_BASE { return 0; }
    var name *u8 = base_type_name(t);
    return *name == 'u';  // u8, u16, u32, u64, u128 start with 'u'
}

// Get type size in bits (for cast decisions)
func llvm_type_bits(t *u8) i64 {
    if t == nil { return 64; }
    if type_kind(t) != TYPE_BASE { return 64; }
    var name *u8 = base_type_name(t);
    var len i64 = base_type_name_len(t);

    if len == 2 && memcmp(name, "i8", 2) { return 8; }
    if len == 2 && memcmp(name, "u8", 2) { return 8; }
    if len == 3 && memcmp(name, "i16", 3) { return 16; }
    if len == 3 && memcmp(name, "u16", 3) { return 16; }
    if len == 3 && memcmp(name, "i32", 3) { return 32; }
    if len == 3 && memcmp(name, "u32", 3) { return 32; }
    if len == 3 && memcmp(name, "f32", 3) { return 32; }
    if len == 3 && memcmp(name, "i64", 3) { return 64; }
    if len == 3 && memcmp(name, "u64", 3) { return 64; }
    if len == 3 && memcmp(name, "f64", 3) { return 64; }
    if len == 4 && memcmp(name, "i128", 4) { return 128; }
    if len == 4 && memcmp(name, "u128", 4) { return 128; }
    if len == 4 && memcmp(name, "bool", 4) { return 1; }
    return 64;  // default
}

func llvm_register_func(name *u8, len i64, ret_type *u8) void {
    var key *u8 = str_dup_n(name, len);
    // Store: 0 = i64, 1 = void, 2 = pointer, 3 = bool, 4 = u8, 5 = f32, 6 = f64
    var ret_kind i64 = 0;
    if llvm_is_void_type(ret_type) {
        ret_kind = 1;
    } else if llvm_is_pointer_type(ret_type) {
        ret_kind = 2;
    } else if llvm_is_bool_type(ret_type) {
        ret_kind = 3;
    } else if llvm_is_u8_type(ret_type) {
        ret_kind = 4;
    } else if llvm_is_f32_type(ret_type) {
        ret_kind = 5;
    } else if llvm_is_f64_type(ret_type) {
        ret_kind = 6;
    }
    map_set(llvm_func_ret_types, key, ret_kind);
}

func llvm_func_returns_void(name *u8, len i64) i64 {
    var key *u8 = str_dup_n(name, len);
    if map_has(llvm_func_ret_types, key) {
        return map_get(llvm_func_ret_types, key) == 1;
    }
    return 0;  // Default: assume non-void
}

