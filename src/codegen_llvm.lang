// src/codegen_llvm.lang - LLVM IR backend
//
// Emits LLVM IR text format (.ll files) instead of x86 assembly.
// This enables:
// - Cross-platform compilation via clang
// - Access to LLVM optimizations
// - Future: stack maps for precise GC, custom calling conventions
//
// LLVM IR is just different text output. The kernel walks AST and emits strings.
// Pattern:
//   x86:  movq $42, %rax; ret
//   LLVM: ret i64 42

// =====================================================// Output buffer
// =====================================================
var llvm_out_fd i64 = 0;
var llvm_buf *u8 = nil;
var llvm_len i64 = 0;
var llvm_buf_size i64 = 0;

// Architecture flag: 1 = ARM64 (macOS), 0 = x86-64
var llvm_is_arm64 i64 = 0;
// Target flag: 1 = WebAssembly
var llvm_is_wasm i64 = 0;
var llvm_current_function *u8 = nil;

// Layout type emission can recurse through expressions and declarations.
// Scope its origin independently of other diagnostics so a nested node cannot
// leave a stale location for the next declaration (including spanless core).
var llvm_layout_node *u8 = nil;

// Debug metadata is opt-in and uses only the shared origin contract. Metadata
// IDs have their own namespace, so enabling it never renumbers SSA values.
include "std/emit.lang"
var llvm_debug_enabled i64 = 0;
var llvm_debug_records *u8 = nil;
var llvm_debug_files *u8 = nil;
var llvm_debug_units *u8 = nil;
var llvm_debug_scopes *u8 = nil;
var llvm_debug_locations *u8 = nil;
var llvm_debug_slices *u8 = nil;
var llvm_debug_subprogram i64 = 0;
var llvm_debug_file i64 = 0;
var llvm_debug_location i64 = 0;
var llvm_debug_line_start i64 = 0;
struct LLVMDebugSlice { parent i64; offset i64; }

func llvm_debug_number(n i64) *u8 {
    var text *u8 = alloc(32); itoa(n, text); return text;
}

func llvm_debug_add(text *u8) i64 {
    var id i64 = vec_len(llvm_debug_records);
    vec_push(llvm_debug_records, text); return id;
}

func llvm_debug_quote(text *u8) *u8 {
    var sb *StringBuilder = sb_new();
    sb_char(sb, 34);
    var hex *u8 = "0123456789ABCDEF";
    while *text != 0 {
        var c i64 = *text;
        if c < 32 || c >= 127 || c == 34 || c == 92 {
            sb_char(sb, 92); sb_char(sb, *(hex + c / 16)); sb_char(sb, *(hex + c % 16));
        } else { sb_char(sb, c); }
        text = text + 1;
    }
    sb_char(sb, 34); return sb_finish(sb);
}

func llvm_debug_init() void {
    llvm_debug_subprogram = 0; llvm_debug_location = 0; llvm_debug_line_start = 0;
    if llvm_debug_enabled == 0 { return; }
    llvm_debug_records = vec_new(64); llvm_debug_files = map_new();
    llvm_debug_units = vec_new(8); llvm_debug_scopes = map_new();
    llvm_debug_locations = map_new(); llvm_debug_slices = map_new();
    llvm_debug_add("!DISubroutineType(types: !1)");
    llvm_debug_add("!{null}");
    llvm_debug_add("!{i32 2, !\"Dwarf Version\", i32 4}");
    llvm_debug_add("!{i32 2, !\"Debug Info Version\", i32 3}");
}

// Reader spans index a slice, while inline readers display the containing file.
// Bind the immutable slice to its invocation after parsing reader output. Whole
// source inputs already share the same record and need no offset adjustment.
func llvm_debug_bind_reader(invocation *u8, content *u8) void {
    if llvm_debug_enabled == 0 { return; }
    var origin *PhaseOrigin = phase_origin_get(node_origin_id(invocation));
    if origin == nil { return; }
    var parent *PhaseSource = phase_source_get(origin.source);
    var child i64 = phase_source_latest(parent.name);
    if child == origin.source { return; }
    var start i64 = reader_expr_source_start(invocation);
    if start < 0 { return; }
    var len i64 = strlen(content);
    if start > parent.len || len > parent.len - start { return; }
    if memcmp(parent.text + start, content, len) == 0 { return; }
    var slice *LLVMDebugSlice = alloc(16);
    slice.parent = origin.source; slice.offset = start;
    map_set(llvm_debug_slices, llvm_debug_number(child), slice);
}

func llvm_debug_source(node *u8) *PhaseSource {
    var origin *PhaseOrigin = phase_origin_get(node_origin_id(node));
    if origin == nil { return nil; }
    var source i64 = origin.source;
    var slice *LLVMDebugSlice = map_get(llvm_debug_slices, llvm_debug_number(source));
    while slice != nil {
        source = slice.parent;
        slice = map_get(llvm_debug_slices, llvm_debug_number(source));
    }
    return phase_source_get(source);
}

func llvm_debug_position(node *u8) i64 {
    var origin *PhaseOrigin = phase_origin_get(node_origin_id(node));
    var source i64 = origin.source;
    var offset i64 = origin.start;
    var slice *LLVMDebugSlice = map_get(llvm_debug_slices, llvm_debug_number(source));
    while slice != nil {
        offset = offset + slice.offset; source = slice.parent;
        slice = map_get(llvm_debug_slices, llvm_debug_number(source));
    }
    return offset;
}

func llvm_debug_file_id(source *PhaseSource) i64 {
    var id i64 = map_get(llvm_debug_files, source.name);
    if id != 0 { return id; }
    id = llvm_debug_add(str_concat(str_concat("!DIFile(filename: ", llvm_debug_quote(source.name)),
                                  ", directory: \".\")"));
    map_set(llvm_debug_files, source.name, id);
    var sb *StringBuilder = sb_new();
    sb_str(sb, "distinct !DICompileUnit(language: DW_LANG_C, file: !"); sb_int(sb, id);
    sb_str(sb, ", producer: \"lang\", isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug)");
    var unit i64 = llvm_debug_add(sb_finish(sb));
    // The CU immediately follows its file record.
    vec_push(llvm_debug_units, unit); return id;
}

func llvm_debug_set_node(node *u8) void {
    if llvm_debug_enabled == 0 || llvm_debug_subprogram == 0 { return; }
    var source *PhaseSource = llvm_debug_source(node);
    if source == nil { return; }
    // The reader adapter marks unspanned generated nodes with an empty span at
    // byte zero. Keep the enclosing location rather than inventing line one.
    if node_origin_start(node) == 0 && node_origin_end(node) == 0 && llvm_debug_location != 0 { return; }
    var offset i64 = llvm_debug_position(node);
    var line i64 = 1;
    while line < source.line_count && phase_word(source.lines, line) <= offset { line = line + 1; }
    var column i64 = offset - phase_word(source.lines, line - 1) + 1;
    var file i64 = llvm_debug_file_id(source);
    var scope i64 = llvm_debug_subprogram;
    if file != llvm_debug_file {
        var scope_key *u8 = str_concat(str_concat(llvm_debug_number(scope), ":"), llvm_debug_number(file));
        var scoped i64 = map_get(llvm_debug_scopes, scope_key);
        if scoped == 0 {
            var scope_sb *StringBuilder = sb_new();
            sb_str(scope_sb, "!DILexicalBlockFile(scope: !"); sb_int(scope_sb, scope);
            sb_str(scope_sb, ", file: !"); sb_int(scope_sb, file); sb_str(scope_sb, ", discriminator: 0)");
            scoped = llvm_debug_add(sb_finish(scope_sb)); map_set(llvm_debug_scopes, scope_key, scoped);
        }
        scope = scoped;
    }
    var sb *StringBuilder = sb_new();
    sb_str(sb, "!DILocation(line: "); sb_int(sb, line); sb_str(sb, ", column: "); sb_int(sb, column);
    sb_str(sb, ", scope: !"); sb_int(sb, scope); sb_str(sb, ")");
    var text *u8 = sb_finish(sb);
    var id i64 = map_get(llvm_debug_locations, text);
    if id == 0 { id = llvm_debug_add(text); map_set(llvm_debug_locations, text, id); }
    llvm_debug_location = id;
}

func llvm_debug_begin(node *u8, name *u8) void {
    llvm_debug_subprogram = 0; llvm_debug_location = 0;
    if llvm_debug_enabled == 0 { return; }
    var source *PhaseSource = llvm_debug_source(node);
    if source == nil { return; }
    llvm_debug_file = llvm_debug_file_id(source);
    var line i64 = 1;
    var offset i64 = llvm_debug_position(node);
    while line < source.line_count && phase_word(source.lines, line) <= offset { line = line + 1; }
    var sb *StringBuilder = sb_new();
    sb_str(sb, "distinct !DISubprogram(name: "); sb_str(sb, llvm_debug_quote(name));
    sb_str(sb, ", scope: !"); sb_int(sb, llvm_debug_file); sb_str(sb, ", file: !"); sb_int(sb, llvm_debug_file);
    sb_str(sb, ", line: "); sb_int(sb, line); sb_str(sb, ", type: !0, scopeLine: "); sb_int(sb, line);
    sb_str(sb, ", spFlags: DISPFlagDefinition, unit: !"); sb_int(sb, llvm_debug_file + 1); sb_str(sb, ")");
    llvm_debug_subprogram = llvm_debug_add(sb_finish(sb));
    llvm_debug_set_node(node);
}

func llvm_debug_signature() void {
    if llvm_debug_enabled != 0 { llvm_emit_str(" #0"); }
    if llvm_debug_subprogram != 0 {
        llvm_emit_str(" !dbg !"); llvm_emit_int(llvm_debug_subprogram);
    }
}

func llvm_debug_finish() void {
    if llvm_debug_enabled == 0 { return; }
    llvm_emit_str("!llvm.dbg.cu = !{");
    var i i64 = 0;
    while i < vec_len(llvm_debug_units) {
        if i > 0 { llvm_emit_str(", "); }
        llvm_emit_char('!'); llvm_emit_int(vec_get(llvm_debug_units, i)); i = i + 1;
    }
    llvm_emit_line("}"); llvm_emit_line("!llvm.module.flags = !{!2, !3}");
    i = 0;
    while i < vec_len(llvm_debug_records) {
        llvm_emit_char('!'); llvm_emit_int(i); llvm_emit_str(" = ");
        llvm_emit_line(vec_get(llvm_debug_records, i)); i = i + 1;
    }
}

func llvm_init_output(output_file *u8) void {
    llvm_buf_size = 65536;  // Grow geometrically under the host output budget
    llvm_buf = compiler_table_new(llvm_buf_size, 1);
    llvm_len = 0;

    llvm_out_fd = file_open(output_file, O_WRONLY_CREAT_TRUNC);
    if llvm_out_fd < 0 {
        eprint("Error: cannot open output file: ");
        eprintln(output_file);
        exit(1);
    }
}

func llvm_reserve_output(extra i64) void {
    var maximum i64 = phase_limit();
    if extra < 0 || extra > maximum - llvm_len {
        phase_error("byte-limit", "LLVM output buffer overflow (host output budget)");
    }
    var need i64 = llvm_len + extra;
    if need <= llvm_buf_size { return; }
    var capacity i64 = llvm_buf_size;
    while capacity < need { capacity = capacity * 2; }
    if capacity > maximum { capacity = maximum; }
    var storage *u8 = compiler_table_new(capacity, 1);
    memcpy(storage, llvm_buf, llvm_len);
    llvm_buf = storage; llvm_buf_size = capacity;
}

func llvm_emit_char(c u8) void {
    if llvm_debug_enabled != 0 && c == 10 {
        if llvm_debug_location != 0 && llvm_debug_subprogram != 0 && llvm_len > llvm_debug_line_start + 4 {
            var start *u8 = llvm_buf + llvm_debug_line_start;
            if memcmp(start, "    ", 4) {
                llvm_emit_str(", !dbg !"); llvm_emit_int(llvm_debug_location);
            }
        }
        llvm_debug_line_start = llvm_len + 1;
    }
    llvm_reserve_output(1);
    *(llvm_buf + llvm_len) = c;
    llvm_len = llvm_len + 1;
}

func llvm_emit_str(s *u8) void {
    llvm_emit_n(s, strlen(s));
}

func llvm_emit_line(s *u8) void {
    llvm_emit_str(s);
    llvm_emit_char(10);  // newline
}

func llvm_emit_int(n i64) void {
    if n < 0 {
        llvm_emit_char(45);  // '-'
        n = 0 - n;
    }
    if n == 0 {
        llvm_emit_char(48);  // '0'
        return;
    }
    // Find highest power of 10
    var divisor i64 = 1;
    var temp i64 = n;
    while temp >= 10 {
        temp = temp / 10;
        divisor = divisor * 10;
    }
    // Emit digits
    while divisor > 0 {
        var digit i64 = n / divisor;
        llvm_emit_char(48 + digit);
        n = n % divisor;
        divisor = divisor / 10;
    }
}

func llvm_emit_n(s *u8, len i64) void {
    llvm_reserve_output(len);
    memcpy(llvm_buf + llvm_len, s, len);
    llvm_len = llvm_len + len;
}

func llvm_flush() void {
    compiler_write_all(llvm_out_fd, llvm_buf, llvm_len);
    file_close(llvm_out_fd);
}

// =====================================================// Type emission
// =====================================================
func llvm_emit_type(type_node *u8) void {
    numeric_validate_legacy_type(type_node, cg_diagnostic_node);
    if type_node == nil {
        llvm_emit_str("void");
        return;
    }

    var k i64 = type_kind(type_node);

    if k == TYPE_BASE {
        var name *u8 = base_type_name(type_node);
        var len i64 = base_type_name_len(type_node);

        // Map lang types to LLVM types
        if len == 3 && memcmp(name, "i64", 3) {
            llvm_emit_str("i64");
        } else if len == 3 && memcmp(name, "i32", 3) {
            llvm_emit_str("i32");
        } else if len == 3 && memcmp(name, "i16", 3) {
            llvm_emit_str("i16");
        } else if len == 2 && memcmp(name, "i8", 2) {
            llvm_emit_str("i8");
        } else if len == 3 && memcmp(name, "u64", 3) {
            llvm_emit_str("i64");  // LLVM doesn't distinguish signed/unsigned in types
        } else if len == 3 && memcmp(name, "u32", 3) {
            llvm_emit_str("i32");
        } else if len == 3 && memcmp(name, "u16", 3) {
            llvm_emit_str("i16");
        } else if len == 2 && memcmp(name, "u8", 2) {
            llvm_emit_str("i8");
        } else if len == 3 && memcmp(name, "f32", 3) {
            llvm_emit_str("float");
        } else if len == 3 && memcmp(name, "f64", 3) {
            llvm_emit_str("double");
        } else if len == 4 && memcmp(name, "i128", 4) {
            llvm_emit_str("i128");
        } else if len == 4 && memcmp(name, "u128", 4) {
            llvm_emit_str("i128");  // LLVM uses i128 for both signed/unsigned
        } else if len == 4 && memcmp(name, "bool", 4) {
            llvm_emit_str("i1");
        } else if len == 4 && memcmp(name, "void", 4) {
            llvm_emit_str("void");
        } else {
            // Named aggregates retain the legacy address representation.
            llvm_emit_str("i64");
        }
        return;
    }

    if k == TYPE_PTR {
        llvm_emit_str("i8*");  // Use typed pointers for older LLVM
        return;
    }

    if k == TYPE_ARRAY {
        // Validate representable scalar-array storage before emitting its type.
        var storage_size i64 = llvm_storage_size(type_node, llvm_layout_node);
        // LLVM array type: [N x T]
        llvm_emit_str("[");
        llvm_emit_int(array_type_size(type_node));
        llvm_emit_str(" x ");
        llvm_emit_type(array_type_elem(type_node));
        llvm_emit_str("]");
        return;
    }

    // Default fallback
    llvm_emit_str("i64");
}

func llvm_is_pointer_type(t *u8) i64 {
    if t == nil {
        return 0;
    }
    return type_kind(t) == TYPE_PTR;
}

// =====================================================// Expression emission
// =====================================================
// Label counter for generating unique labels
var llvm_label_counter i64 = 0;

func llvm_next_label() i64 {
    var n i64 = llvm_label_counter;
    llvm_label_counter = llvm_label_counter + 1;
    return n;
}

// Temp register counter
var llvm_temp_counter i64 = 0;

func llvm_next_temp() i64 {
    var n i64 = llvm_temp_counter;
    llvm_temp_counter = llvm_temp_counter + 1;
    return n;
}

// Counter for anonymous locals (enums, etc.)
var llvm_anon_local_counter i64 = 0;

// One counter names every source binding and anonymous stack slot in a function.
func llvm_binding_name(name *u8, len i64) *u8 {
    var unique *u8 = alloc(len + 32);
    memcpy(unique, name, len);
    *(unique + len) = 46;
    itoa(llvm_anon_local_counter, unique + len + 1);
    llvm_anon_local_counter = llvm_anon_local_counter + 1;
    return unique;
}

// Allocate an anonymous local with given size, returns LLVM variable name
func llvm_alloc_local_size(size i64) *u8 {
    var name *u8 = alloc(32);
    var p *u8 = name;
    *p = 91; p = p + 1;  // [
    itoa(size, p);
    var len i64 = strlen(p);
    p = p + len;
    *p = 32; p = p + 1;  // space
    *p = 120; p = p + 1;  // x
    *p = 32; p = p + 1;  // space
    *p = 105; p = p + 1;  // i
    *p = 56; p = p + 1;   // 8
    *p = 93; p = p + 1;   // ]
    *p = 0;

    // Emit alloca
    var local_name *u8 = alloc(32);
    *local_name = 37;  // %
    *(local_name + 1) = 95;  // _
    *(local_name + 2) = 97;  // a
    itoa(llvm_anon_local_counter, local_name + 3);
    llvm_anon_local_counter = llvm_anon_local_counter + 1;

    llvm_emit_str("    ");
    llvm_emit_str(local_name);
    llvm_emit_str(" = alloca ");
    llvm_emit_str(name);
    llvm_emit_char(10);

    return local_name;
}

// Track local variables (need load) vs parameters (use directly)
var llvm_locals *u8 = nil;

// Track if last emitted instruction was a terminator (ret, br)
var llvm_emitted_terminator i64 = 0;

// Current function's return type (for correct return statement emission)
var llvm_current_ret_type *u8 = nil;

func llvm_reset_locals() void {
    llvm_locals = map_new();
}

func llvm_add_local(name *u8, len i64) void {
    var key *u8 = str_dup_n(name, len);
    map_set(llvm_locals, key, 1);
}

func llvm_is_local(name *u8, len i64) i64 {
    // Both registries are scoped; the historical name map outlives blocks.
    return find_local(name, len) >= 0 || llvm_find_let_binding(name, len) != nil;
}

// Let binding stack for name remapping (SSA unique names)
// Each entry: [orig_name:8][orig_len:8][unique_name:8][unique_len:8] = 32 bytes
var llvm_let_bindings *u8 = nil;
var llvm_let_depth i64 = 0;
var llvm_let_capacity i64 = 0;

func llvm_init_let_bindings() void {
    llvm_let_capacity = 256;
    llvm_let_bindings = alloc(llvm_let_capacity * 32);
    llvm_let_depth = 0;
}

func llvm_push_let_binding(name *u8, name_len i64, unique *u8, unique_len i64) void {
    // Ordinary locals also use this stack and stay until the function ends.
    // Large functions must not overwrite the registries allocated beside it.
    if llvm_let_depth >= llvm_let_capacity {
        var capacity i64 = llvm_let_capacity * 2;
        var bindings *u8 = alloc(capacity * 32);
        memcpy(bindings, llvm_let_bindings, llvm_let_depth * 32);
        // alloc may be arena-backed; existing entry pointers remain valid.
        llvm_let_bindings = bindings;
        llvm_let_capacity = capacity;
    }
    var entry *u8 = llvm_let_bindings + (llvm_let_depth * 32);
    var p_name **u8 = entry;
    *p_name = name;
    var p_name_len *i64 = entry + 8;
    *p_name_len = name_len;
    var p_unique **u8 = entry + 16;
    *p_unique = unique;
    var p_unique_len *i64 = entry + 24;
    *p_unique_len = unique_len;
    llvm_let_depth = llvm_let_depth + 1;
}

func llvm_pop_let_binding() void {
    if llvm_let_depth > 0 {
        llvm_let_depth = llvm_let_depth - 1;
    }
}

// Look up let binding and return unique name if found
// Returns nil if not found
func llvm_find_let_binding(name *u8, name_len i64) *u8 {
    var i i64 = llvm_let_depth - 1;
    while i >= 0 {
        var entry *u8 = llvm_let_bindings + (i * 32);
        var p_name **u8 = entry;
        var p_name_len *i64 = entry + 8;
        if *p_name_len == name_len {
            var j i64 = 0;
            var same i64 = 1;
            while j < name_len {
                if *(*p_name + j) != *(name + j) {
                    same = 0;
                }
                j = j + 1;
            }
            if same != 0 {
                return entry;  // Return entry pointer (unique name at offset 16)
            }
        }
        i = i - 1;
    }
    return nil;
}

func llvm_let_unique_name(entry *u8) *u8 {
    var p **u8 = entry + 16;
    return *p;
}

func llvm_let_unique_len(entry *u8) i64 {
    var p *i64 = entry + 24;
    return *p;
}

// Global variable table
var llvm_globals *u8 = nil;

func llvm_init_globals() void {
    llvm_globals = map_new();
}

func llvm_add_global(name *u8, len i64) void {
    var key *u8 = str_dup_n(name, len);
    map_set(llvm_globals, key, 1);
}

func llvm_is_global(name *u8, len i64) i64 {
    var key *u8 = str_dup_n(name, len);
    return map_has(llvm_globals, key);
}

// String literal tracking
// Each entry: [ptr:8][len:8] = 16 bytes
var llvm_strings *u8 = nil;
var llvm_string_count i64 = 0;
var llvm_string_capacity i64 = 0;
var llvm_string_index *u8 = nil;

// Lambda registry
// Each entry: [lambda_node:8][lambda_id:8][captures:8][capture_count:8] = 32 bytes
var llvm_lambdas *u8 = nil;
var llvm_lambda_count i64 = 0;
var llvm_lambda_capacity i64 = 0;

func llvm_init_lambdas() void {
    llvm_lambda_capacity = COMPILER_TABLE_INITIAL;
    llvm_lambdas = compiler_table_new(llvm_lambda_capacity, 32);
    llvm_lambda_count = 0;
}

func llvm_init_strings() void {
    llvm_string_capacity = COMPILER_TABLE_INITIAL;
    llvm_strings = compiler_table_new(llvm_string_capacity, 16);
    llvm_string_index = map_new();
    llvm_string_count = 0;
}

// Maps use NUL-terminated keys, while literal identity includes every byte.
// Hex encoding is injective even for embedded NULs and differing lengths.
func llvm_string_key(ptr *u8, len i64) *u8 {
    if len < 0 || len > (COMPILER_TABLE_MAX_BYTES - 1) / 2 {
        phase_error("table-byte-limit", "LLVM string key");
    }
    var key *u8 = compiler_table_new(len * 2 + 1, 1);
    var digits *u8 = "0123456789abcdef";
    var i i64 = 0;
    while i < len {
        var byte u8 = *(ptr + i);
        *(key + i * 2) = *(digits + byte / 16);
        *(key + i * 2 + 1) = *(digits + byte % 16);
        i = i + 1;
    }
    *(key + len * 2) = 0;
    return key;
}

func llvm_add_string(ptr *u8, len i64) i64 {
    var key *u8 = llvm_string_key(ptr, len);
    var found i64 = map_get(llvm_string_index, key);
    if found != 0 { return found - 1; }
    if llvm_string_count >= llvm_string_capacity {
        llvm_strings = compiler_table_grow(llvm_strings, llvm_string_capacity, 16);
        llvm_string_capacity = llvm_string_capacity * 2;
    }
    map_set(llvm_string_index, key, llvm_string_count + 1);

    // Add new string
    var entry *u8 = llvm_strings + (llvm_string_count * 16);
    var entry_ptr **u8 = entry;
    var entry_len *i64 = entry + 8;
    *entry_ptr = ptr;
    *entry_len = len;
    var idx i64 = llvm_string_count;
    llvm_string_count = llvm_string_count + 1;
    return idx;
}

// Calculate processed length of string (handling escape sequences)
func llvm_string_processed_len(ptr *u8, len i64) i64 {
    var result i64 = 0;
    var j i64 = 0;
    while j < len {
        var c u8 = *(ptr + j);
        if c == 92 && j + 1 < len {  // backslash escape
            j = j + 1;  // Skip the next char (the escape code)
        }
        result = result + 1;
        j = j + 1;
    }
    return result;
}

func llvm_emit_all_strings() void {
    var i i64 = 0;
    while i < llvm_string_count {
        var entry *u8 = llvm_strings + (i * 16);
        var ptr **u8 = entry;
        var len *i64 = entry + 8;

        // String is raw content (escapes already processed)
        // @.str0 = private constant [6 x i8] c"hello\00"
        llvm_emit_str("@.str");
        llvm_emit_int(i);
        llvm_emit_str(" = private constant [");
        llvm_emit_int(*len + 1);  // +1 for null terminator
        llvm_emit_str(" x i8] c\"");

        // Emit raw string content - special chars need escapes for LLVM IR
        var j i64 = 0;
        while j < *len {
            var c u8 = *(*ptr + j);
            if c >= 32 && c < 127 && c != 34 && c != 92 {
                // Printable ASCII except quote and backslash
                llvm_emit_char(c);
            } else if c == 34 {
                // Quote: use hex escape
                llvm_emit_str("\\22");
            } else if c == 92 {
                // Backslash: use hex escape
                llvm_emit_str("\\5C");
            } else {
                // Non-printable character - emit hex escape
                llvm_emit_str("\\");
                var hi u8 = c / 16;
                var lo u8 = c % 16;
                if hi < 10 { llvm_emit_char(48 + hi); } else { llvm_emit_char(55 + hi); }
                if lo < 10 { llvm_emit_char(48 + lo); } else { llvm_emit_char(55 + lo); }
            }
            j = j + 1;
        }
        llvm_emit_line("\\00\"");

        i = i + 1;
    }
    if llvm_string_count > 0 {
        llvm_emit_char(10);
    }
}

// Loop stack for break/continue
// Each entry: [name_ptr:8][name_len:8][break_label:8][continue_label:8] = 32 bytes
var llvm_loop_stack *u8 = nil;
var llvm_loop_depth i64 = 0;

func llvm_init_loop_stack() void {
    llvm_loop_stack = alloc(256 * 32);  // Max 256 nested loops
    llvm_loop_depth = 0;
}

func llvm_push_loop_labeled(name *u8, name_len i64, break_label i64, continue_label i64) void {
    var entry *u8 = llvm_loop_stack + (llvm_loop_depth * 32);
    var p_name **u8 = entry;
    *p_name = name;
    var p_len *i64 = entry + 8;
    *p_len = name_len;
    var p_break *i64 = entry + 16;
    *p_break = break_label;
    var p_cont *i64 = entry + 24;
    *p_cont = continue_label;
    llvm_loop_depth = llvm_loop_depth + 1;
}

func llvm_push_loop(break_label i64, continue_label i64) void {
    llvm_push_loop_labeled(nil, 0, break_label, continue_label);
}

func llvm_pop_loop() void {
    llvm_loop_depth = llvm_loop_depth - 1;
}

func llvm_find_loop(name *u8, name_len i64) *u8 {
    // Search from top of stack (innermost loop first)
    var i i64 = llvm_loop_depth - 1;
    while i >= 0 {
        var entry *u8 = llvm_loop_stack + (i * 32);
        var p_name **u8 = entry;
        var entry_name *u8 = *p_name;
        var p_len *i64 = entry + 8;
        var entry_len i64 = *p_len;

        if name == nil {
            // No label specified, return innermost loop
            return entry;
        }
        if entry_name != nil && entry_len == name_len {
            // Compare names
            var is_match i64 = 1;
            var j i64 = 0;
            while j < name_len {
                if *(name + j) != *(entry_name + j) {
                    is_match = 0;
                }
                j = j + 1;
            }
            if is_match == 1 {
                return entry;
            }
        }
        i = i - 1;
    }
    return nil;
}

func llvm_loop_break_label(entry *u8) i64 {
    var p *i64 = entry + 16;
    return *p;
}

func llvm_loop_continue_label(entry *u8) i64 {
    var p *i64 = entry + 24;
    return *p;
}

// Function table: track return types (1=void, 0=non-void)
var llvm_func_ret_types *u8 = nil;

func llvm_is_void_type(t *u8) i64 {
    if t == nil {
        return 1;
    }
    if type_kind(t) == TYPE_BASE {
        var name *u8 = base_type_name(t);
        var len i64 = base_type_name_len(t);
        if len == 4 {
            if memcmp(name, "void", 4) {
                return 1;
            }
        }
    }
    return 0;
}

func llvm_init_func_table() void {
    llvm_func_ret_types = map_new();
}

func llvm_is_bool_type(t *u8) i64 {
    if t == nil {
        return 0;
    }
    if type_kind(t) == TYPE_BASE {
        var name *u8 = base_type_name(t);
        var len i64 = base_type_name_len(t);
        if len == 4 {
            if memcmp(name, "bool", 4) {
                return 1;
            }
        }
    }
    return 0;
}

