// Lang's explicit generic syntax. Index local templates before parsing and
// follow ordinary includes on demand. Only concrete AST leaves the reader.
struct LangGenericTemplate {
    kind i64;
    start i64;
    signature i64;
    end i64;
    name *u8;
    params *u8;
    visible i64;
    source *LangGenericSource;
}

struct LangGenericSource {
    tokens *u8;
    text *u8;
    id i64;
    included i64;
    templates *u8;
    includes *u8;
}

struct LangGenerics {
    source *LangGenericSource;
    sources *u8;
    load_include fn(*u8) *u8;
    stage *GenericStage;
    template *LangGenericTemplate;
    args *u8;
    validating bool;
    closing bool;
    angle_depth i64;
    depth i64;
}

var parse_generics *LangGenerics = nil;

func parse_generic_error(tok *u8, message *u8) void {
    parse_error_at(tok, message);
    exit(1);
}

func parse_generic_base_token(kind i64) bool {
    return kind == TOKEN_IDENT || kind == TOKEN_VOID ||
           (kind >= TOKEN_I8 && kind <= TOKEN_BOOL) ||
           kind == TOKEN_F32 || kind == TOKEN_F64;
}

func parse_generic_begin(inherited *u8, load_include fn(*u8) *u8) *LangGenerics {
    var source *LangGenericSource = parse_generic_index(load_include != nil);
    if source.templates == nil && source.includes == nil { return nil; }

    phase_charge(72);
    var state *LangGenerics = alloc(72);
    state.source = source;
    state.sources = nil;
    state.load_include = load_include;
    state.stage = generic_stage_new(inherited);
    state.template = nil;
    state.args = nil;
    state.validating = false;
    state.closing = false;
    state.angle_depth = 0;
    state.depth = 0;
    return state;
}

func parse_generic_index(index_includes bool) *LangGenericSource {
    phase_charge(48);
    var source *LangGenericSource = alloc(48);
    source.tokens = parse_tokens;
    source.text = lex_source;
    source.id = phase_bound_source_id;
    source.included = phase_include_origin;
    source.templates = nil;
    source.includes = nil;
    var nesting i64 = 0;
    var saved_current i64 = parse_current;
    var i i64 = saved_current;
    var kind i64 = 0;
    while i + 2 < parser_token_count() {
        kind = tok_type(get_token(i));
        if nesting == 0 && (kind == TOKEN_FUNC || kind == TOKEN_STRUCT) {
            if tok_type(get_token(i + 1)) == TOKEN_IDENT && tok_type(get_token(i + 2)) == TOKEN_LT {
                if source.templates == nil { source.templates = map_new(); }
                i = parse_generic_index_template(source, i, kind);
                continue;
            }
        }
        if index_includes && nesting == 0 && kind == TOKEN_INCLUDE && tok_type(get_token(i + 1)) == TOKEN_STRING {
            if source.includes == nil { source.includes = vec_new(8); }
            vec_push(source.includes, i);
            i = i + 2;
            continue;
        }
        nesting = nesting + phase_token_nesting(kind);
        if kind == TOKEN_DOLLAR_LBRACE { nesting = nesting + 1; }
        i = i + 1;
    }
    parse_current = saved_current;
    return source;
}

func parse_generic_index_template(source *LangGenericSource, start i64, kind i64) i64 {
    var name_tok *u8 = get_token(start + 1);
    var name *u8 = str_dup_n(tok_lexeme(name_tok), tok_lexeme_len(name_tok));
    if map_has(source.templates, name) {
        parse_generic_error(name_tok, "duplicate generic declaration");
    }
    if start > 0 && tok_type(get_token(start - 1)) == TOKEN_EXTERN {
        parse_generic_error(name_tok, "extern functions cannot be generic");
    }

    parse_current = start + 3;
    var params *u8 = vec_new(8);
    while true {
        var param_tok *u8 = parse_peek();
        if !parse_match(TOKEN_IDENT) { parse_generic_error(param_tok, "expected type parameter name"); }
        var param *u8 = str_dup_n(tok_lexeme(param_tok), tok_lexeme_len(param_tok));
        var p i64 = 0;
        while p < vec_len(params) {
            if streq(vec_get(params, p), param) { parse_generic_error(param_tok, "duplicate type parameter"); }
            p = p + 1;
        }
        vec_push(params, param);
        if !parse_match(TOKEN_COMMA) { break; }
    }
    if !parse_match(TOKEN_GT) { parse_generic_error(parse_peek(), "expected '>' after type parameters"); }
    var signature i64 = parse_current;
    while !parse_check(TOKEN_LBRACE) {
        var kind_at_cursor i64 = tok_type(parse_peek());
        if kind_at_cursor == TOKEN_EOF || kind_at_cursor == TOKEN_ERROR ||
           kind_at_cursor == TOKEN_SEMICOLON || kind_at_cursor == TOKEN_RBRACE {
            parse_generic_error(parse_peek(), "expected generic declaration body");
        }
        parse_advance();
    }
    parse_advance();
    var braces i64 = 1;
    while braces > 0 {
        var body_kind i64 = tok_type(parse_peek());
        if body_kind == TOKEN_EOF || body_kind == TOKEN_ERROR {
            parse_generic_error(parse_peek(), "expected '}' after generic declaration body");
        }
        if body_kind == TOKEN_LBRACE || body_kind == TOKEN_DOLLAR_LBRACE { braces = braces + 1; }
        if body_kind == TOKEN_RBRACE { braces = braces - 1; }
        parse_advance();
    }

    phase_charge(64);
    var templ *LangGenericTemplate = alloc(64);
    templ.kind = kind;
    templ.start = start;
    templ.signature = signature;
    templ.end = parse_current;
    templ.name = name;
    templ.params = params;
    templ.visible = start > 0 && tok_type(get_token(start - 1)) == TOKEN_PUB;
    templ.source = source;
    map_set(source.templates, name, templ);
    return templ.end;
}

func parse_generic_use_source(source *LangGenericSource) void {
    var record *PhaseSource = phase_source_get(source.id);
    parse_tokens = source.tokens;
    lex_source = source.text;
    lex_source_len = record.len;
    parse_source_name = record.name;
    phase_diagnostic_source = record.name;
    phase_bound_source_id = source.id;
    phase_include_origin = source.included;
}

func parse_generic_include(source *LangGenericSource, index i64, name *u8) *LangGenericSource {
    var state *LangGenerics = parse_generics;
    if state.sources == nil { state.sources = map_new(); }
    if map_has(state.sources, name) { return map_get(state.sources, name); }

    var imported *LangGenericSource = nil;
    var text *u8 = state.load_include(name);
    if text != nil {
        var include_tok *u8 = vec_get(source.tokens, index);
        var record *PhaseSource = phase_source_get(source.id);
        var start i64 = phase_line_byte(record, tok_line(include_tok), tok_col(include_tok));
        var current i64 = parse_current;
        var errors i64 = parse_error_count;
        // The static include chain belongs to the definition. The specialization
        // separately records the expansion origin of its requesting use.
        phase_include_origin = phase_origin_new(source.id, start, start + tok_lexeme_len(include_tok),
                                                source.included, 0);
        parser_set_source_name(name);
        parser_tokenize(text);
        imported = parse_generic_index(true);
        parse_generic_use_source(state.source);
        parse_current = current;
        parse_error_count = errors;
    }
    map_set(state.sources, name, imported);
    return imported;
}

func parse_generic_local(source *LangGenericSource, tok *u8) *LangGenericTemplate {
    if source.templates == nil { return nil; }
    return map_get_n(source.templates, tok_lexeme(tok), tok_lexeme_len(tok));
}

func parse_generic_search(source *LangGenericSource, tok *u8, seen *u8, depth i64) *LangGenericTemplate {
    var found *LangGenericTemplate = parse_generic_local(source, tok);
    if found != nil || source.includes == nil { return found; }
    if depth >= LIMIT_INCLUDE_DEPTH { return nil; }

    var i i64 = 0;
    while i < vec_len(source.includes) {
        var index i64 = vec_get(source.includes, i);
        var path_tok *u8 = vec_get(source.tokens, index + 1);
        var name *u8 = parse_string_literal(tok_lexeme(path_tok), tok_lexeme_len(path_tok));
        if !map_has(seen, name) {
            map_set(seen, name, 1);
            var imported *LangGenericSource = parse_generic_include(source, index, name);
            if imported != nil {
                found = parse_generic_search(imported, tok, seen, depth + 1);
                if found != nil { return found; }
            }
        }
        i = i + 1;
    }
    return nil;
}

func parse_generic_lookup(tok *u8) *LangGenericTemplate {
    if parse_generics == nil { return nil; }
    var state *LangGenerics = parse_generics;
    var source *LangGenericSource = state.source;
    var found *LangGenericTemplate = parse_generic_local(source, tok);
    if found != nil || source.includes == nil || state.load_include == nil { return found; }
    var seen *u8 = map_new();
    map_set(seen, parse_source_name, 1);
    found = parse_generic_search(source, tok, seen, 0);
    map_free(seen);
    return found;
}

func parse_generic_binding(tok *u8) *u8 {
    if parse_generics == nil || parse_generics.args == nil { return nil; }
    var params *u8 = parse_generics.template.params;
    var i i64 = 0;
    while i < vec_len(params) {
        if buf_eq_str(tok_lexeme(tok), tok_lexeme_len(tok), vec_get(params, i)) {
            return vec_get(parse_generics.args, i);
        }
        i = i + 1;
    }
    return nil;
}

// A declared generic name followed by a type list and '(' denotes a call.
// Leave comparison and shift tokens alone everywhere else.
func parse_generic_call_ahead() bool {
    var i i64 = parse_current + 1;
    var depth i64 = 1;
    var kind i64 = 0;
    while i + 1 < parser_token_count() {
        kind = tok_type(get_token(i));
        if kind == TOKEN_LT { depth = depth + 1; }
        else if kind == TOKEN_GT { depth = depth - 1; }
        else if kind == TOKEN_GTGT { depth = depth - 2; }
        else if !parse_generic_base_token(kind) &&
                kind != TOKEN_STAR && kind != TOKEN_COMMA && kind != TOKEN_FN &&
                kind != TOKEN_CLOSURE && kind != TOKEN_LPAREN && kind != TOKEN_RPAREN &&
                kind != TOKEN_LBRACKET && kind != TOKEN_RBRACKET && kind != TOKEN_NUMBER {
            return false;
        }
        if depth <= 0 {
            return depth == 0 && tok_type(get_token(i + 1)) == TOKEN_LPAREN;
        }
        i = i + 1;
    }
    return false;
}

// Encode the concrete type tree. Prefix tags and lengths make the key
// unambiguous, independent of whitespace and the spelling of array lengths.
func parse_generic_type_key(key *PhaseBuffer, t *u8) void {
    var kind i64 = node_kind(t);
    if kind == TYPE_BASE {
        phase_buffer_text(key, "B");
        phase_buffer_int(key, base_type_name_len(t));
        phase_buffer_text(key, ":");
        phase_buffer_append(key, base_type_name(t), base_type_name_len(t));
    } else if kind == TYPE_PTR {
        phase_buffer_text(key, "P");
        parse_generic_type_key(key, ptr_type_elem(t));
    } else if kind == TYPE_ARRAY {
        phase_buffer_text(key, "A");
        phase_buffer_int(key, array_type_size(t));
        phase_buffer_text(key, ":");
        parse_generic_type_key(key, array_type_elem(t));
    } else {
        var params *u8 = nil;
        var ret *u8 = nil;
        if kind == TYPE_FUNC {
            phase_buffer_text(key, "F");
            params = func_type_params(t);
            ret = func_type_ret(t);
        } else {
            phase_buffer_text(key, "C");
            params = closure_type_params(t);
            ret = closure_type_ret(t);
        }
        var i i64 = 0;
        phase_buffer_int(key, vec_len(params));
        phase_buffer_text(key, ":");
        while i < vec_len(params) {
            parse_generic_type_key(key, vec_get(params, i));
            i = i + 1;
        }
        parse_generic_type_key(key, ret);
    }
}

func parse_generic_request(templ *LangGenericTemplate, name_tok *u8) *u8 {
    var state *LangGenerics = parse_generics;
    var angle *u8 = parse_advance();
    state.angle_depth = state.angle_depth + 1;
    var args *u8 = vec_new(8);
    if !parse_check(TOKEN_GT) && !parse_check(TOKEN_GTGT) {
        var errors i64 = parse_error_count;
        while true {
            if parse_is_at_end() { parse_generic_error(parse_peek(), "expected type argument"); }
            vec_push(args, parse_type());
            if parse_error_count != errors { exit(1); }
            if state.closing || !parse_match(TOKEN_COMMA) { break; }
        }
    }

    // Within type arguments only, >> can close two nested applications.
    if state.closing {
        state.closing = false;
    } else if !parse_match(TOKEN_GT) {
        if state.angle_depth == 1 || !parse_match(TOKEN_GTGT) {
            parse_generic_error(parse_peek(), "expected '>' after type arguments");
        }
        state.closing = true;
    }
    state.angle_depth = state.angle_depth - 1;
    if vec_len(args) != vec_len(templ.params) {
        parse_generic_error(angle, "wrong number of type arguments");
    }
    if state.validating { return templ.name; }

    var key *PhaseBuffer = phase_buffer_new(phase_limit(), parse_source_name);
    var definition *PhaseSource = phase_source_get(templ.source.id);
    phase_buffer_field(key, definition.name);
    phase_buffer_field(key, definition.digest);
    phase_buffer_field(key, templ.name);
    var i i64 = 0;
    while i < vec_len(args) {
        parse_generic_type_key(key, vec_get(args, i));
        i = i + 1;
    }
    var source *PhaseSource = phase_source_get(phase_bound_source_id);
    var start i64 = phase_line_byte(source, tok_line(name_tok), tok_col(name_tok));
    var end i64 = start + tok_lexeme_len(name_tok);
    var origin i64 = phase_origin_new(phase_bound_source_id, start, end, phase_include_origin, phase_expansion_origin);
    return generic_stage_request(state.stage, key, templ, args, origin, state.depth + 1, phase_depth_limit());
}

func parse_generic_declaration(templ *LangGenericTemplate) *u8 {
    parse_current = templ.signature;
    var name_tok *u8 = get_token(templ.start + 1);
    if templ.kind == TOKEN_FUNC { return parse_func_after_name(name_tok, 0); }
    return parse_struct_after_name(name_tok);
}

func parse_generic_validate(templ *LangGenericTemplate) void {
    parse_generics.validating = true;
    parse_generic_declaration(templ);
    parse_generics.validating = false;
    parse_current = templ.end;
}

func parse_generic_materialize(instance *GenericInstance) *u8 {
    var state *LangGenerics = parse_generics;
    var templ *LangGenericTemplate = instance.template;
    var saved_source *LangGenericSource = state.source;
    var saved_current i64 = parse_current;
    var saved_origin i64 = phase_expansion_origin;
    phase_expansion_origin = instance.origin;
    state.source = templ.source;
    parse_generic_use_source(templ.source);
    state.template = templ;
    state.args = instance.args;
    state.depth = instance.depth;
    var decl *u8 = parse_generic_declaration(templ);
    if decl != nil {
        var len i64 = strlen(instance.name);
        if templ.kind == TOKEN_FUNC {
            func_decl_set_name(decl, instance.name);
            func_decl_set_name_len(decl, len);
            func_decl_set_is_pub(decl, templ.visible);
        } else {
            struct_decl_set_name(decl, instance.name);
            struct_decl_set_name_len(decl, len);
            struct_decl_set_is_pub(decl, templ.visible);
        }
        var start *u8 = get_token(templ.start);
        node_set_origin(decl, parse_source_name, tok_line(start), tok_col(start));
    }
    state.template = nil;
    state.args = nil;
    state.depth = 0;
    state.source = saved_source;
    parse_generic_use_source(saved_source);
    parse_current = saved_current;
    phase_expansion_origin = saved_origin;
    return decl;
}

func parse_generic_at_declaration() bool {
    if parse_generics == nil || !parse_check(TOKEN_IDENT) { return false; }
    var templ *LangGenericTemplate = parse_generic_local(parse_generics.source, parse_peek());
    if templ == nil || templ.start + 1 != parse_current { return false; }
    parse_generic_validate(templ);
    return true;
}
