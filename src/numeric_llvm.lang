    llvm_emit_str(", label %L"); llvm_emit_int(ok); llvm_emit_char(10);
    llvm_emit_str("L"); llvm_emit_int(fail); llvm_emit_line(":");
    llvm_emit_line("    call void @llvm.trap()"); llvm_emit_line("    unreachable");
