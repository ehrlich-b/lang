// Exact values cross the legacy expression boundary as sign/zero-extended i64
// or double. All arithmetic and rounding happen at the declared core width.
func llvm_numeric_declarations() void {
    llvm_emit_line("declare void @llvm.trap() cold noreturn nounwind");
    llvm_emit_line("declare double @llvm.trunc.f64(double)");
