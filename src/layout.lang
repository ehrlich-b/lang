// Scalar storage admission and target object layout. No enum or call ABI.
// A failed query always clears every output field; callers must check status.
include "src/numeric_types.lang"

struct StorageLayout { size i64; alignment i64; stride i64; }
var LAYOUT_OK i64 = 0;
var LAYOUT_PROFILE i64 = 1;
var LAYOUT_UNSUPPORTED i64 = 2;
var LAYOUT_RELOCATION i64 = 3;
var LAYOUT_COUNT i64 = 4;
var LAYOUT_OVERFLOW i64 = 5;

func layout_limit(profile *u8) i64 {
    if profile == nil { return 0; }
    if streq(profile, "llvm-linux-x86_64") || streq(profile, "llvm-darwin-aarch64") { return 9223372036854775807; }
    if streq(profile, "llvm-wasm32") { return 4294967295; }
    return 0;
}

func layout_target_profile(triple *u8) *u8 {
    if triple == nil { return nil; }
    if streq(triple, "x86_64-linux-gnu") { return "llvm-linux-x86_64"; }
    if streq(triple, "aarch64-apple-darwin") { return "llvm-darwin-aarch64"; }
    if streq(triple, "wasm32-unknown-unknown") { return "llvm-wasm32"; }
    return nil;
}

func layout_scalar_bytes(t *u8) i64 {
    if t == nil || type_kind(t) != TYPE_BASE { return 0; }
    var name *u8 = str_dup_n(base_type_name(t), base_type_name_len(t));
    if streq(name, "bool") { return 1; }
    return numeric_bits(name) / 8;
}

// Select the bounded storage tranche, independently of array count validity.
// Legacy aggregate/pointer consumers must not mistake this for ABI admission.
func layout_is_scalar_storage(t *u8) i64 {
    if t == nil { return 0; }
    if type_kind(t) == TYPE_ARRAY { return layout_is_scalar_storage(array_type_elem(t)); }
    return layout_scalar_bytes(t) != 0;
}

func layout_query(t *u8, profile *u8, out *StorageLayout) i64 {
    out.size = 0; out.alignment = 0; out.stride = 0;
    var limit i64 = layout_limit(profile);
    if limit == 0 { return LAYOUT_PROFILE; }
    if t == nil { return LAYOUT_UNSUPPORTED; }
    var kind i64 = type_kind(t);
    if kind == TYPE_PTR || kind == TYPE_FUNC || kind == TYPE_CLOSURE { return LAYOUT_RELOCATION; }
    if kind == TYPE_ARRAY {
        var count i64 = array_type_size(t);
        if count < 0 { return LAYOUT_COUNT; }
        var element StorageLayout;
        var status i64 = layout_query(array_type_elem(t), profile, &element);
        if status != LAYOUT_OK { return status; }
        // Divide before multiplying. Even a zero-sized element cannot admit a
        // count outside the target's address domain.
        if count > limit { return LAYOUT_OVERFLOW; }
        if element.stride != 0 {
            if count > limit / element.stride { return LAYOUT_OVERFLOW; }
        }
        out.size = count * element.stride;
        out.alignment = element.alignment;
        out.stride = out.size;
        return LAYOUT_OK;
    }
    var size i64 = layout_scalar_bytes(t);
    if size == 0 { return LAYOUT_UNSUPPORTED; }
    out.size = size; out.alignment = size; out.stride = size;
    return LAYOUT_OK;
}

func layout_error(status i64) *u8 {
    if status == LAYOUT_PROFILE { return "unsupported target profile"; }
    if status == LAYOUT_RELOCATION { return "pointer/function relocation storage is not supported"; }
    if status == LAYOUT_COUNT { return "negative fixed-array count"; }
    if status == LAYOUT_OVERFLOW { return "fixed-array storage exceeds target size limit"; }
    return "unsupported storage type (expected scalar or fixed array of scalars)";
}

// Target object layout, separate from the scalar-only storage admission above.
// Declarations are supplied by the caller so this service owns no reader rules.
func layout_struct(t *u8, decls *u8, count i64) *u8 {
    if t == nil || type_kind(t) != TYPE_BASE { return nil; }
    var i i64 = 0;
    while i < count {
        var slot **u8 = decls + i * 8;
        var d *u8 = *slot;
        if base_type_name_len(t) == struct_decl_name_len(d) {
            var j i64 = 0;
            while j < base_type_name_len(t) && *(base_type_name(t) + j) == *(struct_decl_name(d) + j) { j = j + 1; }
            if j == base_type_name_len(t) { return d; }
        }
        i = i + 1;
    }
    return nil;
}

func layout_align(size i64, alignment i64) i64 {
    return ((size + (alignment - 1)) / alignment) * alignment;
}

func layout_target_query(t *u8, profile *u8, decls *u8, count i64,
                         depth i64, out *StorageLayout) i64 {
    out.size = 0; out.alignment = 0; out.stride = 0;
    var limit i64 = layout_limit(profile);
    if limit == 0 { return LAYOUT_PROFILE; }
    if t == nil || depth > 64 { return LAYOUT_UNSUPPORTED; }
    var result StorageLayout;
    var kind i64 = type_kind(t);
    if kind == TYPE_PTR {
        result.size = 8;
        if streq(profile, "llvm-wasm32") { result.size = 4; }
        result.alignment = result.size;
    } else if kind == TYPE_ARRAY {
        var n i64 = array_type_size(t);
        if n < 0 { return LAYOUT_COUNT; }
        var element StorageLayout;
        var status i64 = layout_target_query(array_type_elem(t), profile, decls, count, depth + 1, &element);
        if status != LAYOUT_OK { return status; }
        if n > limit || (element.stride != 0 && n > limit / element.stride) { return LAYOUT_OVERFLOW; }
        result.size = n * element.stride;
        result.alignment = element.alignment;
    } else {
        var d *u8 = layout_struct(t, decls, count);
        if d == nil { return layout_query(t, profile, out); }
        result.size = 0; result.alignment = 1;
        var i i64 = 0;
        while i < struct_decl_field_count(d) {
            var field *u8 = get_struct_field(struct_decl_fields(d), i);
            var element StorageLayout;
            var status i64 = layout_target_query(struct_field_type(field), profile, decls, count, depth + 1, &element);
            if status != LAYOUT_OK { return status; }
            if result.size > limit - (element.alignment - 1) { return LAYOUT_OVERFLOW; }
            result.size = layout_align(result.size, element.alignment);
            if result.size > limit - element.size { return LAYOUT_OVERFLOW; }
            result.size = result.size + element.size;
            if element.alignment > result.alignment { result.alignment = element.alignment; }
            i = i + 1;
        }
        if result.size > limit - (result.alignment - 1) { return LAYOUT_OVERFLOW; }
        result.size = layout_align(result.size, result.alignment);
    }
    out.size = result.size; out.alignment = result.alignment; out.stride = result.size;
    return LAYOUT_OK;
}

func layout_target_field_offset(d *u8, index i64, profile *u8,
                                decls *u8, count i64) i64 {
    var limit i64 = layout_limit(profile);
    if limit == 0 || d == nil || index < 0 || index >= struct_decl_field_count(d) { return -1; }
    var offset i64 = 0;
    var i i64 = 0;
    while i <= index {
        var field *u8 = get_struct_field(struct_decl_fields(d), i);
        var element StorageLayout;
        if layout_target_query(struct_field_type(field), profile, decls, count, 0, &element) != LAYOUT_OK { return -1; }
        if offset > limit - (element.alignment - 1) { return -1; }
        offset = layout_align(offset, element.alignment);
        if i == index { return offset; }
        if offset > limit - element.size { return -1; }
        offset = offset + element.size;
        i = i + 1;
    }
    return -1;
}
