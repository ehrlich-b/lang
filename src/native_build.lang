// Project orchestration over the shared compiler-host driver.
include "src/native_host.lang"

// Each compiler phase gets a process boundary so an inherited fatal diagnostic
// cannot bypass driver cleanup or lose its stage. stderr is inherited verbatim.
func native_build_phase_run(stage i64, project *LanguageProject, source *u8,
                        work *u8) i64 {
    var ast *u8 = str_concat(work, "/guest.ast");
    var ir *u8 = str_concat(work, "/guest.ll");
    var pid i64 = os_fork();
    if pid != 0 {
        var name *u8 = "reader";
        if stage == 1 { name = "validation"; }
        if stage == 2 { name = "LLVM emission"; }
        return native_build_wait(pid, name);
    }
    if stage == 0 {
        var readers *u8 = vec_new(1);
        vec_push(readers, project_field(project, "reader_source"));
        if read_prepare_readers(readers) == 0 { os__exit(1); }
        var content *u8 = read_file(source);
        if content == nil { os__exit(1); }
        var text *u8 = read_run_reader_raw(project_field(project, "reader_name"), source, content);
        if text == nil {
            if phase_worker_status < 0 { os__exit(0 - phase_worker_status); }
            os__exit(1);
        }
        os__exit(native_build_write(ast, text));
    }
    if stage == 1 {
        var text *u8 = read_file(ast);
        var content *u8 = read_file(source);
        if text == nil || content == nil { os__exit(1); }
        if parse_ast_from_reader_string(text, source, content) == nil { os__exit(1); }
        os__exit(native_build_write(str_concat(work, "/formatted.ast"), read_ast_format(text)));
    }
    var arguments *u8 = vec_new(16);
    vec_push(arguments, phase_compiler_path); vec_push(arguments, "--from-ast");
    vec_push(arguments, ast); vec_push(arguments, "--ast-source"); vec_push(arguments, source);
    var i i64 = 0;
    while i < vec_len(project.runtimes) {
        vec_push(arguments, "--runtime"); vec_push(arguments, vec_get(project.runtimes, i)); i = i + 1;
    }
    vec_push(arguments, "-o"); vec_push(arguments, ir);
    os__exit(main_dispatch(vec_len(arguments), project_argv(arguments)));
    return 1;
}

// Optional machine timings are emitted by the parent of each completed phase.
extern func clock_gettime(clock i64, value *u8) i64;
func native_build_nanoseconds() i64 {
    var stamp *u8 = alloc(16);
    if clock_gettime(1, stamp) != 0 { return 0; }
    var seconds *i64 = stamp;
    var nanos *i64 = stamp + 8;
    return *seconds * 1000000000 + *nanos;
}

func native_build_phase(stage i64, project *LanguageProject, source *u8,
                        work *u8) i64 {
    var start i64 = native_build_nanoseconds();
    var result i64 = native_build_phase_run(stage, project, source, work);
    var elapsed i64 = native_build_nanoseconds() - start;
    var enabled *u8 = getenv("LANG_TEST_TIMINGS");
    if enabled != nil && streq(enabled, "1") {
        eprint("Native phase "); eprint_i64(stage); eprint(" nanoseconds ");
        eprint_i64(elapsed); eprint(" exit "); eprint_i64(result); eprintln("");
    }
    return result;
}

func native_build_pipeline(manifest *u8, source *u8, work *u8, emit *u8) i64 {
    var pid i64 = os_fork();
    if pid != 0 { return native_build_wait(pid, "manifest/pipeline"); }
    var project *LanguageProject = project_load(manifest);
    var extension *u8 = get_extension(source);
    if extension == nil { eprintln("Error: build source suffix must match project reader"); os__exit(1); }
    if !streq(extension, project_field(project, "reader_name")) {
        eprintln("Error: build source suffix must match project reader"); os__exit(1);
    }
    if native_build_profile(source, LANG_BUILD_ARCH) != 0 { os__exit(1); }
    cg_langos_override = "linux";
    var result i64 = native_build_phase(0, project, source, work);
    if result == 0 { result = native_build_phase(1, project, source, work); }
    if result == 0 && !streq(emit, "ast") { result = native_build_phase(2, project, source, work); }
    if result != 0 || !streq(emit, "native") { os__exit(result); }
    os__exit(native_build_link(work, source, project_field(project, "native_toolchain")));
    return 1;
}

func cmd_help_native_build() i64 {
    println("lang build --project PROJECT SOURCE -o OUTPUT [--emit=native|ast|llvm]");
    println("Native Linux x86-64; default optimization -O0; tool: LANG_CLANG or clang in PATH.");
    println("Use a fresh output path or a previous native ELF output; failed rebuilds invalidate it.");
    return 0;
}

func cmd_native_build(argc i64, argv **u8) i64 {
    if argc == 3 {
        if streq(get_arg(argv, 2), "--help") || streq(get_arg(argv, 2), "-h") { return cmd_help_native_build(); }
    }
    if !streq(os_platform_name(), "linux") || !streq(LANG_BUILD_ARCH, "x86_64") {
        eprintln("Error: native build requires a Linux x86-64 host"); return 1;
    }
    var manifest *u8 = nil;
    var source *u8 = nil;
    var output *u8 = nil;
    var emit *u8 = "native";
    var invalid_emit i64 = 0;
    var invalid_argument i64 = 0;
    var seen_emit i64 = 0;
    var seen_output i64 = 0;
    var seen_project i64 = 0;
    var i i64 = 2;
    while i < argc {
        var arg *u8 = get_arg(argv, i);
        if streq(arg, "--project") || streq(arg, "-o") {
            var duplicate i64 = 0;
            if streq(arg, "--project") {
                if seen_project != 0 { eprintln("Error: duplicate --project"); duplicate = 1; }
                seen_project = 1;
            } else {
                if seen_output != 0 { eprintln("Error: duplicate -o"); duplicate = 1; }
                seen_output = 1;
            }
            if duplicate != 0 { invalid_argument = 1; }
            if i + 1 >= argc || *get_arg(argv, i + 1) == '-' {
                eprintln("Error: build option needs a path"); invalid_argument = 1;
            } else {
                i = i + 1;
                if duplicate == 0 {
                    if streq(arg, "--project") { manifest = get_arg(argv, i); }
                    else { output = get_arg(argv, i); }
                }
            }
        } else if str_starts_with(arg, "--emit=") {
            if seen_emit != 0 { eprintln("Error: duplicate --emit"); invalid_argument = 1; }
            seen_emit = 1;
            emit = arg + 7;
            if native_build_emit_valid(emit, 1) == 0 {
                invalid_emit = 1;
            }
        } else if *arg == '-' || source != nil {
            eprintln("Error: unknown build option or extra source"); invalid_argument = 1;
        } else { source = arg; }
        i = i + 1;
    }
    if manifest == nil || source == nil || output == nil || *output == 0 {
        eprintln("Usage: lang build --project PROJECT SOURCE -o OUTPUT [--emit=native|ast|llvm]"); invalid_argument = 1;
    }
    if output == nil || *output == 0 { return 1; }
    var inputs *u8 = vec_new(2);
    if source != nil { vec_push(inputs, source); }
    if manifest != nil { vec_push(inputs, manifest); }
    if native_build_prepare_output(output, inputs) != 0 { return 1; }
    if invalid_emit != 0 { eprintln("Error: build --emit must be native, ast or llvm"); }
    if invalid_argument != 0 || invalid_emit != 0 { return 1; }
    // A private directory next to OUTPUT provides exclusive paths and same-device
    // rename publication, independent of TMPDIR and quoting in file operands.
    var work *u8 = mkdtemp(str_concat(output, ".lang-build-XXXXXX"));
    if work == nil { eprintln("Error: cannot reserve native build directory"); return 1; }
    var result i64 = native_build_pipeline(manifest, source, work, emit);
    var artifact *u8 = str_concat(work, "/program");
    if streq(emit, "ast") { artifact = str_concat(work, "/formatted.ast"); }
    if streq(emit, "llvm") { artifact = str_concat(work, "/guest.ll"); }
    result = native_build_publish(work, artifact, output, result);
    if result == 0 { print("Built "); println(output); }
    return result;
}
