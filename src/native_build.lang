// Compiler-host orchestration. Readers own language semantics; the driver only
// coordinates manifest inputs, validated core, LLVM and the native toolchain.
extern func mkdtemp(template *u8) *u8;
extern func realpath(path *u8, resolved *u8) *u8;
extern func lstat(path *u8, buffer *u8) i64;

func native_build_wait(pid i64, stage *u8) i64 {
    var result i64 = 1;
    if pid > 0 {
        var status i64 = 0;
        if os_waitpid(pid, &status, 0) == pid { result = process_status_code(status); }
    }
    if result != 0 {
        eprint("Error: native build "); eprint(stage); eprint(" failed (exit ");
        eprint_i64(result); eprintln(")");
    }
    return result;
}

func native_build_same_file(left *u8, right *u8) i64 {
    var a *u8 = realpath(left, nil);
    var b *u8 = realpath(right, nil);
    if a == nil || b == nil { return streq(left, right); }
    return streq(a, b);
}

func native_build_write(path *u8, text *u8) i64 {
    var fd i64 = file_open(path, O_WRONLY_CREAT_EXCL);
    if fd < 0 { eprint("Error: cannot create "); eprintln(path); return 1; }
    var ok i64 = file_write_all(fd, text);
    if os_close(fd) != 0 { ok = 0; }
    if ok == 0 { eprint("Error: cannot finish "); eprintln(path); return 1; }
    return 0;
}

// Each compiler phase gets a process boundary so an inherited fatal diagnostic
// cannot bypass driver cleanup or lose its stage. stderr is inherited verbatim.
func native_build_phase(stage i64, project *LanguageProject, source *u8,
                        work *u8, tool *u8) i64 {
    var ast *u8 = str_concat(work, "/guest.ast");
    var ir *u8 = str_concat(work, "/guest.ll");
    var object *u8 = str_concat(work, "/guest.o");
    if stage == 3 { return exec_run(tool, "-O0", "-c", ir, "-o", object, nil); }
    if stage == 4 { return exec_run(tool, object, "-o", str_concat(work, "/program"), nil, nil, nil); }
    var pid i64 = os_fork();
    if pid != 0 {
        var name *u8 = "reader";
        if stage == 1 { name = "validation"; }
        if stage == 2 { name = "LLVM emission"; }
        return native_build_wait(pid, name);
    }
    if stage == 0 {
        var readers *u8 = vec_new(1);
        vec_push(readers, project_field(project, "reader_source"));
        if read_prepare_readers(readers) == 0 { os__exit(1); }
        var content *u8 = read_file(source);
        if content == nil { os__exit(1); }
        var text *u8 = read_run_reader_raw(project_field(project, "reader_name"), source, content);
        if text == nil { os__exit(1); }
        os__exit(native_build_write(ast, text));
    }
    if stage == 1 {
        var text *u8 = read_file(ast);
        var content *u8 = read_file(source);
        if text == nil || content == nil { os__exit(1); }
        if parse_ast_from_reader_string(text, source, content) == nil { os__exit(1); }
        os__exit(native_build_write(str_concat(work, "/formatted.ast"), read_ast_format(text)));
    }
    var arguments *u8 = vec_new(16);
    vec_push(arguments, phase_compiler_path); vec_push(arguments, "--from-ast");
    vec_push(arguments, ast); vec_push(arguments, "--ast-source"); vec_push(arguments, source);
    var i i64 = 0;
    while i < vec_len(project.runtimes) {
        vec_push(arguments, "--runtime"); vec_push(arguments, vec_get(project.runtimes, i)); i = i + 1;
    }
    vec_push(arguments, "-o"); vec_push(arguments, ir);
    os__exit(main_dispatch(vec_len(arguments), project_argv(arguments)));
    return 1;
}

func native_build_pipeline(manifest *u8, source *u8, work *u8, emit *u8) i64 {
    var pid i64 = os_fork();
    if pid != 0 { return native_build_wait(pid, "manifest/pipeline"); }
    var project *LanguageProject = project_load(manifest);
    var extension *u8 = get_extension(source);
    if extension == nil { eprintln("Error: build source suffix must match project reader"); os__exit(1); }
    if !streq(extension, project_field(project, "reader_name")) {
        eprintln("Error: build source suffix must match project reader"); os__exit(1);
    }
    var target *u8 = getenv("LANGOS");
    if cg_backend_is_llvm() == 0 || (target != nil && !streq(target, "linux")) ||
       !streq(os_platform_name(), "linux") || !streq(LANG_BUILD_ARCH, "x86_64") {
        eprintln("Error: native build requires LANGBE=llvm LANGOS=linux on Linux x86-64"); os__exit(1);
    }
    cg_langos_override = "linux";
    var result i64 = native_build_phase(0, project, source, work, nil);
    if result == 0 { result = native_build_phase(1, project, source, work, nil); }
    if result == 0 && !streq(emit, "ast") { result = native_build_phase(2, project, source, work, nil); }
    if result != 0 || !streq(emit, "native") { os__exit(result); }
    // The manifest selects the toolchain family; LANG_CLANG selects its executable.
    // No shell, implicit flags or fallback to another installation on failure.
    var tool *u8 = getenv("LANG_CLANG");
    if tool == nil || *tool == 0 { tool = find_in_path(project_field(project, "native_toolchain")); }
    if tool == nil { eprintln("Error: native build toolchain: clang not found in PATH"); os__exit(127); }
    eprint("Native build: profile=llvm-linux-x86_64 optimization=-O0 toolchain="); eprintln(tool);
    result = native_build_phase(3, project, source, work, tool);
    if result != 0 { eprintln("Error: native build optimizer/object compilation failed"); os__exit(result); }
    result = native_build_phase(4, project, source, work, tool);
    if result != 0 { eprintln("Error: native build linker failed"); }
    os__exit(result);
    return 1;
}

func cmd_native_build(argc i64, argv **u8) i64 {
    if !streq(os_platform_name(), "linux") || !streq(LANG_BUILD_ARCH, "x86_64") {
        eprintln("Error: native build requires a Linux x86-64 host"); return 1;
    }
    var manifest *u8 = nil;
    var source *u8 = nil;
    var output *u8 = nil;
    var emit *u8 = "native";
    var i i64 = 2;
    while i < argc {
        var arg *u8 = get_arg(argv, i);
        if streq(arg, "--project") || streq(arg, "-o") {
            if i + 1 >= argc { eprintln("Error: build option needs a path"); return 1; }
            i = i + 1;
            if streq(arg, "--project") {
                if manifest != nil { eprintln("Error: duplicate --project"); return 1; }
                manifest = get_arg(argv, i);
            } else {
                if output != nil { eprintln("Error: duplicate -o"); return 1; }
                output = get_arg(argv, i);
            }
        } else if str_starts_with(arg, "--emit=") {
            emit = arg + 7;
            if !streq(emit, "ast") && !streq(emit, "llvm") && !streq(emit, "native") {
                eprintln("Error: build --emit must be native, ast or llvm"); return 1;
            }
        } else if *arg == '-' || source != nil {
            eprintln("Error: unknown build option or extra source"); return 1;
        } else { source = arg; }
        i = i + 1;
    }
    if manifest == nil || source == nil || output == nil || *output == 0 {
        eprintln("Usage: lang build --project PROJECT SOURCE -o OUTPUT [--emit=native|ast|llvm]"); return 1;
    }
    if native_build_same_file(output, source) || native_build_same_file(output, manifest) {
        eprintln("Error: build output would overwrite an input"); return 1;
    }
    // Only replace a prior native executable. Never destroy an unrelated source,
    // symlink or directory supplied accidentally as the destination.
    var info *u8 = alloc(256);
    if lstat(output, info) == 0 {
        var mode *i32 = info + 24; // Linux x86-64 stat.st_mode (the supported profile).
        if (*mode & 61440) != 32768 { eprintln("Error: build output must be a regular file"); return 1; }
        var fd i64 = file_open(output, O_RDONLY);
        var magic *u8 = alloc(4);
        var count i64 = -1;
        if fd >= 0 { count = file_read(fd, magic, 4); file_close(fd); }
        if count != 4 || *magic != 127 || *(magic + 1) != 'E' || *(magic + 2) != 'L' || *(magic + 3) != 'F' {
            eprintln("Error: refusing to replace an existing non-native file"); return 1;
        }
        if os_unlink(output) != 0 { eprintln("Error: cannot invalidate previous build output"); return 1; }
    }
    // A private directory next to OUTPUT provides exclusive paths and same-device
    // rename publication, independent of TMPDIR and quoting in file operands.
    var work *u8 = mkdtemp(str_concat(output, ".lang-build-XXXXXX"));
    if work == nil { eprintln("Error: cannot reserve native build directory"); return 1; }
    var result i64 = native_build_pipeline(manifest, source, work, emit);
    var artifact *u8 = str_concat(work, "/program");
    if streq(emit, "ast") { artifact = str_concat(work, "/formatted.ast"); }
    if streq(emit, "llvm") { artifact = str_concat(work, "/guest.ll"); }
    if result == 0 {
        if rename(artifact, output) != 0 { eprintln("Error: native build publication failed"); result = 1; }
    }
    os_unlink(str_concat(work, "/guest.ast"));
    os_unlink(str_concat(work, "/formatted.ast"));
    os_unlink(str_concat(work, "/guest.ll"));
    os_unlink(str_concat(work, "/guest.o"));
    os_unlink(str_concat(work, "/program"));
    rmdir(work);
    if result == 0 { print("Built "); println(output); }
    return result;
}
