// Shared compiler-host driver for project builds and minted compilers.
// No reader, manifest or language semantics belong in this module.
extern func mkdtemp(template *u8) *u8;
extern func realpath(path *u8, resolved *u8) *u8;
extern func lstat(path *u8, buffer *u8) i64;
extern func fcntl(fd i64, command i64, value i64) i64;

func native_build_wait(pid i64, stage *u8) i64 {
    var result i64 = 1;
    if pid > 0 {
        var status i64 = 0;
        if os_waitpid(pid, &status, 0) == pid { result = process_status_code(status); }
    }
    if result != 0 {
        eprint("Error: native build "); eprint(stage); eprint(" failed (exit ");
        eprint_i64(result); eprintln(")");
    }
    return result;
}

func native_build_same_file(left *u8, right *u8) i64 {
    var a *u8 = realpath(left, nil);
    var b *u8 = realpath(right, nil);
    if a == nil || b == nil { return streq(left, right); }
    return streq(a, b);
}

// A close-on-exec pipe distinguishes an exec failure from a tool that itself
// exits 127. The original tool stderr remains connected to the caller.
func native_build_tool(tool *u8, arg1 *u8, arg2 *u8, arg3 *u8, arg4 *u8, arg5 *u8) i64 {
    var fds *u8 = alloc(8);
    if os_pipe(fds) != 0 { eprintln("Error: native build toolchain pipe failed"); return 1; }
    var read_fd *i32 = fds; var write_fd *i32 = fds + 4;
    if fcntl(*write_fd, 2, 1) != 0 {
        os_close(*read_fd); os_close(*write_fd);
        eprintln("Error: native build toolchain pipe setup failed"); return 1;
    }
    var argv *u8 = alloc(56);
    var a0 **u8 = argv; *a0 = tool;
    var a1 **u8 = argv + 8; *a1 = arg1;
    var a2 **u8 = argv + 16; *a2 = arg2;
    var a3 **u8 = argv + 24; *a3 = arg3;
    var a4 **u8 = argv + 32; *a4 = arg4;
    var a5 **u8 = argv + 40; *a5 = arg5;
    var a6 **u8 = argv + 48; *a6 = nil;
    var pid i64 = os_fork();
    if pid == 0 {
        os_close(*read_fd);
        os_execve(tool, argv, ___envp);
        os_write(*write_fd, "!", 1);
        os__exit(127);
    }
    os_close(*write_fd);
    if pid < 0 { os_close(*read_fd); eprintln("Error: native build toolchain fork failed"); return 1; }
    var marker *u8 = alloc(1);
    var failed i64 = os_read(*read_fd, marker, 1);
    os_close(*read_fd);
    var status i64 = 0;
    if os_waitpid(pid, &status, 0) != pid { eprintln("Error: native build toolchain wait failed"); return 1; }
    if failed != 0 {
        eprint("Error: native build toolchain could not execute: "); eprintln(tool); return 0 - 127;
    }
    return process_status_code(status);
}

func native_build_emit_valid(emit *u8, allow_ast i64) i64 {
    return streq(emit, "native") || streq(emit, "llvm") || (allow_ast != 0 && streq(emit, "ast"));
}

func native_build_source_error(source *u8, phase *u8) void {
    eprint(source); eprint(": error: native build "); eprint(phase); eprintln(" failed");
}

func native_build_profile(source *u8, arch *u8) i64 {
    var target *u8 = getenv("LANGOS");
    if cg_backend_is_llvm() == 0 || (target != nil && !streq(target, "linux")) ||
       !streq(os_platform_name(), "linux") || !streq(arch, "x86_64") {
        native_build_source_error(source, "backend selection");
        eprintln("Error: native build requires LANGBE=llvm LANGOS=linux on Linux x86-64");
        return 1;
    }
    return 0;
}

func native_build_link(work *u8, source *u8, toolchain *u8) i64 {
    // Explicit executable selection; no shell, extra flags or fallback on failure.
    var tool *u8 = getenv("LANG_CLANG");
    if tool == nil || *tool == 0 { tool = find_in_path(toolchain); }
    if tool == nil {
        native_build_source_error(source, "toolchain");
        eprintln("Error: native build toolchain: clang not found in PATH"); return 127;
    }
    eprint("Native build: profile=llvm-linux-x86_64 optimization=-O0 toolchain="); eprintln(tool);
    var result i64 = native_build_tool(tool, "-O0", "-c", str_concat(work, "/guest.ll"), "-o", str_concat(work, "/guest.o"));
    if result < 0 { native_build_source_error(source, "toolchain"); return 0 - result; }
    if result != 0 {
        native_build_source_error(source, "optimizer/object compilation"); return result;
    }
    result = native_build_tool(tool, str_concat(work, "/guest.o"), "-o", str_concat(work, "/program"), nil, nil);
    if result < 0 { native_build_source_error(source, "toolchain"); return 0 - result; }
    if result != 0 { native_build_source_error(source, "linker"); }
    return result;
}

func native_build_prepare_output(output *u8, inputs *u8) i64 {
    var i i64 = 0;
    while i < vec_len(inputs) {
        if native_build_same_file(output, vec_get(inputs, i)) {
            eprintln("Error: build output would overwrite an input"); return 1;
        }
        i = i + 1;
    }
    // Only invalidate a previous ELF, preserving unrelated files and symlinks.
    var info *u8 = alloc(256);
    if lstat(output, info) == 0 {
        var mode *i32 = info + 24; // Linux x86-64 stat.st_mode (the supported profile).
        if (*mode & 61440) != 32768 { eprintln("Error: build output must be a regular file"); return 1; }
        var fd i64 = file_open(output, O_RDONLY);
        var magic *u8 = alloc(4);
        var count i64 = -1;
        if fd >= 0 { count = file_read(fd, magic, 4); file_close(fd); }
        if count != 4 || *magic != 127 || *(magic + 1) != 'E' || *(magic + 2) != 'L' || *(magic + 3) != 'F' {
            eprintln("Error: refusing to replace an existing non-native file"); return 1;
        }
        if os_unlink(output) != 0 { eprintln("Error: cannot invalidate previous build output"); return 1; }
    }
    return 0;
}

func native_build_publish(work *u8, artifact *u8, output *u8, result i64) i64 {
    if result == 0 {
        if rename(artifact, output) != 0 { eprintln("Error: native build publication failed"); result = 1; }
    }
    os_unlink(str_concat(work, "/guest.ast"));
    os_unlink(str_concat(work, "/formatted.ast"));
    os_unlink(str_concat(work, "/guest.ll"));
    os_unlink(str_concat(work, "/guest.o"));
    os_unlink(str_concat(work, "/program"));
    rmdir(work);
    return result;
}
