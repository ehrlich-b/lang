}

func read_prepare_readers(reader_files *u8) i64 {
    var source *u8 = alloc(4194304);
    var source_len i64 = 0;
    var i i64 = 0;
    while i < vec_len(reader_files) {
        append_str(source, &source_len, "include \"");
        append_str(source, &source_len, vec_get(reader_files, i));
        append_str(source, &source_len, "\"\n");
        i = i + 1;
    }
    *(source + source_len) = 0;

    parser_set_source_name("<lang read>");
    parser_tokenize(source);
    var prog *u8 = parse_program();
    if prog == nil || parse_error_count > 0 { return 0; }

    codegen_init();
    cg_has_llvm_backend = 1;
    cg_generate_llvm_fn = &generate_llvm;
    interp_init();
    cg_current_file_decls = program_decls(prog);
    cg_current_file_decl_count = program_decl_count(prog);

    var decls *u8 = program_decls(prog);
    var count i64 = program_decl_count(prog);
    i = 0;
    while i < count {
        process_decl_first_pass(get_decl(decls, i));
        i = i + 1;
    }
    if cg_had_error != 0 { return 0; }
    return 1;
}

func read_error_prefix(source_path *u8) void {
    eprint(source_path);
    eprint(":1:1: error: ");
}

func read_run_reader(name *u8, source_path *u8, content *u8) *u8 {
    var name_len i64 = strlen(name);
    var output *u8 = nil;
    var embedded_func *u8 = find_embedded_reader_func(name, name_len);
    if embedded_func != nil {
        var reader_fn fn(*u8) *u8 = embedded_func;
        output = reader_fn(content);
        if output == nil {
            read_error_prefix(source_path);
            eprint("embedded reader '");
            eprint(name);
            eprintln("' returned nil");
            return nil;
        }
    } else {
        var reader_decl *u8 = find_reader(name, name_len);
        if reader_decl == nil {
            read_error_prefix(source_path);
            eprint("reader '");
            eprint(name);
            eprintln("' not found");
            return nil;
        }

        var exe_path *u8 = build_reader_cache_path(name, name_len);
        output = alloc(4194304);
        var n i64 = exec_capture(exe_path, content, strlen(content), output, 4194304);
        if n < 0 {
            read_error_prefix(source_path);
            eprint("reader '");
            eprint(name);
            eprint("' exited with status ");
            eprint_i64(0 - n);
            eprintln("");
            return nil;
        }
        if n == 0 {
            read_error_prefix(source_path);
            eprint("reader '");
            eprint(name);
            eprintln("' returned no AST");
            return nil;
        }
    }

    var parsed *u8 = parse_ast_from_reader_string(output, source_path, content);
    if parsed == nil {
        read_error_prefix(source_path);
        eprint("reader '");
        eprint(name);
        eprintln("' did not return valid program AST");
        return nil;
    }
    return output;
}

// A second, syntax-only S-expression parse lets `lang read` format the
// reader's artifact without rebuilding it from compiler nodes (which would
// discard `(span ...)` wrappers). `start` and `end` are unused on this private
// tree, so the measurement pass stores flat width and simple-list status there.
struct ReadAstFormatter {
    output *u8;
    len i64;
    cap i64;
    failed i64;
}

func read_ast_measure(node *PNode) i64 {
    if node.kind != PNODE_LIST {
        node.start = strlen(node.text);
        node.end = 1;
        return node.start;
    }

    var width i64 = 2;
    var simple i64 = 1;
    var count i64 = vec_len(node.children);
    var i i64 = 0;
    while i < count {
        var child *PNode = vec_get(node.children, i);
        if i > 0 { width = width + 1; }
        width = width + read_ast_measure(child);
        if child.kind == PNODE_LIST { simple = 0; }
        i = i + 1;
    }
    node.start = width;
    node.end = simple;
    return width;
}

func read_ast_emit_char(formatter *ReadAstFormatter, c u8) void {
    if formatter.len >= formatter.cap - 1 {
        formatter.failed = 1;
        return;
    }
    *(formatter.output + formatter.len) = c;
    formatter.len = formatter.len + 1;
}

func read_ast_emit_text(formatter *ReadAstFormatter, text *u8) void {
    while *text != 0 {
        read_ast_emit_char(formatter, *text);
        text = text + 1;
    }
}

func read_ast_emit_indent(formatter *ReadAstFormatter, indent i64) void {
    read_ast_emit_char(formatter, '\n');
    var i i64 = 0;
    while i < indent {
        read_ast_emit_char(formatter, ' ');
        i = i + 1;
    }
}

func read_ast_emit_flat(formatter *ReadAstFormatter, node *PNode) void {
    if node.kind != PNODE_LIST {
        read_ast_emit_text(formatter, node.text);
        return;
    }

    read_ast_emit_char(formatter, '(');
    var count i64 = vec_len(node.children);
    var i i64 = 0;
    while i < count {
        if i > 0 { read_ast_emit_char(formatter, ' '); }
        read_ast_emit_flat(formatter, vec_get(node.children, i));
        i = i + 1;
    }
    read_ast_emit_char(formatter, ')');
}

func read_ast_emit_pretty(formatter *ReadAstFormatter, node *PNode,
                          indent i64, column i64, force_break i64) i64 {
    if node.kind != PNODE_LIST {
        read_ast_emit_text(formatter, node.text);
        return column + node.start;
    }
    if force_break == 0 && column + node.start <= 88 {
        read_ast_emit_flat(formatter, node);
        return column + node.start;
    }

    read_ast_emit_char(formatter, '(');
    var count i64 = vec_len(node.children);
    if count == 0 {
        read_ast_emit_char(formatter, ')');
        return column + 2;
    }

    var first *PNode = vec_get(node.children, 0);
    read_ast_emit_flat(formatter, first);
    var current i64 = column + 1 + first.start;
    var broken i64 = force_break;
    var child_indent i64 = indent + 2;
    var i i64 = 1;
    while i < count {
        var child *PNode = vec_get(node.children, i);
        if broken == 0 && (child.kind != PNODE_LIST || child.end != 0) &&
           current + 1 + child.start <= 88 {
            read_ast_emit_char(formatter, ' ');
            read_ast_emit_flat(formatter, child);
            current = current + 1 + child.start;
        } else {
            read_ast_emit_indent(formatter, child_indent);
            current = read_ast_emit_pretty(formatter, child, child_indent,
                                           child_indent, 0);
            broken = 1;
        }
        i = i + 1;
    }
    read_ast_emit_char(formatter, ')');
    return current + 1;
}

func read_ast_format(ast *u8) *u8 {
    var tokens *Tokenizer = tok_new(ast);
    var root *PNode = parse_sexpr(tokens);
    if root == nil || !tok_eof(tokens) { return nil; }
    read_ast_measure(root);

    var formatter *ReadAstFormatter = alloc(32);
    formatter.output = alloc(SIZE_AST_EMIT);
    formatter.len = 0;
    formatter.cap = SIZE_AST_EMIT;
    formatter.failed = 0;
    read_ast_emit_pretty(formatter, root, 0, 0, 1);
    if formatter.failed != 0 { return nil; }
    *(formatter.output + formatter.len) = 0;
    return formatter.output;
}

func read_write_ast(fd i64, ast *u8, compact i64) i64 {
    if file_write_all(fd, ast) == 0 { return 0; }
    if compact != 0 { return 1; }
    var len i64 = strlen(ast);
    if len == 0 || *(ast + len - 1) != '\n' {
        if file_write_all(fd, "\n") == 0 { return 0; }
    }
    return 1;
}

func cmd_read(argc i64, argv **u8, arg_offset i64) i64 {
    if argc == 1 {
        var only *u8 = get_arg(argv, arg_offset);
        if streq(only, "--help") || streq(only, "-h") { return cmd_help_read(); }
    }

    var paths *u8 = vec_new(8);
    var output_file *u8 = nil;
    var compact i64 = 0;
    var i i64 = 0;
    while i < argc {
        var arg *u8 = get_arg(argv, arg_offset + i);
        if streq(arg, "-o") {
            if i + 1 >= argc {
                eprintln("Error: -o needs an output path");
                return 1;
            }
            i = i + 1;
            output_file = get_arg(argv, arg_offset + i);
        } else if streq(arg, "--compact") {
            compact = 1;
        } else if *arg == '-' {
            eprint("Error: unknown read option: ");
            eprintln(arg);
            return 1;
        } else {
            vec_push(paths, arg);
        }
        i = i + 1;
    }

    if vec_len(paths) < 2 {
        eprintln("Error: read needs reader source and custom source");
        return 1;
    }

    var source_path *u8 = vec_get(paths, vec_len(paths) - 1);
    var reader_name *u8 = get_extension(source_path);
    if reader_name == nil || is_lang_extension(reader_name) != 0 {
        eprintln("Error: read source needs a custom file extension");
        return 1;
    }

    var reader_files *u8 = vec_new(vec_len(paths) - 1);
    i = 0;
    while i < vec_len(paths) - 1 {
        var reader_path *u8 = vec_get(paths, i);
        if is_lang_extension(get_extension(reader_path)) == 0 {
            eprint("Error: reader source must be a .lang file: ");
            eprintln(reader_path);
            return 1;
        }
        vec_push(reader_files, reader_path);
        i = i + 1;
    }

    var content *u8 = read_file(source_path);
    if content == nil { return 1; }
    if read_prepare_readers(reader_files) == 0 { return 1; }
    var ast *u8 = read_run_reader(reader_name, source_path, content);
    if ast == nil { return 1; }
    if compact == 0 {
        ast = read_ast_format(ast);
        if ast == nil {
            eprintln("Error: cannot format reader AST");
            return 1;
        }
    }

    if output_file == nil {
        if read_write_ast(1, ast, compact) == 0 {
            eprintln("Error: cannot write AST to stdout");
            return 1;
        }
        return 0;
    }

    var fd i64 = file_open(output_file, O_WRONLY_CREAT_TRUNC);
    if fd < 0 {
        eprint("Error: cannot create ");
        eprintln(output_file);
        return 1;
    }
    if read_write_ast(fd, ast, compact) == 0 {
        file_close(fd);
        os_unlink(output_file);
        eprint("Error: cannot write ");
        eprintln(output_file);
        return 1;
    }
    if os_close(fd) < 0 {
        os_unlink(output_file);
        eprint("Error: cannot finish ");
        eprintln(output_file);
        return 1;
    }
    print("Wrote ");
    println(output_file);
    return 0;
}

