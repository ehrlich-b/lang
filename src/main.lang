func scaffold_valid_name(name *u8) i64 {
    var len i64 = strlen(name);
    if len == 0 || len > 64 { return 0; }

    // Let the language lexer enforce both identifier spelling and reserved
    // words, so every accepted name is valid after `reader` and in #parser{}.
    lexer_init(name);
    var first *u8 = scan_token();
    if tok_type(first) != TOKEN_IDENT { return 0; }
    var after *u8 = scan_token();
    if tok_type(after) != TOKEN_EOF { return 0; }
    return 1;
}

func scaffold_exists(path *u8) i64 {
    var fd i64 = file_open(path, O_RDONLY);
    if fd < 0 { return 0; }
    file_close(fd);
    return 1;
}

func file_write_all(fd i64, data *u8) i64 {
    var len i64 = strlen(data);
    var written i64 = 0;
    while written < len {
        var n i64 = file_write(fd, data + written, len - written);
        if n <= 0 { return 0; }
        written = written + n;
    }
    return 1;
}

func scaffold_reader_source(name *u8) *u8 {
    var source *u8 = alloc(4096);
    var len i64 = 0;
    append_str(source, &len, "include \"std/parser_reader.lang\"\n");
    append_str(source, &len, "include \"std/ast.lang\"\n\n");
    append_str(source, &len, "#parser{\n    ");
    append_str(source, &len, name);
    append_str(source, &len, "_program = 'answer' number\n}\n\nreader ");
    append_str(source, &len, name);
    append_str(source, &len, "(text *u8) *u8 {\n");
    append_str(source, &len, "    var tokens *Tokenizer = tok_new(text);\n");
    append_str(source, &len, "    var tree *PNode = parse_");
    append_str(source, &len, name);
    append_str(source, &len, "_program(tokens);\n");
    append_str(source, &len, "    if tree == nil || !tok_eof(tokens) {\n");
    append_str(source, &len, "        tok_print_error(tokens, \"");
    append_str(source, &len, name);
    append_str(source, &len, "\"); return nil;\n");
    append_str(source, &len, "    }\n");
    append_str(source, &len, "    var value *PNode = pnode_child(tree, 1);\n");
    append_str(source, &len, "    return ast_main_i64(ast_span(ast_number(value.text), value.start, value.end));\n");
    append_str(source, &len, "}\n");
    *(source + len) = 0;
    return source;
}

func cmd_help_new() i64 {
    println("lang new reader - start a source language");
    println("");
    println("Usage: lang new reader <name>");
    println("");
    println("Creates <name>.lang and answer.<name> without overwriting files.");
    println("");
    println("Example:");
    println("  lang new reader tiny");
    println("  lang run tiny.lang answer.tiny");
    return 0;
}

func cmd_new_reader(name *u8) i64 {
    if scaffold_valid_name(name) == 0 {
        eprint("Error: reader name must be a non-keyword identifier (up to 64 characters): ");
        eprintln(name);
        return 1;
    }

    var toolkit_fd i64 = resource_open_read("std/parser_reader.lang");
    if toolkit_fd < 0 {
        eprintln("Error: reader toolkit not found; run from the checkout or set LANG_ROOT");
        return 1;
    }
    file_close(toolkit_fd);
    toolkit_fd = resource_open_read("std/ast.lang");
    if toolkit_fd < 0 {
        eprintln("Error: reader toolkit not found; run from the checkout or set LANG_ROOT");
        return 1;
    }
    file_close(toolkit_fd);

    var reader_path *u8 = str_concat(name, ".lang");
    var sample_path *u8 = str_concat("answer.", name);
    if scaffold_exists(reader_path) != 0 {
        eprint("Error: refusing to overwrite ");
        eprintln(reader_path);
        return 1;
    }
    if scaffold_exists(sample_path) != 0 {
        eprint("Error: refusing to overwrite ");
        eprintln(sample_path);
        return 1;
    }

    var source *u8 = scaffold_reader_source(name);
    var reader_fd i64 = file_open(reader_path, O_WRONLY_CREAT_EXCL);
    if reader_fd < 0 {
        eprint("Error: cannot create ");
        eprintln(reader_path);
        return 1;
    }
    if file_write_all(reader_fd, source) == 0 {
        file_close(reader_fd);
        os_unlink(reader_path);
        eprint("Error: cannot write ");
        eprintln(reader_path);
        return 1;
    }
    if os_close(reader_fd) < 0 {
        os_unlink(reader_path);
        eprint("Error: cannot finish ");
        eprintln(reader_path);
        return 1;
    }

    var sample_fd i64 = file_open(sample_path, O_WRONLY_CREAT_EXCL);
    if sample_fd < 0 {
        os_unlink(reader_path);
        eprint("Error: cannot create ");
        eprintln(sample_path);
        return 1;
    }
    if file_write_all(sample_fd, "answer 42\n") == 0 {
        file_close(sample_fd);
        os_unlink(sample_path);
        os_unlink(reader_path);
        eprint("Error: cannot write ");
        eprintln(sample_path);
        return 1;
    }
    if os_close(sample_fd) < 0 {
        os_unlink(sample_path);
        os_unlink(reader_path);
        eprint("Error: cannot finish ");
        eprintln(sample_path);
        return 1;
    }

    print("Created ");
    print(reader_path);
    print(" and ");
    println(sample_path);
    print("Run: lang run ");
    print(reader_path);
    print(" ");
    println(sample_path);
    return 0;
}

func cmd_new(argc i64, argv **u8, arg_offset i64) i64 {
    if argc == 1 {
        var only *u8 = get_arg(argv, arg_offset);
        if streq(only, "--help") || streq(only, "-h") { return cmd_help_new(); }
    }
    if argc != 2 {
        eprintln("Error: expected `lang new reader <name>`");
        return 1;
    }
    var kind *u8 = get_arg(argv, arg_offset);
    if !streq(kind, "reader") {
        eprint("Error: cannot scaffold ");
        eprintln(kind);
        return 1;
    }
    return cmd_new_reader(get_arg(argv, arg_offset + 1));
}

func cmd_help_read() i64 {
    println("lang read - inspect the AST returned by a reader");
    println("");
    println("Usage: lang read <reader.lang...> <source.ext> [-o output.ast] [--compact]");
    println("");
    println("The source extension selects the reader. AST goes to stdout by default.");
    println("Output is formatted for review; --compact preserves the reader's raw bytes.");
    println("");
    println("Example:");
    println("  lang read tiny.lang answer.tiny -o answer.ast");
    println("  lang --from-ast answer.ast --ast-source answer.tiny -o answer.ll");
