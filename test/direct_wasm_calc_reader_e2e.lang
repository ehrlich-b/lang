include "example/calc/calc.lang"

// The browser backend builds readers with the same std/prec.lang ladder as
// native, so the table has to produce the same tree here: the tighter level
// nests inside the looser one, and equal power folds left.
func main() i64 {
    var table *PrecTable = calc_table();

    var mixed *PrecExpr = prec_expr(table);
    prec_operand(mixed, ast_number("1"));
    prec_op(mixed, "+");
    prec_operand(mixed, ast_number("2"));
    prec_op(mixed, "*");
    prec_operand(mixed, ast_number("3"));
    var mixed_ast *u8 = prec_build(mixed);
    if mixed_ast == nil { return 1; }
    if !streq(mixed_ast, "(binop + (number 1) (binop * (number 2) (number 3)))") {
        return 2;
    }

    var chain *PrecExpr = prec_expr(table);
    prec_operand(chain, ast_number("1"));
    prec_op(chain, "-");
    prec_operand(chain, ast_number("2"));
    prec_op(chain, "-");
    prec_operand(chain, ast_number("3"));
    var chain_ast *u8 = prec_build(chain);
    if chain_ast == nil { return 3; }
    if !streq(chain_ast, "(binop - (binop - (number 1) (number 2)) (number 3))") {
        return 4;
    }

    var output *u8 = calc("answer 1 + 2 * 3");
    if output == nil { return 5; }
    return *output;
}
