include "std/core.lang"
include "src/phase_host.lang"
include "src/lexer.lang"
include "src/parser.lang"
include "src/ast_emit.lang"
include "src/sexpr_reader.lang"
func arg(argv **u8, n i64) *u8 { var raw *u8 = argv; var slot **u8 = raw + n * 8; return *slot; }
func number(text *u8) i64 {
    var n i64 = 0;
    while *text != 0 { n = n * 10 + *text - 48; text = text + 1; } return n;
}
func hex(c i64) i64 {
    if c >= 48 && c <= 57 { return c - 48; }
    if c >= 97 && c <= 102 { return c - 87; }
    phase_error("probe-hex", "tooling"); return 0;
}
func main(argc i64, argv **u8) i64 {
    var mode *u8 = arg(argv, 1);
    var name *u8 = arg(argv, 2);
    var text *u8 = phase_read_file(name);
    var source i64 = phase_source_capture(name, text);
    var root i64 = phase_origin_new(source, 0, strlen(text), 0, 0);
    var start i64 = number(arg(argv, 3)); var end i64 = number(arg(argv, 4));
    var invocation i64 = phase_origin_new(source, start, end, root, root);
    var slice i64 = phase_source_new("guest-slice", str_dup_n(text + start, end - start));
    phase_origin_new(slice, 0, end - start, 0, invocation);
    if streq(mode, "stale") { phase_source_capture(name, "changed snapshot"); }
    var input *PhaseBuffer = phase_read_fd(0, phase_limit(), "hex-frame");
    var frame *u8 = alloc(input.len / 2 + 1); var i i64 = 0;
    while i < input.len / 2 {
        *(frame + i) = hex(*(input.data + i * 2)) * 16 + hex(*(input.data + i * 2 + 1)); i = i + 1;
    }
    if streq(mode, "old-W") { phase_wire_decode(frame, i, root); return 9; }
    var envelope *ToolEnvelope = tooling_wire_decode(frame, i, root);
    if streq(mode, "capabilities") { println(tooling_capabilities(envelope)); return 0; }
    if streq(mode, "Q1") { tooling_require(envelope, 1); return 9; }
    if streq(mode, "Q2") { tooling_require(envelope, 2); return 9; }
    if streq(mode, "Q3") { tooling_require(envelope, 3); return 9; }
    if streq(mode, "Q4") { tooling_require(envelope, 4); return 9; }
    if streq(mode, "program") {
        // This marker must never be reached by malformed metadata.
        println("validated-before-analysis");
        if tooling_program(envelope) == nil { return 8; } return 0;
    }
    var encoded *PhaseBuffer = tooling_wire_encode(envelope);
    file_write(1, encoded.data, encoded.len); return 0;
}
