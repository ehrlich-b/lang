include "example/shipping/shipping.lang"
include "test/reader_author/fixtures/lexer_profile/query.lang"

func same_text(a *u8, b *u8) bool {
    if a == nil || b == nil { return a == b; }
    return streq(a, b);
}

// Include internal capture wrappers, branch labels and every exact byte span.
func same_tree(a *PNode, b *PNode) bool {
    if a == nil || b == nil { return false; }
    if a.kind != b.kind || a.start != b.start || a.end != b.end ||
       !same_text(a.text, b.text) || !same_text(a.branch, b.branch) { return false; }
    if a.children == nil || b.children == nil { return a.children == b.children; }
    if vec_len(a.children) != vec_len(b.children) { return false; }
    var i i64 = 0;
    while i < vec_len(a.children) {
        if !same_tree(vec_get(a.children, i), vec_get(b.children, i)) { return false; }
        i = i + 1;
    }
    return true;
}

func config_source() *u8 { return "// café\nshipping { base 00010; /* units */ free_over 100; } // end"; }
func config_manual() *Tokenizer {
    var stream *u8 = tok_stream_new();
    tok_stream_push(stream, TOK_IDENT, 9, 8, nil);
    tok_stream_push(stream, TOK_LBRACE, 18, 1, nil);
    tok_stream_push(stream, TOK_IDENT, 20, 4, nil);
    tok_stream_push(stream, TOK_NUMBER, 25, 5, nil);
    tok_stream_push(stream, TOK_SEMI, 30, 1, nil);
    tok_stream_push(stream, TOK_IDENT, 44, 9, nil);
    tok_stream_push(stream, TOK_NUMBER, 54, 3, nil);
    tok_stream_push(stream, TOK_SEMI, 57, 1, nil);
    tok_stream_push(stream, TOK_RBRACE, 59, 1, nil);
    return tok_new_stream(config_source(), stream);
}

func query_source() *u8 { return "-- café\nselect order-total (* units *) limit 003; -- end"; }
func query_manual() *Tokenizer {
    var stream *u8 = tok_stream_new();
    tok_stream_push(stream, TOK_IDENT, 9, 6, nil);
    tok_stream_push(stream, TOK_IDENT, 16, 11, nil);
    tok_stream_push(stream, TOK_IDENT, 40, 5, nil);
    tok_stream_push(stream, TOK_NUMBER, 46, 3, nil);
    tok_stream_push(stream, TOK_SEMI, 49, 1, nil);
    return tok_new_stream(query_source(), stream);
}

func adjacent_comment_tree() bool {
    var source *u8 = "select item--comment\nlimit 3;";
    var stream *u8 = tok_stream_new();
    tok_stream_push(stream, TOK_IDENT, 0, 6, nil);
    tok_stream_push(stream, TOK_IDENT, 7, 4, nil);
    tok_stream_push(stream, TOK_IDENT, 21, 5, nil);
    tok_stream_push(stream, TOK_NUMBER, 27, 1, nil);
    tok_stream_push(stream, TOK_SEMI, 28, 1, nil);
    var scanned *Tokenizer = tok_new_profile(source, query_profile());
    var manual *Tokenizer = tok_new_stream(source, stream);
    var first *PNode = parse_lookup(scanned);
    var second *PNode = parse_lookup(manual);
    return same_tree(first, second) && tok_expect_end(scanned) && tok_expect_end(manual);
}

func identifier_at(t *Tokenizer, text *u8, start i64, end i64) bool {
    return tok_kind(t) == TOK_IDENT && streq(tok_text(t), text) &&
           tok_start_offset(t) == start && tok_end_offset(t) == end;
}

// Alphabetic comment markers overlap ordinary identifier continuation bytes.
// Existing constructors consume the whole identifier; explicit profiles give
// the marker priority regardless of their numeric mode or extra name bytes.
func alphabetic_comment_boundaries() bool {
    var legacy *Tokenizer = tok_new_comments("weekend tail", "end", nil, nil);
    if !identifier_at(legacy, "weekend", 0, 7) { return false; }
    tok_next(legacy);
    if !identifier_at(legacy, "tail", 8, 12) { return false; }
    tok_next(legacy);
    if !tok_eof(legacy) { return false; }
    legacy = tok_new_comments("weekbegin body stop tail", nil, "begin", "stop");
    if !identifier_at(legacy, "weekbegin", 0, 9) { return false; }
    tok_next(legacy);
    if !identifier_at(legacy, "body", 10, 14) { return false; }
    tok_next(legacy);
    if !identifier_at(legacy, "stop", 15, 19) { return false; }
    tok_next(legacy);
    if !identifier_at(legacy, "tail", 20, 24) { return false; }
    tok_next(legacy);
    if !tok_eof(legacy) { return false; }
    // Legacy comments are still recognized at token boundaries.
    legacy = tok_new_comments("week end ignored\ntail", "end", nil, nil);
    if !identifier_at(legacy, "week", 0, 4) { return false; }
    tok_next(legacy);
    if !identifier_at(legacy, "tail", 17, 21) { return false; }
    legacy = tok_new_comments("week begin ignored stop tail", nil, "begin", "stop");
    tok_next(legacy);
    if !identifier_at(legacy, "tail", 24, 28) { return false; }

    var mode i64 = TOK_NUM_DEFAULT;
    while mode <= TOK_NUM_DECIMAL {
        var profiled *Tokenizer = tok_new_profile("weekend ignored\ntail",
            tok_profile_new(mode, nil, "end", nil, nil));
        if !identifier_at(profiled, "week", 0, 4) { return false; }
        tok_next(profiled);
        if !identifier_at(profiled, "tail", 16, 20) { return false; }
        tok_next(profiled);
        if !tok_eof(profiled) { return false; }
        profiled = tok_new_profile("weekbegin body stop tail",
            tok_profile_new(mode, nil, nil, "begin", "stop"));
        if !identifier_at(profiled, "week", 0, 4) { return false; }
        tok_next(profiled);
        if !identifier_at(profiled, "tail", 20, 24) { return false; }
        tok_next(profiled);
        if !tok_eof(profiled) { return false; }
        mode = mode + 1;
    }
    return true;
}

func main(argc i64, argv **u8) i64 {
    if argc > 1 {
        var tokens *Tokenizer = tok_new_profile(argv[1], shipping_profile());
        var tree *PNode = nil;
        if argc > 2 {
            tokens = tok_new_profile(argv[1], query_profile());
            tree = parse_lookup(tokens);
        } else { tree = parse_shipping_policy(tokens); }
        var complete bool = false;
        if tree != nil { complete = tok_expect_end(tokens); }
        if !complete { tok_print_error(tokens, "profile"); return 1; }
        pnode_dump(tree);
        return 0;
    }
    var a *Tokenizer = tok_new_profile(config_source(), shipping_profile());
    var b *Tokenizer = config_manual();
    var first *PNode = parse_shipping_policy(a);
    var second *PNode = parse_shipping_policy(b);
    if !same_tree(first, second) || !tok_expect_end(a) || !tok_expect_end(b) { return 10; }
    if vec_len(capture_shipping_policy_repeated(first, "settings")) != 2 { return 11; }
    pnode_dump(first);
    a = tok_new_profile(query_source(), query_profile());
    b = query_manual();
    first = parse_lookup(a);
    second = parse_lookup(b);
    if !same_tree(first, second) || !tok_expect_end(a) || !tok_expect_end(b) { return 12; }
    if !streq(capture_lookup_required(first, "field").text, "order-total") { return 13; }
    pnode_dump(first);
    // Profiles are per tokenizer, even when their scans are interleaved.
    a = tok_new_profile("12-- end", query_profile());
    b = tok_new("-12 1.5 2e3 4name // inherited");
    if tok_kind(a) != TOK_NUMBER || !streq(tok_text(a), "12") { return 14; }
    tok_next(a);
    if !tok_eof(a) || tok_kind(b) != TOK_NUMBER || tok_number(b) != -12 { return 15; }
    tok_next(b);
    if !streq(tok_text(b), "1") { return 16; }
    tok_next(b);
    if tok_kind(b) != TOK_DOT { return 17; }
    tok_next(b);
    tok_next(b);
    if !streq(tok_text(b), "2") { return 18; }
    tok_next(b);
    if !streq(tok_text(b), "e3") { return 19; }
    tok_next(b);
    if !streq(tok_text(b), "4") { return 20; }
    tok_next(b);
    if !streq(tok_text(b), "name") { return 21; }
    tok_next(b);
    if !tok_eof(b) { return 22; }
    // A lexical error stays exact across rewind, another expectation and EOF.
    a = tok_new_profile("7 1e+3;", shipping_profile());
    var mark i64 = tok_mark(a);
    tok_next(a);
    tok_reset(a, mark);
    tok_note_expected(a, "something else");
    if tok_expect_end(a) || tok_eof(a) || tok_error_offset(a) != 2 ||
       tok_error_end_offset(a) != 6 || !streq(tok_error_expected(a), "decimal integer") { return 23; }
    if !adjacent_comment_tree() { return 24; }
    // Both kinds of opener win over continuation bytes, including at EOF.
    a = tok_new_profile("item--comment", query_profile());
    if !streq(tok_text(a), "item") || tok_end_offset(a) != 4 { return 25; }
    tok_next(a);
    if !tok_eof(a) { return 26; }
    a = tok_new_profile("item-*comment*-next",
                        tok_profile_new(TOK_NUM_DECIMAL, "-", nil, "-*", "*-"));
    if !streq(tok_text(a), "item") || tok_end_offset(a) != 4 { return 27; }
    tok_next(a);
    if !streq(tok_text(a), "next") || tok_start_offset(a) != 15 { return 28; }
    tok_next(a);
    if !tok_eof(a) { return 29; }
    // An opener alone does not enable block comments.
    a = tok_new_profile("item-*comment",
                        tok_profile_new(TOK_NUM_DECIMAL, "-", nil, "-*", nil));
    if !streq(tok_text(a), "item-") || tok_end_offset(a) != 5 { return 30; }
    if !alphabetic_comment_boundaries() { return 31; }
    println("PASS two-readers");
    return 0;
}
