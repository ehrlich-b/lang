include "std/core.lang"
include "std/pnode.lang"
reader broken(text *u8) *u8 {
    var mode *u8 = text; var size i64 = 131072;
    if str_starts_with(text, "256:") { size = 262144; mode = text + 4; }
    if str_starts_with(text, "512:") { size = 524288; mode = text + 4; }
    if str_starts_with(text, "768:") { size = 786432; mode = text + 4; }
    if streq(mode, "large-truncated") || streq(mode, "large-mixed") || streq(mode, "large-mixed-truncated") {
        var message *u8 = alloc(size + 1);
        var i i64 = 0;
        while i < size { *(message + i) = 120; i = i + 1; }
        *(message + size) = 0;
        if streq(mode, "large-truncated") == 0 {
            // Exercise escaping and scalar widths as well as plain ASCII.
            i = 0;
            while i < size {
                memcpy(message + i, "\"\\\n\t\r", 5);
                *(message + i + 5) = 1; memcpy(message + i + 6, "é", 2); i = i + 32;
            }
        }
        reader_error("large-message", message, "broken", text, -1, -1);
        if streq(mode, "large-truncated") == 0 {
            var d *ReaderDiagnostic = alloc(48);
            d.code = "reader-implementation"; d.message = "after large message";
            d.source = "broken"; d.start = -1; d.end = -1; d.category = 1;
            reader_diagnostic_emit(d, text);
            reader_error("last-guest", "last guest message", "broken", text, 0, 1);
        }
        if streq(mode, "large-mixed") == 0 { file_write(2, "\0RDI1", 5); }
    } else if streq(text, "exit-invalid-0") || streq(text, "exit-invalid-1") {
        reader_error("bad-range", "bad range", "broken", text, 3, 1);
        print("(program)");
        if streq(text, "exit-invalid-1") { os__exit(1); }
        os__exit(0);
    } else if streq(text, "exit-error-0") || streq(text, "exit-error-1") {
        reader_error("early-error", "error before exit", "broken", text, -1, -1);
        print("(program)");
        if streq(text, "exit-error-1") { os__exit(1); }
        os__exit(0);
    } else if streq(text, "exit-empty-0") || streq(text, "exit-empty-1") {
        print("(program)");
        if streq(text, "exit-empty-1") { os__exit(1); }
        os__exit(0);
    } else if streq(text, "snapshot") {
        reader_error("snapshot", "wrong snapshot", "broken", "other input", -1, -1);
    } else if streq(text, "RDI1") || streq(text, "prefixRDI1suffix") || streq(text, "RDI1RDI1") {
        pnode_dump(pnode_atom(PNODE_SYMBOL, text));
        eprintln("tail RDI1");
        return "(program)";
    } else if streq(text, "plain-stderr") {
        var debug *u8 = alloc(14);
        memcpy(debug, "debug é\r\n", 10);
        *(debug + 10) = 0; *(debug + 11) = 255; *(debug + 12) = 82;
        file_write(2, debug, 13);
        return "(program)";
    } else if streq(text, "legacy-error") {
        eprintln("legacy: lowering failed"); return nil;
    } else if streq(text, "legacy-exit") {
        eprintln("legacy: lowering failed"); os__exit(1);
    } else if streq(text, "mixed-stderr") {
        eprintln("debug before RDI1 é");
        reader_error("mixed-error", "guest RDI1 failure", "broken", text, -1, -1);
        eprintln("debug after RDI1 é");
    } else if streq(text, "plain-malformed") {
        eprintln("debug before RDI1 é"); file_write(2, "\0RDI1", 5);
    } else if streq(text, "raw") {
        file_write(2, "\0RDI1", 5);
    } else if streq(text, "bom") {
        reader_error("﻿code", "﻿message", "broken", text, -1, -1);
    } else if streq(text, "bom-key") {
        reader_error("bom-key", "bad source", "﻿broken", text, -1, -1);
    } else if streq(text, "valid") {
        return "(program)";
    } else if streq(text, "missing") {
        reader_error("missing-span", "no span", "broken", text, -1, -1);
    } else if streq(text, "implementation") {
        var d *ReaderDiagnostic = alloc(48);
        d.code = "reader-implementation"; d.message = "lowering invariant";
        d.source = "broken"; d.start = -1; d.end = -1; d.category = 1;
        reader_diagnostic_emit(d, text);
    } else if streq(text, "forged") {
        reader_error("forged", "bad source", "unrelated.lang", text, 0, 1);
    } else if streq(text, "reverse") {
        reader_error("reverse", "bad range", "broken", text, 3, 1);
    } else if streq(text, "overflow") {
        reader_error("overflow", "bad range", "broken", text, 0, 999999);
    } else {
        // The input is é: byte 1 is not a UTF-8 scalar boundary.
        reader_error("split", "bad boundary", "broken", text, 1, 2);
    }
    // Even a well-formed AST cannot override any diagnostic or bad record.
    return "(program)";
}
