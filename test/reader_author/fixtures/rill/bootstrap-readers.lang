// Test composition uses the normal embedded-reader interface.
include "example/rill/rill.lang"

func compiler_register_direct_reader(decl *u8) void { add_reader(decl); }
func compiler_direct_reader_runtime_only() i64 { return 0; }
func compiler_expand_direct_reader(name *u8, name_len i64, text *u8, text_len i64) *u8 {
    var embedded *u8 = find_embedded_reader_func(name, name_len);
    if embedded == nil { return nil; }
    var reader_fn fn(*u8) *u8 = embedded;
    return reader_fn(text);
}
func init_compiler_readers() void {
    embedded_reader_names[0] = "rill";
    embedded_reader_funcs[0] = &rill;
}
