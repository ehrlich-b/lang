include "std/tok.lang"
include "std/ast.lang"

// Validate comment closure before tok_new can skip an unfinished block to EOF.
// Comments are non-nesting; line comments end only at LF or end of input.
func pack_comments(text *u8) bool {
    var length i64 = strlen(text);
    var i i64 = 0;
    while i + 1 < length {
        if *(text + i) == 47 && *(text + i + 1) == 47 {
            i = i + 2;
            while i < length && *(text + i) != 10 { i = i + 1; }
        } else if *(text + i) == 47 && *(text + i + 1) == 42 {
            i = i + 2;
            while i + 1 < length && !(*(text + i) == 42 && *(text + i + 1) == 47) {
                i = i + 1;
            }
            if i + 1 >= length {
                eprintln("threshold: unterminated block comment");
                return false;
            }
            i = i + 2;
        } else { i = i + 1; }
    }
    return true;
}

// Validate the complete spelling before ast_number: TOK_NUMBER also includes
// forms outside this exercise's decimal-byte domain.
func pack_number(tokens *Tokenizer) *u8 {
    if tok_kind(tokens) != TOK_NUMBER {
        eprintln("threshold: expected decimal byte (0..255)");
        return nil;
    }
    var text *u8 = tok_text(tokens);
    var length i64 = strlen(text);
    if length == 0 || length > 3 {
        eprintln("threshold: expected decimal byte (0..255)");
        return nil;
    }
    var i i64 = 0;
    var value i64 = 0;
    while i < length {
        var ch i64 = *(text + i);
        if ch < 48 || ch > 57 {
            eprintln("threshold: expected decimal byte (0..255)");
            return nil;
        }
        value = value * 10 + ch - 48;
        i = i + 1;
    }
    if value > 255 {
        eprintln("threshold: expected decimal byte (0..255)");
        return nil;
    }
    var end i64 = tokens.tok_start + length;
    tok_next(tokens);
    if tok_kind(tokens) != TOK_EOF && tokens.tok_start == end {
        eprintln("threshold: expected decimal byte (0..255)");
        return nil;
    }
    // Canonicalize leading zeros before LLVM sees a numeric literal.
    i = 0;
    while i + 1 < length && *(text + i) == 48 { i = i + 1; }
    return text + i;
}

func pack_word(tokens *Tokenizer, word *u8) bool {
    if tok_kind(tokens) != TOK_IDENT || !streq(tok_text(tokens), word) {
        eprintln("threshold: expected keyword");
        return false;
    }
    tok_next(tokens);
    return true;
}

func pack_end(tokens *Tokenizer) bool {
    if tok_kind(tokens) != TOK_EOF {
        eprintln("threshold: expected end of input");
        return false;
    }
    return true;
}
