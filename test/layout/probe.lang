    if form == 4 || form == 5 || form == 7 {
        var a *u8 = array_type_alloc(); array_type_set_elem(a, t); array_type_set_size(a, count); t = a;
        if form == 5 {
            var b *u8 = array_type_alloc(); array_type_set_elem(b, t); array_type_set_size(b, outer); t = b;
        }
    }
    if form == 6 { t = nil; }
    result.size = 111; result.alignment = 222; result.stride = 333;
    return layout_query(t, profile, result);
}
