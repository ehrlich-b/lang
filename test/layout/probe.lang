func layout_probe(name *u8, profile *u8, count i64, outer i64, form i64, result *StorageLayout) i64 {
    var t *u8 = numeric_type(name);
    if form == 1 { var p *u8 = ptr_type_alloc(); ptr_type_set_elem(p, t); t = p; }
    if form == 2 { t = func_type_alloc(); }
    if form == 3 { t = closure_type_alloc(); }
