// expect: 180
// Cast: float conversions, integer narrowing, and bitcast

func main() i64 {
    var result i64 = 0;

    // Float to int (fptosi): truncates toward zero
    var e f64 = 5.7;
    var f i64 = cast(i64, e);
    if f == 5 {
        result = result + 30;
    }

    // Int to float (sitofp)
    var g i64 = 10;
    var h f64 = cast(f64, g);
    if h > 9.9 {
        if h < 10.1 {
            result = result + 40;
        }
    }

    // Bitcast: f64 -> i64 (reinterpret IEEE 754 bits)
    var k f64 = 1.0;
    var l i64 = bitcast(i64, k);
    // IEEE 754: 1.0 = 0x3FF0000000000000
    var high i64 = l >> 48;
    if high == 16368 {  // 0x3FF0
        result = result + 30;
    }

    // Narrow signed values are truncated, then sign-extended into lang's
    // all-i64 expression representation.
    var signed_byte i64 = cast(i8, 255);
    if signed_byte == -1 {
        result = result + 20;
    }

    // Unsigned narrowing zero-extends back to i64.
    var unsigned_byte i64 = cast(u8, 258);
    if unsigned_byte == 2 {
        result = result + 20;
    }

    // A narrowed cast can feed another cast without an LLVM width mismatch.
    var chained i64 = cast(i64, cast(u8, 258));
    if chained == 2 {
        result = result + 20;
    }

    // Float-to-narrow-int results are normalized the same way.
    var float_byte i64 = cast(i8, 5.7);
    if float_byte == 5 {
        result = result + 20;
    }

    // All pass: 30+40+30+20+20+20+20 = 180
    return result;
}
