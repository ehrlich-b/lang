// expect: 0
// Named captures decouple lowering from positional grammar children.

include "std/parser_reader.lang"

#parser{
    pair = left:number ':' right:number
    action = command:('answer' | 'bad') value:(number | symbol)
    maybe = required:number optional:symbol?
    values = items:number+
    chain = head:number tail:chain?
    repeated = (item:number)*
    plain    = kw:symbol body:number
    padded   = kw:symbol ',' body:number
}

// The point of naming the parts: one lowering reads two rules that differ by an
// inserted literal. Positional access could not - `body` is child 1 in one and
// child 2 in the other - and that renumbering is silent.
func read_body(node *PNode) *u8 {
    return pnode_require(node, "body").text;
}

func main() i64 {
    var pair_tokens *Tokenizer = tok_new("10:32");
    var pair *PNode = parse_pair(pair_tokens);
    if pair == nil || !tok_eof(pair_tokens) { return 1; }
    var left *PNode = pnode_require(pair, "left");
    var right *PNode = pnode_require(pair, "right");
    if left == nil || right == nil { return 2; }
    if !streq(left.text, "10") || !streq(right.text, "32") { return 3; }

    // Adding captures does not renumber positional access for migrated rules.
    if pnode_child(pair, 0) != left || pnode_child(pair, 2) != right { return 4; }

    // The same labels may describe both branches of a choice.
    var action_tokens *Tokenizer = tok_new("bad missing");
    var action *PNode = parse_action(action_tokens);
    if action == nil || !tok_eof(action_tokens) { return 5; }
    var command *PNode = pnode_require(action, "command");
    var value *PNode = pnode_require(action, "value");
    if command == nil || value == nil { return 6; }
    if !streq(command.text, "bad") || !streq(value.text, "missing") { return 7; }

    // Captured optionals remain optional; absent is not a parse failure.
    var maybe_tokens *Tokenizer = tok_new("42");
    var maybe *PNode = parse_maybe(maybe_tokens);
    if maybe == nil || !tok_eof(maybe_tokens) { return 8; }
    if pnode_require(maybe, "required") == nil { return 9; }
    if pnode_get(maybe, "optional") != nil { return 10; }

    // A modifier belongs to the capture, so one lookup returns the whole list.
    var values_tokens *Tokenizer = tok_new("1 2 3");
    var values *PNode = parse_values(values_tokens);
    if values == nil || !tok_eof(values_tokens) { return 11; }
    var items *PNode = pnode_require(values, "items");
    if items == nil || vec_len(items.children) != 3 { return 12; }

    // Recursion after a token is safe and remains supported.
    var chain_tokens *Tokenizer = tok_new("1 2 3");
    var chain *PNode = parse_chain(chain_tokens);
    if chain == nil || !tok_eof(chain_tokens) { return 13; }
    if !streq(pnode_require(chain, "head").text, "1") { return 14; }
    var tail *PNode = pnode_get(chain, "tail");
    if tail == nil || !streq(pnode_require(tail, "head").text, "2") {
        return 15;
    }

    // Captures inside a repetition are explicitly plural.
    var repeated_tokens *Tokenizer = tok_new("4 5 6");
    var repeated *PNode = parse_repeated(repeated_tokens);
    if repeated == nil || !tok_eof(repeated_tokens) { return 16; }
    var matches *u8 = pnode_get_all(repeated, "item");
    if vec_len(matches) != 3 { return 17; }
    var middle *PNode = vec_get(matches, 1);
    if !streq(middle.text, "5") { return 18; }
    if vec_len(pnode_get_all(repeated, "missing")) != 0 { return 19; }

    var plain_tokens *Tokenizer = tok_new("go 7");
    var plain *PNode = parse_plain(plain_tokens);
    if plain == nil || !tok_eof(plain_tokens) { return 20; }
    var padded_tokens *Tokenizer = tok_new("go , 7");
    var padded *PNode = parse_padded(padded_tokens);
    if padded == nil || !tok_eof(padded_tokens) { return 21; }
    if !streq(read_body(plain), "7") || !streq(read_body(padded), "7") { return 22; }
    return 0;
}
