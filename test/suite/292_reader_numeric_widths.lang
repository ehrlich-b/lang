// Reader expansion types survive arithmetic, calls, typed returns and storage.
include "std/ast.lang"

reader scalar_width(text *u8) *u8 {
    if streq(text, "narrow") { return "(cast (type_base f32) (number 0.3))"; }
    if streq(text, "negative") { return ast_number("-0.125"); }
    return ast_number("1.25");
}

func reader_value32() f32 { return #scalar_width{narrow}; }
func reader_value64() f64 { return #scalar_width{negative}; }
func reader_identity32(value f32) f32 { return value; }
func reader_identity64(value f64) f64 { return value; }
func main() i64 {
    var narrow f32 = #scalar_width{narrow};
    if bitcast(i32, narrow) != 1050253722 { return 1; }
    if bitcast(i32, reader_value32()) != 1050253722 { return 2; }
    if reader_value64() != -0.125 { return 3; }
    var widened f64 = reader_identity32(#scalar_width{narrow});
    if widened < 0.3000000119209289 || widened > 0.3000000119209290 { return 4; }
    if reader_identity64(#scalar_width{negative}) != -0.125 { return 5; }
    if #scalar_width{positive} + 2 != 3.25 { return 6; }
    if 8 * #scalar_width{negative} != -1.0 { return 7; }
    var narrow_sum f32 = #scalar_width{narrow} + 1;
    if narrow_sum != cast(f32, 1.3) { return 8; }
    var mixed f64 = #scalar_width{narrow} + #scalar_width{positive};
    if mixed < 1.5500000119209289 || mixed > 1.5500000119209291 { return 9; }
    return 100;
}
