// expect: 42
// Test: break/continue survive the reader-build path.
//
// A reader's source is regenerated by unparsing its AST back to lang source
// before being compiled in a forked child. `ast_to_string_stmt` had no case for
// break or continue, so both were replaced by "/* unknown stmt */" and silently
// DELETED - control fell through into the code they were meant to skip. Nothing
// errored; the reader just computed the wrong thing (and, in the forth reader
// that found this, then segfaulted). A standalone compile of the same source was
// correct, which is what made it so confusing.

include "std/core.lang"
include "std/emit.lang"
include "src/lang_reader.lang"

reader loops(text *u8) *u8 {
    // continue: skip i == 3, so the sum is 0+1+2+4 = 7
    var sum i64 = 0;
    var i i64 = 0;
    while i < 5 {
        if i == 3 {
            i = i + 1;
            continue;
        }
        sum = sum + i;
        i = i + 1;
    }

    // break: stop at j == 5, so the count is 5 not 100
    var count i64 = 0;
    var j i64 = 0;
    while j < 100 {
        if j == 5 {
            break;
        }
        count = count + 1;
        j = j + 1;
    }

    // labeled break: leaves the outer loop from inside the inner one
    var hits i64 = 0;
    var a i64 = 0;
    outer:
    while a < 10 {
        var b i64 = 0;
        while b < 10 {
            hits = hits + 1;
            if hits == 6 {
                break outer;
            }
            b = b + 1;
        }
        a = a + 1;
    }

    // 7 * 6 = 42, and count must be exactly 5
    var result i64 = sum * hits;
    if hits != 6 { result = 0; }
    if count != 5 { result = 0; }
    return lang(emit_number(result));
}

func main() i64 {
    return #loops{ignored};
}
