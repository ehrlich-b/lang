include "std/parser_runtime.lang"
include "std/ast.lang"

#parser{
    answer_program = good:('answer' value:number) | bad:('bad' value:symbol)
}

reader parser_tiny(text *u8) *u8 {
    var tokens *Tokenizer = tok_new(text);
    var tree *PNode = parse_answer_program(tokens);
    if tree == nil || !tok_eof(tokens) { return nil; }
    var value *PNode = pnode_require(tree, "value");
    if value == nil { return nil; }
    // The labeled alternative says which form matched; no keyword text to sniff.
    var result *u8 = nil;
    if pnode_is(tree, "bad") {
        result = ast_call0(value.text);
    } else if pnode_is(tree, "good") {
        result = ast_number(value.text);
    } else {
        return nil;
    }
    result = ast_span(result, value.start, value.end);
    var body *u8 = ast_block1(ast_return(result));
    return ast_program1(ast_func("main", ast_vec(), ast_type_i64(), body));
}
