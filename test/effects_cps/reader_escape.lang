include "std/core.lang"
effect Ask(i64) i64
reader local_address(text *u8) *u8 { return "(unop & (ident local))"; }
func worker() *i64 {
    var local i64 = perform Ask(3);
    return #local_address{};
}
func main() i64 {
    var result *i64 = handle { worker() } with { return(v) => v, Ask(x, k) => resume k(x) };
