include "std/core.lang"
effect Ask(i64) i64
struct Pair { x i64; y i64; }
struct Box { pair Pair; }
func worker() i64 {
    var a Box;
    a.pair.x = 40;
    a.pair.y = 2;
    var answer i64 = a.pair.x + a.pair.y;
    return perform Ask(answer);
}
func main() i64 {
    var result i64 = handle { worker() } with { return(v) => v, Ask(x, k) => resume k(x) };
    print_int(result); println(""); return 0;
}
