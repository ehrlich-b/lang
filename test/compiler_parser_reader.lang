// Smallest generated-parser reader used to guard `lang compiler`.

include "std/parser_reader.lang"
include "std/ast.lang"

#parser{
    answer_program = (command:'answer' value:number) | (command:'bad' value:symbol)
}

reader parser_tiny(text *u8) *u8 {
    var tokens *Tokenizer = tok_new(text);
    var tree *PNode = parse_answer_program(tokens);
    if tree == nil || !tok_eof(tokens) {
        eprintln("parser_tiny: expected `answer NUMBER`");
        return nil;
    }

    var command *PNode = pnode_require(tree, "command");
    var value *PNode = pnode_require(tree, "value");
    if command == nil || value == nil { return nil; }
    var result *u8 = nil;
    if streq(command.text, "bad") {
        result = ast_ident(value.text);
    } else {
        result = ast_number(value.text);
    }
    result = ast_span(result, value.start, value.end);
    var body *u8 = ast_block1(ast_return(result));
    return ast_program1(ast_func("main", ast_vec(), ast_type_i64(), body));
}
