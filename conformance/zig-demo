#!/usr/bin/env python3
"""Build and measure the M0 oracle/native-reader boundary."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / 'zig'))
from oracle import LOCK, digest, save


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('milestone', choices=['M0'])
    p.add_argument('--zig-version', default='0.17.0', choices=['0.17.0'])
    p.add_argument('--target', default='x86_64-linux', choices=['x86_64-linux'])
    for name in ['source', 'source-archive', 'compiler', 'compiler-archive', 'work', 'receipt']:
        p.add_argument('--' + name, type=Path, required=True)
    p.add_argument('--lang', type=Path, default=ROOT.parent / 'out/lang')
    p.add_argument('--mode-jobs', type=int, choices=range(1, 4), default=1)
    args = p.parse_args()
    if not args.lang.is_file() or not os.access(args.lang, os.X_OK):
        p.error(f'--lang must name an executable Lang compiler: {args.lang}; run make bootstrap PUBLISH_BOOTSTRAP=0 or select one with --lang')
    work = args.work.resolve()
    work.mkdir(parents=True, exist_ok=True)
    commands = [
        ('reference', [sys.executable, '-B', ROOT / 'zig/oracle.py', 'reference',
                       '--source', args.source.resolve(), '--source-archive', args.source_archive.resolve(),
                       '--compiler', args.compiler.resolve(), '--compiler-archive', args.compiler_archive.resolve(),
                       '--mode-jobs', args.mode_jobs]),
        ('harness', [sys.executable, '-B', ROOT / 'zig/oracle.py', 'selftest', '--compiler', args.compiler.resolve()]),
        ('readers', [sys.executable, '-B', ROOT / 'zig/readers.py', '--compiler', args.lang.resolve()]),
    ]
    report = {'milestone': 'M0', 'profile': LOCK, 'profile_sha256': digest(ROOT / 'zig/oracle.lock.json'),
              'lang_compiler_sha256': digest(args.lang.resolve()), 'upstream_passes_claimed': False,
              'candidate_status': 'not_implemented', 'steps': []}
    for name, command in commands:
        receipt = work / f'{name}.json'
        command += ['--work', work / name, '--receipt', receipt]
        with open(work / f'{name}-command.txt', 'wb') as log:
            result = subprocess.run(list(map(str, command)), stdout=log, stderr=log)
        report['steps'].append({'name': name, 'command': list(map(str, command)),
                                'returncode': result.returncode, 'receipt': str(receipt)})
        save(args.receipt, report)
        if result.returncode:
            raise SystemExit(f'M0 {name} failed; see {work / (name + "-command.txt")}')
    reference = json.loads((work / 'reference.json').read_text())
    report.update(U=reference['U'], U_recursive=reference['U_recursive'],
                  P={r['mode']: r['P'] for r in reference['modes']})
    report['status'] = 'boundary_verified_no_candidate_semantics'
    save(args.receipt, report)


if __name__ == '__main__':
    main()
