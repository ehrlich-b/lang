// ============================================================
// std/grammar.lang - Grammar Parser for #parser{} Reader
// ============================================================
//
// Dependencies: std/tok.lang (tokenizer)
include "std/tok.lang"

// Parses simple grammar specifications:
//   rule = alt1 | alt2
//   alt  = elem elem ...
//   elem = 'literal' | name | elem* | elem+ | elem?
//   elem = capture:elem
//
// Token kinds used in grammar:
//   number  - matches TOK_NUMBER
//   symbol  - matches TOK_IDENT (user's symbols)
//   ident   - matches TOK_IDENT (alias)
//   string  - matches TOK_STRING
//   'x'     - matches specific character token
//   name    - references another rule
//
// Modifiers:
//   *  - zero or more
//   +  - one or more
//   ?  - optional

// ============================================================
// Grammar AST Node Kinds
// ============================================================

var GNODE_RULE i64 = 1;       // rule = alternatives
var GNODE_ALT i64 = 2;        // alternative (sequence of elements)
var GNODE_CHOICE i64 = 3;     // choice between alternatives
var GNODE_SEQ i64 = 4;        // sequence of elements
var GNODE_LITERAL i64 = 5;    // 'x' literal token
var GNODE_TOKTYPE i64 = 6;    // number, symbol, string, ident
var GNODE_REF i64 = 7;        // reference to another rule
var GNODE_STAR i64 = 8;       // * (zero or more)
var GNODE_PLUS i64 = 9;       // + (one or more)
var GNODE_OPT i64 = 10;       // ? (optional)
var GNODE_CAPTURE i64 = 11;   // name:element (named lowering capture)
var GNODE_BRANCH i64 = 12;    // name:alternative (labeled choice branch)

// ============================================================
// Grammar Node Structure
// ============================================================

struct GNode {
    kind i64;       // GNODE_*
    name *u8;       // rule name or literal text
    name_len i64;   // length of name
    children *u8;   // Vec of child GNodes (for CHOICE, SEQ)
    child *u8;      // single child (for STAR, PLUS, OPT, CAPTURE)
    start i64;      // byte offset in the grammar, for author diagnostics
}

func gnode_new(kind i64) *GNode {
    var n *GNode = alloc(48);  // 6 fields * 8 bytes
    n.kind = kind;
    n.name = nil;
    n.name_len = 0;
    n.children = nil;
    n.child = nil;
    n.start = -1;
    return n;
}

func gnode_with_name(kind i64, name *u8, name_len i64) *GNode {
    var n *GNode = gnode_new(kind);
    n.name = name;
    n.name_len = name_len;
    return n;
}

// ============================================================
// Grammar Structure
// ============================================================

struct Grammar {
    rules *u8;      // Vec of GNode (GNODE_RULE)
    rule_names *u8; // Map of rule names to GNode
}

func grammar_new() *Grammar {
    var g *Grammar = alloc(16);
    g.rules = vec_new(8);
    g.rule_names = map_new();
    return g;
}

func grammar_add_rule(g *Grammar, rule *GNode) void {
    vec_push(g.rules, rule);
    map_set_n(g.rule_names, rule.name, rule.name_len, rule);
}

func grammar_get_rule(g *Grammar, name *u8, name_len i64) *GNode {
    return map_get_n(g.rule_names, name, name_len);
}

// ============================================================
// Grammar Parser
// ============================================================

struct GrammarParser {
    t *Tokenizer;
    failed i64;
}

func gp_new(text *u8) *GrammarParser {
    var gp *GrammarParser = alloc(16);
    gp.t = tok_new(text);
    gp.failed = 0;
    return gp;
}

func gp_fail(gp *GrammarParser, expected *u8) void {
    if gp.failed != 0 { return; }
    tok_note_expected(gp.t, expected);
    tok_print_error(gp.t, "#parser");
    gp.failed = 1;
}

// Check if current token is a specific keyword
func gp_is_keyword(gp *GrammarParser, kw *u8) bool {
    if tok_kind(gp.t) != TOK_IDENT {
        return false;
    }
    var text *u8 = tok_text_ptr(gp.t);
    var len i64 = tok_text_len(gp.t);
    return str_eq_n(text, len, kw, strlen(kw));
}

// Parse a single element (atom or modified atom)
func gp_parse_element(gp *GrammarParser) *GNode {
    var node *GNode = nil;

    // Named capture: value:number, body:(statement*), etc. The recursive call
    // deliberately consumes the child's modifier first, so `items:expr+`
    // captures the repetition list rather than each individual expression.
    if tok_kind(gp.t) == TOK_IDENT {
        var mark i64 = tok_mark(gp.t);
        var capture_name *u8 = tok_text_ptr(gp.t);
        var capture_name_len i64 = tok_text_len(gp.t);
        tok_next(gp.t);
        if tok_kind(gp.t) == TOK_COLON {
            tok_next(gp.t);
            var captured *GNode = gp_parse_element(gp);
            if captured == nil {
                gp_fail(gp, "grammar element after capture");
                return nil;
            }
            var capture *GNode = gnode_with_name(
                GNODE_CAPTURE, capture_name, capture_name_len);
            capture.child = captured;
            capture.start = mark;
            return capture;
        }
        tok_reset(gp.t, mark);
    }

    // Literal: 'x'
    if tok_kind(gp.t) == TOK_STRING {
        var start i64 = tok_start_offset(gp.t);
        var text *u8 = tok_text_ptr(gp.t);
        var len i64 = tok_text_len(gp.t);
        // Strip quotes: 'x' -> x
        node = gnode_with_name(GNODE_LITERAL, text + 1, len - 2);
        node.start = start;
        tok_next(gp.t);
    }
    // Token type keywords: number, symbol, string, ident
    else if gp_is_keyword(gp, "number") {
        node = gnode_with_name(GNODE_TOKTYPE, "number", 6);
        node.start = tok_start_offset(gp.t);
        tok_next(gp.t);
    }
    else if gp_is_keyword(gp, "symbol") {
        node = gnode_with_name(GNODE_TOKTYPE, "symbol", 6);
        node.start = tok_start_offset(gp.t);
        tok_next(gp.t);
    }
    else if gp_is_keyword(gp, "string") {
        node = gnode_with_name(GNODE_TOKTYPE, "string", 6);
        node.start = tok_start_offset(gp.t);
        tok_next(gp.t);
    }
    else if gp_is_keyword(gp, "ident") {
        node = gnode_with_name(GNODE_TOKTYPE, "ident", 5);
        node.start = tok_start_offset(gp.t);
        tok_next(gp.t);
    }
    else if gp_is_keyword(gp, "operator") {
        node = gnode_with_name(GNODE_TOKTYPE, "operator", 8);
        node.start = tok_start_offset(gp.t);
        tok_next(gp.t);
    }
    // Rule reference: name (but stop if this ident is followed by '=' - that's a new rule)
    else if tok_kind(gp.t) == TOK_IDENT {
        // Save current token info (workaround for struct.ptr_field bug - use temp)
        var t *Tokenizer = gp.t;
        var text *u8 = tok_text_ptr(t);
        var len i64 = tok_text_len(t);
        // Save full tokenizer state before advancing
        var save_pos i64 = t.pos;
        var save_start i64 = t.tok_start;
        var save_len i64 = t.tok_len;
        var save_kind i64 = t.tok_kind;
        tok_next(t);  // consume the ident
        // Check if this ident is followed by '=' - that means this is a new rule definition
        if tok_kind(t) == TOK_EQ {
            // This is a new rule definition (ident =), restore and return nil
            t.pos = save_pos;
            t.tok_start = save_start;
            t.tok_len = save_len;
            t.tok_kind = save_kind;
            return nil;
        }
        // Not followed by '=', this is a rule reference
        node = gnode_with_name(GNODE_REF, text, len);
        node.start = save_start;
        // tok_next already called, tokenizer is at next token
    }
    // Grouped expression: ( ... )
    else if tok_kind(gp.t) == TOK_LPAREN {
        var group_start i64 = tok_start_offset(gp.t);
        tok_next(gp.t);  // skip '('
        node = gp_parse_choice(gp);
        if node == nil { return nil; }
        if tok_kind(gp.t) != TOK_RPAREN {
            gp_fail(gp, "')'");
            return nil;
        }
        tok_next(gp.t);  // skip ')'
        if node.start < 0 { node.start = group_start; }
    }
    else {
        return nil;
    }

    // Check for modifiers: * + ?
    if tok_kind(gp.t) == TOK_STAR {
        var star *GNode = gnode_new(GNODE_STAR);
        star.child = node;
        star.start = node.start;
        node = star;
        tok_next(gp.t);
    }
    else if tok_kind(gp.t) == TOK_PLUS {
        var plus *GNode = gnode_new(GNODE_PLUS);
        plus.child = node;
        plus.start = node.start;
        node = plus;
        tok_next(gp.t);
    }
    else if tok_kind(gp.t) == TOK_QUESTION || tok_kind(gp.t) == TOK_UNKNOWN {
        // TOK_QUESTION is current; TOK_UNKNOWN accepts caches built with the
        // older tokenizer that did not name '?' yet.
        var text *u8 = tok_text_ptr(gp.t);
        if *text == 63 {
            var opt *GNode = gnode_new(GNODE_OPT);
            opt.child = node;
            opt.start = node.start;
            node = opt;
            tok_next(gp.t);
        }
    }

    return node;
}

// Parse a sequence of elements
func gp_parse_seq(gp *GrammarParser) *GNode {
    var elements *u8 = vec_new(4);

    var done i64 = 0;
    while done == 0 {
        var elem *GNode = gp_parse_element(gp);
        if elem == nil {
            done = 1;
        }
        else {
            vec_push(elements, elem);
        }
    }

    var count i64 = vec_len(elements);
    if count == 0 {
        return nil;
    }
    if count == 1 {
        return vec_get(elements, 0);
    }

    var seq *GNode = gnode_new(GNODE_SEQ);
    seq.children = elements;
    var first *GNode = vec_get(elements, 0);
    seq.start = first.start;
    return seq;
}

// Forward declaration workaround - parse_choice calls parse_seq
func gp_parse_choice(gp *GrammarParser) *GNode {
    var alts *u8 = vec_new(4);

    var first *GNode = gp_parse_seq(gp);
    if first == nil {
        return nil;
    }
    vec_push(alts, first);

    while tok_kind(gp.t) == TOK_PIPE {
        tok_next(gp.t);  // skip '|'
        var alt *GNode = gp_parse_seq(gp);
        if alt == nil {
            gp_fail(gp, "grammar element after '|'");
            return nil;
        }
        vec_push(alts, alt);
    }

    if vec_len(alts) == 1 {
        return vec_get(alts, 0);
    }

    // A capture that IS a whole alternative labels the branch instead of
    // wrapping it: lowering has to ask which alternative matched, and every
    // PNode accessor unwraps, so a wrapper would not survive to be asked.
    var count i64 = vec_len(alts);
    var i i64 = 0;
    while i < count {
        var alt *GNode = vec_get(alts, i);
        if alt.kind == GNODE_CAPTURE { alt.kind = GNODE_BRANCH; }
        i = i + 1;
    }

    var choice *GNode = gnode_new(GNODE_CHOICE);
    choice.children = alts;
    choice.start = first.start;
    return choice;
}

// Parse a single rule: name = choice
func gp_parse_rule(gp *GrammarParser) *GNode {
    if tok_kind(gp.t) != TOK_IDENT {
        return nil;
    }

    var rule_start i64 = tok_start_offset(gp.t);
    var name *u8 = tok_text_ptr(gp.t);
    var name_len i64 = tok_text_len(gp.t);
    tok_next(gp.t);

    // Expect '='
    if tok_kind(gp.t) != TOK_EQ {
        gp_fail(gp, "'='");
        return nil;
    }
    tok_next(gp.t);

    var body *GNode = gp_parse_choice(gp);
    if body == nil {
        gp_fail(gp, "grammar element");
        return nil;
    }

    var rule *GNode = gnode_new(GNODE_RULE);
    rule.name = name;
    rule.name_len = name_len;
    rule.child = body;
    rule.start = rule_start;
    return rule;
}

func grammar_validate_node(g *Grammar, gp *GrammarParser, node *GNode) i64 {
    if node == nil { return 1; }
    if node.kind == GNODE_REF &&
       grammar_get_rule(g, node.name, node.name_len) == nil {
        tok_reset(gp.t, node.start);
        gp_fail(gp, "defined rule");
        return 0;
    }
    if node.children != nil {
        var count i64 = vec_len(node.children);
        var i i64 = 0;
        while i < count {
            if grammar_validate_node(g, gp, vec_get(node.children, i)) == 0 {
                return 0;
            }
            i = i + 1;
        }
    }
    if node.child != nil {
        return grammar_validate_node(g, gp, node.child);
    }
    return 1;
}

func grammar_capture_index(captures *u8, capture *GNode) i64 {
    var count i64 = vec_len(captures);
    var i i64 = 0;
    while i < count {
        var prior *GNode = vec_get(captures, i);
        if str_eq_n(prior.name, prior.name_len,
                    capture.name, capture.name_len) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

func grammar_capture_add(captures *u8, capture *GNode) void {
    if grammar_capture_index(captures, capture) < 0 {
        vec_push(captures, capture);
    }
}

// Reject a label that could occur twice in one successful rule path. A choice
// validates each branch against the same incoming labels, then merges the
// labels it may produce. That keeps `left:x | left:y` useful while rejecting a
// later second `left:` that would be ambiguous for at least one branch.
func grammar_validate_captures(gp *GrammarParser, node *GNode,
                               captures *u8) i64 {
    if node == nil { return 1; }

    if node.kind == GNODE_CAPTURE || node.kind == GNODE_BRANCH {
        if grammar_capture_index(captures, node) >= 0 {
            tok_reset(gp.t, node.start);
            gp_fail(gp, "capture name used once per branch");
            return 0;
        }
        vec_push(captures, node);
        return grammar_validate_captures(gp, node.child, captures);
    }

    if node.kind == GNODE_CHOICE {
        var base i64 = vec_len(captures);
        var merged *u8 = vec_new(4);
        var count i64 = vec_len(node.children);
        var i i64 = 0;
        while i < count {
            while vec_len(captures) > base { vec_pop(captures); }
            if grammar_validate_captures(
                   gp, vec_get(node.children, i), captures) == 0 {
                return 0;
            }
            var j i64 = base;
            while j < vec_len(captures) {
                grammar_capture_add(merged, vec_get(captures, j));
                j = j + 1;
            }
            i = i + 1;
        }
        while vec_len(captures) > base { vec_pop(captures); }
        i = 0;
        while i < vec_len(merged) {
            vec_push(captures, vec_get(merged, i));
            i = i + 1;
        }
        return 1;
    }

    if node.children != nil {
        var count i64 = vec_len(node.children);
        var i i64 = 0;
        while i < count {
            if grammar_validate_captures(
                   gp, vec_get(node.children, i), captures) == 0 {
                return 0;
            }
            i = i + 1;
        }
    }
    if node.child != nil {
        return grammar_validate_captures(gp, node.child, captures);
    }
    return 1;
}

// Does this element resolve to a choice that labels its own alternatives?
func grammar_labels_branch(g *Grammar, node *GNode, visited *u8) i64 {
    if node == nil { return 0; }
    if node.kind == GNODE_CHOICE {
        var count i64 = vec_len(node.children);
        var i i64 = 0;
        while i < count {
            var alt *GNode = vec_get(node.children, i);
            if alt.kind == GNODE_BRANCH { return 1; }
            i = i + 1;
        }
        return 0;
    }
    if node.kind == GNODE_REF {
        if map_get_n(visited, node.name, node.name_len) != 0 { return 0; }
        map_set_n(visited, node.name, node.name_len, 1);
        var rule *GNode = grammar_get_rule(g, node.name, node.name_len);
        if rule == nil { return 0; }
        return grammar_labels_branch(g, rule.child, visited);
    }
    return 0;
}

// A branch label lives on the chosen node, so an alternative that resolves to
// another labeled choice would overwrite that node's label and leave one of the
// two dispatches silently answering for the other. Reject it at the grammar.
func grammar_validate_branches(g *Grammar, gp *GrammarParser,
                               node *GNode) i64 {
    if node == nil { return 1; }
    if node.kind == GNODE_BRANCH &&
       grammar_labels_branch(g, node.child, map_new()) != 0 {
        tok_reset(gp.t, node.start);
        gp_fail(gp,
                "branch label on a rule that does not label its own alternatives");
        return 0;
    }
    if node.children != nil {
        var count i64 = vec_len(node.children);
        var i i64 = 0;
        while i < count {
            if grammar_validate_branches(g, gp, vec_get(node.children, i)) == 0 {
                return 0;
            }
            i = i + 1;
        }
    }
    if node.child != nil {
        return grammar_validate_branches(g, gp, node.child);
    }
    return 1;
}

func grammar_node_nullable(g *Grammar, node *GNode, nullable *u8) i64 {
    if node == nil { return 0; }
    if node.kind == GNODE_OPT || node.kind == GNODE_STAR { return 1; }
    if node.kind == GNODE_CAPTURE || node.kind == GNODE_BRANCH ||
       node.kind == GNODE_PLUS || node.kind == GNODE_RULE {
        return grammar_node_nullable(g, node.child, nullable);
    }
    if node.kind == GNODE_REF {
        if map_get_n(nullable, node.name, node.name_len) != 0 { return 1; }
        return 0;
    }
    if node.kind == GNODE_CHOICE {
        var count i64 = vec_len(node.children);
        var i i64 = 0;
        while i < count {
            if grammar_node_nullable(
                   g, vec_get(node.children, i), nullable) != 0 {
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
    if node.kind == GNODE_SEQ {
        var count i64 = vec_len(node.children);
        var i i64 = 0;
        while i < count {
            if grammar_node_nullable(
                   g, vec_get(node.children, i), nullable) == 0 {
                return 0;
            }
            i = i + 1;
        }
        return 1;
    }
    return 0;
}

func grammar_nullable_rules(g *Grammar) *u8 {
    var nullable *u8 = map_new();
    var changed i64 = 1;
    while changed != 0 {
        changed = 0;
        var count i64 = vec_len(g.rules);
        var i i64 = 0;
        while i < count {
            var rule *GNode = vec_get(g.rules, i);
            if map_get_n(nullable, rule.name, rule.name_len) == 0 &&
               grammar_node_nullable(g, rule.child, nullable) != 0 {
                map_set_n(nullable, rule.name, rule.name_len, 1);
                changed = 1;
            }
            i = i + 1;
        }
    }
    return nullable;
}

// Find a reference to target that can be reached before consuming a token.
// Following nullable sequence prefixes makes this catch both ordinary cycles
// and traps such as `expr = prefix? expr | number`.
func grammar_left_reference(g *Grammar, node *GNode,
                            target *GNode, nullable *u8,
                            visited *u8) *GNode {
    if node == nil { return nil; }
    if node.kind == GNODE_REF {
        if str_eq_n(node.name, node.name_len, target.name, target.name_len) {
            return node;
        }
        if map_get_n(visited, node.name, node.name_len) != 0 { return nil; }
        map_set_n(visited, node.name, node.name_len, 1);
        var referenced *GNode = grammar_get_rule(g, node.name, node.name_len);
        if referenced == nil { return nil; }
        return grammar_left_reference(
            g, referenced.child, target, nullable, visited);
    }
    if node.kind == GNODE_CHOICE {
        var count i64 = vec_len(node.children);
        var i i64 = 0;
        while i < count {
            var found *GNode = grammar_left_reference(
                g, vec_get(node.children, i), target, nullable, visited);
            if found != nil { return found; }
            i = i + 1;
        }
        return nil;
    }
    if node.kind == GNODE_SEQ {
        var count i64 = vec_len(node.children);
        var i i64 = 0;
        while i < count {
            var child *GNode = vec_get(node.children, i);
            var found *GNode = grammar_left_reference(
                g, child, target, nullable, visited);
            if found != nil { return found; }
            if grammar_node_nullable(g, child, nullable) == 0 { return nil; }
            i = i + 1;
        }
        return nil;
    }
    if node.kind == GNODE_CAPTURE || node.kind == GNODE_BRANCH ||
       node.kind == GNODE_OPT || node.kind == GNODE_STAR ||
       node.kind == GNODE_PLUS {
        return grammar_left_reference(g, node.child, target, nullable, visited);
    }
    return nil;
}

func grammar_validate_left_recursion(g *Grammar,
                                     gp *GrammarParser) i64 {
    var nullable *u8 = grammar_nullable_rules(g);
    var count i64 = vec_len(g.rules);
    var i i64 = 0;
    while i < count {
        var rule *GNode = vec_get(g.rules, i);
        var visited *u8 = map_new();
        var found *GNode = grammar_left_reference(
            g, rule.child, rule, nullable, visited);
        if found != nil {
            tok_reset(gp.t, found.start);
            gp_fail(gp, "non-left-recursive rule");
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// Parse a complete grammar
func grammar_parse(text *u8) *Grammar {
    var gp *GrammarParser = gp_new(text);
    var g *Grammar = grammar_new();

    // Native reader expansion passes only the block body; the browser's direct
    // macro hook includes the closing `}` sentinel. Accept that one delimiter,
    // but keep every other trailing token as a grammar error.
    while !tok_eof(gp.t) && tok_kind(gp.t) != TOK_RBRACE && gp.failed == 0 {
        var rule *GNode = gp_parse_rule(gp);
        if rule == nil {
            if gp.failed == 0 { gp_fail(gp, "rule name"); }
            return nil;
        }
        if grammar_get_rule(g, rule.name, rule.name_len) != nil {
            tok_reset(gp.t, rule.start);
            gp_fail(gp, "unique rule name");
            return nil;
        }
        grammar_add_rule(g, rule);
    }

    if gp.failed != 0 { return nil; }
    if vec_len(g.rules) == 0 {
        gp_fail(gp, "rule name");
        return nil;
    }

    var count i64 = vec_len(g.rules);
    var i i64 = 0;
    while i < count {
        var rule *GNode = vec_get(g.rules, i);
        if grammar_validate_node(g, gp, rule.child) == 0 { return nil; }
        if grammar_validate_captures(
               gp, rule.child, vec_new(4)) == 0 { return nil; }
        if grammar_validate_branches(g, gp, rule.child) == 0 { return nil; }
        i = i + 1;
    }

    if grammar_validate_left_recursion(g, gp) == 0 { return nil; }

    return g;
}
