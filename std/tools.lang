// std/tools.lang - Tool detection utilities
//
// Provides functions to find build tools in PATH and common locations.

// Match executable PATH lookup, including empty entries for the current
// directory. Readability does not imply executability, and directories cannot
// be launched even when access(X_OK) succeeds.
pub func find_in_path(tool *u8) *u8 {
    var path *u8 = getenv("PATH");
    if path == nil { return nil; }
    var start *u8 = path;
    var info *u8 = alloc(256);
    while 1 {
        if *path == ':' || *path == 0 {
            var directory *u8 = ".";
            if path != start { directory = str_dup_n(start, path - start); }
            var candidate *u8 = str_concat(str_concat(directory, "/"), tool);
            if os_access(candidate, 1) == 0 && os_stat(candidate, info) == 0 {
                var mode i64 = 0;
                if streq(os_platform_name(), "macos") {
                    var mac_mode *i16 = info + 4;
                    mode = *mac_mode;
                } else {
                    var linux_mode *i32 = info + 24;
                    mode = *linux_mode;
                }
                if (mode & 61440) == 32768 { return candidate; }
            }
            if *path == 0 { return nil; }
            start = path + 1;
        }
        path = path + 1;
    }
    return nil;
}

// Find clang - explicit selection, then PATH and common LLVM locations.
pub func find_clang() *u8 {
    // Reader builds and compiler minting must use the same selected host tool
    // as native builds so dependency receipts identify the actual executable.
    var selected *u8 = getenv("LANG_CLANG");
    if selected != nil && *selected != 0 { return selected; }

    // First try PATH
    var path_clang *u8 = find_in_path("clang");
    if path_clang != nil { return path_clang; }

    // Common locations
    var buf *u8 = alloc(256);

    // macOS Homebrew LLVM
    var loc1 *u8 = "/opt/homebrew/opt/llvm/bin/clang";
    var fd i64 = file_open(loc1, 0);
    if fd >= 0 { file_close(fd); return loc1; }

    // Linux common location
    var loc2 *u8 = "/usr/bin/clang";
    fd = file_open(loc2, 0);
    if fd >= 0 { file_close(fd); return loc2; }

    // Xcode command line tools
    var loc3 *u8 = "/usr/local/bin/clang";
    fd = file_open(loc3, 0);
    if fd >= 0 { file_close(fd); return loc3; }

    return nil;
}

// Find assembler
pub func find_as() *u8 {
    var path_as *u8 = find_in_path("as");
    if path_as != nil { return path_as; }

    // Common locations
    var loc1 *u8 = "/usr/bin/as";
    var fd i64 = file_open(loc1, 0);
    if fd >= 0 { file_close(fd); return loc1; }

    return nil;
}

