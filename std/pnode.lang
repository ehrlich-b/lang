// ============================================================
// PNode - the parse tree shared by generated parsers and the kernel
// ============================================================
//
// Both #parser{}-generated parsers (via std/rdgen.lang) and the kernel's
// S-expression loader (src/sexpr_reader.lang) build this tree. It is defined
// ONCE here so a composed compiler - `kernel -r <name> <reader.ast>`, which
// links a reader's toolkit into the kernel - carries a single copy instead of
// colliding on duplicate symbols. The kernel includes this file; the reader
// toolkit requires it (so -r composition filters it as kernel-supplied).

struct PNode {
    kind i64;       // PNODE_* constant
    text *u8;       // token text (for atoms)
    children *u8;   // vec of *PNode (for lists/sequences)
    start i64;      // zero-based byte start in reader input, or -1
    end i64;        // exclusive byte end in reader input, or -1
    branch *u8;     // label of the choice alternative that built this, or nil
}

var PNODE_NUMBER i64 = 1;
var PNODE_SYMBOL i64 = 2;
var PNODE_STRING i64 = 3;
var PNODE_LIST i64 = 4;
var PNODE_OPERATOR i64 = 5;
var PNODE_CAPTURE i64 = 6;
var PNODE_TOKEN i64 = 7;      // a token kind the reader defined, not the scanner

pub func pnode_new(kind i64) *PNode {
    var n *PNode = alloc(48);
    n.kind = kind;
    n.text = nil;
    n.children = nil;
    n.start = -1;
    n.end = -1;
    n.branch = nil;
    return n;
}

pub func pnode_atom(kind i64, text *u8) *PNode {
    var n *PNode = pnode_new(kind);
    n.text = text;
    return n;
}

pub func pnode_atom_span(kind i64, text *u8, start i64, end i64) *PNode {
    var n *PNode = pnode_atom(kind, text);
    n.start = start;
    n.end = end;
    return n;
}

pub func pnode_list(children *u8) *PNode {
    var n *PNode = pnode_new(PNODE_LIST);
    n.children = children;
    var count i64 = vec_len(children);
    var i i64 = 0;
    while i < count && n.start < 0 {
        var child *PNode = vec_get(children, i);
        if child != nil && child.start >= 0 { n.start = child.start; }
        i = i + 1;
    }
    i = count - 1;
    while i >= 0 && n.end < 0 {
        var child *PNode = vec_get(children, i);
        if child != nil && child.end >= 0 { n.end = child.end; }
        i = i - 1;
    }
    return n;
}

// Captures are opt-in wrappers generated by `name:element` in #parser{}.
// Keeping the label on a wrapper rather than on the child makes nested
// captures safe and leaves the PNode layout and every old grammar unchanged.
pub func pnode_capture(name *u8, child *PNode) *PNode {
    var children *u8 = vec_new(1);
    vec_push(children, child);
    var n *PNode = pnode_list(children);
    n.kind = PNODE_CAPTURE;
    n.text = name;
    return n;
}

pub func pnode_unwrap(node *PNode) *PNode {
    while node != nil && node.kind == PNODE_CAPTURE &&
          node.children != nil && vec_len(node.children) > 0 {
        node = vec_get(node.children, 0);
    }
    return node;
}

pub func pnode_child(node *PNode, index i64) *PNode {
    node = pnode_unwrap(node);
    if node == nil || node.children == nil { return nil; }
    return pnode_unwrap(vec_get(node.children, index));
}

func pnode_collect_capture_chain(node *PNode, name *u8,
                                 matches *u8) void {
    while node != nil && node.kind == PNODE_CAPTURE {
        if node.text != nil && streq(node.text, name) {
            vec_push(matches, pnode_unwrap(node));
        }
        if node.children == nil || vec_len(node.children) == 0 { return; }
        node = vec_get(node.children, 0);
    }
}

func pnode_count_capture_chain(node *PNode, name *u8) i64 {
    var count i64 = 0;
    while node != nil && node.kind == PNODE_CAPTURE {
        if node.text != nil && streq(node.text, name) { count = count + 1; }
        if node.children == nil || vec_len(node.children) == 0 { return count; }
        node = vec_get(node.children, 0);
    }
    return count;
}

func pnode_first_capture_chain(node *PNode, name *u8) *PNode {
    while node != nil && node.kind == PNODE_CAPTURE {
        if node.text != nil && streq(node.text, name) {
            return pnode_unwrap(node);
        }
        if node.children == nil || vec_len(node.children) == 0 { return nil; }
        node = vec_get(node.children, 0);
    }
    return nil;
}

// A labeled alternative names its node instead of wrapping it, so a child that
// carries the label answers the same question a capture wrapper used to.
func pnode_branch_matches(node *PNode, name *u8) i64 {
    node = pnode_unwrap(node);
    if node == nil || node.branch == nil { return 0; }
    if streq(node.branch, name) { return 1; }
    return 0;
}

func pnode_visible_capture_count(node *PNode, name *u8) i64 {
    var total i64 = pnode_count_capture_chain(node, name);
    node = pnode_unwrap(node);
    if node == nil || node.children == nil { return total; }
    var count i64 = vec_len(node.children);
    var i i64 = 0;
    while i < count {
        var child *PNode = vec_get(node.children, i);
        total = total + pnode_count_capture_chain(child, name);
        total = total + pnode_branch_matches(child, name);
        i = i + 1;
    }
    return total;
}

func pnode_first_visible_capture(node *PNode, name *u8) *PNode {
    var found *PNode = pnode_first_capture_chain(node, name);
    if found != nil { return found; }
    node = pnode_unwrap(node);
    if node == nil || node.children == nil { return nil; }
    var count i64 = vec_len(node.children);
    var i i64 = 0;
    while i < count {
        var child *PNode = vec_get(node.children, i);
        found = pnode_first_capture_chain(child, name);
        if found != nil { return found; }
        if pnode_branch_matches(child, name) != 0 { return pnode_unwrap(child); }
        i = i + 1;
    }
    return nil;
}

// Return every matching capture directly visible from this parse node. This is
// the explicit API for captures repeated by `*`/`+` or surfaced by more than
// one referenced rule.
pub func pnode_get_all(node *PNode, name *u8) *u8 {
    var matches *u8 = vec_new(4);
    pnode_collect_capture_chain(node, name, matches);

    node = pnode_unwrap(node);
    if node == nil || node.children == nil { return matches; }
    var count i64 = vec_len(node.children);
    var i i64 = 0;
    while i < count {
        var child *PNode = vec_get(node.children, i);
        pnode_collect_capture_chain(child, name, matches);
        if pnode_branch_matches(child, name) != 0 {
            vec_push(matches, pnode_unwrap(child));
        }
        i = i + 1;
    }
    return matches;
}

func pnode_lookup_one(node *PNode, name *u8, required i64) *PNode {
    var count i64 = pnode_visible_capture_count(node, name);
    if count > 1 {
        eprint("reader lowering error: grammar capture '");
        eprint(name);
        eprintln("' is ambiguous in this parse node");
        return nil;
    }
    if count == 0 {
        if required == 0 { return nil; }
        eprint("reader lowering error: required grammar capture '");
        eprint(name);
        eprintln("' is absent");
        return nil;
    }
    return pnode_first_visible_capture(node, name);
}

// Look up one capture directly visible from this parse node. Optional captures
// return nil; multiple matches are an error instead of an arbitrary first hit.
pub func pnode_get(node *PNode, name *u8) *PNode {
    return pnode_lookup_one(node, name, 0);
}

pub func pnode_require(node *PNode, name *u8) *PNode {
    return pnode_lookup_one(node, name, 1);
}

// A labeled choice alternative (`name:element` as a whole alternative) records
// its name ON the chosen node rather than wrapping it. That is what makes the
// label survive: pnode_child, pnode_get, and pnode_require all unwrap, so a
// wrapper would vanish exactly where lowering needs to ask which branch it got.
// Positional access and existing grammars are unaffected - nothing is inserted
// into the tree.
pub func pnode_set_branch(node *PNode, name *u8) void {
    if node == nil { return; }
    node.branch = name;
}

// Which alternative built this node? Sole dispatch primitive for a labeled
// choice; kinds and child order stay out of it.
pub func pnode_is(node *PNode, name *u8) bool {
    if node == nil || node.branch == nil { return false; }
    return streq(node.branch, name);
}

// The label itself, for reporting a branch the reader does not handle. Returns
// nil when the grammar left the alternative unlabeled.
pub func pnode_branch(node *PNode) *u8 {
    if node == nil { return nil; }
    return node.branch;
}

func pnode_kind_name(kind i64) *u8 {
    if kind == 0 { return "marker"; }
    if kind == PNODE_NUMBER { return "number"; }
    if kind == PNODE_SYMBOL { return "symbol"; }
    if kind == PNODE_STRING { return "string"; }
    if kind == PNODE_LIST { return "list"; }
    if kind == PNODE_OPERATOR { return "operator"; }
    if kind == PNODE_CAPTURE { return "capture"; }
    if kind == PNODE_TOKEN { return "token"; }
    return "unknown";
}

func pnode_dump_text(text *u8) void {
    eprint("\"");
    var p *u8 = text;
    while p != nil && *p != 0 {
        var c i64 = *p;
        if c == 34 { eprint("\\\""); }
        else if c == 92 { eprint("\\\\"); }
        else if c == 10 { eprint("\\n"); }
        else if c == 13 { eprint("\\r"); }
        else if c == 9 { eprint("\\t"); }
        else {
            var byte u8 = c;
            eprint_buf(&byte, 1);
        }
        p = p + 1;
    }
    eprint("\"");
}

func pnode_dump_at(node *PNode, depth i64) void {
    var i i64 = 0;
    while i < depth {
        eprint("  ");
        i = i + 1;
    }
    if node == nil {
        eprintln("nil");
        return;
    }

    eprint(pnode_kind_name(node.kind));
    if node.branch != nil {
        eprint(" <");
        eprint(node.branch);
        eprint(">");
    }
    if node.text != nil {
        eprint(" ");
        pnode_dump_text(node.text);
    }
    eprint(" @");
    eprint_i64(node.start);
    eprint(":");
    eprint_i64(node.end);
    eprint("\n");

    if node.children == nil { return; }
    var count i64 = vec_len(node.children);
    i = 0;
    while i < count {
        pnode_dump_at(vec_get(node.children, i), depth + 1);
        i = i + 1;
    }
}

// Print the generated parse tree to stderr without changing a reader's AST
// output. Capture wrappers are deliberately visible: this is a lowering aid,
// not the transparent positional view exposed by pnode_child.
pub func pnode_dump(node *PNode) void {
    pnode_dump_at(node, 0);
}
