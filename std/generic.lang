include "std/ast.lang"
include "std/stage.lang"

// Instantiate a named scalar without a user type environment.
func list_instantiate(element_type *u8) *u8 {
    return list_instantiate_with_types(element_type, stage_types(""));
}

// Emit a concrete List and its typed push operation. The caller supplies
// aligned storage for capacity elements and initializes len to zero. Pass
// stage_types(...) for named structs. A failed layout returns nil so the reader
// can report the request using its own source span.
func list_instantiate_with_types(element_type *u8, types *u8) *u8 {
    var size i64 = stage_try_named_type_size(types, element_type);
    if size <= 0 { return nil; }

    var name *u8 = str_concat("List_", element_type);
    var item_type *u8 = ast_type(element_type);
    var item_ptr *u8 = ast_type_ptr(item_type);
    var fields *u8 = ast_vec();
    ast_push(fields, ast_field_decl("items", item_ptr));
    ast_push(fields, ast_field_decl("len", ast_type_i64()));
    ast_push(fields, ast_field_decl("capacity", ast_type_i64()));

    var params *u8 = ast_vec();
    ast_push(params, ast_param("list", ast_type_ptr(ast_type(name))));
    ast_push(params, ast_param("item", item_type));

    var list *u8 = ast_ident("list");
    var len *u8 = ast_field(list, "len");
    var capacity *u8 = ast_field(list, "capacity");
    var body *u8 = ast_vec();
    ast_push(body, ast_if_then(ast_binop(">=", len, capacity),
                               ast_block1(ast_return(ast_bool(false)))));
    ast_push(body, ast_var("bytes", ast_type_str(), ast_field(list, "items")));
    var offset *u8 = ast_binop("*", len, ast_int(size));
    ast_push(body, ast_var("slot", item_ptr, ast_binop("+", ast_ident("bytes"), offset)));
    ast_push(body, ast_assign(ast_index(ast_ident("slot"), ast_int(0)), ast_ident("item")));
    ast_push(body, ast_assign(len, ast_binop("+", len, ast_number("1"))));
    ast_push(body, ast_return(ast_bool(true)));

    var decls *u8 = ast_vec();
    ast_push(decls, ast_struct(name, fields));
    ast_push(decls, ast_func(str_concat(name, "_push"), params,
                             ast_type_bool(), ast_block(body)));
    return ast_program(decls);
}

// A read-time specialization queue. Readers provide an opaque template,
// concrete arguments and a canonical key. They emit ordinary declarations
// from the queue in request order, including requests made during emission.
include "std/core.lang"
include "std/diagnostics.lang"
include "std/buffer.lang"
include "src/stage_digest.lang"

struct GenericStage {
    names *u8;
    pending *u8;
    inherited *u8;
}

struct GenericInstance {
    name *u8;
    template *u8;
    args *u8;
    origin i64;
    depth i64;
}

var generic_stage_symbol_prefix *u8 = "__lang_generic_";

// The canonical symbol carries the specialization identity across the AST
// boundary, including when a reader runs in a separate process.
func generic_stage_symbol(name *u8, len i64) bool {
    var prefix_len i64 = strlen(generic_stage_symbol_prefix);
    if len != prefix_len + 64 ||
       !str_eq_n(name, prefix_len, generic_stage_symbol_prefix, prefix_len) {
        return false;
    }
    var i i64 = prefix_len;
    while i < len {
        var c u8 = *(name + i);
        if !(c >= '0' && c <= '9') && !(c >= 'a' && c <= 'f') { return false; }
        i = i + 1;
    }
    return true;
}

func generic_stage_new(inherited *u8) *GenericStage {
    phase_charge(24);
    var stage *GenericStage = alloc(24);
    stage.names = map_new();
    stage.pending = vec_new(8);
    stage.inherited = inherited;
    return stage;
}

func generic_stage_request(stage *GenericStage, key *PhaseBuffer, template *u8,
                           args *u8, origin i64, depth i64, limit i64) *u8 {
    var digest *u8 = phase_digest(key.data, key.len);
    var existing *u8 = map_get(stage.names, digest);
    if existing == nil && stage.inherited != nil { existing = map_get(stage.inherited, digest); }
    if existing != nil { return existing; }
    if depth > limit { phase_error("specialization-depth", key.source); }
    phase_charge(40);
    var instance *GenericInstance = alloc(40);
    instance.name = str_concat(generic_stage_symbol_prefix, digest);
    instance.template = template;
    instance.args = args;
    instance.origin = origin;
    instance.depth = depth;
    map_set(stage.names, digest, instance.name);
    vec_push(stage.pending, instance);
    return instance.name;
}

// Publish names only after the reader has emitted all declarations successfully.
func generic_stage_publish(stage *GenericStage) void {
    if stage.inherited == nil || vec_len(stage.pending) == 0 { return; }
    var keys *u8 = map_keys(stage.names);
    var i i64 = 0;
    while i < vec_len(keys) {
        var key *u8 = vec_get(keys, i);
        map_set(stage.inherited, key, map_get(stage.names, key));
        i = i + 1;
    }
    vec_free(keys);
}
