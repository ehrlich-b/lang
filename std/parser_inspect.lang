// Opt-in generated parser boundary. The actual reader supplies its tokenizer,
// including comment policy or a custom token stream. No replacement scanner.
include "std/reader_request.lang"
var parser_inspect_depth i64 = 0;

func parser_inspect_begin(t *Tokenizer) void {
    var stage *u8 = reader_request_inspect_stage;
    if stage == nil { return; }
    parser_inspect_depth = parser_inspect_depth + 1;
    if !streq(stage, "tokens") || parser_inspect_depth != 1 { return; }
    print("LANG-INSPECT/1 tokens\n");
    while !tok_eof(t) {
        if t.comment_error >= 0 {
            tok_expect_end(t); tok_print_error(t, getenv("LANG_INSPECT_READER")); exit(1);
        }
        print("token "); print_int(tok_kind(t)); print(" ");
        pnode_dump_text_to(1, tok_text(t));
        print(" @"); print_int(tok_start_offset(t)); print(":");
        print_int(tok_end_offset(t)); print("\n");
        tok_next(t);
    }
    if !tok_expect_end(t) { tok_print_error(t, getenv("LANG_INSPECT_READER")); exit(1); }
    exit(0);
}

func parser_inspect_end(t *Tokenizer, tree *PNode, rule *u8) void {
    var stage *u8 = reader_request_inspect_stage;
    if stage == nil { return; }
    parser_inspect_depth = parser_inspect_depth - 1;
    if !streq(stage, "tree") || parser_inspect_depth != 0 { return; }
    var complete bool = false;
    if tree != nil { complete = tok_expect_end(t); }
    if !complete { tok_print_error(t, getenv("LANG_INSPECT_READER")); exit(1); }
    print("LANG-INSPECT/1 tree\n");
    pnode_dump_to(1, tree, 0);
    exit(0);
}
