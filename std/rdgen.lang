// ============================================================
// std/rdgen.lang - Recursive Descent Code Generator
// ============================================================
//
// Takes a Grammar and generates lang parser functions.
//
// Generated parsers return a simple AST:
//   struct PNode { kind, text, children, start, end }
//
// Generated functions:
//   parse_<rule>(t *Tokenizer) *PNode

// Dependencies
include "std/emit.lang"
include "std/grammar.lang"

// PNode kinds and constructors come from std/pnode.lang (shared with the
// kernel's sexpr_reader; see the note there).
require "std/pnode"

// ============================================================
// Code Generator State
// ============================================================

struct RDGen {
    sb *StringBuilder;  // output buffer
    grammar *Grammar;   // grammar being generated
    indent i64;         // current indentation level
    next_temp i64;      // unique suffix for generated local names
}

func rdgen_new(g *Grammar) *RDGen {
    var rd *RDGen = alloc(32);
    rd.sb = sb_new();
    rd.grammar = g;
    rd.indent = 0;
    rd.next_temp = 0;
    return rd;
}

func rdgen_indent(rd *RDGen) void {
    var i i64 = 0;
    while i < rd.indent {
        sb_str(rd.sb, "    ");
        i = i + 1;
    }
}

func rdgen_line(rd *RDGen, s *u8) void {
    rdgen_indent(rd);
    sb_str(rd.sb, s);
    sb_char(rd.sb, 10);  // newline
}

func rdgen_str(rd *RDGen, s *u8) void {
    sb_str(rd.sb, s);
}

func rdgen_strn(rd *RDGen, s *u8, len i64) void {
    var i i64 = 0;
    while i < len {
        sb_char(rd.sb, *(s + i));
        i = i + 1;
    }
}

func rdgen_int(rd *RDGen, n i64) void {
    sb_int(rd.sb, n);
}

func rdgen_newline(rd *RDGen) void {
    sb_char(rd.sb, 10);
}

func rdgen_temp(rd *RDGen) i64 {
    var id i64 = rd.next_temp;
    rd.next_temp = rd.next_temp + 1;
    return id;
}

func rdgen_name1(prefix *u8, id i64) *u8 {
    var sb *StringBuilder = sb_new();
    sb_str(sb, prefix);
    sb_int(sb, id);
    return sb_finish(sb);
}

func rdgen_name2(prefix *u8, id i64, index i64) *u8 {
    var sb *StringBuilder = sb_new();
    sb_str(sb, prefix);
    sb_int(sb, id);
    sb_char(sb, 95);  // _
    sb_int(sb, index);
    return sb_finish(sb);
}

// ============================================================
// Stack-based Expression Generator (avoids mutual recursion)
// ============================================================
//
// Instead of recursive calls, we use a work stack.
// Each stack entry contains: (node, result_var, phase)
// Phase 0 = start, Phase 1+ = continuation after child processing

struct GenWork {
    node *GNode;
    result_var *u8;
    phase i64;
    temp_data *u8;  // for storing intermediate results
    temp_int i64;   // for storing loop counters
    temp_id i64;    // unique names for this generated expression
}

func genwork_new(node *GNode, result_var *u8) *GenWork {
    var w *GenWork = alloc(48);
    w.node = node;
    w.result_var = result_var;
    w.phase = 0;
    w.temp_data = nil;
    w.temp_int = 0;
    w.temp_id = -1;
    return w;
}

// Generate code for an expression using iterative stack
func rdgen_gen_expr(rd *RDGen, root *GNode, root_result_var *u8) void {
    if root == nil {
        return;
    }

    // Work stack
    var stack *u8 = vec_new(16);
    vec_push(stack, genwork_new(root, root_result_var));

    while vec_len(stack) > 0 {
        var work *GenWork = vec_pop(stack);
        var node *GNode = work.node;
        var result_var *u8 = work.result_var;
        var phase i64 = work.phase;
        var kind i64 = node.kind;

        // LITERAL: '(' or similar
        if kind == GNODE_LITERAL {
            var lit *u8 = node.name;
            var len i64 = node.name_len;
            if len == 1 {
                var c i64 = *lit;
                rdgen_indent(rd);
                sb_str(rd.sb, "if tok_kind(t) == ");
                if c == 40 { sb_str(rd.sb, "TOK_LPAREN"); }
                else if c == 41 { sb_str(rd.sb, "TOK_RPAREN"); }
                else if c == 91 { sb_str(rd.sb, "TOK_LBRACKET"); }
                else if c == 93 { sb_str(rd.sb, "TOK_RBRACKET"); }
                else if c == 123 { sb_str(rd.sb, "TOK_LBRACE"); }
                else if c == 125 { sb_str(rd.sb, "TOK_RBRACE"); }
                else if c == 43 { sb_str(rd.sb, "TOK_PLUS"); }
                else if c == 45 { sb_str(rd.sb, "TOK_MINUS"); }
                else if c == 42 { sb_str(rd.sb, "TOK_STAR"); }
                else if c == 47 { sb_str(rd.sb, "TOK_SLASH"); }
                else if c == 44 { sb_str(rd.sb, "TOK_COMMA"); }
                else if c == 46 { sb_str(rd.sb, "TOK_DOT"); }
                else if c == 61 { sb_str(rd.sb, "TOK_EQ"); }
                else if c == 59 { sb_str(rd.sb, "TOK_SEMI"); }
                else if c == 58 { sb_str(rd.sb, "TOK_COLON"); }
                else if c == 60 { sb_str(rd.sb, "TOK_LT"); }
                else if c == 62 { sb_str(rd.sb, "TOK_GT"); }
                else if c == 33 { sb_str(rd.sb, "TOK_BANG"); }
                else if c == 37 { sb_str(rd.sb, "TOK_PERCENT"); }
                else if c == 38 { sb_str(rd.sb, "TOK_AMP"); }
                else if c == 124 { sb_str(rd.sb, "TOK_PIPE"); }
                else if c == 63 { sb_str(rd.sb, "TOK_QUESTION"); }
                else if c == 126 { sb_str(rd.sb, "TOK_TILDE"); }
                else {
                    sb_int(rd.sb, c);
                }
                sb_str(rd.sb, " && tok_text_len(t) == 1 { ");
                sb_str(rd.sb, result_var);
                // Marker keeps its matched text (kind stays 0, so `kind != 0`
                // skip-checks are unaffected) so converters can tell '(' from '['.
                sb_str(rd.sb, " = pnode_atom_span(0, tok_text(t), tok_start_offset(t), tok_end_offset(t)); tok_next(t); } else { tok_note_expected(t, \"'");
                rdgen_strn(rd, lit, len);
                sb_str(rd.sb, "'\"); }");
                rdgen_newline(rd);
            }
            else {
                // Multi-char literals match exact token text. This covers both
                // keywords (`return`) and operators (`==`, `->`, `++`).
                rdgen_indent(rd);
                sb_str(rd.sb, "if str_eq_n(tok_text_ptr(t), tok_text_len(t), \"");
                var ki i64 = 0;
                while ki < len {
                    sb_char(rd.sb, *(lit + ki));
                    ki = ki + 1;
                }
                sb_str(rd.sb, "\", ");
                sb_int(rd.sb, len);
                sb_str(rd.sb, ") { ");
                sb_str(rd.sb, result_var);
                sb_str(rd.sb, " = pnode_atom_span(2, tok_text(t), tok_start_offset(t), tok_end_offset(t)); tok_next(t); } else { tok_note_expected(t, \"'");
                rdgen_strn(rd, lit, len);
                sb_str(rd.sb, "'\"); }");
                rdgen_newline(rd);
            }
        }

        // TOKTYPE: number, symbol, string
        else if kind == GNODE_TOKTYPE {
            var name *u8 = node.name;
            var name_len i64 = node.name_len;

            rdgen_indent(rd);
            sb_str(rd.sb, "if tok_kind(t) == ");
            if str_eq_n(name, name_len, "number", 6) {
                sb_str(rd.sb, "TOK_NUMBER");
            }
            else if str_eq_n(name, name_len, "symbol", 6) {
                sb_str(rd.sb, "TOK_IDENT");
            }
            else if str_eq_n(name, name_len, "ident", 5) {
                sb_str(rd.sb, "TOK_IDENT");
            }
            else if str_eq_n(name, name_len, "string", 6) {
                sb_str(rd.sb, "TOK_STRING");
            }
            else if str_eq_n(name, name_len, "operator", 8) {
                // operator matches +, -, *, /, %, <, >, =, !, &, |, ^, ~
                sb_str(rd.sb, "TOK_PLUS || tok_kind(t) == TOK_MINUS || tok_kind(t) == TOK_STAR || tok_kind(t) == TOK_SLASH || tok_kind(t) == TOK_PERCENT || tok_kind(t) == TOK_LT || tok_kind(t) == TOK_GT || tok_kind(t) == TOK_EQ || tok_kind(t) == TOK_BANG || tok_kind(t) == TOK_AMP || tok_kind(t) == TOK_PIPE || tok_kind(t) == TOK_CARET || tok_kind(t) == TOK_TILDE");
            }
            sb_str(rd.sb, " {");
            rdgen_newline(rd);

            rd.indent = rd.indent + 1;
            rdgen_indent(rd);
            sb_str(rd.sb, result_var);
            sb_str(rd.sb, " = pnode_atom_span(");
            if str_eq_n(name, name_len, "number", 6) {
                sb_str(rd.sb, "1");
            }
            else if str_eq_n(name, name_len, "symbol", 6) {
                sb_str(rd.sb, "2");
            }
            else if str_eq_n(name, name_len, "ident", 5) {
                sb_str(rd.sb, "2");
            }
            else if str_eq_n(name, name_len, "string", 6) {
                sb_str(rd.sb, "3");
            }
            else if str_eq_n(name, name_len, "operator", 8) {
                sb_str(rd.sb, "5");  // kind 5 = operator
            }
            sb_str(rd.sb, ", tok_text(t), tok_start_offset(t), tok_end_offset(t));");
            rdgen_newline(rd);
            rdgen_line(rd, "tok_next(t);");
            rd.indent = rd.indent - 1;
            rdgen_indent(rd);
            sb_str(rd.sb, "} else { tok_note_expected(t, \"");
            rdgen_strn(rd, name, name_len);
            sb_str(rd.sb, "\"); }");
            rdgen_newline(rd);
        }

        // REF: reference to another rule
        else if kind == GNODE_REF {
            rdgen_indent(rd);
            sb_str(rd.sb, result_var);
            sb_str(rd.sb, " = parse_");
            rdgen_strn(rd, node.name, node.name_len);
            sb_str(rd.sb, "(t);");
            rdgen_newline(rd);
        }

        // SEQ: sequence of elements (multi-phase)
        else if kind == GNODE_SEQ {
            var children *u8 = node.children;
            var n i64 = vec_len(children);

            if phase == 0 {
                work.temp_id = rdgen_temp(rd);
                var seq_name *u8 = rdgen_name1("_seq", work.temp_id);
                var mark_name *u8 = rdgen_name1("_seq_mark", work.temp_id);
                var ok_name *u8 = rdgen_name1("_seq_ok", work.temp_id);

                rdgen_indent(rd);
                sb_str(rd.sb, "var ");
                sb_str(rd.sb, mark_name);
                sb_str(rd.sb, " i64 = tok_mark(t);");
                rdgen_newline(rd);
                rdgen_indent(rd);
                sb_str(rd.sb, "var ");
                sb_str(rd.sb, seq_name);
                sb_str(rd.sb, " *u8 = vec_new(");
                rdgen_int(rd, n);
                sb_str(rd.sb, ");");
                rdgen_newline(rd);
                rdgen_indent(rd);
                sb_str(rd.sb, "var ");
                sb_str(rd.sb, ok_name);
                sb_str(rd.sb, " i64 = 1;");
                rdgen_newline(rd);

                if n > 0 {
                    var elem_name *u8 = rdgen_name2("_e", work.temp_id, 0);
                    rdgen_indent(rd);
                    sb_str(rd.sb, "var ");
                    sb_str(rd.sb, elem_name);
                    sb_str(rd.sb, " *PNode = nil;");
                    rdgen_newline(rd);

                    work.phase = 1;
                    work.temp_int = 0;
                    vec_push(stack, work);

                    var child *GNode = vec_get(children, 0);
                    vec_push(stack, genwork_new(child, elem_name));
                }
                else {
                    rdgen_indent(rd);
                    sb_str(rd.sb, result_var);
                    sb_str(rd.sb, " = pnode_list(");
                    sb_str(rd.sb, seq_name);
                    sb_str(rd.sb, ");");
                    rdgen_newline(rd);
                }
            }
            else {
                var i i64 = work.temp_int;
                var seq_name *u8 = rdgen_name1("_seq", work.temp_id);
                var mark_name *u8 = rdgen_name1("_seq_mark", work.temp_id);
                var ok_name *u8 = rdgen_name1("_seq_ok", work.temp_id);
                var elem_name *u8 = rdgen_name2("_e", work.temp_id, i);
                var completed_child *GNode = vec_get(children, i);

                // Optional elements may be absent. Every other sequence element
                // is required; failure rewinds the whole sequence.
                if completed_child.kind != GNODE_OPT {
                    rdgen_indent(rd);
                    sb_str(rd.sb, "if ");
                    sb_str(rd.sb, elem_name);
                    sb_str(rd.sb, " == nil { ");
                    sb_str(rd.sb, ok_name);
                    sb_str(rd.sb, " = 0; }");
                    rdgen_newline(rd);
                }

                rdgen_indent(rd);
                sb_str(rd.sb, "if ");
                sb_str(rd.sb, elem_name);
                sb_str(rd.sb, " != nil { vec_push(");
                sb_str(rd.sb, seq_name);
                sb_str(rd.sb, ", ");
                sb_str(rd.sb, elem_name);
                sb_str(rd.sb, "); }");
                rdgen_newline(rd);

                i = i + 1;
                if i < n {
                    rdgen_indent(rd);
                    sb_str(rd.sb, "if ");
                    sb_str(rd.sb, ok_name);
                    sb_str(rd.sb, " != 0 {");
                    rdgen_newline(rd);
                    rd.indent = rd.indent + 1;

                    var next_elem_name *u8 = rdgen_name2("_e", work.temp_id, i);
                    rdgen_indent(rd);
                    sb_str(rd.sb, "var ");
                    sb_str(rd.sb, next_elem_name);
                    sb_str(rd.sb, " *PNode = nil;");
                    rdgen_newline(rd);

                    work.phase = phase + 1;
                    work.temp_int = i;
                    vec_push(stack, work);

                    var child *GNode = vec_get(children, i);
                    vec_push(stack, genwork_new(child, next_elem_name));
                }
                else {
                    var closes i64 = n - 1;
                    while closes > 0 {
                        rd.indent = rd.indent - 1;
                        rdgen_line(rd, "}");
                        closes = closes - 1;
                    }

                    rdgen_indent(rd);
                    sb_str(rd.sb, "if ");
                    sb_str(rd.sb, ok_name);
                    sb_str(rd.sb, " != 0 { ");
                    sb_str(rd.sb, result_var);
                    sb_str(rd.sb, " = pnode_list(");
                    sb_str(rd.sb, seq_name);
                    sb_str(rd.sb, "); }");
                    rdgen_newline(rd);
                    rdgen_indent(rd);
                    sb_str(rd.sb, "if ");
                    sb_str(rd.sb, ok_name);
                    sb_str(rd.sb, " == 0 { tok_reset(t, ");
                    sb_str(rd.sb, mark_name);
                    sb_str(rd.sb, "); }");
                    rdgen_newline(rd);
                }
            }
        }

        // CHOICE: alternatives (multi-phase)
        else if kind == GNODE_CHOICE {
            var children *u8 = node.children;
            var n i64 = vec_len(children);

            if phase == 0 {
                work.temp_id = rdgen_temp(rd);
                var mark_name *u8 = rdgen_name1("_choice_mark", work.temp_id);
                rdgen_indent(rd);
                sb_str(rd.sb, "var ");
                sb_str(rd.sb, mark_name);
                sb_str(rd.sb, " i64 = tok_mark(t);");
                rdgen_newline(rd);
            }

            if phase < n {
                if phase > 0 {
                    var mark_name *u8 = rdgen_name1("_choice_mark", work.temp_id);
                    rdgen_indent(rd);
                    sb_str(rd.sb, "if ");
                    sb_str(rd.sb, result_var);
                    sb_str(rd.sb, " == nil {");
                    rdgen_newline(rd);
                    rd.indent = rd.indent + 1;
                    rdgen_indent(rd);
                    sb_str(rd.sb, "tok_reset(t, ");
                    sb_str(rd.sb, mark_name);
                    sb_str(rd.sb, ");");
                    rdgen_newline(rd);
                }

                work.phase = phase + 1;
                vec_push(stack, work);

                var child *GNode = vec_get(children, phase);
                vec_push(stack, genwork_new(child, result_var));
            }
            else {
                var mark_name *u8 = rdgen_name1("_choice_mark", work.temp_id);
                rdgen_indent(rd);
                sb_str(rd.sb, "if ");
                sb_str(rd.sb, result_var);
                sb_str(rd.sb, " == nil { tok_reset(t, ");
                sb_str(rd.sb, mark_name);
                sb_str(rd.sb, "); }");
                rdgen_newline(rd);

                var closes i64 = n - 1;
                while closes > 0 {
                    rd.indent = rd.indent - 1;
                    rdgen_line(rd, "}");
                    closes = closes - 1;
                }
            }
        }

        // STAR: zero or more (multi-phase)
        else if kind == GNODE_STAR {
            var child *GNode = node.child;

            if phase == 0 {
                work.temp_id = rdgen_temp(rd);
                var list_name *u8 = rdgen_name1("_star_list", work.temp_id);
                var done_name *u8 = rdgen_name1("_star_done", work.temp_id);
                var mark_name *u8 = rdgen_name1("_star_mark", work.temp_id);
                var item_name *u8 = rdgen_name1("_star_item", work.temp_id);
                rdgen_indent(rd);
                sb_str(rd.sb, "var ");
                sb_str(rd.sb, list_name);
                sb_str(rd.sb, " *u8 = vec_new(8);");
                rdgen_newline(rd);
                rdgen_indent(rd);
                sb_str(rd.sb, "var ");
                sb_str(rd.sb, done_name);
                sb_str(rd.sb, " i64 = 0;");
                rdgen_newline(rd);
                rdgen_indent(rd);
                sb_str(rd.sb, "while ");
                sb_str(rd.sb, done_name);
                sb_str(rd.sb, " == 0 {");
                rdgen_newline(rd);
                rd.indent = rd.indent + 1;
                rdgen_indent(rd);
                sb_str(rd.sb, "var ");
                sb_str(rd.sb, mark_name);
                sb_str(rd.sb, " i64 = tok_mark(t);");
                rdgen_newline(rd);
                rdgen_indent(rd);
                sb_str(rd.sb, "var ");
                sb_str(rd.sb, item_name);
                sb_str(rd.sb, " *PNode = nil;");
                rdgen_newline(rd);

                work.phase = 1;
                vec_push(stack, work);
                vec_push(stack, genwork_new(child, item_name));
            }
            else if phase == 1 {
                var list_name *u8 = rdgen_name1("_star_list", work.temp_id);
                var done_name *u8 = rdgen_name1("_star_done", work.temp_id);
                var mark_name *u8 = rdgen_name1("_star_mark", work.temp_id);
                var item_name *u8 = rdgen_name1("_star_item", work.temp_id);
                rdgen_indent(rd);
                sb_str(rd.sb, "if ");
                sb_str(rd.sb, item_name);
                sb_str(rd.sb, " == nil { tok_reset(t, ");
                sb_str(rd.sb, mark_name);
                sb_str(rd.sb, "); ");
                sb_str(rd.sb, done_name);
                sb_str(rd.sb, " = 1; }");
                rdgen_newline(rd);
                rdgen_indent(rd);
                sb_str(rd.sb, "if ");
                sb_str(rd.sb, item_name);
                sb_str(rd.sb, " != nil && tok_mark(t) == ");
                sb_str(rd.sb, mark_name);
                sb_str(rd.sb, " { ");
                sb_str(rd.sb, done_name);
                sb_str(rd.sb, " = 1; }");
                rdgen_newline(rd);
                rdgen_indent(rd);
                sb_str(rd.sb, "if ");
                sb_str(rd.sb, item_name);
                sb_str(rd.sb, " != nil && tok_mark(t) != ");
                sb_str(rd.sb, mark_name);
                sb_str(rd.sb, " { vec_push(");
                sb_str(rd.sb, list_name);
                sb_str(rd.sb, ", ");
                sb_str(rd.sb, item_name);
                sb_str(rd.sb, "); }");
                rdgen_newline(rd);
                rd.indent = rd.indent - 1;
                rdgen_line(rd, "}");

                rdgen_indent(rd);
                sb_str(rd.sb, result_var);
                sb_str(rd.sb, " = pnode_list(");
                sb_str(rd.sb, list_name);
                sb_str(rd.sb, ");");
                rdgen_newline(rd);
            }
        }

        // PLUS: one or more
        else if kind == GNODE_PLUS {
            var child *GNode = node.child;

            if phase == 0 {
                work.temp_id = rdgen_temp(rd);
                var list_name *u8 = rdgen_name1("_plus_list", work.temp_id);
                var mark_name *u8 = rdgen_name1("_plus_mark", work.temp_id);
                var first_name *u8 = rdgen_name1("_plus_first", work.temp_id);
                rdgen_indent(rd);
                sb_str(rd.sb, "var ");
                sb_str(rd.sb, mark_name);
                sb_str(rd.sb, " i64 = tok_mark(t);");
                rdgen_newline(rd);
                rdgen_indent(rd);
                sb_str(rd.sb, "var ");
                sb_str(rd.sb, list_name);
                sb_str(rd.sb, " *u8 = vec_new(8);");
                rdgen_newline(rd);
                rdgen_indent(rd);
                sb_str(rd.sb, "var ");
                sb_str(rd.sb, first_name);
                sb_str(rd.sb, " *PNode = nil;");
                rdgen_newline(rd);

                work.phase = 1;
                vec_push(stack, work);
                vec_push(stack, genwork_new(child, first_name));
            }
            else if phase == 1 {
                var list_name *u8 = rdgen_name1("_plus_list", work.temp_id);
                var mark_name *u8 = rdgen_name1("_plus_mark", work.temp_id);
                var first_name *u8 = rdgen_name1("_plus_first", work.temp_id);
                var done_name *u8 = rdgen_name1("_plus_done", work.temp_id);
                var loop_mark_name *u8 = rdgen_name1("_plus_loop_mark", work.temp_id);
                var item_name *u8 = rdgen_name1("_plus_item", work.temp_id);

                rdgen_indent(rd);
                sb_str(rd.sb, "if ");
                sb_str(rd.sb, first_name);
                sb_str(rd.sb, " == nil { tok_reset(t, ");
                sb_str(rd.sb, mark_name);
                sb_str(rd.sb, "); }");
                rdgen_newline(rd);
                rdgen_indent(rd);
                sb_str(rd.sb, "if ");
                sb_str(rd.sb, first_name);
                sb_str(rd.sb, " != nil {");
                rdgen_newline(rd);
                rd.indent = rd.indent + 1;
                rdgen_indent(rd);
                sb_str(rd.sb, "vec_push(");
                sb_str(rd.sb, list_name);
                sb_str(rd.sb, ", ");
                sb_str(rd.sb, first_name);
                sb_str(rd.sb, ");");
                rdgen_newline(rd);
                rdgen_indent(rd);
                sb_str(rd.sb, "var ");
                sb_str(rd.sb, done_name);
                sb_str(rd.sb, " i64 = 0;");
                rdgen_newline(rd);
                rdgen_indent(rd);
                sb_str(rd.sb, "while ");
                sb_str(rd.sb, done_name);
                sb_str(rd.sb, " == 0 {");
                rdgen_newline(rd);
                rd.indent = rd.indent + 1;
                rdgen_indent(rd);
                sb_str(rd.sb, "var ");
                sb_str(rd.sb, loop_mark_name);
                sb_str(rd.sb, " i64 = tok_mark(t);");
                rdgen_newline(rd);
                rdgen_indent(rd);
                sb_str(rd.sb, "var ");
                sb_str(rd.sb, item_name);
                sb_str(rd.sb, " *PNode = nil;");
                rdgen_newline(rd);

                work.phase = 2;
                vec_push(stack, work);
                vec_push(stack, genwork_new(child, item_name));
            }
            else if phase == 2 {
                var list_name *u8 = rdgen_name1("_plus_list", work.temp_id);
                var done_name *u8 = rdgen_name1("_plus_done", work.temp_id);
                var loop_mark_name *u8 = rdgen_name1("_plus_loop_mark", work.temp_id);
                var item_name *u8 = rdgen_name1("_plus_item", work.temp_id);
                rdgen_indent(rd);
                sb_str(rd.sb, "if ");
                sb_str(rd.sb, item_name);
                sb_str(rd.sb, " == nil { tok_reset(t, ");
                sb_str(rd.sb, loop_mark_name);
                sb_str(rd.sb, "); ");
                sb_str(rd.sb, done_name);
                sb_str(rd.sb, " = 1; }");
                rdgen_newline(rd);
                rdgen_indent(rd);
                sb_str(rd.sb, "if ");
                sb_str(rd.sb, item_name);
                sb_str(rd.sb, " != nil && tok_mark(t) == ");
                sb_str(rd.sb, loop_mark_name);
                sb_str(rd.sb, " { ");
                sb_str(rd.sb, done_name);
                sb_str(rd.sb, " = 1; }");
                rdgen_newline(rd);
                rdgen_indent(rd);
                sb_str(rd.sb, "if ");
                sb_str(rd.sb, item_name);
                sb_str(rd.sb, " != nil && tok_mark(t) != ");
                sb_str(rd.sb, loop_mark_name);
                sb_str(rd.sb, " { vec_push(");
                sb_str(rd.sb, list_name);
                sb_str(rd.sb, ", ");
                sb_str(rd.sb, item_name);
                sb_str(rd.sb, "); }");
                rdgen_newline(rd);
                rd.indent = rd.indent - 1;
                rdgen_line(rd, "}");

                rdgen_indent(rd);
                sb_str(rd.sb, result_var);
                sb_str(rd.sb, " = pnode_list(");
                sb_str(rd.sb, list_name);
                sb_str(rd.sb, ");");
                rdgen_newline(rd);
                rd.indent = rd.indent - 1;
                rdgen_line(rd, "}");
            }
        }

        // OPT: optional
        else if kind == GNODE_OPT {
            var child *GNode = node.child;
            if phase == 0 {
                work.temp_id = rdgen_temp(rd);
                var mark_name *u8 = rdgen_name1("_opt_mark", work.temp_id);
                rdgen_indent(rd);
                sb_str(rd.sb, "var ");
                sb_str(rd.sb, mark_name);
                sb_str(rd.sb, " i64 = tok_mark(t);");
                rdgen_newline(rd);
                work.phase = 1;
                vec_push(stack, work);
                vec_push(stack, genwork_new(child, result_var));
            }
            else {
                var mark_name *u8 = rdgen_name1("_opt_mark", work.temp_id);
                rdgen_indent(rd);
                sb_str(rd.sb, "if ");
                sb_str(rd.sb, result_var);
                sb_str(rd.sb, " == nil { tok_reset(t, ");
                sb_str(rd.sb, mark_name);
                sb_str(rd.sb, "); }");
                rdgen_newline(rd);
            }
        }
    }
}

// Generate a single parser function
func rdgen_gen_rule(rd *RDGen, rule *GNode) void {
    rdgen_indent(rd);
    sb_str(rd.sb, "func parse_");
    rdgen_strn(rd, rule.name, rule.name_len);
    sb_str(rd.sb, "(t *Tokenizer) *PNode {");
    rdgen_newline(rd);

    rd.indent = rd.indent + 1;
    rdgen_line(rd, "var result *PNode = nil;");

    rdgen_gen_expr(rd, rule.child, "result");

    rdgen_line(rd, "return result;");
    rd.indent = rd.indent - 1;
    rdgen_line(rd, "}");
    rdgen_newline(rd);
}

// Generate all parser functions for a grammar
func rdgen_generate(g *Grammar) *u8 {
    var rd *RDGen = rdgen_new(g);

    // PNode struct + pnode_* helpers are static in parser_reader.lang, not
    // generated per-grammar, so a program with multiple #parser{} grammars
    // doesn't redefine them (duplicate-symbol collision).

    // Emit parser functions
    var rules *u8 = g.rules;
    var n i64 = vec_len(rules);
    var i i64 = 0;
    while i < n {
        var rule *GNode = vec_get(rules, i);
        rdgen_gen_rule(rd, rule);
        i = i + 1;
    }

    return sb_finish(rd.sb);
}
