var PHASE_PROTOCOL_VERSION i64 = 1;
var PHASE_CACHE_VERSION i64 = 1;
// Bounded owned byte storage. Limits count payload bytes, excluding sentinel.
struct PhaseBuffer { data *u8; len i64; cap i64; limit i64; source *u8; }
var phase_budget_used i64 = 0;
var phase_budget_limit i64 = 1073741824;
var phase_work_used i64 = 0;
var phase_work_limit i64 = 16777216;
var phase_diagnostic_source *u8 = "<compiler-host>";

pub func phase_error(code *u8, source *u8) void {
    phase_error_at(code, source, -1, -1);
}
pub func phase_error_at(code *u8, source *u8, start i64, end i64) void {
    ___compiler_diagnostic_context(code, source, start, end);
    eprint("(host-error (version 1) (code "); eprint(code);
    eprint(") (source ");
    phase_error_string(source);
    eprintln(") (phase 1))");
    exit(1);
}
pub func phase_error_string(s *u8) void {
    eprint("\"");
    if s != nil {
        while *s != 0 {
            var c u8 = *s;
            if c == 34 || c == 92 { eprint("\\"); }
            if c < 32 { eprint("?"); } else { eprint_buf(s, 1); }
            s = s + 1;
        }
    }
    eprint("\"");
}
// Explicit process configuration; invalid/overflowed limits never wrap.
var phase_configured_limit i64 = 0;
pub func phase_limit() i64 {
    if phase_configured_limit != 0 { return phase_configured_limit; }
    var s *u8 = getenv("LANG_HOST_MAX_BYTES");
    if s == nil || *s == 0 { phase_configured_limit = 16777216; return phase_configured_limit; }
    var n i64 = 0;
    while *s != 0 {
        if *s < 48 || *s > 57 || n > 107374182 { phase_error("invalid-limit", phase_diagnostic_source); }
        n = n * 10 + *s - 48;
        s = s + 1;
    }
    if n < 1 || n > 1073741824 { phase_error("invalid-limit", phase_diagnostic_source); }
    phase_configured_limit = n; return n;
}
pub func phase_charge(bytes i64) void {
    if bytes < 0 || bytes > phase_budget_limit - phase_budget_used {
        phase_error("memory-budget", phase_diagnostic_source);
    }
    phase_budget_used = phase_budget_used + bytes;
}
pub func phase_work(amount i64) void {
    if amount < 0 || amount > phase_work_limit - phase_work_used {
        phase_error("work-budget", phase_diagnostic_source);
    }
    phase_work_used = phase_work_used + amount;
}
pub func phase_buffer_new(limit i64, source *u8) *PhaseBuffer {
    if limit < 0 || limit > 1073741824 { phase_error("invalid-limit", source); }
    phase_charge(48);
    var b *PhaseBuffer = alloc(48);
    b.data = nil; b.len = 0; b.cap = 0; b.limit = limit; b.source = source;
    return b;
}
pub func phase_buffer_reserve(b *PhaseBuffer, extra i64) void {
    if extra < 0 || extra > b.limit - b.len { phase_error("byte-limit", b.source); }
    var need i64 = b.len + extra + 1;
    if need <= b.cap { return; }
    var cap i64 = b.cap;
    if cap == 0 { cap = 256; }
    while cap < need { cap = cap * 2; }
    if cap > b.limit + 1 { cap = b.limit + 1; }
    phase_charge(cap);
    var data *u8 = alloc(cap);
    if b.len > 0 { memcpy(data, b.data, b.len); }
    b.data = data; b.cap = cap;
    *(b.data + b.len) = 0;
}
pub func phase_buffer_append(b *PhaseBuffer, data *u8, len i64) void {
    phase_buffer_reserve(b, len);
    if len > 0 { memcpy(b.data + b.len, data, len); }
    b.len = b.len + len; *(b.data + b.len) = 0;
}
pub func phase_buffer_text(b *PhaseBuffer, s *u8) void { phase_buffer_append(b, s, strlen(s)); }
pub func phase_buffer_int(b *PhaseBuffer, n i64) void {
    var digits *u8 = alloc(24);
    var len i64 = 0;
    if n < 0 { phase_error("negative-field", b.source); }
    if n == 0 { phase_buffer_text(b, "0"); return; }
    while n > 0 { *(digits + len) = n % 10 + 48; len = len + 1; n = n / 10; }
    while len > 0 { len = len - 1; phase_buffer_append(b, digits + len, 1); }
}
pub func phase_buffer_field(b *PhaseBuffer, s *u8) void {
    phase_buffer_int(b, strlen(s)); phase_buffer_text(b, ":"); phase_buffer_text(b, s);
}
pub func phase_read_fd(fd i64, limit i64, source *u8) *PhaseBuffer {
    var b *PhaseBuffer = phase_buffer_new(limit, source);
    var chunk *u8 = alloc(4096);
    var n i64 = file_read(fd, chunk, 4096);
    while n > 0 {
        var i i64 = 0;
        while i < n {
            if *(chunk + i) == 0 { phase_error_at("embedded-nul", source, b.len + i, b.len + i + 1); }
            i = i + 1;
        }
        phase_buffer_append(b, chunk, n);
        n = file_read(fd, chunk, 4096);
    }
    if n < 0 { phase_error("read-failed", source); }
    phase_buffer_reserve(b, 0);
    return b;
}
pub func phase_read_file(path *u8) *u8 {
    var fd i64 = file_open(path, 0);
    if fd < 0 { return nil; }
    var b *PhaseBuffer = phase_read_fd(fd, phase_limit(), path);
    file_close(fd);
    return b.data;
}
// Adapter for callers with a fixed destination; detects overflow at EOF.
pub func phase_read_into(fd i64, buf *u8, cap i64, source *u8) i64 {
    var b *PhaseBuffer = phase_read_fd(fd, cap - 1, source);
    memcpy(buf, b.data, b.len + 1);
    return b.len;
}

// Bridge for legacy pointer/length/capacity triples. Growth and accounting
// still belong to the same service.
pub func phase_grow(data *u8, len i64, cap *i64, extra i64, source *u8) *u8 {
    var b *PhaseBuffer = phase_buffer_new(phase_limit(), source);
    b.data = data; b.len = len; b.cap = *cap;
    phase_buffer_reserve(b, extra); *cap = b.cap; return b.data;
}
