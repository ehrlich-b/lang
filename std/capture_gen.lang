// Included by rdgen after its emitter helpers. Bounds describe syntax only;
// references are lexical boundaries, never inferred domain types.
func capture_bound(node *GNode, name *GNode, upper i64) i64 {
    if node == nil || node.kind == GNODE_REF { return 0; }
    if node.kind == GNODE_CAPTURE &&
       str_eq_n(node.name, node.name_len, name.name, name.name_len) {
        var child *GNode = node.child;
        if child.kind == GNODE_STAR {
            if upper != 0 { return -1; }
            return 0;
        }
        if child.kind == GNODE_PLUS {
            if upper != 0 { return -1; }
            return 1;
        }
        if child.kind == GNODE_OPT && upper == 0 { return 0; }
        return 1;
    }
    if node.kind == GNODE_STAR || node.kind == GNODE_PLUS || node.kind == GNODE_OPT {
        var bound i64 = capture_bound(node.child, name, upper);
        if upper == 0 && node.kind != GNODE_PLUS { return 0; }
        if upper != 0 && node.kind != GNODE_OPT && bound != 0 { return -1; }
        return bound;
    }
    if node.children != nil {
        var total i64 = 0;
        var i i64 = 0;
        while i < vec_len(node.children) {
            var bound i64 = capture_bound(vec_get(node.children, i), name, upper);
            if node.kind == GNODE_CHOICE {
                if i == 0 { total = bound; }
                else if upper == 0 && bound < total { total = bound; }
                else if upper != 0 && (bound == -1 || (total != -1 && bound > total)) { total = bound; }
            } else {
                if bound == -1 || total == -1 { total = -1; }
                else { total = total + bound; }
            }
            i = i + 1;
        }
        return total;
    }
    return capture_bound(node.child, name, upper);
}

func capture_names(node *GNode, names *u8) void {
    if node == nil || node.kind == GNODE_REF { return; }
    if node.kind == GNODE_CAPTURE { grammar_capture_add(names, node); }
    if node.children != nil {
        var i i64 = 0;
        while i < vec_len(node.children) {
            capture_names(vec_get(node.children, i), names);
            i = i + 1;
        }
    }
    capture_names(node.child, names);
}

func capture_gen_name(rd *RDGen, prefix *u8, rule *GNode, suffix *u8) void {
    sb_str(rd.sb, prefix);
    rdgen_strn(rd, rule.name, rule.name_len);
    sb_str(rd.sb, suffix);
}

func capture_gen_schema(rd *RDGen, rule *GNode) void {
    var body *GNode = rule.child;
    var alternatives *u8 = vec_new(4);
    if body.kind == GNODE_CHOICE { alternatives = body.children; }
    else { vec_push(alternatives, body); }
    capture_gen_name(rd, "func schema_", rule, "_alternatives() i64 { return ");
    sb_int(rd.sb, vec_len(alternatives));
    sb_str(rd.sb, "; }\n");
    capture_gen_name(rd, "func schema_", rule, "_alternative(index i64) *u8 {\n");
    var i i64 = 0;
    while i < vec_len(alternatives) {
        var alt *GNode = vec_get(alternatives, i);
        sb_str(rd.sb, "if index == "); sb_int(rd.sb, i); sb_str(rd.sb, " { return \"");
        if alt.kind == GNODE_BRANCH { rdgen_strn(rd, alt.name, alt.name_len); }
        sb_str(rd.sb, "\"; }\n");
        i = i + 1;
    }
    sb_str(rd.sb, "return nil;\n}\n");
    // Enumeration and lookup use the same lexical name list.
    var names *u8 = vec_new(4);
    capture_names(body, names);
    capture_gen_name(rd, "func schema_", rule, "_name(index i64) *u8 {\n");
    i = 0;
    while i < vec_len(names) {
        var name *GNode = vec_get(names, i);
        sb_str(rd.sb, "if index == "); sb_int(rd.sb, i); sb_str(rd.sb, " { return \"");
        rdgen_strn(rd, name.name, name.name_len); sb_str(rd.sb, "\"; }\n");
        i = i + 1;
    }
    sb_str(rd.sb, "return nil;\n}\n");
    capture_gen_name(rd, "func schema_", rule, "_capture(alternative i64, name *u8) *CaptureSpec {\n");
    i = 0;
    while i < vec_len(alternatives) {
        var alt *GNode = vec_get(alternatives, i);
        var j i64 = 0;
        while j < vec_len(names) {
            var name *GNode = vec_get(names, j);
            var maximum i64 = capture_bound(alt, name, 1);
            if maximum != 0 {
                sb_str(rd.sb, "if alternative == "); sb_int(rd.sb, i);
                sb_str(rd.sb, " && streq(name, \""); rdgen_strn(rd, name.name, name.name_len);
                sb_str(rd.sb, "\") { return capture_spec(");
                sb_int(rd.sb, capture_bound(alt, name, 0)); sb_str(rd.sb, ", ");
                sb_int(rd.sb, maximum); sb_str(rd.sb, "); }\n");
            }
            j = j + 1;
        }
        i = i + 1;
    }
    sb_str(rd.sb, "return nil;\n}\n");
    var mode i64 = 1;
    while mode <= 3 {
        var suffix *u8 = "_required";
        if mode == 2 { suffix = "_optional"; }
        if mode == 3 { suffix = "_repeated"; }
        capture_gen_name(rd, "func capture_", rule, suffix);
        sb_str(rd.sb, "(node *PNode, name *u8) ");
        if mode == 3 { sb_str(rd.sb, "*u8 {\nreturn "); }
        else { sb_str(rd.sb, "*PNode {\nreturn capture_one("); }
        sb_str(rd.sb, "capture_checked(node, \""); rdgen_strn(rd, rule.name, rule.name_len);
        sb_str(rd.sb, "\", name, ");
        capture_gen_name(rd, "schema_", rule, "_capture(capture_alternative(node, \"");
        rdgen_strn(rd, rule.name, rule.name_len);
        sb_str(rd.sb, "\", name), name), "); sb_int(rd.sb, mode); sb_str(rd.sb, ")");
        if mode != 3 { sb_str(rd.sb, ")"); }
        sb_str(rd.sb, ";\n}\n");
        mode = mode + 1;
    }
}
