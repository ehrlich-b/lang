// ============================================================
// std/tok.lang - Tokenizer for Reader Macros
// ============================================================
//
// A simple, configurable tokenizer for building readers.
// Provides a stream of tokens with position tracking.
//
// Example:
//   var t *Tokenizer = tok_new("(+ 1 2)");
//   while !tok_eof(t) {
//       var kind i64 = tok_kind(t);
//       var text *u8 = tok_text(t);
//       tok_advance(t);
//   }
//

// ============================================================
// Token Kinds
// ============================================================

var TOK_EOF i64 = 0;
var TOK_NUMBER i64 = 1;
var TOK_IDENT i64 = 2;
var TOK_STRING i64 = 3;
var TOK_LPAREN i64 = 4;    // (
var TOK_RPAREN i64 = 5;    // )
var TOK_LBRACKET i64 = 6;  // [
var TOK_RBRACKET i64 = 7;  // ]
var TOK_LBRACE i64 = 8;    // {
var TOK_RBRACE i64 = 9;    // }
var TOK_PLUS i64 = 10;
var TOK_MINUS i64 = 11;
var TOK_STAR i64 = 12;
var TOK_SLASH i64 = 13;
var TOK_PERCENT i64 = 14;
var TOK_COMMA i64 = 15;
var TOK_COLON i64 = 16;
var TOK_SEMI i64 = 17;
var TOK_DOT i64 = 18;
var TOK_EQ i64 = 19;
var TOK_LT i64 = 20;
var TOK_GT i64 = 21;
var TOK_BANG i64 = 22;
var TOK_AMP i64 = 23;
var TOK_PIPE i64 = 24;
var TOK_CARET i64 = 25;
var TOK_QUESTION i64 = 26;  // ? (ternary)
var TOK_TILDE i64 = 27;     // ~ (bitwise not)
var TOK_UNKNOWN i64 = 99;

// Kinds a reader invents for its own token stream start here. The built-in
// scanner never produces one, so a grammar referring to a custom kind can only
// match a token some reader put there deliberately.
var TOK_USER i64 = 100;

// ============================================================
// Tokenizer State
// ============================================================

struct Tokenizer {
    input *u8;      // input string
    pos i64;        // current position
    len i64;        // length of input
    tok_start i64;  // start of current token
    tok_len i64;    // length of current token
    tok_kind i64;   // kind of current token
    error_pos i64;       // furthest failed match, or -1
    error_expected *u8;  // "number or '('", capped at 511 bytes
    error_expected_len i64;
    error_found *u8;     // token text captured at error_pos
    stream *u8;          // reader-supplied token stream, or nil to scan input
    stream_index i64;    // index of the current token within that stream
    stream_count i64;    // number of tokens in it
    stream_text *u8;     // text override for the current token, or nil
}

func tok_new_state(input *u8) *Tokenizer {
    var t *Tokenizer = alloc(112);  // 14 fields * 8 bytes
    t.input = input;
    t.pos = 0;
    t.len = strlen(input);
    t.tok_start = 0;
    t.tok_len = 0;
    t.tok_kind = TOK_EOF;
    t.error_pos = -1;
    t.error_expected = alloc(512);
    t.error_expected_len = 0;
    t.error_found = nil;
    t.stream = nil;
    t.stream_index = 0;
    t.stream_count = 0;
    t.stream_text = nil;
    return t;
}

pub func tok_new(input *u8) *Tokenizer {
    var t *Tokenizer = tok_new_state(input);
    tok_next(t);  // prime the tokenizer
    return t;
}

// ============================================================
// Reader-supplied token streams
// ============================================================
//
// A generated parser only ever asks a Tokenizer for the current token's kind,
// text and span, and for a mark it can rewind to. None of that requires the
// tokenizer to be the thing that produced the token. A reader whose language is
// not a straight left-to-right scan - layout, a preprocessing pass, a lexer that
// needs to know something the parser already decided - can therefore lex the
// source its own way and hand the result over, and every generated parser reads
// it unchanged.
//
// A token is (kind, start, len, text): a kind, a half-open byte span into the
// SAME input string, and an optional text override. Spans stay real even for
// tokens the source does not literally contain, which is what keeps error
// locations and AST spans honest in a language nobody can parse by reading
// characters in order.

pub func tok_stream_new() *u8 {
    return vec_new(64);
}

// `text` is nil for a token that reads as the bytes it spans. A synthetic token
// - an INDENT standing for a column, say - spans zero bytes at the position it
// was inferred from, and names itself through `text` so that a parse error can
// still say what it found.
pub func tok_stream_push(toks *u8, kind i64, start i64, len i64, text *u8) void {
    vec_push(toks, kind);
    vec_push(toks, start);
    vec_push(toks, len);
    vec_push(toks, text);
}

pub func tok_stream_count(toks *u8) i64 {
    return vec_len(toks) / 4;
}

pub func tok_new_stream(input *u8, toks *u8) *Tokenizer {
    var t *Tokenizer = tok_new_state(input);
    t.stream = toks;
    t.stream_count = tok_stream_count(toks);
    tok_stream_load(t, 0);
    return t;
}

// Position on token `index`. Past the end is EOF at the end of the input, which
// is where a parser that wanted more will report having run out.
func tok_stream_load(t *Tokenizer, index i64) void {
    if index < 0 { index = 0; }
    if index > t.stream_count { index = t.stream_count; }
    t.stream_index = index;
    if index >= t.stream_count {
        t.tok_kind = TOK_EOF;
        t.tok_start = t.len;
        t.tok_len = 0;
        t.stream_text = nil;
        t.pos = t.len;
        return;
    }
    var base i64 = index * 4;
    t.tok_kind = vec_get(t.stream, base);
    t.tok_start = vec_get(t.stream, base + 1);
    t.tok_len = vec_get(t.stream, base + 2);
    t.stream_text = vec_get(t.stream, base + 3);
    t.pos = t.tok_start + t.tok_len;
}

// ============================================================
// Character Helpers
// ============================================================

pub func tok_is_digit(c i64) bool {
    return c >= 48 && c <= 57;
}

pub func tok_is_alpha(c i64) bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

pub func tok_is_alnum(c i64) bool {
    return tok_is_digit(c) || tok_is_alpha(c);
}

pub func tok_is_space(c i64) bool {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

// ============================================================
// Tokenizer Methods
// ============================================================

pub func tok_peek_char(t *Tokenizer) i64 {
    if t.pos >= t.len {
        return 0;
    }
    return *(t.input + t.pos);
}

pub func tok_peek_char_at(t *Tokenizer, offset i64) i64 {
    if t.pos + offset >= t.len {
        return 0;
    }
    return *(t.input + t.pos + offset);
}

pub func tok_advance_char(t *Tokenizer) void {
    if t.pos < t.len {
        t.pos = t.pos + 1;
    }
}

pub func tok_skip_whitespace(t *Tokenizer) void {
    var again i64 = 1;
    while again == 1 {
        again = 0;
        while t.pos < t.len && tok_is_space(tok_peek_char(t)) {
            tok_advance_char(t);
        }
        // Line comment: // ... to end of line
        if tok_peek_char(t) == 47 && tok_peek_char_at(t, 1) == 47 {
            while t.pos < t.len && tok_peek_char(t) != 10 {
                tok_advance_char(t);
            }
            again = 1;
        }
        // Block comment: /* ... */
        if tok_peek_char(t) == 47 && tok_peek_char_at(t, 1) == 42 {
            tok_advance_char(t);
            tok_advance_char(t);
            while t.pos < t.len && (tok_peek_char(t) != 42 || tok_peek_char_at(t, 1) != 47) {
                tok_advance_char(t);
            }
            tok_advance_char(t);
            tok_advance_char(t);
            again = 1;
        }
    }
}

pub func tok_next(t *Tokenizer) void {
    if t.stream != nil {
        tok_stream_load(t, t.stream_index + 1);
        return;
    }
    tok_skip_whitespace(t);

    t.tok_start = t.pos;
    t.tok_len = 0;

    if t.pos >= t.len {
        t.tok_kind = TOK_EOF;
        return;
    }

    var c i64 = tok_peek_char(t);

    // Single character tokens
    if c == 40 { t.tok_kind = TOK_LPAREN; t.tok_len = 1; tok_advance_char(t); return; }
    if c == 41 { t.tok_kind = TOK_RPAREN; t.tok_len = 1; tok_advance_char(t); return; }
    if c == 91 { t.tok_kind = TOK_LBRACKET; t.tok_len = 1; tok_advance_char(t); return; }
    if c == 93 { t.tok_kind = TOK_RBRACKET; t.tok_len = 1; tok_advance_char(t); return; }
    if c == 123 { t.tok_kind = TOK_LBRACE; t.tok_len = 1; tok_advance_char(t); return; }
    if c == 125 { t.tok_kind = TOK_RBRACE; t.tok_len = 1; tok_advance_char(t); return; }
    // + ++ +=  (2-char forms share the kind, with tok_len=2 + 2-char text, like <<)
    if c == 43 {
        tok_advance_char(t);
        var pn i64 = tok_peek_char(t);
        if pn == 43 || pn == 61 { tok_advance_char(t); t.tok_len = 2; }  // ++ or +=
        else { t.tok_len = 1; }
        t.tok_kind = TOK_PLUS;
        return;
    }
    if c == 42 {  // * or *=
        tok_advance_char(t);
        if tok_peek_char(t) == 61 { tok_advance_char(t); t.tok_len = 2; }
        else { t.tok_len = 1; }
        t.tok_kind = TOK_STAR;
        return;
    }
    if c == 47 {  // / or /=
        tok_advance_char(t);
        if tok_peek_char(t) == 61 { tok_advance_char(t); t.tok_len = 2; }
        else { t.tok_len = 1; }
        t.tok_kind = TOK_SLASH;
        return;
    }
    if c == 37 {  // % or %=
        tok_advance_char(t);
        if tok_peek_char(t) == 61 { tok_advance_char(t); t.tok_len = 2; }
        else { t.tok_len = 1; }
        t.tok_kind = TOK_PERCENT;
        return;
    }
    if c == 94 { t.tok_kind = TOK_CARET; t.tok_len = 1; tok_advance_char(t); return; }  // ^
    if c == 63 { t.tok_kind = TOK_QUESTION; t.tok_len = 1; tok_advance_char(t); return; }  // ?
    if c == 126 { t.tok_kind = TOK_TILDE; t.tok_len = 1; tok_advance_char(t); return; }  // ~
    if c == 44 { t.tok_kind = TOK_COMMA; t.tok_len = 1; tok_advance_char(t); return; }
    if c == 58 { t.tok_kind = TOK_COLON; t.tok_len = 1; tok_advance_char(t); return; }
    if c == 59 { t.tok_kind = TOK_SEMI; t.tok_len = 1; tok_advance_char(t); return; }
    if c == 46 { t.tok_kind = TOK_DOT; t.tok_len = 1; tok_advance_char(t); return; }

    // Multi-char operators: ==, !=, <=, >=, <<, >>, &&, ||
    if c == 61 {  // = or ==
        tok_advance_char(t);
        if tok_peek_char(t) == 61 { tok_advance_char(t); t.tok_len = 2; }
        else { t.tok_len = 1; }
        t.tok_kind = TOK_EQ;
        return;
    }
    if c == 60 {  // < or <= or <<
        tok_advance_char(t);
        var next i64 = tok_peek_char(t);
        if next == 61 || next == 60 { tok_advance_char(t); t.tok_len = 2; }
        else { t.tok_len = 1; }
        t.tok_kind = TOK_LT;
        return;
    }
    if c == 62 {  // > or >= or >>
        tok_advance_char(t);
        var next i64 = tok_peek_char(t);
        if next == 61 || next == 62 { tok_advance_char(t); t.tok_len = 2; }
        else { t.tok_len = 1; }
        t.tok_kind = TOK_GT;
        return;
    }
    if c == 33 {  // ! or !=
        tok_advance_char(t);
        if tok_peek_char(t) == 61 { tok_advance_char(t); t.tok_len = 2; }
        else { t.tok_len = 1; }
        t.tok_kind = TOK_BANG;
        return;
    }
    if c == 38 {  // & or &&
        tok_advance_char(t);
        if tok_peek_char(t) == 38 { tok_advance_char(t); t.tok_len = 2; }
        else { t.tok_len = 1; }
        t.tok_kind = TOK_AMP;
        return;
    }
    if c == 124 {  // | or ||
        tok_advance_char(t);
        if tok_peek_char(t) == 124 { tok_advance_char(t); t.tok_len = 2; }
        else { t.tok_len = 1; }
        t.tok_kind = TOK_PIPE;
        return;
    }

    // Minus or negative number
    if c == 45 {
        if tok_peek_char_at(t, 1) == 62 {  // -> : lex as '.' (the kernel's field
            tok_advance_char(t);           // access auto-derefs pointers, so p->x
            tok_advance_char(t);           // and p.x are equivalent for a reader)
            t.tok_len = 2;
            t.tok_kind = TOK_DOT;
            return;
        }
        var mn i64 = tok_peek_char_at(t, 1);
        if mn == 45 || mn == 61 {          // -- or -= (TOK_MINUS, tok_len=2, text)
            tok_advance_char(t);
            tok_advance_char(t);
            t.tok_len = 2;
            t.tok_kind = TOK_MINUS;
            return;
        }
        if tok_is_digit(tok_peek_char_at(t, 1)) {
            // Negative number
            tok_advance_char(t);
            while tok_is_digit(tok_peek_char(t)) {
                tok_advance_char(t);
            }
            t.tok_len = t.pos - t.tok_start;
            t.tok_kind = TOK_NUMBER;
            return;
        }
        t.tok_kind = TOK_MINUS;
        t.tok_len = 1;
        tok_advance_char(t);
        return;
    }

    // Number
    if tok_is_digit(c) {
        while tok_is_digit(tok_peek_char(t)) {
            tok_advance_char(t);
        }
        t.tok_len = t.pos - t.tok_start;
        t.tok_kind = TOK_NUMBER;
        return;
    }

    // Identifier
    if tok_is_alpha(c) {
        while tok_is_alnum(tok_peek_char(t)) {
            tok_advance_char(t);
        }
        t.tok_len = t.pos - t.tok_start;
        t.tok_kind = TOK_IDENT;
        return;
    }

    // Double-quoted string
    if c == 34 {  // "
        tok_advance_char(t);  // skip opening quote
        while tok_peek_char(t) != 0 && tok_peek_char(t) != 34 {
            if tok_peek_char(t) == 92 {  // backslash escape
                tok_advance_char(t);
            }
            tok_advance_char(t);
        }
        if tok_peek_char(t) == 34 {
            tok_advance_char(t);  // skip closing quote
        }
        t.tok_len = t.pos - t.tok_start;
        t.tok_kind = TOK_STRING;
        return;
    }

    // Single-quoted string (for grammar literals like '(')
    if c == 39 {  // '
        tok_advance_char(t);  // skip opening quote
        while tok_peek_char(t) != 0 && tok_peek_char(t) != 39 {
            if tok_peek_char(t) == 92 {  // backslash escape
                tok_advance_char(t);
            }
            tok_advance_char(t);
        }
        if tok_peek_char(t) == 39 {
            tok_advance_char(t);  // skip closing quote
        }
        t.tok_len = t.pos - t.tok_start;
        t.tok_kind = TOK_STRING;
        return;
    }

    // Unknown
    t.tok_kind = TOK_UNKNOWN;
    t.tok_len = 1;
    tok_advance_char(t);
}

pub func tok_kind(t *Tokenizer) i64 {
    return t.tok_kind;
}

pub func tok_eof(t *Tokenizer) bool {
    return t.tok_kind == TOK_EOF;
}

// Returns the raw text of the current token (not null-terminated!)
pub func tok_text_ptr(t *Tokenizer) *u8 {
    if t.stream_text != nil { return t.stream_text; }
    return t.input + t.tok_start;
}

pub func tok_text_len(t *Tokenizer) i64 {
    if t.stream_text != nil { return strlen(t.stream_text); }
    return t.tok_len;
}

pub func tok_start_offset(t *Tokenizer) i64 {
    return t.tok_start;
}

pub func tok_end_offset(t *Tokenizer) i64 {
    return t.tok_start + t.tok_len;
}

// Returns a null-terminated copy of the token text
pub func tok_text(t *Tokenizer) *u8 {
    if t.stream_text != nil { return t.stream_text; }
    var buf *u8 = alloc(t.tok_len + 1);
    var i i64 = 0;
    while i < t.tok_len {
        *(buf + i) = *(t.input + t.tok_start + i);
        i = i + 1;
    }
    *(buf + t.tok_len) = 0;
    return buf;
}

// A checkpoint names the current token, not the byte after it. Restoring and
// lexing again also handles whitespace/comments between the previous token and
// this one, while leaving furthest-error tracking intact across alternatives.
pub func tok_mark(t *Tokenizer) i64 {
    if t.stream != nil { return t.stream_index; }
    return t.tok_start;
}

pub func tok_reset(t *Tokenizer, mark i64) void {
    if t.stream != nil { tok_stream_load(t, mark); return; }
    if mark < 0 { mark = 0; }
    if mark > t.len { mark = t.len; }
    t.pos = mark;
    tok_next(t);
}

func tok_expected_has(t *Tokenizer, expected *u8, expected_len i64) i64 {
    var i i64 = 0;
    while i + expected_len <= t.error_expected_len {
        var before_ok i64 = 0;
        if i == 0 { before_ok = 1; }
        else if i >= 4 && str_eq_n(t.error_expected + i - 4, 4, " or ", 4) { before_ok = 1; }
        if before_ok != 0 && str_eq_n(t.error_expected + i, expected_len, expected, expected_len) {
            var after i64 = i + expected_len;
            if after == t.error_expected_len { return 1; }
            if after + 4 <= t.error_expected_len &&
               str_eq_n(t.error_expected + after, 4, " or ", 4) {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

// Generated parsers call this on a terminal mismatch. Expectations at the
// furthest byte win; alternatives failing at that byte are accumulated.
pub func tok_note_expected(t *Tokenizer, expected *u8) void {
    var at i64 = t.tok_start;
    if at < t.error_pos { return; }

    if at > t.error_pos {
        t.error_pos = at;
        t.error_expected_len = 0;
        *t.error_expected = 0;
        if t.tok_kind == TOK_EOF { t.error_found = "end of input"; }
        else { t.error_found = tok_text(t); }
    }

    var expected_len i64 = strlen(expected);
    if tok_expected_has(t, expected, expected_len) != 0 { return; }

    var needed i64 = expected_len;
    if t.error_expected_len > 0 { needed = needed + 4; }
    if t.error_expected_len + needed >= 512 { return; }

    if t.error_expected_len > 0 {
        memcpy(t.error_expected + t.error_expected_len, " or ", 4);
        t.error_expected_len = t.error_expected_len + 4;
    }
    memcpy(t.error_expected + t.error_expected_len, expected, expected_len);
    t.error_expected_len = t.error_expected_len + expected_len;
    *(t.error_expected + t.error_expected_len) = 0;
}

pub func tok_error_offset(t *Tokenizer) i64 {
    return t.error_pos;
}

pub func tok_error_expected(t *Tokenizer) *u8 {
    return t.error_expected;
}

pub func tok_error_found(t *Tokenizer) *u8 {
    if t.error_found == nil { return ""; }
    return t.error_found;
}

pub func tok_error_line(t *Tokenizer) i64 {
    var stop i64 = t.error_pos;
    if stop < 0 { stop = t.tok_start; }
    var line i64 = 1;
    var i i64 = 0;
    while i < stop {
        if *(t.input + i) == 10 { line = line + 1; }
        i = i + 1;
    }
    return line;
}

pub func tok_error_column(t *Tokenizer) i64 {
    var stop i64 = t.error_pos;
    if stop < 0 { stop = t.tok_start; }
    var column i64 = 1;
    var i i64 = 0;
    while i < stop {
        if *(t.input + i) == 10 { column = 1; }
        else { column = column + 1; }
        i = i + 1;
    }
    return column;
}

// Ready-to-use diagnostic for small readers. Larger readers can use the query
// functions above to integrate the same structured data into their own errors.
pub func tok_print_error(t *Tokenizer, label *u8) void {
    if label != nil && *label != 0 {
        eprint(label);
        eprint(":");
    }
    eprint_i64(tok_error_line(t));
    eprint(":");
    eprint_i64(tok_error_column(t));
    eprint(": expected ");
    eprint(tok_error_expected(t));
    eprint(", found ");
    eprintln(tok_error_found(t));
}

// Parse the current number token as i64
pub func tok_number(t *Tokenizer) i64 {
    var ptr *u8 = tok_text_ptr(t);
    var len i64 = tok_text_len(t);
    var neg i64 = 0;
    var i i64 = 0;

    if len > 0 && *ptr == 45 {  // '-'
        neg = 1;
        i = 1;
    }

    var n i64 = 0;
    while i < len {
        n = n * 10 + (*(ptr + i) - 48);
        i = i + 1;
    }

    if neg != 0 {
        return 0 - n;
    }
    return n;
}

// Get the string value (without quotes, with escapes processed)
pub func tok_string_value(t *Tokenizer) *u8 {
    var start *u8 = t.input + t.tok_start + 1;  // skip opening quote
    var len i64 = t.tok_len - 2;  // exclude both quotes
    var buf *u8 = alloc(len + 1);
    var i i64 = 0;
    var j i64 = 0;

    while i < len {
        var c i64 = *(start + i);
        if c == 92 && i + 1 < len {  // backslash
            i = i + 1;
            var next i64 = *(start + i);
            if next == 110 { c = 10; }       // \n
            else if next == 114 { c = 13; }  // \r
            else if next == 116 { c = 9; }   // \t
            else if next == 34 { c = 34; }   // \"
            else if next == 92 { c = 92; }   // \\
            else { c = next; }
        }
        *(buf + j) = c;
        i = i + 1;
        j = j + 1;
    }
    *(buf + j) = 0;
    return buf;
}

// Check if current token matches a specific kind
pub func tok_check(t *Tokenizer, kind i64) bool {
    return t.tok_kind == kind;
}

// Match and consume a token of the given kind
pub func tok_match(t *Tokenizer, kind i64) bool {
    if t.tok_kind == kind {
        tok_next(t);
        return true;
    }
    return false;
}

// Expect a token of the given kind (error if not found)
pub func tok_expect(t *Tokenizer, kind i64) bool {
    if t.tok_kind != kind {
        return false;
    }
    tok_next(t);
    return true;
}
