// Private request state. Native workers import it from the compiler's request.
// The compiler supplies the output target directly for embedded readers.
var reader_request_inspect_stage *u8 = nil;
var reader_request_output_target *u8 = nil;

func reader_request_init() void {
    reader_request_inspect_stage = getenv("LANG_INSPECT_STAGE");
    reader_request_output_target = getenv("LANG_STAGE_OUTPUT_TARGET");
}
