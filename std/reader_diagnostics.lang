include "std/reader_diagnostic_width.lang"

// Reader errors are values, never AST. Source is a reader-local source key;
// an invoking host grants that key an immutable guest snapshot and origin.
struct ReaderDiagnostic {
    code *u8; message *u8; source *u8; start i64; end i64; category i64;
}
struct ReaderReport { diagnostic *ReaderDiagnostic; text *u8; }
var reader_diagnostic_collect i64 = 0;
var reader_diagnostic_reports *u8 = nil;
var reader_diagnostic_invalid i64 = 0;
var reader_diagnostic_wire i64 = 0;
var reader_diagnostic_count i64 = 0;
// A native embedded host grants one immutable snapshot before invoking a reader.
var reader_diagnostic_snapshot *u8 = nil;

pub func reader_diagnostic_put32(p *u8, value i64) void {
    var i i64 = 0;
    while i < 4 { *(p + i) = value % 256; value = value / 256; i = i + 1; }
}
pub func reader_diagnostic_u32(p *u8) i64 {
    return *p + *(p + 1) * 256 + *(p + 2) * 65536 + *(p + 3) * 16777216;
}
func reader_diagnostic_utf8(text *u8) i64 {
    var len i64 = strlen(text); var i i64 = 0; var width i64 = 0;
    while i < len {
        width = ___compiler_diagnostic_utf8_width(text + i, len - i);
        if width == 0 { return 0; }
        i = i + width;
    }
    return 1;
}
pub func reader_diagnostic_valid(d *ReaderDiagnostic, text *u8) i64 {
    if d == nil || text == nil { return 0; }
    if d.code == nil || d.message == nil || d.source == nil { return 0; }
    if *d.code == 0 || *d.source == 0 || d.category < 0 || d.category > 1 { return 0; }
    if strlen(d.code) > 256 || strlen(d.source) > 4096 || strlen(d.message) > 1048576 { return 0; }
    if reader_diagnostic_utf8(d.code) == 0 || reader_diagnostic_utf8(d.source) == 0 ||
       reader_diagnostic_utf8(d.message) == 0 { return 0; }
    if d.start == -1 && d.end == -1 { return 1; }
    if d.start < 0 || d.end < d.start || d.end > strlen(text) { return 0; }
    var a i64 = *(text + d.start); var b i64 = *(text + d.end);
    if a >= 128 && a < 192 { return 0; }
    if b >= 128 && b < 192 { return 0; }
    return 1;
}
// Decode one scalar to a terminal cell count without depending on the host
// locale. Invalid UTF-8 keeps the existing one-cell fallback for a leading byte.
func reader_diagnostic_cells(text *u8, len i64, column i64) i64 {
    if *text == 9 { return 8 - column % 8; }
    var bytes i64 = ___compiler_diagnostic_utf8_width(text, len);
    if bytes < 2 { return 1; }
    var value i64 = *text - 192;
    if bytes == 3 { value = *text - 224; }
    if bytes == 4 { value = *text - 240; }
    var i i64 = 1;
    while i < bytes {
        value = value * 64 + *(text + i) - 128;
        i = i + 1;
    }
    return reader_diagnostic_scalar_cells(value);
}
// Render the first source line intersecting the half-open byte span. Tabs in
// the prefix are copied; tabs in the span use eight-column tab stops. Wide and
// fullwidth scalars take two cells, other scalars one. CRLF is one line ending.
// Empty spans (including EOF) get one caret; multiline spans are clipped to
// the displayed line.
func reader_diagnostic_snippet(text *u8, start i64, end i64) void {
    var line_start i64 = start;
    while line_start > 0 {
        if *(text + line_start - 1) == 10 { break; }
        line_start = line_start - 1;
    }
    var line_end i64 = start;
    while *(text + line_end) != 0 && *(text + line_end) != 10 {
        line_end = line_end + 1;
    }
    if line_end > line_start && *(text + line_end - 1) == 13 { line_end = line_end - 1; }
    eprintln(str_dup_n(text + line_start, line_end - line_start));
    var i i64 = line_start;
    var column i64 = 0;
    while i < start && i < line_end {
        if *(text + i) == 9 {
            eprint("\t"); column = column + 8 - column % 8;
        }
        else if *(text + i) < 128 || *(text + i) >= 192 {
            var padding i64 = reader_diagnostic_cells(text + i, line_end - i, column);
            column = column + padding;
            while padding > 0 { eprint(" "); padding = padding - 1; }
        }
        i = i + 1;
    }
    var carets i64 = 0;
    while i < end && i < line_end {
        if *(text + i) < 128 || *(text + i) >= 192 {
            var width i64 = reader_diagnostic_cells(text + i, line_end - i, column);
            column = column + width;
            while width > 0 {
                eprint("^"); carets = carets + 1; width = width - 1;
            }
        }
        i = i + 1;
    }
    if carets == 0 { eprint("^"); }
    eprintln("");
}
pub func reader_diagnostic_text(d *ReaderDiagnostic, text *u8) void {
    eprint(d.source); eprint(":");
    if d.start >= 0 {
        var line i64 = 1; var column i64 = 1; var i i64 = 0;
        while i < d.start {
            if *(text + i) == 10 { line = line + 1; column = 1; }
            else { column = column + 1; }
            i = i + 1;
        }
        eprint_i64(line); eprint(":"); eprint_i64(column); eprint(":");
    }
    eprint(" "); eprint(d.message);
    if (streq(d.code, "reader-syntax") || streq(d.code, "reader-syntax-snippet")) && d.start >= 0 {
        eprint(" @"); eprint_i64(d.start); eprint(":"); eprint_i64(d.end);
    }
    eprintln("");
    if streq(d.code, "reader-syntax-snippet") && d.start >= 0 {
        reader_diagnostic_snippet(text, d.start, d.end);
    }
}
pub func reader_diagnostic_emit(d *ReaderDiagnostic, text *u8) void {
    reader_diagnostic_count = reader_diagnostic_count + 1;
    if reader_diagnostic_valid(d, text) == 0 ||
       (reader_diagnostic_snapshot != nil && streq(text, reader_diagnostic_snapshot) == 0) {
        reader_diagnostic_invalid = 1;
        if reader_diagnostic_collect == 0 {
            // Invalid API calls must remain fatal at a host that also accepts
            // ordinary stderr. A truncated reserved marker cannot be legacy text.
            if reader_diagnostic_wire != 0 { file_write(2, "\0RDI1", 5); }
            else { eprintln("reader: invalid diagnostic"); }
        }
        return;
    }
    if reader_diagnostic_collect != 0 {
        if vec_len(reader_diagnostic_reports) >= 1024 { reader_diagnostic_invalid = 1; return; }
        var owned *ReaderDiagnostic = alloc(48); memcpy(owned, d, 48);
        owned.code = str_dup(d.code); owned.message = str_dup(d.message); owned.source = str_dup(d.source);
        var report *ReaderReport = alloc(16); report.diagnostic = owned; report.text = str_dup(text);
        vec_push(reader_diagnostic_reports, report); return;
    }
    if reader_diagnostic_wire == 0 { reader_diagnostic_text(d, text); return; }
    // Reserve NUL + RDI1 for binary records; printable RDI1 is ordinary stderr.
    // Then category, start+1, end+1, and three byte lengths (little-endian).
    // -1/-1 is encoded as 0/0. No pointers or host IDs cross this boundary.
    var header *u8 = alloc(29); memcpy(header, "\0RDI1", 5);
    reader_diagnostic_put32(header + 5, d.category);
    reader_diagnostic_put32(header + 9, d.start + 1);
    reader_diagnostic_put32(header + 13, d.end + 1);
    reader_diagnostic_put32(header + 17, strlen(d.code));
    reader_diagnostic_put32(header + 21, strlen(d.source));
    reader_diagnostic_put32(header + 25, strlen(d.message));
    file_write(2, header, 29); file_write(2, d.code, strlen(d.code));
    file_write(2, d.source, strlen(d.source)); file_write(2, d.message, strlen(d.message));
}
pub func reader_error(code *u8, message *u8, source *u8, text *u8, start i64, end i64) void {
    var d *ReaderDiagnostic = alloc(48);
    d.code = code; d.message = message; d.source = source;
    d.start = start; d.end = end; d.category = 0;
    reader_diagnostic_emit(d, text);
}
