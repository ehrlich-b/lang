include "std/parser_reader.lang"
include "std/prec.lang"
include "std/buffer.lang"

var tariff_source *u8 = nil;
func tariff_name(n *PNode) *u8 {
    var name *u8 = n.text;
    if streq(name, "fn") || streq(name, "let") || streq(name, "if") || streq(name, "else") || streq(name, "while") || streq(name, "return") {
        pnode_print_error(n, tariff_source, "tariff", "keyword cannot be an identifier");
        exit(1);
    }
    return name;
}

// Expressions use the toolkit's precedence service.
#parser{
    tariff = functions:tariff_function+
    tariff_function = signature:tariff_signature body:tariff_block
    tariff_parameters = first:symbol rest:tariff_parameter_tail*
    tariff_parameter_tail = ',' name:symbol
    tariff_block = '{' items:tariff_statement* '}'
    tariff_statement = bind:tariff_binding | assign:tariff_assignment | cond:tariff_conditional | loop:tariff_loop | ret:tariff_return
    tariff_binding = 'let' name:symbol '=' value:tariff_expression ';'
    tariff_assignment = name:symbol '=' value:tariff_expression ';'
    tariff_conditional = 'if' '(' condition:tariff_expression ')' yes:tariff_block otherwise:tariff_else?
    tariff_else = 'else' body:tariff_block
    tariff_loop = 'while' '(' condition:tariff_expression ')' body:tariff_block
    tariff_return = 'return' value:tariff_expression ';'
    tariff_expression = first:tariff_unary rest:tariff_tail*
    tariff_tail = op:tariff_operator right:tariff_unary
    tariff_operator = '==' | '!=' | '<' | '>' | '<=' | '>=' | '+' | '-' | '%' | '*' | '/'
    tariff_unary = neg:tariff_negative | tariff_primary
    tariff_negative = '-' value:tariff_unary
    tariff_primary = num:number | call:tariff_call | ident:symbol | paren:tariff_paren
    tariff_paren = '(' value:tariff_expression ')'
    tariff_call = name:symbol '(' args:tariff_arguments? ')'
    tariff_arguments = first:tariff_expression rest:tariff_argument_tail*
    tariff_argument_tail = ',' value:tariff_expression
    tariff_signature = 'fn' name:symbol '(' params:tariff_parameters? ')'
}

var tariff_precedence *PrecTable = nil;
func tariff_table() *PrecTable {
    if tariff_precedence != nil { return tariff_precedence; }
    var t *PrecTable = prec_new();
    prec_left(t, "== !=");
    prec_left(t, "< > <= >=");
    prec_left(t, "+ -");
    prec_left(t, "%");
    prec_left(t, "* /");
    tariff_precedence = t;
    return t;
}

func tariff_expr(n *PNode) *u8 {
    var result *u8 = nil;
    if pnode_is(n, "num") { result = ast_number(n.text); }
    else if pnode_is(n, "ident") { result = ast_ident(tariff_name(n)); }
    else if pnode_is(n, "neg") { result = ast_neg(tariff_expr(pnode_require(n, "value"))); }
    else if pnode_is(n, "paren") { result = tariff_expr(pnode_require(n, "value")); }
    else if pnode_is(n, "call") {
        var args *u8 = ast_vec();
        var values *PNode = pnode_get(n, "args");
        if values != nil {
            ast_push(args, tariff_expr(pnode_require(values, "first")));
            var rest *PNode = pnode_require(values, "rest");
            var i i64 = 0;
            while i < vec_len(rest.children) {
                var tail *PNode = vec_get(rest.children, i);
                ast_push(args, tariff_expr(pnode_require(tail, "value")));
                i = i + 1;
            }
        }
        result = ast_call_named(tariff_name(pnode_require(n, "name")), args);
        vec_free(args);
    } else {
        var e *PrecExpr = prec_expr(tariff_table());
        prec_operand(e, tariff_expr(pnode_require(n, "first")));
        var rest *PNode = pnode_require(n, "rest");
        var i i64 = 0;
        while i < vec_len(rest.children) {
            var tail *PNode = vec_get(rest.children, i);
            prec_op(e, pnode_require(tail, "op").text);
            prec_operand(e, tariff_expr(pnode_require(tail, "right")));
            i = i + 1;
        }
        result = prec_build(e);
        vec_free(e.items);
        vec_free(e.kinds);
        free(e);
    }
    return ast_span(result, n.start, n.end);
}

func tariff_stmt(n *PNode) *u8 {
    if pnode_is(n, "bind") {
        return ast_var(tariff_name(pnode_require(n, "name")), ast_type_i64(), tariff_expr(pnode_require(n, "value")));
    }
    if pnode_is(n, "assign") {
        return ast_assign(ast_ident(tariff_name(pnode_require(n, "name"))), tariff_expr(pnode_require(n, "value")));
    }
    if pnode_is(n, "ret") { return ast_return(tariff_expr(pnode_require(n, "value"))); }
    if pnode_is(n, "loop") {
        return ast_while(tariff_expr(pnode_require(n, "condition")), tariff_block(pnode_require(n, "body")));
    }
    var other *PNode = pnode_get(n, "otherwise");
    var no *u8 = ast_block(ast_vec());
    if other != nil { no = tariff_block(pnode_require(other, "body")); }
    return ast_if(tariff_expr(pnode_require(n, "condition")), tariff_block(pnode_require(n, "yes")), no);
}

func tariff_block(n *PNode) *u8 {
    var items *PNode = pnode_require(n, "items");
    var stmts *u8 = ast_vec();
    var i i64 = 0;
    while i < vec_len(items.children) {
        var item *PNode = vec_get(items.children, i);
        ast_push(stmts, ast_span(tariff_stmt(item), item.start, item.end));
        i = i + 1;
    }
    var block *u8 = ast_block(stmts);
    vec_free(stmts);
    return block;
}

func tariff_params(signature *PNode) *u8 {
    var params *u8 = ast_vec();
    var names *PNode = pnode_get(signature, "params");
    if names != nil {
        ast_push(params, ast_param(tariff_name(pnode_require(names, "first")), ast_type_i64()));
        var rest *PNode = pnode_require(names, "rest");
        var j i64 = 0;
        while j < vec_len(rest.children) {
            var tail *PNode = vec_get(rest.children, j);
            ast_push(params, ast_param(tariff_name(pnode_require(tail, "name")), ast_type_i64()));
            j = j + 1;
        }
    }
    return params;
}

// Use the same grammar productions, but lower each top-level statement before
// recognizing the next. Only nested statements need a retained parse tree.
func tariff_read_native(text *u8) *u8 {
    var t *Tokenizer = tok_new_state(text);
    t.comment_open = nil;
    t.comment_close = nil;
    t.comment_cr = 1;
    t.split_minus = 1;
    tok_parser_streaming(t, 100000000);
    tok_next(t);
    var decls *u8 = ast_vec();
    var start i64 = 0;
    var end i64 = 0;
    var signature *PNode = nil;
    var item *PNode = nil;
    var name *u8 = nil;
    var params *u8 = nil;
    var stmts *u8 = nil;
    while !tok_eof(t) {
        start = t.tok_start;
        reader_scratch_begin();
        signature = parse_tariff_signature(t);
        reader_scratch_end();
        if signature == nil { tok_print_error(t, "tariff"); return nil; }
        if !tok_expect(t, TOK_LBRACE) {
            t.error_pos = -1;
            tok_note_expected(t, "'{'");
            tok_print_error(t, "tariff");
            return nil;
        }
        name = str_dup(tariff_name(pnode_require(signature, "name")));
        params = tariff_params(signature);
        stmts = ast_vec();
        while tok_kind(t) != TOK_RBRACE {
            t.error_pos = -1;
            reader_scratch_begin();
            item = parse_tariff_statement(t);
            reader_scratch_end();
            if item == nil { tok_print_error(t, "tariff"); return nil; }
            ast_push(stmts, ast_span(tariff_stmt(item), item.start, item.end));
        }
        end = t.tok_start + t.tok_len;
        tok_next(t);
        ast_push(decls, ast_span(ast_func(name, params, ast_type_i64(), ast_block(stmts)), start, end));
        free(name);
        vec_free(params);
        vec_free(stmts);
        t.error_pos = -1;
    }
    if ast_vec_len(decls) == 0 { tok_note_expected(t, "'fn'"); tok_print_error(t, "tariff"); return nil; }
    var program *u8 = ast_program(decls);
    vec_free(decls);
    return program;
}

pub func tariff_read(text *u8) *u8 {
    tariff_source = text;
    if ast_use_native() != 0 { return tariff_read_native(text); }
    // The standard scanner folds -123; split it so x-1 is subtraction too.
    // Tariff ends line comments at CR or LF. Scan a length-preserving copy:
    // the shared scanner ends comments at LF; original source spans stay valid.
    var scanned *u8 = str_dup(text);
    var offset i64 = 0;
    while *(scanned + offset) != 0 {
        if *(scanned + offset) == 13 { *(scanned + offset) = 10; }
        offset = offset + 1;
    }
    var raw *Tokenizer = tok_new_comments(scanned, "//", nil, nil);
    var stream *u8 = tok_stream_new();
    while !tok_eof(raw) {
        var word *u8 = tok_text(raw);
        if tok_kind(raw) == TOK_NUMBER && *word == '-' {
            tok_stream_push(stream, TOK_MINUS, raw.tok_start, 1, "-");
            tok_stream_push(stream, TOK_NUMBER, raw.tok_start + 1, raw.tok_len - 1, word + 1);
        } else if streq(word, "--") {
            tok_stream_push(stream, TOK_MINUS, raw.tok_start, 1, "-");
            tok_stream_push(stream, TOK_MINUS, raw.tok_start + 1, 1, "-");
        } else {
            tok_stream_push(stream, tok_kind(raw), raw.tok_start, raw.tok_len, word);
        }
        tok_next(raw);
    }
    var t *Tokenizer = tok_new_stream(text, stream);
    var tree *PNode = parse_tariff(t);
    var complete bool = false;
    if tree != nil { complete = tok_expect_end(t); }
    if !complete { tok_print_error(t, "tariff"); return nil; }
    var decls *u8 = ast_vec();
    var functions *PNode = pnode_require(tree, "functions");
    var i i64 = 0;
    while i < vec_len(functions.children) {
        var f *PNode = vec_get(functions.children, i);
        var signature *PNode = pnode_require(f, "signature");
        var params *u8 = tariff_params(signature);
        ast_push(decls, ast_span(ast_func(tariff_name(pnode_require(signature, "name")), params, ast_type_i64(), tariff_block(pnode_require(f, "body"))), f.start, f.end));
        vec_free(params);
        i = i + 1;
    }
    return ast_program(decls);
}
