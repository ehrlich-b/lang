func main(argc i64, argv **u8) i64 {
    if argc != 2 { return 2; }
    var text *u8 = phase_read_file(*(argv + 1));
    if text == nil { return 2; }
    var result *u8 = tariff_read(text);
    if result == nil { return 1; }
