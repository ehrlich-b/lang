grammar Tariff;
program: function+ EOF;
function: 'fn' ID '(' parameters? ')' block;
parameters: ID (',' ID)*;
block: '{' statement* '}';
statement: binding | assignment | conditional | loop | returning;
binding: 'let' ID '=' expression ';';
assignment: ID '=' expression ';';
conditional: 'if' '(' expression ')' block otherwise?;
otherwise: 'else' block;
loop: 'while' '(' expression ')' block;
returning: 'return' expression ';';
expression: equality;
equality: comparison (('==' | '!=') comparison)*;
comparison: addition (('<' | '>' | '<=' | '>=') addition)*;
addition: product (('+' | '-') product)*;
product: unary (('*' | '/') unary)*;
unary: '-' unary | primary;
primary: INT | call | ID | '(' expression ')';
call: ID '(' arguments? ')';
arguments: expression (',' expression)*;
ID: [a-zA-Z_] [a-zA-Z_0-9]*;
INT: [0-9]+;
WS: [ \t\r\n]+ -> skip;
COMMENT: '//' ~[\r\n]* -> skip;
