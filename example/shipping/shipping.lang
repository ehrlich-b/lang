include "std/parser_reader.lang"
include "std/ast.lang"
include "example/shipping/exports.lang"

#parser{
    !captures;
    !inspect shipping_policy;
    shipping_policy = 'shipping' '{' settings:shipping_setting* '}'
    shipping_setting = name:symbol value:shipping_value ';'
    shipping_editor_policy = 'shipping' '{' settings:shipping_editor_setting* '}'
    shipping_editor_setting = recover(shipping_setting, ';', "}")
    shipping_value = number | '-' number
}

// Validate before converting: the scanner also recognizes nondecimal numbers.
func shipping_number(node *PNode, text *u8) i64 {
    var value i64 = 0;
    var i i64 = node.start;
    while i < node.end {
        var ch i64 = *(text + i);
        if ch < 48 || ch > 57 || value > 100000 {
            reader_error("shipping-range", "expected decimal integer in 0..1000000", "shipping", text, node.start, node.end);
            return -1;
        }
        value = value * 10 + ch - 48;
        i = i + 1;
    }
    if value > 1000000 {
        reader_error("shipping-range", "expected decimal integer in 0..1000000", "shipping", text, node.start, node.end);
        return -1;
    }
    return value;
}

func shipping_read(text *u8, with_main bool) *u8 {
    var tokens *Tokenizer = tok_new(text);
    var tree *PNode = parse_shipping_policy(tokens);
    var complete bool = false;
    if tree != nil { complete = tok_expect_end(tokens); }
    if pnode_has_error(tree) { return nil; }
    if !complete { tok_print_error(tokens, "shipping"); return nil; }
    var settings *u8 = capture_shipping_policy_repeated(tree, "settings");
    var base i64 = -1;
    var free_over i64 = -1;
    var i i64 = 0;
    while i < vec_len(settings) {
        var setting *PNode = vec_get(settings, i);
        var name *PNode = capture_shipping_setting_required(setting, "name");
        if !streq(name.text, "base") && !streq(name.text, "free_over") {
            reader_error("shipping-setting", "unknown setting; expected base or free_over", "shipping", text, name.start, name.end);
            return nil;
        }
        if (streq(name.text, "base") && base >= 0) || (streq(name.text, "free_over") && free_over >= 0) {
            reader_error("shipping-duplicate", "duplicate setting", "shipping", text, name.start, name.end); return nil;
        }
        var value i64 = shipping_number(capture_shipping_setting_required(setting, "value"), text);
        if value < 0 { return nil; }
        if streq(name.text, "base") { base = value; } else { free_over = value; }
        i = i + 1;
    }
    if base < 0 || free_over < 0 {
        reader_error("shipping-missing", "missing setting; require base and free_over", "shipping", text, tree.start, tree.end); return nil;
    }
    // Shared AST boundary: policy constants become data; total stays a variable.
    var names *u8 = vec_new(1);
    vec_push(names, "total");
    var body *u8 = ast_vec();
    ast_push(body, ast_if_then(ast_ge(ast_ident("total"), ast_int(free_over)), ast_block1(ast_return(ast_int(0)))));
    ast_push(body, ast_return(ast_int(base)));
    var decls *u8 = ast_vec();
    ast_push(decls, ast_span(reader_export_func(reader_export_find(shipping_exports(), "shipping_cost"),
        names, ast_block(body)), tree.start, tree.end));
    if !with_main { return ast_program(decls); }
    var params *u8 = ast_vec();
    ast_push(params, ast_param("argc", ast_type_i64()));
    ast_push(params, ast_param("argv", ast_type_ptr(ast_type_str())));
    body = ast_vec();
    ast_push(body, ast_var("total", ast_type_i64(), ast_call2("shipping_total", ast_ident("argc"), ast_ident("argv"))));
    ast_push(body, ast_return(ast_call1("shipping_print", ast_call1("shipping_cost", ast_ident("total")))));
    ast_push(decls, ast_func("main", params, ast_type_i64(), ast_block(body)));
    return ast_program(decls);
}

reader shipping(text *u8) *u8 { return shipping_read(text, true); }

// Library mode emits the exported function without a competing entry point.
reader shippinglib(text *u8) *u8 { return shipping_read(text, false); }

// Editor consumers receive syntax only. This entry point never emits core AST.
pub func shipping_partial(text *u8) *PNode {
    var tokens *Tokenizer = tok_new(text);
    tokens.recovery = 1;
    return parse_shipping_editor_policy(tokens);
}
