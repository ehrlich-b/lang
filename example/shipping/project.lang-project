project {
    version 1;
    parser_work 1000000;
    parser_depth 128;
    reader_source "shipping.lang";
    reader_name "shipping";
    source_suffix ".shipping";
    runtime_files ["runtime.lang"];
    entry "policy.shipping";
    backend "llvm";
    native_profile "llvm-linux-x86_64";
    native_toolchain "clang";
}
