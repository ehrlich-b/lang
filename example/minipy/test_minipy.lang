// minipy demo - the block delimiter is whitespace.
//
// Nothing below says where a block starts or ends; the column of each line
// does. The shared tokenizer never saw that column - it skips whitespace - so
// the reader recovers it from each token's byte offset and synthesizes the
// INDENT/DEDENT tokens itself. No shared code changed to make this language
// possible, which is the whole claim.
include "std/core.lang"
include "example/minipy/minipy_runtime.lang"
include "example/minipy/minipy.lang"

// Called from minipy below with no declaration of any kind - a name minipy
// doesn't recognize is emitted as an ordinary call, and the i64 ABI does the
// rest.
func host_double(n i64) i64 { return n * 2; }

#minipy{
# --- functions, recursion, and the precedence ladder ---
def add(a, b):
    return a + b

def fib(n):
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

def tiny(n): return n * 2                  # a one-line suite

def bits(n):
    return (n << 2) | (n & 3) ^ 1          # Python's precedence: | then ^ then &

def inv(n):
    return ~n

# The tokenizer folds `-` into a following digit, so all three spellings below
# would otherwise lex differently. They must not.
def spaced(n):
    return n -1 + n- 1 + n-1

def half(n):
    return n // 2                          # `//` would be a lang comment; the
                                           # reader defuses it before tokenizing

def logic(a, b):
    if a and not b:
        return 1
    if a or b:
        return 2
    return 3

# --- indentation IS the block structure ---
def collatz(n):
    steps = 0
    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1
        steps += 1
    return steps

def gcd(a, b):
    while b != 0:
        t = a % b
        a = b
        b = t
    return a

# `s` is assigned only inside branches and read after them. Python scopes it to
# the function; lang would scope each `var` to its own block, so the reader
# hoists every assigned name to the top of the function.
def sign(n):
    if n > 0:
        s = 1
    elif n < 0:
        s = -1
    else:
        s = 0
    return s

def digits(n):
    c = 0
    while True:
        c += 1
        n = n / 10
        if n == 0:
            break
    return c

# --- for/range, including the cases that break a naive desugaring ---
def sum_evens(n):
    total = 0
    for i in range(n):
        if i % 2 == 1:
            continue                       # must still advance the loop
        total += i
    return total

def countdown(n):
    out = 0
    for i in range(n, 0, -1):              # a negative step flips the test
        out = out * 10 + i
    return out

def first_div(n):
    for d in range(2, n):
        if n % d == 0:
            return d
    return 0

def count_primes(n):
    c = 0
    for x in range(2, n):
        prime = 1
        for d in range(2, x):              # nested loops, inner break
            if x % d == 0:
                prime = 0
                break
        if prime:
            c += 1
    return c

# --- layout edge cases ---
def wide(a, b, c):
    return (a +
            b +
            c)                             # a newline inside ( ) continues the line

def wide2(a):
    return wide(a,
                a + 1,
                a + 2)

def commented(n):
    # a full-line comment
    x = n * 2                              # and a trailing one
              # this comment is indented far deeper than the block, and must not
              # open one: after stripping, the line holds no tokens at all
    return x

def oneline(n):
    if n > 5: return 1
    return 0

def semis(n):
    x = 1; y = 2
    return x * 10 + y

def hosted(n):
    return host_double(n)                  # a lang function, called from Python

def quoted(n):
    print("a # inside a string is not a comment")
    return n
}

// A second block, indented, to show the base column is taken from the block's
// own first line rather than assumed to be zero.
    #minipy{
        def indented_ok(n):
            if n > 0:
                return n * 100
            return 0
    }

func check(name *u8, got i64, want i64) i64 {
    if got == want { return 0; }
    print("FAIL ");
    print(name);
    print(": got ");
    print_int(got);
    print(" want ");
    print_int(want);
    print("\n");
    return 1;
}

func main() i64 {
    var bad i64 = 0;
    bad = bad + check("add", add(3, 4), 7);
    bad = bad + check("fib", fib(10), 55);
    bad = bad + check("tiny", tiny(21), 42);
    bad = bad + check("bits", bits(5), 20);
    bad = bad + check("inv", inv(0), 0 - 1);
    bad = bad + check("half", half(7), 3);
    bad = bad + check("spaced", spaced(10), 27);
    bad = bad + check("logic10", logic(1, 0), 1);
    bad = bad + check("logic01", logic(0, 1), 2);
    bad = bad + check("logic00", logic(0, 0), 3);
    bad = bad + check("collatz", collatz(27), 111);
    bad = bad + check("gcd", gcd(48, 18), 6);
    bad = bad + check("sign+", sign(5), 1);
    bad = bad + check("sign-", sign(0 - 5), 0 - 1);
    bad = bad + check("sign0", sign(0), 0);
    bad = bad + check("digits", digits(12345), 5);
    bad = bad + check("sum_evens", sum_evens(10), 20);
    bad = bad + check("countdown", countdown(3), 321);
    bad = bad + check("first_div", first_div(15), 3);
    bad = bad + check("count_primes", count_primes(30), 10);
    bad = bad + check("wide", wide(1, 2, 3), 6);
    bad = bad + check("wide2", wide2(10), 33);
    bad = bad + check("commented", commented(21), 42);
    bad = bad + check("oneline6", oneline(6), 1);
    bad = bad + check("oneline3", oneline(3), 0);
    bad = bad + check("semis", semis(0), 12);
    bad = bad + check("hosted", hosted(21), 42);
    bad = bad + check("indented_ok", indented_ok(4), 400);

    print("collatz(27) = "); print_int(collatz(27)); print("\n");
    print("primes below 30: "); print_int(count_primes(30)); print("\n");
    quoted(1);

    if bad != 0 { return 1; }
    print("MINIPY PASS\n");
    return 0;
}
