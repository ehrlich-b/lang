// ============================================================
// minipy - a language whose block delimiter is whitespace
// ============================================================
//
// The fifth polyglot language, and the first one you cannot parse by reading
// characters in order. C, flow and minilisp bracket their blocks, and forth has
// no blocks at all; minipy's block structure lives in the space to the LEFT of
// each line, which is exactly the part every other reader throws away:
//
//   #minipy{
//       def collatz(n):
//           steps = 0
//           while n != 1:
//               if n % 2 == 0:
//                   n = n / 2
//               else:
//                   n = 3 * n + 1
//               steps += 1
//           return steps
//   }
//
// The shared tokenizer (std/tok.lang) is deliberately whitespace-blind - it
// skips runs of spaces and newlines without recording them, and every other
// reader depends on that. Layout does NOT need it to change. A token carries its
// byte offset into the source (`tok_start`), so the two facts the offside rule
// actually needs - "is this the first token on its line" and "at what column" -
// are still recoverable, and recovering them is the reader's business, not the
// tokenizer's. py_lex below rebuilds them and emits the synthetic NEWLINE /
// INDENT / DEDENT tokens a layout language wants, which is precisely what
// CPython's tokenizer hands to its parser. Nothing shared was touched, so
// nothing else could break: layout is a plugin too.
//
// Two consequences of layout that the token stream then handles for free:
// a newline inside `( ... )` continues the line (bracket depth suppresses the
// rule), and a blank or comment-only line has no tokens at all, so it cannot
// affect indentation.
//
// Supported: def, if/elif/else, while, for-in-range, return, pass, break,
// continue, assignment and augmented assignment, `and`/`or`/`not`, the full
// Python precedence ladder down through the bitwise and shift operators,
// calls, `#` comments, and both quote styles. True/False/None are 1/0/0.
//
// Deliberate bounds (round 1): every value is an i64, so there are no lists,
// dicts, strings-as-values (a string literal may only be an argument to
// `print`), or floats; no classes, no lambdas, no nested defs or closures, no
// default/keyword arguments, no `import`, no exceptions, and only `def` at the
// top level. `for` iterates `range(...)` only. Chained comparisons (`a < b < c`)
// are rejected rather than silently mis-associated. Names are function-scoped as
// in Python (see py_def's hoist), NOT block-scoped as in lang.
//
// A call to a name minipy has never seen is emitted as an ordinary call, so
// minipy reaches C, minilisp, flow, forth and lang functions with no
// declaration of any kind - the i64 ABI is the whole interface.
//
// Converter helpers are py_-prefixed so minipy composes with the other readers
// in one binary (no symbol collisions).

include "std/core.lang"
include "std/ast.lang"
include "std/tok.lang"

// Synthetic token kinds, above anything std/tok.lang produces. These are the
// layout algorithm's entire output: the structure of the program.
var PY_NEWLINE i64 = 200;
var PY_INDENT i64 = 201;
var PY_DEDENT i64 = 202;

// ============================================================
// Source pre-pass
// ============================================================

// Blank out `#` comments and defuse `//`, without moving a single byte.
//
// Byte positions ARE the block structure here, so this pass must be
// length-preserving: a comment becomes spaces rather than disappearing, which
// also makes a comment-only line indistinguishable from a blank one - Python's
// rule, for free. `//` (floor division) has to be neutered because the shared
// tokenizer would eat the rest of the line as a lang comment; rewriting it to
// `/ ` keeps the length, and integer division is what `/` already means when
// every value is an i64.
func py_strip_comments(text *u8) *u8 {
    var sb *StringBuilder = sb_new();
    var p *u8 = text;
    var quote i64 = 0;
    while *p != 0 {
        var c i64 = *p;
        if quote != 0 {
            sb_char(sb, c);
            if c == 92 {
                if *(p + 1) != 0 {
                    p = p + 1;
                    sb_char(sb, *p);
                }
            } else if c == quote {
                quote = 0;
            }
        } else if c == 34 || c == 39 {
            quote = c;
            sb_char(sb, c);
        } else if c == 35 {
            while *p != 0 && *p != 10 {
                sb_char(sb, 32);
                p = p + 1;
            }
            if *p == 0 { return sb_finish(sb); }
            sb_char(sb, 10);
        } else if c == 47 && *(p + 1) == 47 {
            sb_char(sb, 47);
            sb_char(sb, 32);
            p = p + 1;
        } else {
            sb_char(sb, c);
        }
        p = p + 1;
    }
    return sb_finish(sb);
}

// ============================================================
// The token stream
// ============================================================
//
// Tokens are a flat vec of (kind, text, line, col) quadruples. A reader's own
// struct declarations are a road less travelled, and four parallel slots cost
// nothing next to that risk.

func py_emit(toks *u8, kind i64, text *u8, line i64, col i64) void {
    vec_push(toks, kind);
    vec_push(toks, text);
    vec_push(toks, line);
    vec_push(toks, col);
}

func py_k(toks *u8, i i64) i64 {
    if i * 4 >= vec_len(toks) { return TOK_EOF; }
    return vec_get(toks, i * 4);
}

func py_txt(toks *u8, i i64) *u8 {
    if i * 4 + 1 >= vec_len(toks) { return ""; }
    return vec_get(toks, i * 4 + 1);
}

func py_line(toks *u8, i i64) i64 {
    if i * 4 + 2 >= vec_len(toks) { return 0; }
    return vec_get(toks, i * 4 + 2);
}

// Offset of the first byte of the line containing `off`.
func py_line_start(text *u8, off i64) i64 {
    while off > 0 {
        if *(text + off - 1) == 10 { return off; }
        off = off - 1;
    }
    return 0;
}

func py_top(indents *u8) i64 {
    return vec_get(indents, vec_len(indents) - 1);
}

// The offside rule. Walks the ordinary token stream and inserts NEWLINE where a
// logical line ends and INDENT/DEDENT where the left margin moves.
//
// The base indent is taken from the FIRST token rather than assumed to be
// column 0, so a `#minipy{ ... }` block may sit at whatever indentation the
// host file uses - only the columns relative to that first line matter.
func py_lex(text *u8) *u8 {
    var t *Tokenizer = tok_new(text);
    var toks *u8 = vec_new(256);
    var indents *u8 = vec_new(16);
    vec_push(indents, 0);

    var depth i64 = 0;
    var prev_ls i64 = 0 - 1;
    var started i64 = 0;
    var line i64 = 1;
    var scanned i64 = 0;

    while tok_kind(t) != TOK_EOF {
        var start i64 = t.tok_start;
        while scanned < start {
            if *(text + scanned) == 10 { line = line + 1; }
            scanned = scanned + 1;
        }
        var ls i64 = py_line_start(text, start);
        var col i64 = start - ls;

        // Bracketed newlines are continuations, not statement ends.
        if depth == 0 && ls != prev_ls {
            if started == 0 {
                vec_set(indents, 0, col);
            } else {
                py_emit(toks, PY_NEWLINE, "", line, col);
                if col > py_top(indents) {
                    vec_push(indents, col);
                    py_emit(toks, PY_INDENT, "", line, col);
                } else {
                    while col < py_top(indents) {
                        vec_pop(indents);
                        py_emit(toks, PY_DEDENT, "", line, col);
                    }
                    if col != py_top(indents) {
                        eprint("minipy: line ");
                        eprint_i64(line);
                        eprint(": dedent does not match any enclosing block\n");
                    }
                }
            }
        }
        prev_ls = ls;
        started = 1;

        var k i64 = tok_kind(t);
        if k == TOK_LPAREN || k == TOK_LBRACKET || k == TOK_LBRACE {
            depth = depth + 1;
        }
        if k == TOK_RPAREN || k == TOK_RBRACKET || k == TOK_RBRACE {
            if depth > 0 { depth = depth - 1; }
        }
        // A string's text is its VALUE (unquoted, unescaped); the kind is what
        // says it was quoted, so nothing downstream needs to re-parse it.
        if k == TOK_STRING {
            py_emit(toks, k, tok_string_value(t), line, col);
        } else {
            py_emit(toks, k, tok_text(t), line, col);
        }
        tok_next(t);
    }

    if started == 1 { py_emit(toks, PY_NEWLINE, "", line, 0); }
    while vec_len(indents) > 1 {
        vec_pop(indents);
        py_emit(toks, PY_DEDENT, "", line, 0);
    }
    py_emit(toks, TOK_EOF, "", line, 0);
    return toks;
}

// ============================================================
// Token predicates
// ============================================================

func py_is_kw(toks *u8, i i64, kw *u8) i64 {
    if py_k(toks, i) != TOK_IDENT { return 0; }
    if streq(py_txt(toks, i), kw) { return 1; }
    return 0;
}

// Operators arrive as a kind plus their text, so `<`, `<=` and `<<` all share
// TOK_LT and are told apart here.
func py_is_op(toks *u8, i i64, kind i64, text *u8) i64 {
    if py_k(toks, i) != kind { return 0; }
    if streq(py_txt(toks, i), text) { return 1; }
    return 0;
}

var py_errors i64 = 0;

// Line numbers are relative to the `#minipy{` block, which is the only origin
// the reader is given.
func py_err(toks *u8, i i64, msg *u8) void {
    py_errors = py_errors + 1;
    eprint("minipy: line ");
    eprint_i64(py_line(toks, i));
    eprint(": ");
    eprint(msg);
    eprint("\n");
}

func py_expect(toks *u8, ip *i64, kind i64, what *u8) void {
    if py_k(toks, *ip) == kind {
        *ip = *ip + 1;
        return;
    }
    py_err(toks, *ip, what);
}

func py_expect_kw(toks *u8, ip *i64, kw *u8, what *u8) void {
    if py_is_kw(toks, *ip, kw) == 1 {
        *ip = *ip + 1;
        return;
    }
    py_err(toks, *ip, what);
}

// ============================================================
// Expressions - the Python precedence ladder
// ============================================================

func py_expr(toks *u8, ip *i64) *u8 {
    return py_or(toks, ip);
}

func py_or(toks *u8, ip *i64) *u8 {
    var e *u8 = py_and(toks, ip);
    while py_is_kw(toks, *ip, "or") == 1 {
        *ip = *ip + 1;
        e = ast_binop("||", e, py_and(toks, ip));
    }
    return e;
}

func py_and(toks *u8, ip *i64) *u8 {
    var e *u8 = py_not(toks, ip);
    while py_is_kw(toks, *ip, "and") == 1 {
        *ip = *ip + 1;
        e = ast_binop("&&", e, py_not(toks, ip));
    }
    return e;
}

func py_not(toks *u8, ip *i64) *u8 {
    if py_is_kw(toks, *ip, "not") == 1 {
        *ip = *ip + 1;
        return ast_not(py_not(toks, ip));
    }
    return py_cmp(toks, ip);
}

// The comparison operator at i, or nil. `<<` and `>>` are shifts, not
// comparisons, and are filtered out here by their text.
func py_cmp_op(toks *u8, i i64) *u8 {
    var k i64 = py_k(toks, i);
    var s *u8 = py_txt(toks, i);
    if k == TOK_LT {
        if streq(s, "<") { return "<"; }
        if streq(s, "<=") { return "<="; }
        return nil;
    }
    if k == TOK_GT {
        if streq(s, ">") { return ">"; }
        if streq(s, ">=") { return ">="; }
        return nil;
    }
    if k == TOK_EQ {
        if streq(s, "==") { return "=="; }
        return nil;
    }
    if k == TOK_BANG {
        if streq(s, "!=") { return "!="; }
        return nil;
    }
    return nil;
}

// Python's `a < b < c` means `a < b and b < c`, not `(a < b) < c`. Rather than
// quietly compile the wrong program, refuse it.
func py_cmp(toks *u8, ip *i64) *u8 {
    var e *u8 = py_bitor(toks, ip);
    var op *u8 = py_cmp_op(toks, *ip);
    if op == nil { return e; }
    *ip = *ip + 1;
    var rhs *u8 = py_bitor(toks, ip);
    if py_cmp_op(toks, *ip) != nil {
        py_err(toks, *ip, "chained comparison (a < b < c) is not supported");
    }
    return ast_binop(op, e, rhs);
}

func py_bitor(toks *u8, ip *i64) *u8 {
    var e *u8 = py_bitxor(toks, ip);
    while py_is_op(toks, *ip, TOK_PIPE, "|") == 1 {
        *ip = *ip + 1;
        e = ast_binop("|", e, py_bitxor(toks, ip));
    }
    return e;
}

func py_bitxor(toks *u8, ip *i64) *u8 {
    var e *u8 = py_bitand(toks, ip);
    while py_is_op(toks, *ip, TOK_CARET, "^") == 1 {
        *ip = *ip + 1;
        e = ast_binop("^", e, py_bitand(toks, ip));
    }
    return e;
}

func py_bitand(toks *u8, ip *i64) *u8 {
    var e *u8 = py_shift(toks, ip);
    while py_is_op(toks, *ip, TOK_AMP, "&") == 1 {
        *ip = *ip + 1;
        e = ast_binop("&", e, py_shift(toks, ip));
    }
    return e;
}

func py_shift(toks *u8, ip *i64) *u8 {
    var e *u8 = py_add(toks, ip);
    var go i64 = 1;
    while go == 1 {
        if py_is_op(toks, *ip, TOK_LT, "<<") == 1 {
            *ip = *ip + 1;
            e = ast_binop("<<", e, py_add(toks, ip));
        } else if py_is_op(toks, *ip, TOK_GT, ">>") == 1 {
            *ip = *ip + 1;
            e = ast_binop(">>", e, py_add(toks, ip));
        } else {
            go = 0;
        }
    }
    return e;
}

// The shared tokenizer folds a `-` straight into a following digit, so `n -1`
// arrives as `n` and the single number `-1` with no operator between them.
// Every infix reader has to undo that; forth's answer was to ban `-5` outright,
// which is not an option for a language people expect to write `i-1` in.
func py_neg_number(toks *u8, i i64) i64 {
    if py_k(toks, i) != TOK_NUMBER { return 0; }
    if *py_txt(toks, i) == 45 { return 1; }
    return 0;
}

func py_add(toks *u8, ip *i64) *u8 {
    var e *u8 = py_term(toks, ip);
    var go i64 = 1;
    while go == 1 {
        if py_is_op(toks, *ip, TOK_PLUS, "+") == 1 {
            *ip = *ip + 1;
            e = ast_binop("+", e, py_term(toks, ip));
        } else if py_is_op(toks, *ip, TOK_MINUS, "-") == 1 {
            *ip = *ip + 1;
            e = ast_binop("-", e, py_term(toks, ip));
        } else if py_neg_number(toks, *ip) == 1 {
            var t *u8 = py_txt(toks, *ip);
            *ip = *ip + 1;
            e = ast_binop("-", e, ast_number(t + 1));
        } else {
            go = 0;
        }
    }
    return e;
}

func py_term(toks *u8, ip *i64) *u8 {
    var e *u8 = py_unary(toks, ip);
    var go i64 = 1;
    while go == 1 {
        if py_is_op(toks, *ip, TOK_STAR, "*") == 1 {
            *ip = *ip + 1;
            e = ast_binop("*", e, py_unary(toks, ip));
        } else if py_is_op(toks, *ip, TOK_SLASH, "/") == 1 {
            *ip = *ip + 1;
            e = ast_binop("/", e, py_unary(toks, ip));
        } else if py_is_op(toks, *ip, TOK_PERCENT, "%") == 1 {
            *ip = *ip + 1;
            e = ast_binop("%", e, py_unary(toks, ip));
        } else {
            go = 0;
        }
    }
    return e;
}

func py_unary(toks *u8, ip *i64) *u8 {
    if py_is_op(toks, *ip, TOK_MINUS, "-") == 1 {
        *ip = *ip + 1;
        return ast_neg(py_unary(toks, ip));
    }
    if py_is_op(toks, *ip, TOK_PLUS, "+") == 1 {
        *ip = *ip + 1;
        return py_unary(toks, ip);
    }
    if py_is_op(toks, *ip, TOK_TILDE, "~") == 1 {
        *ip = *ip + 1;
        return ast_binop("^", py_unary(toks, ip), ast_neg(ast_int(1)));
    }
    return py_atom(toks, ip);
}

func py_args(toks *u8, ip *i64) *u8 {
    var args *u8 = ast_vec();
    py_expect(toks, ip, TOK_LPAREN, "expected '(' in call");
    while py_k(toks, *ip) != TOK_RPAREN && py_k(toks, *ip) != TOK_EOF {
        ast_push(args, py_expr(toks, ip));
        if py_k(toks, *ip) == TOK_COMMA { *ip = *ip + 1; }
    }
    py_expect(toks, ip, TOK_RPAREN, "unclosed call argument list");
    return args;
}

func py_atom(toks *u8, ip *i64) *u8 {
    var k i64 = py_k(toks, *ip);
    if k == TOK_NUMBER {
        var n *u8 = py_txt(toks, *ip);
        *ip = *ip + 1;
        return ast_number(n);
    }
    if k == TOK_STRING {
        py_err(toks, *ip, "a string may only be an argument to print in this subset");
        *ip = *ip + 1;
        return ast_int(0);
    }
    if k == TOK_LPAREN {
        *ip = *ip + 1;
        var e *u8 = py_expr(toks, ip);
        py_expect(toks, ip, TOK_RPAREN, "unclosed parenthesis");
        return e;
    }
    if k == TOK_IDENT {
        var name *u8 = py_txt(toks, *ip);
        if streq(name, "True")  { *ip = *ip + 1; return ast_int(1); }
        if streq(name, "False") { *ip = *ip + 1; return ast_int(0); }
        if streq(name, "None")  { *ip = *ip + 1; return ast_int(0); }
        *ip = *ip + 1;
        // Any name, defined here or in any other language in the binary.
        if py_k(toks, *ip) == TOK_LPAREN {
            return ast_call_named(name, py_args(toks, ip));
        }
        return ast_ident(name);
    }
    py_err(toks, *ip, "expected an expression");
    *ip = *ip + 1;
    return ast_int(0);
}

// ============================================================
// Statements
// ============================================================

func py_name_in(names *u8, name *u8) i64 {
    var n i64 = vec_len(names);
    var i i64 = 0;
    while i < n {
        var s *u8 = vec_get(names, i);
        if streq(s, name) { return 1; }
        i = i + 1;
    }
    return 0;
}

func py_note_local(locals *u8, name *u8) void {
    if py_name_in(locals, name) == 0 { vec_push(locals, name); }
}

// A per-token-unique name for a compiler-introduced temp.
func py_gensym(prefix *u8, idx i64) *u8 {
    var sb *StringBuilder = sb_new();
    sb_str(sb, prefix);
    sb_int(sb, idx);
    return sb_finish(sb);
}

// The augmented-assignment operator at i, or nil.
func py_aug_op(toks *u8, i i64) *u8 {
    var k i64 = py_k(toks, i);
    var s *u8 = py_txt(toks, i);
    if k == TOK_PLUS && streq(s, "+=") { return "+"; }
    if k == TOK_MINUS && streq(s, "-=") { return "-"; }
    if k == TOK_STAR && streq(s, "*=") { return "*"; }
    if k == TOK_SLASH && streq(s, "/=") { return "/"; }
    if k == TOK_PERCENT && streq(s, "%=") { return "%"; }
    return nil;
}

// `print(a, "b", c)` -> py_int(a); py_space(); py_str("b"); ... ; py_nl().
// Which call an argument becomes is decided from its syntax right here, which
// is how a variadic polymorphic builtin survives lowering into a language that
// has neither.
func py_print(toks *u8, ip *i64, stmts *u8) void {
    *ip = *ip + 1;
    py_expect(toks, ip, TOK_LPAREN, "expected '(' after print");
    var n i64 = 0;
    while py_k(toks, *ip) != TOK_RPAREN && py_k(toks, *ip) != TOK_EOF {
        if n > 0 { ast_push(stmts, ast_expr_stmt(ast_call_named0("py_space"))); }
        if py_k(toks, *ip) == TOK_STRING {
            var s *u8 = py_txt(toks, *ip);
            *ip = *ip + 1;
            ast_push(stmts, ast_expr_stmt(ast_call_named1("py_str", ast_string(s))));
        } else {
            ast_push(stmts, ast_expr_stmt(ast_call_named1("py_int", py_expr(toks, ip))));
        }
        n = n + 1;
        if py_k(toks, *ip) == TOK_COMMA { *ip = *ip + 1; }
    }
    py_expect(toks, ip, TOK_RPAREN, "unclosed print");
    ast_push(stmts, ast_expr_stmt(ast_call_named0("py_nl")));
}

// Statements that cannot contain a block.
func py_simple(toks *u8, ip *i64, stmts *u8, locals *u8) void {
    if py_k(toks, *ip) == TOK_IDENT {
        var w *u8 = py_txt(toks, *ip);
        if streq(w, "pass") { *ip = *ip + 1; return; }
        if streq(w, "break") {
            *ip = *ip + 1;
            ast_push(stmts, ast_break(nil));
            return;
        }
        if streq(w, "continue") {
            *ip = *ip + 1;
            ast_push(stmts, ast_continue(nil));
            return;
        }
        if streq(w, "return") {
            *ip = *ip + 1;
            if py_k(toks, *ip) == PY_NEWLINE || py_k(toks, *ip) == TOK_SEMI {
                ast_push(stmts, ast_return(ast_int(0)));
            } else {
                ast_push(stmts, ast_return(py_expr(toks, ip)));
            }
            return;
        }
        if streq(w, "print") {
            if py_k(toks, *ip + 1) == TOK_LPAREN {
                py_print(toks, ip, stmts);
                return;
            }
        }
        if py_is_op(toks, *ip + 1, TOK_EQ, "=") == 1 {
            py_note_local(locals, w);
            *ip = *ip + 2;
            ast_push(stmts, ast_assign(ast_ident(w), py_expr(toks, ip)));
            return;
        }
        var aug *u8 = py_aug_op(toks, *ip + 1);
        if aug != nil {
            py_note_local(locals, w);
            *ip = *ip + 2;
            var rhs *u8 = py_expr(toks, ip);
            ast_push(stmts, ast_assign(ast_ident(w), ast_binop(aug, ast_ident(w), rhs)));
            return;
        }
    }
    ast_push(stmts, ast_expr_stmt(py_expr(toks, ip)));
}

// `:` followed by either an indented block or a one-line suite. Statements are
// appended to the caller's vec so a desugaring can wrap them (see py_for).
func py_block_into(toks *u8, ip *i64, stmts *u8, locals *u8) void {
    py_expect(toks, ip, TOK_COLON, "expected ':' to open a block");
    if py_k(toks, *ip) != PY_NEWLINE {
        py_simple(toks, ip, stmts, locals);
        while py_k(toks, *ip) == TOK_SEMI {
            *ip = *ip + 1;
            py_simple(toks, ip, stmts, locals);
        }
        if py_k(toks, *ip) == PY_NEWLINE { *ip = *ip + 1; }
        return;
    }
    *ip = *ip + 1;
    if py_k(toks, *ip) != PY_INDENT {
        py_err(toks, *ip, "expected an indented block");
        return;
    }
    *ip = *ip + 1;
    while py_k(toks, *ip) != PY_DEDENT && py_k(toks, *ip) != TOK_EOF {
        py_stmt(toks, ip, stmts, locals);
    }
    if py_k(toks, *ip) == PY_DEDENT { *ip = *ip + 1; }
}

func py_block(toks *u8, ip *i64, locals *u8) *u8 {
    var stmts *u8 = ast_vec();
    py_block_into(toks, ip, stmts, locals);
    return ast_block(stmts);
}

// `elif` is just an `if` in the else branch, so the keyword is skipped by the
// same line that skips `if`.
func py_if(toks *u8, ip *i64, stmts *u8, locals *u8) void {
    *ip = *ip + 1;
    var cond *u8 = py_expr(toks, ip);
    var then_b *u8 = py_block(toks, ip, locals);
    var else_b *u8 = nil;
    if py_is_kw(toks, *ip, "elif") == 1 {
        var eb *u8 = ast_vec();
        py_if(toks, ip, eb, locals);
        else_b = ast_block(eb);
    } else if py_is_kw(toks, *ip, "else") == 1 {
        *ip = *ip + 1;
        else_b = py_block(toks, ip, locals);
    }
    ast_push(stmts, ast_if(cond, then_b, else_b));
}

func py_while(toks *u8, ip *i64, stmts *u8, locals *u8) void {
    *ip = *ip + 1;
    var cond *u8 = py_expr(toks, ip);
    ast_push(stmts, ast_while(cond, py_block(toks, ip, locals)));
}

// A literal integer, optionally negated - the only form `range`'s step may
// take, because the direction of the loop test has to be known at read time.
func py_step_literal(toks *u8, ip *i64) i64 {
    var neg i64 = 0;
    if py_is_op(toks, *ip, TOK_MINUS, "-") == 1 {
        neg = 1;
        *ip = *ip + 1;
    }
    if py_k(toks, *ip) != TOK_NUMBER {
        py_err(toks, *ip, "range's step must be an integer literal");
        return 1;
    }
    var v i64 = py_str_to_int(py_txt(toks, *ip));
    *ip = *ip + 1;
    if neg == 1 { return 0 - v; }
    return v;
}

func py_str_to_int(s *u8) i64 {
    var neg i64 = 0;
    if *s == 45 {
        neg = 1;
        s = s + 1;
    }
    var n i64 = 0;
    while *s != 0 {
        n = n * 10 + (*s - 48);
        s = s + 1;
    }
    if neg == 1 { return 0 - n; }
    return n;
}

// `for v in range(start, limit, step): body`
//
//     __lim = limit
//     v = start - step
//     while 1:
//         v = v + step
//         if v >= __lim: break
//         body
//
// The step happens at the TOP of the body, not the bottom, so that `continue`
// still advances the loop - lang's `continue` jumps to the loop condition, and a
// bottom increment would be skipped, turning a Python `continue` into a hang.
// Biasing the initial value by one step is what buys that placement. Both range
// bounds are evaluated exactly once, as in Python.
func py_for(toks *u8, ip *i64, stmts *u8, locals *u8) void {
    var idx i64 = *ip;
    *ip = *ip + 1;
    if py_k(toks, *ip) != TOK_IDENT {
        py_err(toks, *ip, "expected a loop variable after 'for'");
        return;
    }
    var vname *u8 = py_txt(toks, *ip);
    py_note_local(locals, vname);
    *ip = *ip + 1;
    py_expect_kw(toks, ip, "in", "expected 'in' after the loop variable");
    if py_is_kw(toks, *ip, "range") == 0 {
        py_err(toks, *ip, "for may only iterate range(...) in this subset");
        return;
    }
    *ip = *ip + 1;
    py_expect(toks, ip, TOK_LPAREN, "expected '(' after range");

    var first *u8 = py_expr(toks, ip);
    var start *u8 = ast_int(0);
    var limit *u8 = first;
    var step i64 = 1;
    if py_k(toks, *ip) == TOK_COMMA {
        *ip = *ip + 1;
        start = first;
        limit = py_expr(toks, ip);
        if py_k(toks, *ip) == TOK_COMMA {
            *ip = *ip + 1;
            step = py_step_literal(toks, ip);
        }
    }
    py_expect(toks, ip, TOK_RPAREN, "unclosed range");
    if step == 0 {
        py_err(toks, idx, "range's step may not be zero");
        step = 1;
    }

    var lim_name *u8 = py_gensym("__py_lim", idx);
    ast_push(stmts, ast_var(lim_name, ast_type_i64(), limit));
    ast_push(stmts, ast_assign(ast_ident(vname), ast_binop("-", start, ast_int(step))));

    var body *u8 = ast_vec();
    ast_push(body, ast_assign(ast_ident(vname), ast_binop("+", ast_ident(vname), ast_int(step))));
    var cmp *u8 = ">=";
    if step < 0 { cmp = "<="; }
    ast_push(body, ast_if(ast_binop(cmp, ast_ident(vname), ast_ident(lim_name)),
                          ast_block1(ast_break(nil)), nil));
    py_block_into(toks, ip, body, locals);
    ast_push(stmts, ast_while(ast_int(1), ast_block(body)));
}

// Keywords that would otherwise fall through to an expression statement and
// compile to something quietly unrelated to what they mean in Python.
func py_unsupported_kw(w *u8) i64 {
    if streq(w, "class") { return 1; }
    if streq(w, "import") { return 1; }
    if streq(w, "from") { return 1; }
    if streq(w, "lambda") { return 1; }
    if streq(w, "try") { return 1; }
    if streq(w, "with") { return 1; }
    if streq(w, "yield") { return 1; }
    if streq(w, "global") { return 1; }
    if streq(w, "nonlocal") { return 1; }
    if streq(w, "assert") { return 1; }
    if streq(w, "del") { return 1; }
    if streq(w, "raise") { return 1; }
    return 0;
}

func py_stmt(toks *u8, ip *i64, stmts *u8, locals *u8) void {
    var k i64 = py_k(toks, *ip);
    if k == PY_NEWLINE {
        *ip = *ip + 1;
        return;
    }
    if k == TOK_IDENT {
        var w *u8 = py_txt(toks, *ip);
        if streq(w, "if") { py_if(toks, ip, stmts, locals); return; }
        if streq(w, "while") { py_while(toks, ip, stmts, locals); return; }
        if streq(w, "for") { py_for(toks, ip, stmts, locals); return; }
        if streq(w, "def") {
            py_err(toks, *ip, "nested functions are not supported");
            py_skip_line(toks, ip);
            return;
        }
        if py_unsupported_kw(w) == 1 {
            py_err(toks, *ip, "this statement is not in the minipy subset");
            py_skip_line(toks, ip);
            return;
        }
    }
    py_simple(toks, ip, stmts, locals);
    while py_k(toks, *ip) == TOK_SEMI {
        *ip = *ip + 1;
        py_simple(toks, ip, stmts, locals);
    }
    if py_k(toks, *ip) == PY_NEWLINE {
        *ip = *ip + 1;
    } else {
        py_err(toks, *ip, "unexpected token after a statement");
        py_skip_line(toks, ip);
    }
}

func py_skip_line(toks *u8, ip *i64) void {
    while py_k(toks, *ip) != PY_NEWLINE && py_k(toks, *ip) != TOK_EOF {
        *ip = *ip + 1;
    }
    if py_k(toks, *ip) == PY_NEWLINE { *ip = *ip + 1; }
}

func py_starts(s *u8, p *u8) i64 {
    while *p != 0 {
        if *s == 0 { return 0; }
        if *s != *p { return 0; }
        s = s + 1;
        p = p + 1;
    }
    return 1;
}

// ============================================================
// Definitions
// ============================================================

// `def f(a, b): body` -> func f(a i64, b i64) i64 { ... }
//
// Python scopes a name to the whole function no matter which branch assigns it;
// lang scopes a `var` to its enclosing block. Every assigned name is therefore
// collected while the body is parsed and declared once at the top, so an
// assignment inside an `if` is still visible after it - which is exactly the
// mismatch that would otherwise make a faithful-looking program fail to compile.
func py_def(toks *u8, ip *i64) *u8 {
    *ip = *ip + 1;
    if py_k(toks, *ip) != TOK_IDENT {
        py_err(toks, *ip, "expected a function name after 'def'");
        return nil;
    }
    var name *u8 = py_txt(toks, *ip);
    *ip = *ip + 1;
    py_expect(toks, ip, TOK_LPAREN, "expected '(' after the function name");

    var params *u8 = ast_vec();
    var pnames *u8 = vec_new(8);
    while py_k(toks, *ip) == TOK_IDENT {
        var pn *u8 = py_txt(toks, *ip);
        ast_push(params, ast_param(pn, ast_type_i64()));
        vec_push(pnames, pn);
        *ip = *ip + 1;
        if py_k(toks, *ip) == TOK_COMMA { *ip = *ip + 1; }
    }
    py_expect(toks, ip, TOK_RPAREN, "unclosed parameter list");

    var locals *u8 = vec_new(16);
    var body *u8 = ast_vec();
    py_block_into(toks, ip, body, locals);

    var all *u8 = ast_vec();
    var nl i64 = vec_len(locals);
    var i i64 = 0;
    while i < nl {
        var ln *u8 = vec_get(locals, i);
        if py_name_in(pnames, ln) == 0 {
            ast_push(all, ast_var(ln, ast_type_i64(), ast_int(0)));
        }
        i = i + 1;
    }
    var nb i64 = ast_vec_len(body);
    i = 0;
    while i < nb {
        ast_push(all, ast_vec_get(body, i));
        i = i + 1;
    }
    // A Python function that runs off the end returns None; here that is 0.
    var tail_returns i64 = 0;
    if nb > 0 {
        if py_starts(ast_vec_get(body, nb - 1), "(return") == 1 { tail_returns = 1; }
    }
    if tail_returns == 0 { ast_push(all, ast_return(ast_int(0))); }

    return ast_func(name, params, ast_type_i64(), ast_block(all));
}

func py_program(toks *u8) *u8 {
    var decls *u8 = ast_vec();
    var ip i64 = 0;
    while py_k(toks, ip) != TOK_EOF {
        var k i64 = py_k(toks, ip);
        if k == PY_NEWLINE || k == PY_INDENT || k == PY_DEDENT {
            ip = ip + 1;
        } else if py_is_kw(toks, ip, "def") == 1 {
            var f *u8 = py_def(toks, &ip);
            if f != nil { ast_push(decls, f); }
        } else {
            py_err(toks, ip, "only 'def' is allowed at the top level");
            py_skip_line(toks, &ip);
        }
    }
    return ast_program(decls);
}

reader minipy(text *u8) *u8 {
    var src *u8 = py_strip_comments(text);
    var prog *u8 = py_program(py_lex(src));
    // A reader that reports a syntax error and then hands back a program anyway
    // is how a bad parse turns into a mystery further down the pipeline - most
    // often a function that simply isn't there. Refuse to emit one.
    if py_errors > 0 {
        eprint("minipy: ");
        eprint_i64(py_errors);
        eprint(" error(s); not emitting a program\n");
        exit(1);
    }
    return prog;
}
