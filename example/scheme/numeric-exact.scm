; Exact identity and extrema must preserve adjacent integers beyond binary64.
(assert (= (exact 9007199254740993) 9007199254740993))
(assert (= (exact -9007199254740993) -9007199254740993))
(assert (= (exact 1152921504606846975) 1152921504606846975))
(assert (= (exact -1152921504606846976) -1152921504606846976))
(assert (= (max 9007199254740992 9007199254740993) 9007199254740993))
(assert (= (max 9007199254740993 9007199254740992) 9007199254740993))
(assert (= (min 9007199254740993 9007199254740992) 9007199254740992))
(assert (= (min 9007199254740992 9007199254740993) 9007199254740992))
(assert (= (max -9007199254740993 -9007199254740992) -9007199254740992))
(assert (= (min -9007199254740992 -9007199254740993) -9007199254740993))
(assert (= (max 1152921504606846974 1152921504606846975) 1152921504606846975))
(assert (= (min -1152921504606846975 -1152921504606846976) -1152921504606846976))
(assert (= (max 9007199254740992 9007199254740993 9007199254740992) 9007199254740993))
(assert (= (min 9007199254740993 9007199254740992 9007199254740993) 9007199254740992))
; Existing inexact conversion and mixed extrema still use real arithmetic.
(assert (= (exact 3.0) 3))
(assert (inexact? (max 1 2.5)))
(assert (= (max 1 2.5) 2.5))
(assert (inexact? (min 2.5 1)))
(assert (= (min 2.5 1) 1.0))
(display "numeric exact ok") (newline)
