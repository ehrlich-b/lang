(assert (= (round -7) -7))
(assert (= (round 1.8) 2))
(assert (= (round 2.5) 2))
(assert (= (round -3.5) -4))
(assert (= (truncate -4.3) -4))
(assert (= (floor -4.3) -5))
(assert (= (ceiling -4.3) -4))
(assert (equal? (list-copy '(6 7 8 . 9)) '(6 7 8 . 9)))
(assert (equal? (string #\a #\b) "ab"))
(assert (equal? (string-copy "abc" 1 2) "b"))
(display "numeric ok") (newline)
