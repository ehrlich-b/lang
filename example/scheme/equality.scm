; Exact comparisons must not round integers through binary64.
(assert (not (equal? 9007199254740992 9007199254740993)))
(assert (not (eqv? 9007199254740992 9007199254740993)))
(assert (not (eq? 9007199254740992 9007199254740993)))
(assert (not (= 9007199254740992 9007199254740993)))
(assert (< 9007199254740992 9007199254740993))
(assert (> 9007199254740993 9007199254740992))
(assert (not (<= 9007199254740993 9007199254740992)))
(assert (not (>= 9007199254740992 9007199254740993)))
(assert (equal? 9007199254740993 9007199254740993))
(assert (not (equal? -9007199254740992 -9007199254740993)))
(assert (< -9007199254740993 -9007199254740992))
(assert (not (= 1152921504606846975 1152921504606846974)))
(assert (< -1152921504606846976 -1152921504606846975))
(assert (not (equal? '(9007199254740992) '(9007199254740993))))
(assert (not (equal? '#(9007199254740992) '#(9007199254740993))))
; Approximation belongs only to test-result, never Scheme equality.
(assert (not (equal? 1.0 1.0000005)))
(assert (not (eqv? 1.0 1.0000005)))
(assert (not (equal? '(1.0) '(1.0000005))))
(assert (not (equal? '#(1.0) '#(1.0000005))))
(assert (not (equal? 1 1.0)))
(assert (not (eqv? 1 1.0)))
(assert (= 1 1.0))
(assert (equal? 1.0 1.0))
(display "equality ok") (newline)
