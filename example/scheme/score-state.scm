; The first comparison deliberately fails: setup effects must never earn a pass.
(define x 0)
(define ignored (begin (set! x 1) 99))
(test 0 x)
(test 2 (begin (set! x (+ x 1)) x))
(test 2 x)
(define (mutate) (set! x 3))
(define also-ignored (mutate))
(test 3 x)
(define saved x)
(define x 4)
(test 3 saved)
(test 4 x)
(test 'call/cc (quote call/cc))
