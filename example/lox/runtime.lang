include "std/core.lang"
extern func fflush(stream *u8) i64;
extern func strtod(s *u8, end **u8) f64;
struct LoxValue { tag i64; data i64; }
// Tags: 0 nil, 1 boolean, 2 number, 3 string, 4 function.
func lox_box(tag i64, data i64) i64 {
    var v *LoxValue = alloc(16); v.tag = tag; v.data = data; return v;
}
func lox_nil() i64 { return lox_box(0, 0); }
func lox_bool(b i64) i64 { return lox_box(1, b); }
func lox_string(s *u8) i64 { return lox_box(3, s); }
func lox_num(n f64) i64 {
    var slot *f64 = alloc(8); slot[0] = n; return lox_box(2, slot);
}
func lox_number(s *u8) i64 { return lox_num(strtod(s, nil)); }
func lox_value(v *LoxValue) f64 { var slot *f64 = v.data; return slot[0]; }
func lox_error(message *u8) void { eprintln(message); exit(70); }
func lox_not(x i64) i64 {
    var a *LoxValue = x;
    if a.tag == 0 || (a.tag == 1 && a.data == 0) { return lox_bool(1); }
    return lox_bool(0);
}
func lox_negate(x i64) i64 {
    var a *LoxValue = x;
    if a.tag != 2 { lox_error("Operand must be a number."); }
    var src *i64 = a.data; var bits *i64 = alloc(8);
    bits[0] = src[0] ^ (1 << 63);
    return lox_box(2, bits);
}
func lox_binary(op i64, x i64, y i64) i64 {
    var a *LoxValue = x; var b *LoxValue = y;
    if op == 1 || op == 2 {
        var eq i64 = 0;
        if a.tag == b.tag {
            if a.tag == 0 { eq = 1; }
            else if a.tag == 1 { if a.data == b.data { eq = 1; } }
            else if a.tag == 2 { if lox_value(a) == lox_value(b) { eq = 1; } }
            else if a.tag == 3 { var s *u8 = a.data; var t *u8 = b.data; if streq(s, t) { eq = 1; } }
            else { if a.data == b.data { eq = 1; } }
        }
        if op == 2 { if eq == 0 { eq = 1; } else { eq = 0; } }
        return lox_bool(eq);
    }
    if op == 7 && a.tag == 3 && b.tag == 3 {
        var s *u8 = a.data; var t *u8 = b.data;
        var n i64 = strlen(s); var m i64 = strlen(t); var out *u8 = alloc(n + m + 1);
        var i i64 = 0; while i < n { *(out + i) = *(s + i); i = i + 1; }
        i = 0; while i < m { *(out + n + i) = *(t + i); i = i + 1; } *(out + n + m) = 0;
        return lox_string(out);
    }
    if a.tag != 2 || b.tag != 2 {
        if op == 7 { lox_error("Operands must be two numbers or two strings."); }
        lox_error("Operands must be numbers.");
    }
    var av f64 = lox_value(a); var bv f64 = lox_value(b);
    if op == 3 { if av < bv { return lox_bool(1); } return lox_bool(0); }
    if op == 4 { if av > bv { return lox_bool(0); } return lox_bool(1); }
    if op == 5 { if av > bv { return lox_bool(1); } return lox_bool(0); }
    if op == 6 { if av < bv { return lox_bool(0); } return lox_bool(1); }
    if op == 7 { return lox_num(av + bv); } if op == 8 { return lox_num(av - bv); }
    if op == 9 { return lox_num(av * bv); } return lox_num(av / bv);
}
func lox_print(x i64) void {
    var a *LoxValue = x;
    if a.tag == 0 { println("nil"); }
    else if a.tag == 1 { if a.data == 0 { println("false"); } else { println("true"); } }
    else if a.tag == 2 { printf("%g\n", lox_value(a)); fflush(nil); }
    else if a.tag == 3 { var s *u8 = a.data; println(s); }
    else { var f *LoxFunction = a.data; print("<fn "); print(f.name); println(">"); }
}

// Scope frames and bindings belong to the target program, not the reader.
struct LoxBinding { name *u8; value i64; next *LoxBinding; }
struct LoxScope { bindings *LoxBinding; parent *LoxScope; }
var lox_scope *LoxScope = nil;
func lox_begin() void {
    var scope *LoxScope = alloc(16); scope.bindings = nil; scope.parent = lox_scope; lox_scope = scope;
}
func lox_end() void { lox_scope = lox_scope.parent; }
func lox_define(name *u8, value i64) i64 {
    if lox_scope == nil { lox_begin(); }
    var b *LoxBinding = lox_scope.bindings;
    // Global redeclarations replace the old binding.
    if lox_scope.parent == nil {
        while b != nil { if streq(b.name, name) { b.value = value; return value; } b = b.next; }
    }
    b = alloc(24); b.name = name; b.value = value; b.next = lox_scope.bindings; lox_scope.bindings = b; return value;
}
func lox_find(name *u8) *LoxBinding {
    var scope *LoxScope = lox_scope;
    while scope != nil {
        var b *LoxBinding = scope.bindings;
        while b != nil { if streq(b.name, name) { return b; } b = b.next; }
        scope = scope.parent;
    }
    return nil;
}
func lox_undefined(name *u8, line i64) void {
    eprint("Undefined variable '"); eprint(name); eprintln("'.");
    eprint("[line "); eprint_i64(line); eprintln("] in script"); exit(70);
}
func lox_get(name *u8, line i64) i64 {
    var b *LoxBinding = lox_find(name);
    if b == nil { lox_undefined(name, line); }
    return b.value;
}
func lox_assign(name *u8, value i64, line i64) i64 {
    var b *LoxBinding = lox_find(name);
    if b == nil { lox_undefined(name, line); }
    b.value = value; return value;
}

// Function values retain their defining environment; argument lists are per call.
struct LoxFunction { id i64; arity i64; scope *LoxScope; name *u8; }
struct LoxArgs { count i64; values *i64; }
var lox_current_args *LoxArgs = nil;
func lox_args() i64 { var a *LoxArgs = alloc(16); a.count = 0; a.values = alloc(2040); return a; }
func lox_arg_add(list i64, value i64) i64 {
    var a *LoxArgs = list; var values *i64 = a.values; values[a.count] = value; a.count = a.count + 1; return list;
}
func lox_return(value i64) i64 { return value; }
func lox_argument(index i64) i64 { var values *i64 = lox_current_args.values; return values[index]; }
func lox_call(value i64, list i64) i64 {
    var v *LoxValue = value; if v.tag != 4 { lox_error("Can only call functions and classes."); }
    var f *LoxFunction = v.data; var a *LoxArgs = list;
    if a.count != f.arity { lox_error("Incorrect argument count."); }
    var saved *LoxScope = lox_scope; var saved_args *LoxArgs = lox_current_args;
    lox_scope = f.scope; lox_begin(); lox_current_args = a;
    var result i64 = lox_dispatch(f.id);
    lox_scope = saved; lox_current_args = saved_args; return result;
}

// Freeze the visible binding heads, while sharing the mutable bindings themselves.
func lox_capture(scope *LoxScope) *LoxScope {
    if scope == nil || scope.parent == nil { return scope; }
    var copy *LoxScope = alloc(16); copy.bindings = scope.bindings; copy.parent = lox_capture(scope.parent); return copy;
}
func lox_function(id i64, arity i64, name *u8) i64 {
    var f *LoxFunction = alloc(32); f.id = id; f.arity = arity; f.scope = lox_capture(lox_scope); f.name = name; return lox_box(4, f);
}
