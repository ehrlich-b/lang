include "std/core.lang"
include "std/emit.lang"
include "std/reader_diagnostics.lang"

extern func fflush(stream *u8) i64;
extern func strtod(s *u8, end **u8) f64;
extern func clock() i64;

struct LoxValue { tag i64; data i64; }
var LOX_NIL i64 = 0;
var LOX_BOOL i64 = 1;
var LOX_NUMBER i64 = 2;
var LOX_STRING i64 = 3;
var LOX_FUNCTION i64 = 4;
var LOX_CLASS i64 = 5;
var LOX_INSTANCE i64 = 6;
var LOX_BOUND i64 = 7;
var LOX_CLOCK i64 = 8;
var lox_source *u8 = nil;
var lox_path *u8 = "<lox>";

func lox_error(message *u8, site i64) void {
    reader_error("reader-syntax-snippet", message, lox_path, lox_source, site, site + 1);
    exit(70);
}
func lox_box(tag i64, data i64) i64 {
    var v *LoxValue = alloc(16);
    v.tag = tag; v.data = data;
    return v;
}
func lox_nil() i64 { return lox_box(LOX_NIL, 0); }
func lox_bool(b i64) i64 { return lox_box(LOX_BOOL, b); }
func lox_string(s *u8) i64 { return lox_box(LOX_STRING, s); }
func lox_num(n f64) i64 {
    return lox_box(LOX_NUMBER, __core_numeric("bitcast", "i64", "f64", n));
}
func lox_number(s *u8) i64 { return lox_num(strtod(s, nil)); }
func lox_value(v *LoxValue) f64 {
    return __core_numeric("bitcast", "f64", "i64", v.data);
}
func lox_truthy(a *LoxValue) bool {
    return a.tag != LOX_NIL && (a.tag != LOX_BOOL || a.data != 0);
}
func lox_not(x i64) i64 {
    if lox_truthy(x) { return lox_bool(0); }
    return lox_bool(1);
}
func lox_negate(a *LoxValue, site i64) i64 {
    if a.tag != LOX_NUMBER { lox_error("Operand must be a number.", site); }
    return lox_box(LOX_NUMBER, a.data ^ (1 << 63));
}
func lox_equal(a *LoxValue, b *LoxValue) bool {
    if a.tag != b.tag { return false; }
    if a.tag == LOX_NUMBER { return lox_value(a) == lox_value(b); }
    if a.tag == LOX_STRING { return streq(a.data, b.data); }
    return a.data == b.data;
}
func lox_binary(op *u8, a *LoxValue, b *LoxValue, site i64) i64 {
    if streq(op, "==") || streq(op, "!=") {
        if lox_equal(a, b) == streq(op, "==") { return lox_bool(1); }
        return lox_bool(0);
    }
    if streq(op, "+") && a.tag == LOX_STRING && b.tag == LOX_STRING {
        return lox_string(str_concat(a.data, b.data));
    }
    if a.tag != LOX_NUMBER || b.tag != LOX_NUMBER {
        if streq(op, "+") { lox_error("Operands must be two numbers or two strings.", site); }
        lox_error("Operands must be numbers.", site);
    }
    var left f64 = lox_value(a);
    var right f64 = lox_value(b);
    if streq(op, "<") { if left < right { return lox_bool(1); } return lox_bool(0); }
    if streq(op, "<=") { if !(left > right) { return lox_bool(1); } return lox_bool(0); }
    if streq(op, ">") { if left > right { return lox_bool(1); } return lox_bool(0); }
    if streq(op, ">=") { if !(left < right) { return lox_bool(1); } return lox_bool(0); }
    if streq(op, "+") { return lox_num(left + right); }
    if streq(op, "-") { return lox_num(left - right); }
    if streq(op, "*") { return lox_num(left * right); }
    return lox_num(left / right);
}

// Locals resolve to a fixed distance. Escaping closures share their frames
// with each other, and unresolved names always address the live global scope.
struct LoxBinding { name *u8; value i64; next *LoxBinding; }
struct LoxScope { bindings *LoxBinding; parent *LoxScope; }
var lox_scope *LoxScope = nil;
var lox_global *LoxScope = nil;
func lox_begin() void {
    var scope *LoxScope = alloc(16);
    scope.bindings = nil; scope.parent = lox_scope; lox_scope = scope;
}
func lox_end() void { lox_scope = lox_scope.parent; }
func lox_find(bindings *LoxBinding, name *u8) *LoxBinding {
    var b *LoxBinding = bindings;
    while b != nil {
        if streq(b.name, name) { return b; }
        b = b.next;
    }
    return nil;
}
func lox_slot(bindings *LoxBinding, name *u8, value i64) *LoxBinding {
    var b *LoxBinding = alloc(24);
    b.name = name; b.value = value; b.next = bindings;
    return b;
}
func lox_define(name *u8, value i64) void {
    var b *LoxBinding = lox_find(lox_scope.bindings, name);
    if b != nil { b.value = value; }
    else { lox_scope.bindings = lox_slot(lox_scope.bindings, name, value); }
}
func lox_binding(distance i64, name *u8, site i64) *LoxBinding {
    var scope *LoxScope = lox_scope;
    if distance < 0 { scope = lox_global; }
    else {
        var i i64 = distance;
        while i > 0 { scope = scope.parent; i = i - 1; }
    }
    var b *LoxBinding = lox_find(scope.bindings, name);
    if b == nil { lox_error(str_concat("Undefined variable '", str_concat(name, "'.")), site); }
    return b;
}
func lox_get(distance i64, name *u8, site i64) i64 { return lox_binding(distance, name, site).value; }
func lox_assign(distance i64, name *u8, value i64, site i64) i64 {
    var b *LoxBinding = lox_binding(distance, name, site);
    b.value = value;
    return value;
}
func lox_start(argc i64, argv **u8, text *u8) void {
    lox_source = text;
    if argc > 1 { lox_path = argv[1]; }
    lox_begin();
    lox_global = lox_scope;
    lox_define("clock", lox_box(LOX_CLOCK, 0));
}

struct LoxFunction { code fn() i64; arity i64; scope *LoxScope; name *u8; }
struct LoxArgs { count i64; values *i64; }
struct LoxClass { name *u8; base *LoxClass; methods *LoxBinding; }
struct LoxInstance { class *LoxClass; fields *LoxBinding; }
struct LoxBound { function *LoxFunction; receiver i64; }
var lox_current_args *LoxArgs = nil;
var lox_call_depth i64 = 1;

func lox_args(count i64) *LoxArgs {
    var a *LoxArgs = alloc(16);
    a.count = count; a.values = alloc(8 * count);
    return a;
}
func lox_arg_set(a *LoxArgs, index i64, value i64) void {
    var values *i64 = a.values;
    values[index] = value;
}
func lox_argument(index i64) i64 {
    var values *i64 = lox_current_args.values;
    return values[index];
}
func lox_function(code fn() i64, arity i64, name *u8) i64 {
    var f *LoxFunction = alloc(32);
    f.code = code; f.arity = arity; f.scope = lox_scope; f.name = name;
    return lox_box(LOX_FUNCTION, f);
}
func lox_class(name *u8, superclass *LoxValue, site i64) i64 {
    var class *LoxClass = alloc(24);
    class.name = name; class.base = nil; class.methods = nil;
    if superclass != nil {
        if superclass.tag != LOX_CLASS { lox_error("Superclass must be a class.", site); }
        class.base = superclass.data;
    }
    return lox_box(LOX_CLASS, class);
}
func lox_superclass(v *LoxValue) i64 {
    var class *LoxClass = v.data;
    return lox_box(LOX_CLASS, class.base);
}
func lox_method(v *LoxValue, method *LoxValue) void {
    var class *LoxClass = v.data;
    var f *LoxFunction = method.data;
    class.methods = lox_slot(class.methods, f.name, f);
}
func lox_find_method(class *LoxClass, name *u8) *LoxFunction {
    var type *LoxClass = class;
    while type != nil {
        var method *LoxBinding = lox_find(type.methods, name);
        if method != nil { return method.value; }
        type = type.base;
    }
    return nil;
}
func lox_bind(method *LoxFunction, receiver i64, name *u8, site i64) i64 {
    if method == nil { lox_error(str_concat("Undefined property '", str_concat(name, "'.")), site); }
    var bound *LoxBound = alloc(16);
    bound.function = method; bound.receiver = receiver;
    return lox_box(LOX_BOUND, bound);
}
func lox_super(v *LoxValue, receiver i64, name *u8, site i64) i64 {
    return lox_bind(lox_find_method(v.data, name), receiver, name, site);
}
func lox_property(v *LoxValue, name *u8, site i64) i64 {
    if v.tag != LOX_INSTANCE { lox_error("Only instances have properties.", site); }
    var instance *LoxInstance = v.data;
    var field *LoxBinding = lox_find(instance.fields, name);
    if field != nil { return field.value; }
    return lox_bind(lox_find_method(instance.class, name), v, name, site);
}
func lox_require_instance(v *LoxValue, site i64) *LoxInstance {
    if v.tag != LOX_INSTANCE { lox_error("Only instances have fields.", site); }
    return v.data;
}
func lox_set_property(instance *LoxInstance, name *u8, value i64) i64 {
    var field *LoxBinding = lox_find(instance.fields, name);
    if field == nil { instance.fields = lox_slot(instance.fields, name, value); }
    else { field.value = value; }
    return value;
}
func lox_check_arity(expected i64, actual i64, site i64) void {
    if expected == actual { return; }
    var sb *StringBuilder = sb_new();
    sb_str(sb, "Expected "); sb_int(sb, expected);
    sb_str(sb, " arguments but got "); sb_int(sb, actual); sb_char(sb, '.');
    lox_error(sb_finish(sb), site);
}
func lox_invoke(f *LoxFunction, receiver i64, args *LoxArgs, site i64) i64 {
    lox_check_arity(f.arity, args.count, site);
    if lox_call_depth == 64 { lox_error("Stack overflow.", site); }
    var saved *LoxScope = lox_scope;
    var saved_args *LoxArgs = lox_current_args;
    lox_scope = f.scope;
    lox_begin();
    if receiver != 0 { lox_define("this", receiver); }
    lox_current_args = args;
    lox_call_depth = lox_call_depth + 1;
    var code fn() i64 = f.code;
    var result i64 = code();
    lox_call_depth = lox_call_depth - 1;
    lox_scope = saved;
    lox_current_args = saved_args;
    if receiver != 0 && streq(f.name, "init") { return receiver; }
    return result;
}
func lox_call(v *LoxValue, args *LoxArgs, site i64) i64 {
    if v.tag == LOX_FUNCTION { return lox_invoke(v.data, 0, args, site); }
    if v.tag == LOX_BOUND {
        var method *LoxBound = v.data;
        return lox_invoke(method.function, method.receiver, args, site);
    }
    if v.tag == LOX_CLASS {
        var instance *LoxInstance = alloc(16);
        instance.class = v.data; instance.fields = nil;
        var object i64 = lox_box(LOX_INSTANCE, instance);
        var init *LoxFunction = lox_find_method(instance.class, "init");
        if init == nil { lox_check_arity(0, args.count, site); }
        else { lox_invoke(init, object, args, site); }
        return object;
    }
    if v.tag == LOX_CLOCK {
        var ticks f64 = __core_numeric("convert", "f64", "i64", clock());
        var ticks_per_second f64 = __core_numeric("convert", "f64", "i64", 1000000);
        return lox_num(ticks / ticks_per_second);
    }
    lox_error("Can only call functions and classes.", site);
    return lox_nil();
}
func lox_print_function(f *LoxFunction) void { print("<fn "); print(f.name); println(">"); }
func lox_print(a *LoxValue) void {
    if a.tag == LOX_NIL { println("nil"); }
    else if a.tag == LOX_BOOL {
        if a.data == 0 { println("false"); } else { println("true"); }
    } else if a.tag == LOX_NUMBER { printf("%g\n", lox_value(a)); fflush(nil); }
    else if a.tag == LOX_STRING { println(a.data); }
    else if a.tag == LOX_FUNCTION { lox_print_function(a.data); }
    else if a.tag == LOX_BOUND { var method *LoxBound = a.data; lox_print_function(method.function); }
    else if a.tag == LOX_CLASS { var class *LoxClass = a.data; println(class.name); }
    else if a.tag == LOX_INSTANCE { var object *LoxInstance = a.data; print(object.class.name); println(" instance"); }
    else { println("<native fn>"); }
}
