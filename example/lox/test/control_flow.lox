var total = 0;
for (var i = 0; i < 5; i = i + 1) {
  if (i == 2) total = total + 10;
  else total = total + i;
}
var remaining = 2;
while (remaining > 0) {
  remaining = remaining - 1;
  total = total + 1;
}
