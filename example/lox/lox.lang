// Recognize Lox with the shared parser, then lower it to native Lang functions.
include "std/parser_reader.lang"
include "std/ast.lang"

// Lox comments and ASCII identifiers already fit the shared profile. Adapt the
// token spellings that the built-in Lang scanner cannot configure.
func lx_keyword(word *u8) bool {
    return streq(word, "and") || streq(word, "class") || streq(word, "else") ||
        streq(word, "false") || streq(word, "for") || streq(word, "fun") ||
        streq(word, "if") || streq(word, "nil") || streq(word, "or") ||
        streq(word, "print") || streq(word, "return") || streq(word, "super") ||
        streq(word, "this") || streq(word, "true") || streq(word, "var") ||
        streq(word, "while");
}
func lx_lex(text *u8) *Tokenizer {
    var scan *Tokenizer = tok_new_profile(text, tok_profile_new(TOK_NUM_DEFAULT, nil, "//", nil, nil));
    var stream *u8 = tok_stream_new();
    while !tok_eof(scan) {
        var start i64 = tok_start_offset(scan);
        var end i64 = tok_end_offset(scan);
        var kind i64 = tok_kind(scan);
        var c u8 = text[start];
        if c == '"' {
            end = start + 1;
            while text[end] != 0 && text[end] != '"' { end = end + 1; }
            if text[end] == 0 {
                reader_error("reader-syntax-snippet", "Error: Unterminated string.", "lox", text, end, end);
                return nil;
            }
            end = end + 1;
        } else if tok_is_digit(c) {
            if text[end] == '.' && tok_is_digit(text[end + 1]) {
                end = end + 2;
                while tok_is_digit(text[end]) { end = end + 1; }
            }
        } else if c == '-' {
            kind = TOK_MINUS;
            end = start + 1;
        } else if end == start + 2 && (c == '+' || c == '*' || c == '/' ||
                   ((c == '<' || c == '>') && text[start + 1] == c)) {
            end = start + 1;
        } else if kind == TOK_IDENT && lx_keyword(tok_text(scan)) {
            kind = TOK_USER;
        } else if kind == TOK_UNKNOWN || c == 39 || c == '[' || c == ']' ||
                  c == '%' || c == ':' || c == '^' || c == '?' || c == '~' ||
                  c == '&' || c == '|' {
            reader_error("reader-syntax-snippet", "Error: Unexpected character.", "lox", text, start, end);
            return nil;
        }
        tok_stream_push(stream, kind, start, end - start, nil);
        tok_reset(scan, end);
    }
    return tok_new_stream(text, stream);
}

#parser{
    lx_file = items:lx_decl*
    lx_decl = class_decl:lx_class | function_decl:lx_fun | variable_decl:lx_var | lx_stmt
    lx_class = 'class' name:symbol base:lx_base? '{' methods:lx_signature* '}'
    lx_base = '<' name:symbol
    lx_fun = 'fun' signature:lx_signature
    lx_signature = name:symbol '(' params:lx_params? ')' body:lx_block
    lx_params = first:symbol rest:lx_param*
    lx_param = ',' name:symbol
    lx_var = 'var' name:symbol init:lx_init? ';'
    lx_init = '=' value:lx_assignment

    lx_stmt = block:lx_block | conditional:lx_if | while_loop:lx_while | for_loop:lx_for |
              return_stmt:lx_ret | print_stmt:lx_print | expr_stmt:lx_expr_stmt
    lx_block = '{' items:lx_decl* '}'
    lx_if = 'if' '(' test:lx_assignment ')' yes:lx_stmt otherwise:lx_else?
    lx_else = 'else' body:lx_stmt
    lx_while = 'while' '(' test:lx_assignment ')' body:lx_stmt
    lx_for = 'for' '(' init:lx_for_init test:lx_assignment? ';' step:lx_assignment? ')' body:lx_stmt
    lx_for_init = variable_decl:lx_var | expr_stmt:lx_expr_stmt | empty:';'
    lx_ret = keyword:'return' value:lx_assignment? ';'
    lx_print = 'print' value:lx_assignment ';'
    lx_expr_stmt = value:lx_assignment ';'

    lx_assignment = value:lx_or write:lx_write?
    lx_write = eq:'=' value:lx_assignment
    lx_or = head:lx_and tail:lx_or_tail*
    lx_or_tail = op:'or' rhs:lx_and
    lx_and = head:lx_equal tail:lx_and_tail*
    lx_and_tail = op:'and' rhs:lx_equal
    lx_equal = head:lx_compare tail:lx_eq_tail*
    lx_eq_tail = op:('==' | '!=') rhs:lx_compare
    lx_compare = head:lx_sum tail:lx_compare_tail*
    lx_compare_tail = op:('<=' | '>=' | '<' | '>') rhs:lx_sum
    lx_sum = head:lx_product tail:lx_sum_tail*
    lx_sum_tail = op:('+' | '-') rhs:lx_product
    lx_product = head:lx_prefix tail:lx_product_tail*
    lx_product_tail = op:('*' | '/') rhs:lx_prefix
    lx_prefix = prefix:lx_unary | postfix:lx_postfix
    lx_unary = op:('!' | '-') rhs:lx_prefix
    lx_postfix = primary:lx_primary suffixes:lx_suffix*
    lx_suffix = call:lx_arguments | get:lx_get
    lx_get = '.' name:symbol
    lx_arguments = '(' args:lx_args? close:')'
    lx_args = first:lx_assignment rest:lx_arg*
    lx_arg = ',' value:lx_assignment
    lx_primary = number_value:number | string_value:string | name:symbol | truth:'true' | falsehood:'false' |
                 null_value:'nil' | receiver:'this' | superclass:lx_super | group:lx_group
    lx_super = keyword:'super' '.' name:symbol
    lx_group = '(' value:lx_assignment ')'
}

include "example/lox/lower.lang"

reader lox(text *u8) *u8 {
    var tokens *Tokenizer = lx_lex(text);
    if tokens == nil { return nil; }
    var tree *PNode = parse_lx_file(tokens);
    if tree == nil || !tok_expect_end(tokens) {
        lx_syntax(tokens, text);
        return nil;
    }
    return lx_program(tree, text);
}
