// C functions defined in C syntax, callable from lang.
include "std/core.lang"
include "example/c/c.lang"

#c{
    int factorial(int n) {
        if (n < 2) return 1;
        return n * factorial(n - 1);
    }

    int fib(int n) {
        if (n < 2) return n;
        return fib(n - 1) + fib(n - 2);
    }

    int add(int a, int b) {
        return a + b;
    }

    // Iterative: local decls, while loop, assignment, <= operator.
    int ifact(int n) {
        int result = 1;
        int i = 1;
        while (i <= n) {
            result = result * i;
            i = i + 1;
        }
        return result;
    }

    // if / else
    int classify(int x) {
        if (x < 5) {
            return 100;
        } else {
            return 200;
        }
    }

    // multi-char operators: && >= <= == ||
    int inrange(int n) {
        if (n >= 2 && n <= 5) return 1;
        if (n == 9 || n == 11) return 1;
        return 0;
    }

    // round 2: for loop (decl-init)
    int triangle(int n) {
        int t = 0;
        for (int i = 1; i <= n; i = i + 1) {
            t = t + i;
        }
        return t;
    }

    // round 2: unary minus
    int negate(int x) {
        return -x;
    }

    // round 2: uninitialized decl + unbraced if/else
    int maxof(int a, int b) {
        int m;
        if (a > b) m = a;
        else m = b;
        return m;
    }

    // round 3: pointer decl, address-of, deref (rvalue + lvalue)
    int through_ptr(int x) {
        int *p;
        p = &x;
        *p = *p + 1;
        return *p;
    }

    // round 3: char* param + string literal, deref to first byte
    int strhead(char *s) {
        return *s;
    }

    // round 3: struct def, struct local, member access, struct-pointer param
    struct Vec2 { int x; int y; };

    int norm_sq(int a, int b) {
        struct Vec2 v;
        v.x = a;
        v.y = b;
        return v.x * v.x + v.y * v.y;
    }

    void scale2(struct Vec2 *vp, int k) {
        (*vp).x = (*vp).x * k;
        (*vp).y = (*vp).y * k;
    }

    int scaled_sum(int a, int b, int k) {
        struct Vec2 v;
        v.x = a;
        v.y = b;
        scale2(&v, k);
        return v.x + v.y;
    }

    // round 4: -> pointer member access (read + write)
    int vsum(struct Vec2 *vp) {
        return vp->x + vp->y;
    }
    int via_arrow(int a, int b) {
        struct Vec2 v;
        v.x = a;
        v.y = b;
        vp_bump(&v);
        return vsum(&v);
    }
    void vp_bump(struct Vec2 *vp) {
        vp->x = vp->x + 1;
    }

    // round 4: bitwise + shift operators
    int bits(int a, int b) {
        return (a & b) + (a | b) + (a ^ b) + (a << 1) + (a >> 1);
    }

    // round 4: break + continue
    int first_factor(int n) {
        int i = 2;
        while (i < n) {
            if (n % i == 0) {
                break;
            }
            i = i + 1;
        }
        return i;
    }

    // round 4: global variables (scalar with init, and an array)
    int g_base = 100;
    int g_arr[3];
    int with_base(int x) { return x + g_base; }
    int store_sum(int a, int b, int c) {
        g_arr[0] = a;
        g_arr[1] = b;
        g_arr[2] = c;
        return g_arr[0] + g_arr[1] + g_arr[2];
    }

    // round 4: compound assignment + ++/--
    int accumulate(int n) {
        int s = 0;
        int i;
        for (i = 0; i < n; i++) {
            s += i;
        }
        s *= 2;
        return s;
    }
    int countdown(int n) {
        int c = 0;
        while (n > 0) {
            n--;
            c += 1;
        }
        return c;
    }

    // round 4: char literals + char arithmetic
    int upcase(int c) {
        if (c >= 'a' && c <= 'z') {
            return c - 'a' + 'A';
        }
        return c;
    }

    // round 4: array decl + indexing (read + write)
    int arrsum(int n) {
        int a[16];
        int i = 0;
        for (i = 0; i < n; i = i + 1) {
            a[i] = i + 1;
        }
        int s = 0;
        for (i = 0; i < n; i = i + 1) {
            s = s + a[i];
        }
        return s;
    }
}

func main() i64 {
    print("factorial(5) = "); print_int(factorial(5)); print("\n");
    print("fib(10)      = "); print_int(fib(10));       print("\n");
    print("add(3, 4)    = "); print_int(add(3, 4));     print("\n");
    print("ifact(5)     = "); print_int(ifact(5));      print("\n");
    print("classify(3)  = "); print_int(classify(3));   print("\n");
    print("classify(9)  = "); print_int(classify(9));   print("\n");
    print("inrange(3)   = "); print_int(inrange(3));    print("\n");
    print("inrange(7)   = "); print_int(inrange(7));    print("\n");
    print("triangle(5)  = "); print_int(triangle(5));   print("\n");
    print("negate(8)    = "); print_int(negate(8));     print("\n");
    print("maxof(3, 9)  = "); print_int(maxof(3, 9));   print("\n");
    print("through_ptr  = "); print_int(through_ptr(41)); print("\n");
    print("strhead(\"A\") = "); print_int(strhead("A"));   print("\n");
    print("norm_sq(3,4)  = "); print_int(norm_sq(3, 4));  print("\n");
    print("scaled_sum    = "); print_int(scaled_sum(2, 3, 10)); print("\n");
    print("bits(12,10)   = "); print_int(bits(12, 10));   print("\n");
    print("first_factor  = "); print_int(first_factor(15)); print("\n");
    print("arrsum(5)     = "); print_int(arrsum(5));      print("\n");
    print("upcase('a')   = "); print_int(upcase('a'));    print("\n");
    print("via_arrow(3,4)= "); print_int(via_arrow(3, 4)); print("\n");
    print("accumulate(5) = "); print_int(accumulate(5)); print("\n");
    print("countdown(7)  = "); print_int(countdown(7));  print("\n");
    print("with_base(5)  = "); print_int(with_base(5));  print("\n");
    print("store_sum     = "); print_int(store_sum(1, 2, 3)); print("\n");

    if factorial(5) != 120 { return 1; }
    if fib(10) != 55 { return 1; }
    if add(3, 4) != 7 { return 1; }
    if ifact(5) != 120 { return 1; }
    if classify(3) != 100 { return 1; }
    if classify(9) != 200 { return 1; }
    if inrange(3) != 1 { return 1; }
    if inrange(7) != 0 { return 1; }
    if inrange(9) != 1 { return 1; }
    if triangle(5) != 15 { return 1; }
    if negate(8) != 0 - 8 { return 1; }
    if maxof(3, 9) != 9 { return 1; }
    if maxof(9, 3) != 9 { return 1; }
    if through_ptr(41) != 42 { return 1; }
    if strhead("A") != 65 { return 1; }
    if strhead("z") != 122 { return 1; }
    if norm_sq(3, 4) != 25 { return 1; }
    if scaled_sum(2, 3, 10) != 50 { return 1; }
    if bits(12, 10) != 58 { return 1; }
    if first_factor(15) != 3 { return 1; }
    if first_factor(7) != 7 { return 1; }
    if arrsum(5) != 15 { return 1; }
    if upcase('a') != 65 { return 1; }
    if upcase('Z') != 90 { return 1; }
    if via_arrow(3, 4) != 8 { return 1; }
    if accumulate(5) != 20 { return 1; }
    if countdown(7) != 7 { return 1; }
    if with_base(5) != 105 { return 1; }
    if store_sum(1, 2, 3) != 6 { return 1; }

    print("PASS\n");
    return 0;
}
