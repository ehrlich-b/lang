// C functions defined in C syntax, callable from lang.
include "std/core.lang"
include "example/c/c.lang"

#c{
    int factorial(int n) {
        if (n < 2) return 1;
        return n * factorial(n - 1);
    }

    int fib(int n) {
        if (n < 2) return n;
        return fib(n - 1) + fib(n - 2);
    }

    int add(int a, int b) {
        return a + b;
    }

    // Iterative: local decls, while loop, assignment. (i < n + 1 == i <= n)
    int ifact(int n) {
        int result = 1;
        int i = 1;
        while (i < n + 1) {
            result = result * i;
            i = i + 1;
        }
        return result;
    }

    // if / else
    int classify(int x) {
        if (x < 5) {
            return 100;
        } else {
            return 200;
        }
    }
}

func main() i64 {
    print("factorial(5) = "); print_int(factorial(5)); print("\n");
    print("fib(10)      = "); print_int(fib(10));       print("\n");
    print("add(3, 4)    = "); print_int(add(3, 4));     print("\n");
    print("ifact(5)     = "); print_int(ifact(5));      print("\n");
    print("classify(3)  = "); print_int(classify(3));   print("\n");
    print("classify(9)  = "); print_int(classify(9));   print("\n");

    if factorial(5) != 120 { return 1; }
    if fib(10) != 55 { return 1; }
    if add(3, 4) != 7 { return 1; }
    if ifact(5) != 120 { return 1; }
    if classify(3) != 100 { return 1; }
    if classify(9) != 200 { return 1; }

    print("PASS\n");
    return 0;
}
