// ============================================================
// c - A C-subset reader (capture real C, compile to native)
// ============================================================
//
// Proves the reader-authorship thesis on a REAL language: a subset of C
// maps almost 1:1 onto lang's C-like AST. Built with #parser{} (the crown
// jewel) plus a converter that does operator precedence-climbing.
//
//   #c{ int factorial(int n) { if (n < 2) return 1; return n * factorial(n - 1); } }
//
// Then factorial() is a normal native function, callable from lang.
//
// SUBSET (deliberately bounded - no typedef/preprocessor/declarators/arrays):
//   types:      int, char, void (int/char→i64/u8), pointers (T*), struct Name
//   decls:      structs (struct N { ... };), funcs, local decls (init optional)
//   statements: return, if/else, while, for, assignment, blocks, expr statements
//   operators:  + - * / %  < > <= >= == != && ||, unary - ! * &, calls f(a,b),
//               member access p.f and (*p).f  (no -> yet; (*p).f is the form)
//   strings:    "..." literals (char*); funcs may return non-struct types only
//
// rdgen's generated parser is weak (no backtracking; a sequence only requires
// its first element). So every grammar choice is driven by a distinct first
// token: keyword-literals lead statements, and each statement alternative is a
// NAMED rule (a choice of inline sequences would short-circuit on the first
// mismatch). Operator precedence is flat in the grammar and resolved here.

include "std/core.lang"
include "std/tok.lang"
include "std/parser_reader.lang"

// All rules are c_-prefixed: bare names like program/type/block/primary would
// generate parse_program/parse_type/... which COLLIDE with the compiler's own
// parser functions (pulled in transitively via lang_reader).
#parser{
    c_program    = c_topdecl+
    c_topdecl    = c_structdef | c_func
    c_structdef  = 'struct' symbol '{' c_fields '}' ';'
    c_fields     = c_field*
    c_field      = c_ptype symbol ';'
    c_func       = c_rettype symbol '(' c_params ')' c_block
    c_rettype    = c_basetype c_stars
    c_ptype      = c_anytype c_stars
    c_anytype    = c_basetype | c_structtype
    c_basetype   = 'int' | 'char' | 'void'
    c_structtype = 'struct' symbol
    c_stars      = c_star*
    c_star       = '*'
    c_params     = c_paramitem*
    c_paramitem  = c_param | ','
    c_param      = c_ptype symbol
    c_block     = '{' c_stmt* '}'
    c_stmt      = c_retstmt | c_ifstmt | c_whilestmt | c_forstmt | c_breakstmt | c_continuestmt | c_decl | c_block | c_exprstmt
    c_breakstmt = 'break' ';'
    c_continuestmt = 'continue' ';'
    c_retstmt   = 'return' c_expr ';'
    c_ifstmt    = 'if' '(' c_expr ')' c_stmt c_elses
    c_elses     = c_elsepart*
    c_elsepart  = 'else' c_stmt
    c_whilestmt = 'while' '(' c_expr ')' c_stmt
    c_forstmt   = 'for' '(' c_forinit c_expr ';' c_expr ')' c_stmt
    c_forinit   = c_decl | c_exprstmt
    c_decl      = c_ptype symbol c_arrdim c_initopt ';'
    c_arrdim    = c_dim*
    c_dim       = '[' number ']'
    c_initopt   = c_initval*
    c_initval   = '=' c_expr
    c_exprstmt  = c_expr ';'
    c_expr      = c_unary c_oprest*
    c_oprest    = operator c_unary
    c_unary     = c_neg | c_postfix
    c_neg       = operator c_postfix
    c_postfix   = c_primary c_postfixop*
    c_postfixop = c_callargs | c_member | c_index
    c_callargs  = '(' c_args ')'
    c_member    = '.' symbol
    c_index     = '[' c_expr ']'
    c_args      = c_argitem*
    c_argitem   = c_expr | ','
    c_primary   = number | string | symbol | c_parenexpr
    c_parenexpr = '(' c_expr ')'
}

// PNode kinds: 1=number, 2=symbol, 3=string, 4=list/sequence, 5=operator, 0=literal marker

// ============================================================
// Operator precedence (higher binds tighter)
// ============================================================

// C precedence ladder (low binds loosest). The tokenizer already lexes the
// 2-char operators (==, !=, <=, >=, &&, ||) and carries their text, so they just
// need a precedence here. '=' is prec 0: it's peeled off as an assignment
// statement, never climbed as a binop.
func prec(op *u8) i64 {
    if streq(op, "||") { return 1; }
    if streq(op, "&&") { return 2; }
    if streq(op, "|") { return 3; }                                  // bitwise or
    if streq(op, "^") { return 4; }                                  // bitwise xor
    if streq(op, "&") { return 5; }                                  // bitwise and
    if streq(op, "==") || streq(op, "!=") { return 6; }
    if streq(op, "<") || streq(op, ">") || streq(op, "<=") || streq(op, ">=") { return 7; }
    if streq(op, "<<") || streq(op, ">>") { return 8; }              // shifts
    if streq(op, "+") || streq(op, "-") { return 9; }
    if streq(op, "*") || streq(op, "/") || streq(op, "%") { return 10; }
    return 0;
}

// ============================================================
// Expression emission (precedence climbing over a flat operand/op list)
// ============================================================

// expr = postfix oprest*  →  children = [postfix0, oprest_star]
// Flatten to operands[] and ops[], then climb.
// Split expr (= postfix oprest*) into parallel operand/op vecs (operands[i] is
// followed by ops[i]). Shared by expression emission and assignment detection.
func flatten_expr(e *PNode, operands *u8, ops *u8) void {
    vec_push(operands, vec_get(e.children, 0));
    var star *PNode = vec_get(e.children, 1);
    var m i64 = vec_len(star.children);
    var i i64 = 0;
    while i < m {
        var orn *PNode = vec_get(star.children, i);  // oprest = [op_atom, postfix]
        vec_push(ops, vec_get(orn.children, 0));
        vec_push(operands, vec_get(orn.children, 1));
        i = i + 1;
    }
}

func emit_expr_str(e *PNode) *u8 {
    var operands *u8 = vec_new(8);
    var ops *u8 = vec_new(8);
    flatten_expr(e, operands, ops);
    var pos i64 = 0;
    return climb(operands, ops, &pos, 0);
}

// Standard precedence climbing. operands[pos] aligns with ops[pos].
func climb(operands *u8, ops *u8, posptr *i64, minprec i64) *u8 {
    var left *u8 = emit_operand_str(vec_get(operands, *posptr));
    var nops i64 = vec_len(ops);
    while *posptr < nops {
        var opnode *PNode = vec_get(ops, *posptr);
        var p i64 = prec(opnode.text);
        if p < minprec { return left; }
        *posptr = *posptr + 1;                        // consume operator
        var right *u8 = climb(operands, ops, posptr, p + 1);  // left-associative
        var sb *StringBuilder = sb_new();
        sb_str(sb, "(binop ");
        sb_str(sb, opnode.text);
        sb_str(sb, " ");
        sb_str(sb, left);
        sb_str(sb, " ");
        sb_str(sb, right);
        sb_str(sb, ")");
        left = sb_finish(sb);
    }
    return left;
}

// An operand is a c_unary = c_neg | c_postfix. The CHOICE returns the chosen
// node directly, so we tell them apart by their first child: c_neg leads with an
// operator atom (kind 5), c_postfix leads with a primary (kind 1/2/4).
func emit_operand_str(node *PNode) *u8 {
    var f *PNode = vec_get(node.children, 0);
    if f.kind == 5 {                          // c_neg = [op_atom, postfix]
        var sb *StringBuilder = sb_new();
        sb_str(sb, "(unop ");
        sb_str(sb, f.text);                   // '-' (or '!') passes straight through
        sb_str(sb, " ");
        sb_str(sb, emit_postfix_str(vec_get(node.children, 1)));
        sb_str(sb, ")");
        return sb_finish(sb);
    }
    return emit_postfix_str(node);            // c_postfix
}

// If `primary` is a parenthesized lone deref `(*X)`, return the c_postfix node X
// being dereferenced; else nil. Used to peel C's explicit deref before a member
// access (see emit_postfix_str).
func deref_paren_inner(primary *PNode) *PNode {
    if primary.kind != 4 { return nil; }              // parenexpr is a list node
    var c0 *PNode = vec_get(primary.children, 0);
    if c0.kind != 0 { return nil; }                   // ...leading with a '(' marker
    var inner *PNode = vec_get(primary.children, 1);  // the c_expr
    var orest *PNode = vec_get(inner.children, 1);    // c_oprest*
    if vec_len(orest.children) != 0 { return nil; }   // must be a lone unary
    var u *PNode = vec_get(inner.children, 0);        // c_unary
    var u0 *PNode = vec_get(u.children, 0);
    if u0.kind == 5 && streq(u0.text, "*") {          // c_neg with '*'
        return vec_get(u.children, 1);                // the c_postfix being deref'd
    }
    return nil;
}

// postfix = primary postfixop*  →  fold the chain left-to-right. Each op is a
// call (c_callargs = ['(', args, ')'], so children[1] is the args list, kind 4)
// or a member access (c_member = ['.', name], so children[1] is the name, kind 2).
func emit_postfix_str(pf *PNode) *u8 {
    var primary *PNode = vec_get(pf.children, 0);
    var ops *PNode = vec_get(pf.children, 1);     // star list of c_postfixop
    var nops i64 = vec_len(ops.children);

    // C's (*p).field is lang's auto-deref p.field. When a member access follows a
    // parenthesized lone deref, peel the '*' and emit (field p ...): the kernel
    // auto-derefs pointer.field, whereas (field (unop * p) ...) would load a
    // struct value and crash.
    var base *u8 = nil;
    var peeled *PNode = nil;
    if nops > 0 {
        var op0 *PNode = vec_get(ops.children, 0);
        var op0second *PNode = vec_get(op0.children, 1);
        if op0second.kind == 2 {                   // first op is a member
            peeled = deref_paren_inner(primary);
        }
    }
    if peeled != nil {
        base = emit_postfix_str(peeled);
    } else {
        base = emit_primary_str(primary);
    }

    var oi i64 = 0;
    while oi < nops {
        var op *PNode = vec_get(ops.children, oi);
        var second *PNode = vec_get(op.children, 1);
        if second.kind == 2 {                     // c_member = ['.', name] → (field base name)
            var sb *StringBuilder = sb_new();
            sb_str(sb, "(field ");
            sb_str(sb, base);
            sb_str(sb, " ");
            sb_str(sb, second.text);
            sb_str(sb, ")");
            base = sb_finish(sb);
        } else {
            // call and index both have a kind-4 second child; distinguish by the
            // leading marker's text ('(' vs '[' — markers now carry their text).
            var marker *PNode = vec_get(op.children, 0);
            if streq(marker.text, "[") {          // c_index = ['[', expr, ']'] → (index base idx)
                var sb *StringBuilder = sb_new();
                sb_str(sb, "(index ");
                sb_str(sb, base);
                sb_str(sb, " ");
                sb_str(sb, emit_expr_str(second));
                sb_str(sb, ")");
                base = sb_finish(sb);
            } else {                              // c_callargs → (call base args...)
                var sb *StringBuilder = sb_new();
                sb_str(sb, "(call ");
                sb_str(sb, base);
                var items *u8 = second.children;
                var n i64 = vec_len(items);
                var i i64 = 0;
                while i < n {
                    var it *PNode = vec_get(items, i);
                    if it.kind != 0 {            // skip ',' markers; args are expr nodes
                        sb_str(sb, " ");
                        sb_str(sb, emit_expr_str(it));
                    }
                    i = i + 1;
                }
                sb_str(sb, ")");
                base = sb_finish(sb);
            }
        }
        oi = oi + 1;
    }
    return base;
}

func emit_primary_str(p *PNode) *u8 {
    if p.kind == 1 {               // number
        var sb *StringBuilder = sb_new();
        sb_str(sb, "(number ");
        sb_str(sb, p.text);
        sb_str(sb, ")");
        return sb_finish(sb);
    }
    if p.kind == 2 {               // symbol → ident
        var sb *StringBuilder = sb_new();
        sb_str(sb, "(ident ");
        sb_str(sb, p.text);
        sb_str(sb, ")");
        return sb_finish(sb);
    }
    if p.kind == 3 {               // TOK_STRING: "..." string OR '...' char literal
        var sb *StringBuilder = sb_new();
        if *(p.text) == 39 {       // leading ' → C char literal, an integer value
            sb_str(sb, "(number ");
            sb_int(sb, char_literal_value(p.text));
            sb_str(sb, ")");
        } else {                   // "..." string; text keeps its quotes for the kernel
            sb_str(sb, "(string ");
            sb_str(sb, p.text);
            sb_str(sb, ")");
        }
        return sb_finish(sb);
    }
    if p.kind == 4 {               // parenexpr = ['(', expr, ')']
        return emit_expr_str(vec_get(p.children, 1));
    }
    return "(number 0)";
}

// Value of a C char literal token (text includes the single quotes, e.g. 'a' or
// '\n'). Handles the common backslash escapes.
func char_literal_value(text *u8) i64 {
    var c i64 = *(text + 1);       // first char after the opening quote
    if c == 92 {                   // backslash escape
        var e i64 = *(text + 2);
        if e == 110 { return 10; }     // \n
        if e == 116 { return 9; }      // \t
        if e == 114 { return 13; }     // \r
        if e == 48 { return 0; }       // \0
        if e == 92 { return 92; }      // \\
        if e == 39 { return 39; }      // \'
        return e;                      // \<other> → literal char
    }
    return c;
}

// ============================================================
// Statement emission
// ============================================================

func emit_stmt(sb *StringBuilder, s *PNode) void {
    var first *PNode = vec_get(s.children, 0);

    if first.kind == 0 {           // block: leading '{' marker
        emit_block(sb, s);
        return;
    }

    if first.kind == 2 {
        if streq(first.text, "break") { sb_str(sb, "(break)"); return; }
        if streq(first.text, "continue") { sb_str(sb, "(continue)"); return; }
        if streq(first.text, "return") {       // ['return', expr, ';']
            sb_str(sb, "(return ");
            sb_str(sb, emit_expr_str(vec_get(s.children, 1)));
            sb_str(sb, ")");
            return;
        }
        if streq(first.text, "if") {           // ['if', '(', expr, ')', stmt, elses]
            sb_str(sb, "(if ");
            sb_str(sb, emit_expr_str(vec_get(s.children, 2)));
            sb_str(sb, " ");
            emit_stmt_as_block(sb, vec_get(s.children, 4));
            var elses *PNode = vec_get(s.children, 5);   // c_elses = c_elsepart*
            if vec_len(elses.children) > 0 {
                var elsepart *PNode = vec_get(elses.children, 0);  // ['else', stmt]
                sb_str(sb, " ");
                emit_stmt_as_block(sb, vec_get(elsepart.children, 1));
            }
            sb_str(sb, ")");
            return;
        }
        if streq(first.text, "while") {        // ['while', '(', expr, ')', stmt]
            sb_str(sb, "(while ");
            sb_str(sb, emit_expr_str(vec_get(s.children, 2)));
            sb_str(sb, " ");
            emit_stmt_as_block(sb, vec_get(s.children, 4));
            sb_str(sb, ")");
            return;
        }
        if streq(first.text, "for") {
            emit_for(sb, s);
            return;
        }
    }

    // first is a kind-4 list: a c_decl leads with a c_ptype, whose first child
    // (the anytype) is either a base-type keyword (kind 2: int/char/void) or a
    // c_structtype = ['struct', Name] (kind 4). A c_exprstmt leads with a c_expr,
    // whose first child is a c_unary (kind 4) — never a 'struct'-led structtype.
    var f0 *PNode = vec_get(first.children, 0);
    if f0.kind == 2 {
        if streq(f0.text, "int") || streq(f0.text, "char") || streq(f0.text, "void") {
            emit_decl(sb, s);
            return;
        }
    }
    if f0.kind == 4 {
        var g0 *PNode = vec_get(f0.children, 0);
        if g0.kind == 2 && streq(g0.text, "struct") {     // struct-typed local decl
            emit_decl(sb, s);
            return;
        }
    }
    emit_exprstmt_from_expr(sb, first);
}

// Emit a bare c_expr as a statement: a leading '=' makes it an assignment,
// otherwise an expression statement. Shared by exprstmt and the for-loop step
// (which is a bare expr with no trailing ';').
func emit_exprstmt_from_expr(sb *StringBuilder, expr *PNode) void {
    var operands *u8 = vec_new(8);
    var ops *u8 = vec_new(8);
    flatten_expr(expr, operands, ops);
    if vec_len(ops) > 0 {
        var op0 *PNode = vec_get(ops, 0);
        if streq(op0.text, "=") {
            var lv *PNode = vec_get(operands, 0);
            sb_str(sb, "(assign ");
            sb_str(sb, emit_operand_str(lv));                  // lvalue (ident)
            sb_str(sb, " ");
            var rpos i64 = 1;
            sb_str(sb, climb(operands, ops, &rpos, 1));        // value (stops before another '=')
            sb_str(sb, ")");
            return;
        }
    }
    var epos i64 = 0;
    sb_str(sb, "(expr_stmt ");
    sb_str(sb, climb(operands, ops, &epos, 0));
    sb_str(sb, ")");
}

// c_forstmt = 'for' '(' c_forinit c_expr ';' c_expr ')' c_stmt
//   children: [for, (, init, cond, ;, step, ), body]   (init consumes its ';')
// Desugar to a block: { init; while (cond) { body; step; } }.  (continue inside
// the body skips step — an accepted limitation of this bounded subset.)
func emit_for(sb *StringBuilder, s *PNode) void {
    var init *PNode = vec_get(s.children, 2);
    var cond *PNode = vec_get(s.children, 3);
    var step *PNode = vec_get(s.children, 5);
    var body *PNode = vec_get(s.children, 7);
    sb_str(sb, "(block ");
    emit_stmt(sb, init);                       // decl or assignment (handles both)
    sb_str(sb, " (while ");
    sb_str(sb, emit_expr_str(cond));
    sb_str(sb, " (block ");
    emit_stmt(sb, body);
    sb_str(sb, " ");
    emit_exprstmt_from_expr(sb, step);
    sb_str(sb, ")))");
}

// c_decl = ptype symbol arrdim initopt ';'  →  children [ptype, name, arrdim, initopt, ';']
// arrdim is a star: zero dims = scalar; one c_dim = ['[', number, ']'] = a 1-D
// array `T name[N]` → (var name (type_array N ELEM)) (no initializer; array
// initializers aren't in this subset). initopt is the stable-slot optional init
// for scalars (uninitialized → kernel alloca with no store, like C).
func emit_decl(sb *StringBuilder, d *PNode) void {
    var kids *u8 = d.children;
    var name *PNode = vec_get(kids, 1);
    var arrdim *PNode = vec_get(kids, 2);
    var initopt *PNode = vec_get(kids, 3);
    sb_str(sb, "(var ");
    sb_str(sb, name.text);
    sb_str(sb, " ");
    if vec_len(arrdim.children) > 0 {
        var dim0 *PNode = vec_get(arrdim.children, 0);   // c_dim = ['[', number, ']']
        var sizenode *PNode = vec_get(dim0.children, 1);
        sb_str(sb, "(type_array ");
        sb_str(sb, sizenode.text);
        sb_str(sb, " ");
        emit_type(sb, vec_get(kids, 0));
        sb_str(sb, ")");
    } else {
        emit_type(sb, vec_get(kids, 0));
        if vec_len(initopt.children) > 0 {
            var initval *PNode = vec_get(initopt.children, 0);   // ['=', expr]
            sb_str(sb, " ");
            sb_str(sb, emit_expr_str(vec_get(initval.children, 1)));
        }
    }
    sb_str(sb, ")");
}

// A control-flow body must be a block; wrap a single statement if needed.
func emit_stmt_as_block(sb *StringBuilder, s *PNode) void {
    var first *PNode = vec_get(s.children, 0);
    if first.kind == 0 {           // already a block
        emit_block(sb, s);
        return;
    }
    sb_str(sb, "(block ");
    emit_stmt(sb, s);
    sb_str(sb, ")");
}

func emit_block(sb *StringBuilder, block *PNode) void {
    sb_str(sb, "(block ");
    if block != nil {
        var stmts *PNode = vec_get(block.children, 1);  // ['{', stmt_star, '}']
        var n i64 = vec_len(stmts.children);
        var i i64 = 0;
        while i < n {
            emit_stmt(sb, vec_get(stmts.children, i));
            sb_str(sb, " ");
            i = i + 1;
        }
    }
    sb_str(sb, ")");
}

// ============================================================
// Declarations
// ============================================================

// c_ptype/c_rettype = anytype c_stars  →  children [anytype, stars_star]. Each
// star wraps the base in a (type_ptr ...). anytype is either a base-type keyword
// atom (kind 2) or a c_structtype = ['struct', Name] (kind 4). char → u8 so
// `char*` is `*u8` (lang's string type); int → i64; void → void; struct N → N.
func emit_type(sb *StringBuilder, t *PNode) void {
    if t == nil { sb_str(sb, "(type_base i64)"); return; }
    var anytype *PNode = vec_get(t.children, 0);
    var stars *PNode = vec_get(t.children, 1);
    var n i64 = vec_len(stars.children);
    var i i64 = 0;
    while i < n { sb_str(sb, "(type_ptr "); i = i + 1; }
    if anytype.kind == 4 {                        // c_structtype = ['struct', Name]
        var nm *PNode = vec_get(anytype.children, 1);
        sb_str(sb, "(type_base ");
        sb_str(sb, nm.text);
        sb_str(sb, ")");
    } else if streq(anytype.text, "void") {
        sb_str(sb, "(type_base void)");
    } else if streq(anytype.text, "char") {
        sb_str(sb, "(type_base u8)");
    } else {
        sb_str(sb, "(type_base i64)");
    }
    i = 0;
    while i < n { sb_str(sb, ")"); i = i + 1; }
}

// func = type symbol '(' params ')' block
func emit_func(sb *StringBuilder, f *PNode) void {
    var kids *u8 = f.children;
    var rettype *PNode = vec_get(kids, 0);
    var name *PNode = vec_get(kids, 1);
    var params *PNode = vec_get(kids, 3);
    var body *PNode = vec_get(kids, 5);

    sb_str(sb, "(func ");
    sb_str(sb, name.text);
    sb_str(sb, " (");
    emit_params(sb, params);
    sb_str(sb, ") ");
    emit_type(sb, rettype);
    sb_str(sb, " ");
    emit_block(sb, body);
    sb_str(sb, ")");
}

// params = paramitem* ; paramitem = param | ',' ; param = type symbol
func emit_params(sb *StringBuilder, params *PNode) void {
    if params == nil { return; }
    var items *u8 = params.children;
    var n i64 = vec_len(items);
    var first i64 = 1;
    var i i64 = 0;
    while i < n {
        var it *PNode = vec_get(items, i);
        if it.kind == 4 {                  // a param (kind-0 = ',' marker)
            if first == 0 { sb_str(sb, " "); }
            first = 0;
            var pkids *u8 = it.children;
            var pname *PNode = vec_get(pkids, 1);
            sb_str(sb, "(param ");
            sb_str(sb, pname.text);
            sb_str(sb, " ");
            emit_type(sb, vec_get(pkids, 0));
            sb_str(sb, ")");
        }
        i = i + 1;
    }
}

// c_structdef = 'struct' Name '{' c_fields '}' ';'  →  children [struct, Name,
// '{', fields, '}', ';'].  Each c_field = c_ptype symbol ';'. Emits the kernel's
// (struct Name ((field_decl fname ftype) ...)); the field head tag is ignored by
// sexpr_reader (it reads name@1, type@2 positionally).
func emit_structdef(sb *StringBuilder, sd *PNode) void {
    var name *PNode = vec_get(sd.children, 1);
    var fields *PNode = vec_get(sd.children, 3);
    sb_str(sb, "(struct ");
    sb_str(sb, name.text);
    sb_str(sb, " (");
    var n i64 = vec_len(fields.children);
    var i i64 = 0;
    while i < n {
        var fld *PNode = vec_get(fields.children, i);     // c_field = [ptype, name, ';']
        var fname *PNode = vec_get(fld.children, 1);
        if i > 0 { sb_str(sb, " "); }
        sb_str(sb, "(field_decl ");
        sb_str(sb, fname.text);
        sb_str(sb, " ");
        emit_type(sb, vec_get(fld.children, 0));
        sb_str(sb, ")");
        i = i + 1;
    }
    sb_str(sb, "))");
}

// program = topdecl+ ; topdecl = structdef | func. A structdef leads with the
// 'struct' keyword (kind-2 atom); a func leads with its c_rettype (kind-4 list).
func emit_program(sb *StringBuilder, prog *PNode) void {
    sb_str(sb, "(program ");
    if prog != nil {
        var decls *u8 = prog.children;
        var n i64 = vec_len(decls);
        var i i64 = 0;
        while i < n {
            var d *PNode = vec_get(decls, i);
            var head *PNode = vec_get(d.children, 0);
            if head.kind == 2 && streq(head.text, "struct") {
                emit_structdef(sb, d);
            } else {
                emit_func(sb, d);
            }
            sb_str(sb, " ");
            i = i + 1;
        }
    }
    sb_str(sb, ")");
}

reader c(text *u8) *u8 {
    var t *Tokenizer = tok_new(text);
    var prog *PNode = parse_c_program(t);
    var sb *StringBuilder = sb_new();
    emit_program(sb, prog);
    return sb_finish(sb);
}
