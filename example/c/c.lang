// ============================================================
// c - A C-subset reader (capture real C, compile to native)
// ============================================================
//
// Proves the reader-authorship thesis on a REAL language: a subset of C
// maps almost 1:1 onto lang's C-like AST. Built with #parser{} (the crown
// jewel, Level 3) for parsing, plus a converter that lowers the parse tree to
// lang AST via the std/ast.lang builder API (Level 1) - NO hand-written S-expr
// strings. The converter does operator precedence-climbing.
//
//   #c{ int factorial(int n) { if (n < 2) return 1; return n * factorial(n - 1); } }
//
// Then factorial() is a normal native function, callable from lang.
//
// SUBSET (deliberately bounded - no typedef/preprocessor/declarators):
//   types:      int, char, void (int/char->i64/u8), pointers (T*), struct Name
//   decls:      structs (struct N { ... };), funcs, local decls (init optional)
//   statements: return, if/else, while, for, assignment, blocks, expr statements
//   operators:  + - * / %  < > <= >= == != && ||, unary - ! ~ * &, ternary ?:,
//               calls f(a,b), member access p.f and (*p).f  (-> lexed as .)
//   strings:    "..." literals (char*); funcs may return non-struct types only
//
// rdgen's generated parser is weak (no backtracking; a sequence only requires
// its first element). So every grammar choice is driven by a distinct first
// token: keyword-literals lead statements, and each statement alternative is a
// NAMED rule (a choice of inline sequences would short-circuit on the first
// mismatch). Operator precedence is flat in the grammar and resolved here.

include "std/core.lang"
include "std/tok.lang"
include "std/parser_reader.lang"
include "std/ast.lang"

// All rules are c_-prefixed: bare names like program/type/block/primary would
// generate parse_program/parse_type/... which COLLIDE with the compiler's own
// parser functions (pulled in transitively via lang_reader).
#parser{
    c_program    = c_topdecl+
    c_topdecl    = c_structdef | c_enumdef | c_topvar
    c_topvar     = c_rettype symbol c_topvartail
    c_topvartail = c_functail | c_globaltail
    c_functail   = '(' c_params ')' c_block
    c_globaltail = c_arrdim c_initopt ';'
    c_structdef  = 'struct' symbol '{' c_fields '}' ';'
    c_fields     = c_field*
    c_field      = c_ptype symbol ';'
    c_enumdef    = 'enum' c_enumtag '{' c_enumitems '}' ';'
    c_enumtag    = c_tagname*
    c_tagname    = symbol
    c_enumitems  = c_enumitem*
    c_enumitem   = c_enummember | ','
    c_enummember = symbol c_enumvalopt
    c_enumvalopt = c_enumval*
    c_enumval    = '=' number
    c_rettype    = c_basetype c_stars
    c_ptype      = c_anytype c_stars
    c_anytype    = c_basetype | c_structtype | c_enumtype
    c_basetype   = 'int' | 'char' | 'void'
    c_structtype = 'struct' symbol
    c_enumtype   = 'enum' symbol
    c_stars      = c_star*
    c_star       = '*'
    c_params     = c_paramitem*
    c_paramitem  = c_param | ','
    c_param      = c_ptype symbol
    c_block     = '{' c_stmt* '}'
    c_stmt      = c_retstmt | c_ifstmt | c_whilestmt | c_forstmt | c_breakstmt | c_continuestmt | c_decl | c_block | c_exprstmt
    c_breakstmt = 'break' ';'
    c_continuestmt = 'continue' ';'
    c_retstmt   = 'return' c_expr ';'
    c_ifstmt    = 'if' '(' c_expr ')' c_stmt c_elses
    c_elses     = c_elsepart*
    c_elsepart  = 'else' c_stmt
    c_whilestmt = 'while' '(' c_expr ')' c_stmt
    c_forstmt   = 'for' '(' c_forinit c_expr ';' c_expr ')' c_stmt
    c_forinit   = c_decl | c_exprstmt
    c_decl      = c_ptype symbol c_arrdim c_initopt ';'
    c_arrdim    = c_dim*
    c_dim       = '[' number ']'
    c_initopt   = c_initval*
    c_initval   = '=' c_expr
    c_exprstmt  = c_expr ';'
    c_expr      = c_binexpr c_terntail*
    c_terntail  = '?' c_expr ':' c_expr
    c_binexpr   = c_unary c_oprest*
    c_oprest    = operator c_unary
    c_unary     = c_neg | c_postfix
    c_neg       = operator c_postfix
    c_postfix   = c_primary c_postfixop*
    c_postfixop = c_callargs | c_member | c_index
    c_callargs  = '(' c_args ')'
    c_member    = '.' symbol
    c_index     = '[' c_expr ']'
    c_args      = c_argitem*
    c_argitem   = c_expr | ','
    c_primary   = number | string | symbol | c_parenexpr
    c_parenexpr = '(' c_expr ')'
}

// PNode kinds: 1=number, 2=symbol, 3=string, 4=list/sequence, 5=operator, 0=literal marker

// ============================================================
// Operator precedence (higher binds tighter)
// ============================================================

// C precedence ladder (low binds loosest). The tokenizer already lexes the
// 2-char operators (==, !=, <=, >=, &&, ||) and carries their text, so they just
// need a precedence here. '=' is prec 0: it's peeled off as an assignment
// statement, never climbed as a binop.
func prec(op *u8) i64 {
    if streq(op, "||") { return 1; }
    if streq(op, "&&") { return 2; }
    if streq(op, "|") { return 3; }                                  // bitwise or
    if streq(op, "^") { return 4; }                                  // bitwise xor
    if streq(op, "&") { return 5; }                                  // bitwise and
    if streq(op, "==") || streq(op, "!=") { return 6; }
    if streq(op, "<") || streq(op, ">") || streq(op, "<=") || streq(op, ">=") { return 7; }
    if streq(op, "<<") || streq(op, ">>") { return 8; }              // shifts
    if streq(op, "+") || streq(op, "-") { return 9; }
    if streq(op, "*") || streq(op, "/") || streq(op, "%") { return 10; }
    return 0;
}

// ============================================================
// Expression emission (precedence climbing over a flat operand/op list)
// ============================================================

// Split a c_binexpr (= c_unary c_oprest*) into parallel operand/op vecs
// (operands[i] is followed by ops[i]). Shared by expression emission and
// assignment detection. (The ternary tail, if any, is handled by the caller.)
func flatten_expr(e *PNode, operands *u8, ops *u8) void {
    vec_push(operands, vec_get(e.children, 0));
    var star *PNode = vec_get(e.children, 1);
    var m i64 = vec_len(star.children);
    var i i64 = 0;
    while i < m {
        var orn *PNode = vec_get(star.children, i);  // oprest = [op_atom, postfix]
        vec_push(ops, vec_get(orn.children, 0));
        // A trailing postfix ++/-- has no right operand (the c_unary failed to
        // match), so the oprest is just [op]; leave operands one shorter than ops.
        if vec_len(orn.children) > 1 {
            vec_push(operands, vec_get(orn.children, 1));
        }
        i = i + 1;
    }
}

// A c_expr is `c_binexpr c_terntail*`: emit the binexpr value, then fold any
// ternary tail around it. (A flat binexpr is children[0]; the star is children[1].)
func emit_expr_str(e *PNode) *u8 {
    var binexpr *PNode = vec_get(e.children, 0);
    var terntail *PNode = vec_get(e.children, 1);
    var operands *u8 = vec_new(8);
    var ops *u8 = vec_new(8);
    flatten_expr(binexpr, operands, ops);
    var pos i64 = 0;
    var base *u8 = climb(operands, ops, &pos, 0);
    if vec_len(terntail.children) > 0 {
        return emit_ternary(base, vec_get(terntail.children, 0));
    }
    return base;
}

// Per-node-unique temp name for a ternary (block_expr vars leak to the enclosing
// scope, so each ?: needs its own; derive it from the terntail node's address).
func ternary_tmp(node *PNode) *u8 {
    var sb *StringBuilder = sb_new();
    sb_str(sb, "__ct");
    var addr i64 = node;
    sb_int(sb, addr);
    return sb_finish(sb);
}

// `cond ? a : b` -> a value-returning block_expr (only the taken branch runs):
//   { var t = 0; if (cond) { t = a; } else { t = b; }  t }
// tt is a c_terntail = ['?', then_expr, ':', else_expr]. The temp is i64, which
// covers the bounded subset's int and pointer values.
func emit_ternary(cond *u8, tt *PNode) *u8 {
    var t *u8 = ternary_tmp(tt);
    var thenexpr *u8 = emit_expr_str(vec_get(tt.children, 1));
    var elseexpr *u8 = emit_expr_str(vec_get(tt.children, 3));
    var stmts *u8 = ast_vec();
    ast_push(stmts, ast_var(t, ast_type_i64(), ast_int(0)));
    ast_push(stmts, ast_if(cond,
                           ast_block1(ast_assign(ast_ident(t), thenexpr)),
                           ast_block1(ast_assign(ast_ident(t), elseexpr))));
    return ast_block_expr(stmts, ast_ident(t));
}

// Standard precedence climbing. operands[pos] aligns with ops[pos].
func climb(operands *u8, ops *u8, posptr *i64, minprec i64) *u8 {
    if *posptr >= vec_len(operands) { return ast_int(0); }   // defensive (dangling postfix op)
    var left *u8 = emit_operand_str(vec_get(operands, *posptr));
    var nops i64 = vec_len(ops);
    while *posptr < nops {
        var opnode *PNode = vec_get(ops, *posptr);
        // A postfix ++/-- in value position (not a statement) has no right operand
        // and is unsupported: skip it (side effect honored only at statement level).
        if streq(opnode.text, "++") || streq(opnode.text, "--") {
            *posptr = *posptr + 1;
        } else {
            var p i64 = prec(opnode.text);
            if p < minprec { return left; }
            *posptr = *posptr + 1;                               // consume operator
            var right *u8 = climb(operands, ops, posptr, p + 1); // left-associative
            left = ast_binop(opnode.text, left, right);
        }
    }
    return left;
}

// An operand is a c_unary = c_neg | c_postfix. The CHOICE returns the chosen
// node directly, so we tell them apart by their first child: c_neg leads with an
// operator atom (kind 5), c_postfix leads with a primary (kind 1/2/4).
func emit_operand_str(node *PNode) *u8 {
    var f *PNode = vec_get(node.children, 0);
    if f.kind == 5 {                          // c_neg = [op_atom, postfix]
        var operand *u8 = emit_postfix_str(vec_get(node.children, 1));
        if streq(f.text, "~") {               // ~x == x ^ -1 (kernel has no unary ~)
            return ast_binop("^", operand, ast_unop("-", ast_int(1)));
        }
        return ast_unop(f.text, operand);
    }
    return emit_postfix_str(node);            // c_postfix
}

// If `primary` is a parenthesized lone deref `(*X)`, return the c_postfix node X
// being dereferenced; else nil. Used to peel C's explicit deref before a member
// access (see emit_postfix_str).
func deref_paren_inner(primary *PNode) *PNode {
    if primary.kind != 4 { return nil; }              // parenexpr is a list node
    var c0 *PNode = vec_get(primary.children, 0);
    if c0.kind != 0 { return nil; }                   // ...leading with a '(' marker
    var inner *PNode = vec_get(primary.children, 1);  // the c_expr = [c_binexpr, terntail*]
    var terntail *PNode = vec_get(inner.children, 1);
    if vec_len(terntail.children) != 0 { return nil; } // a ternary is not a lone deref
    var binexpr *PNode = vec_get(inner.children, 0);  // c_binexpr = [c_unary, c_oprest*]
    var orest *PNode = vec_get(binexpr.children, 1);  // c_oprest*
    if vec_len(orest.children) != 0 { return nil; }   // must be a lone unary
    var u *PNode = vec_get(binexpr.children, 0);      // c_unary
    var u0 *PNode = vec_get(u.children, 0);
    if u0.kind == 5 && streq(u0.text, "*") {          // c_neg with '*'
        return vec_get(u.children, 1);                // the c_postfix being deref'd
    }
    return nil;
}

// postfix = primary postfixop*  ->  fold the chain left-to-right. Each op is a
// call (c_callargs = ['(', args, ')'], so children[1] is the args list, kind 4)
// or a member access (c_member = ['.', name], so children[1] is the name, kind 2).
func emit_postfix_str(pf *PNode) *u8 {
    var primary *PNode = vec_get(pf.children, 0);
    var ops *PNode = vec_get(pf.children, 1);     // star list of c_postfixop
    var nops i64 = vec_len(ops.children);

    // C's (*p).field is lang's auto-deref p.field. When a member access follows a
    // parenthesized lone deref, peel the '*' and emit (field p ...): the kernel
    // auto-derefs pointer.field, whereas (field (unop * p) ...) would load a
    // struct value and crash.
    var base *u8 = nil;
    var peeled *PNode = nil;
    if nops > 0 {
        var op0 *PNode = vec_get(ops.children, 0);
        var op0second *PNode = vec_get(op0.children, 1);
        if op0second.kind == 2 {                   // first op is a member
            peeled = deref_paren_inner(primary);
        }
    }
    if peeled != nil {
        base = emit_postfix_str(peeled);
    } else {
        base = emit_primary_str(primary);
    }

    var oi i64 = 0;
    while oi < nops {
        var op *PNode = vec_get(ops.children, oi);
        var second *PNode = vec_get(op.children, 1);
        if second.kind == 2 {                     // c_member = ['.', name] -> (field base name)
            base = ast_field(base, second.text);
        } else {
            // call and index both have a kind-4 second child; distinguish by the
            // leading marker's text ('(' vs '[' - markers carry their text).
            var marker *PNode = vec_get(op.children, 0);
            if streq(marker.text, "[") {          // c_index = ['[', expr, ']'] -> (index base idx)
                base = ast_index(base, emit_expr_str(second));
            } else {                              // c_callargs -> (call base args...)
                var args *u8 = ast_vec();
                var items *u8 = second.children;
                var n i64 = vec_len(items);
                var i i64 = 0;
                while i < n {
                    var it *PNode = vec_get(items, i);
                    if it.kind != 0 {            // skip ',' markers; args are expr nodes
                        ast_push(args, emit_expr_str(it));
                    }
                    i = i + 1;
                }
                base = ast_call(base, args);
            }
        }
        oi = oi + 1;
    }
    return base;
}

func emit_primary_str(p *PNode) *u8 {
    if p.kind == 1 {               // number
        return ast_number(p.text);
    }
    if p.kind == 2 {               // symbol -> ident
        return ast_ident(p.text);
    }
    if p.kind == 3 {               // TOK_STRING: "..." string OR '...' char literal
        if *(p.text) == 39 {       // leading ' -> C char literal, an integer value
            return ast_int(char_literal_value(p.text));
        }
        return ast_string_raw(p.text);  // "..." string; text keeps its quotes for the kernel
    }
    if p.kind == 4 {               // parenexpr = ['(', expr, ')']
        return emit_expr_str(vec_get(p.children, 1));
    }
    return ast_int(0);
}

// Value of a C char literal token (text includes the single quotes, e.g. 'a' or
// '\n'). Handles the common backslash escapes.
func char_literal_value(text *u8) i64 {
    var c i64 = *(text + 1);       // first char after the opening quote
    if c == 92 {                   // backslash escape
        var e i64 = *(text + 2);
        if e == 110 { return 10; }     // \n
        if e == 116 { return 9; }      // \t
        if e == 114 { return 13; }     // \r
        if e == 48 { return 0; }       // \0
        if e == 92 { return 92; }      // \\
        if e == 39 { return 39; }      // \'
        return e;                      // \<other> -> literal char
    }
    return c;
}

// ============================================================
// Statement emission
// ============================================================

func emit_stmt(s *PNode) *u8 {
    var first *PNode = vec_get(s.children, 0);

    if first.kind == 0 {           // block: leading '{' marker
        return emit_block(s);
    }

    if first.kind == 2 {
        if streq(first.text, "break") { return ast_break(nil); }
        if streq(first.text, "continue") { return ast_continue(nil); }
        if streq(first.text, "return") {       // ['return', expr, ';']
            return ast_return(emit_expr_str(vec_get(s.children, 1)));
        }
        if streq(first.text, "if") {           // ['if', '(', expr, ')', stmt, elses]
            var cond *u8 = emit_expr_str(vec_get(s.children, 2));
            var then_b *u8 = emit_stmt_as_block(vec_get(s.children, 4));
            var elses *PNode = vec_get(s.children, 5);   // c_elses = c_elsepart*
            var else_b *u8 = nil;
            if vec_len(elses.children) > 0 {
                var elsepart *PNode = vec_get(elses.children, 0);  // ['else', stmt]
                else_b = emit_stmt_as_block(vec_get(elsepart.children, 1));
            }
            return ast_if(cond, then_b, else_b);
        }
        if streq(first.text, "while") {        // ['while', '(', expr, ')', stmt]
            return ast_while(emit_expr_str(vec_get(s.children, 2)),
                             emit_stmt_as_block(vec_get(s.children, 4)));
        }
        if streq(first.text, "for") {
            return emit_for(s);
        }
    }

    // first is a kind-4 list: a c_decl leads with a c_ptype, whose first child
    // (the anytype) is either a base-type keyword (kind 2: int/char/void) or a
    // c_structtype = ['struct', Name] (kind 4). A c_exprstmt leads with a c_expr,
    // whose first child is a c_unary (kind 4) - never a 'struct'-led structtype.
    var f0 *PNode = vec_get(first.children, 0);
    if f0.kind == 2 {
        if streq(f0.text, "int") || streq(f0.text, "char") || streq(f0.text, "void") {
            return emit_decl(s);
        }
    }
    if f0.kind == 4 {
        var g0 *PNode = vec_get(f0.children, 0);
        if g0.kind == 2 {
            if streq(g0.text, "struct") { return emit_decl(s); }   // struct-typed local
            if streq(g0.text, "enum") { return emit_decl(s); }     // enum-typed local
        }
    }
    return emit_exprstmt_from_expr(first);
}

// Base operator for a compound-assignment op ("+=" -> "+", ...); nil otherwise.
func compound_base(op *u8) *u8 {
    if streq(op, "+=") { return "+"; }
    if streq(op, "-=") { return "-"; }
    if streq(op, "*=") { return "*"; }
    if streq(op, "/=") { return "/"; }
    if streq(op, "%=") { return "%"; }
    return nil;
}

// Base operator for an increment/decrement op ("++" -> "+", "--" -> "-"); nil otherwise.
func incdec_base(op *u8) *u8 {
    if streq(op, "++") { return "+"; }
    if streq(op, "--") { return "-"; }
    return nil;
}

// Emit `lv = lv <base> 1` for a ++/-- statement (lvnode is a c_unary/c_postfix).
func emit_incdec(lvnode *PNode, base *u8) *u8 {
    var lv *u8 = emit_operand_str(lvnode);
    return ast_assign(lv, ast_binop(base, lv, ast_int(1)));
}

// Handle ++/-- used as a whole statement (or for-step): postfix `i++` / `i--`
// (one oprest that is a bare op) or prefix `++i` / `--i` (a c_neg with op ++/--).
// Returns the assign string if handled, else nil. ++/-- in value position is NOT
// handled here (see climb).
func try_incdec(expr *PNode) *u8 {
    var u *PNode = vec_get(expr.children, 0);        // c_unary
    var star *PNode = vec_get(expr.children, 1);     // c_oprest*
    var ns i64 = vec_len(star.children);
    if ns == 1 {                                     // postfix: lvalue ++ / --
        var orn *PNode = vec_get(star.children, 0);
        if vec_len(orn.children) == 1 {              // bare op, no right operand
            var opn *PNode = vec_get(orn.children, 0);
            var base *u8 = incdec_base(opn.text);
            if base != nil { return emit_incdec(u, base); }
        }
    }
    if ns == 0 {                                     // prefix: ++ / -- lvalue
        var u0 *PNode = vec_get(u.children, 0);
        if u0.kind == 5 {
            var base *u8 = incdec_base(u0.text);
            if base != nil { return emit_incdec(vec_get(u.children, 1), base); }
        }
    }
    return nil;
}

// Lower a bare c_expr as a statement: ++/-- desugar to an assignment, a leading
// '=' is a plain assignment, a leading compound op (+=, ...) desugars to
// `lv = lv op rhs`, otherwise an expression statement. Shared by exprstmt and the
// for-loop step (a bare expr with no trailing ';').
func emit_exprstmt_from_expr(expr *PNode) *u8 {
    var binexpr *PNode = vec_get(expr.children, 0);   // c_expr = [c_binexpr, terntail*]
    var terntail *PNode = vec_get(expr.children, 1);
    var ntt i64 = vec_len(terntail.children);
    if ntt == 0 {                                     // ++/-- only on a bare lvalue
        var inc *u8 = try_incdec(binexpr);
        if inc != nil { return inc; }
    }
    var operands *u8 = vec_new(8);
    var ops *u8 = vec_new(8);
    flatten_expr(binexpr, operands, ops);
    if vec_len(ops) > 0 {
        var op0 *PNode = vec_get(ops, 0);
        if streq(op0.text, "=") {
            var lv *PNode = vec_get(operands, 0);
            var rpos i64 = 1;
            var rhs *u8 = climb(operands, ops, &rpos, 1);         // value right of '=' ...
            if ntt > 0 { rhs = emit_ternary(rhs, vec_get(terntail.children, 0)); }  // ... incl. ?:
            return ast_assign(emit_operand_str(lv), rhs);
        }
        var cbase *u8 = compound_base(op0.text);                  // x op= rhs -> x = x op (rhs)
        if cbase != nil {
            var lv *PNode = vec_get(operands, 0);
            var lvs *u8 = emit_operand_str(lv);
            var cpos i64 = 1;
            var rhs *u8 = climb(operands, ops, &cpos, 1);
            if ntt > 0 { rhs = emit_ternary(rhs, vec_get(terntail.children, 0)); }
            return ast_assign(lvs, ast_binop(cbase, lvs, rhs));
        }
    }
    var epos i64 = 0;
    var base *u8 = climb(operands, ops, &epos, 0);
    if ntt > 0 { base = emit_ternary(base, vec_get(terntail.children, 0)); }
    return ast_expr_stmt(base);
}

// c_forstmt = 'for' '(' c_forinit c_expr ';' c_expr ')' c_stmt
//   children: [for, (, init, cond, ;, step, ), body]   (init consumes its ';')
// Desugar to a block: { init; while (cond) { body; step; } }.  (continue inside
// the body skips step - an accepted limitation of this bounded subset.)
func emit_for(s *PNode) *u8 {
    var init *PNode = vec_get(s.children, 2);
    var cond *PNode = vec_get(s.children, 3);
    var step *PNode = vec_get(s.children, 5);
    var body *PNode = vec_get(s.children, 7);
    var inner *u8 = ast_vec();
    ast_push(inner, emit_stmt(body));
    ast_push(inner, emit_exprstmt_from_expr(step));
    var outer *u8 = ast_vec();
    ast_push(outer, emit_stmt(init));                       // decl or assignment (handles both)
    ast_push(outer, ast_while(emit_expr_str(cond), ast_block(inner)));
    return ast_block(outer);
}

// (var NAME TYPE INIT?). arrdim is a c_dim* (zero = scalar; one c_dim =
// ['[', number, ']'] = 1-D array `T[N]` -> (type_array N ELEM), no initializer).
// initopt is the stable-slot optional init for scalars (absent -> no store, as in
// C / a top-level zero). Shared by local decls and globals.
func emit_var(name *PNode, typenode *PNode, arrdim *PNode, initopt *PNode) *u8 {
    if vec_len(arrdim.children) > 0 {
        var dim0 *PNode = vec_get(arrdim.children, 0);   // c_dim = ['[', number, ']']
        var sizenode *PNode = vec_get(dim0.children, 1);
        return ast_var(name.text, ast_type_array(sizenode.text, emit_type(typenode)), nil);
    }
    if vec_len(initopt.children) > 0 {
        var initval *PNode = vec_get(initopt.children, 0);   // ['=', expr]
        return ast_var(name.text, emit_type(typenode), emit_expr_str(vec_get(initval.children, 1)));
    }
    return ast_var(name.text, emit_type(typenode), nil);
}

// c_decl = ptype symbol arrdim initopt ';'  ->  children [ptype, name, arrdim, initopt, ';']
func emit_decl(d *PNode) *u8 {
    var kids *u8 = d.children;
    return emit_var(vec_get(kids, 1), vec_get(kids, 0), vec_get(kids, 2), vec_get(kids, 3));
}

// A control-flow body must be a block; wrap a single statement if needed.
func emit_stmt_as_block(s *PNode) *u8 {
    var first *PNode = vec_get(s.children, 0);
    if first.kind == 0 {           // already a block
        return emit_block(s);
    }
    return ast_block1(emit_stmt(s));
}

func emit_block(block *PNode) *u8 {
    var stmts *u8 = ast_vec();
    if block != nil {
        var sl *PNode = vec_get(block.children, 1);  // ['{', stmt_star, '}']
        var n i64 = vec_len(sl.children);
        var i i64 = 0;
        while i < n {
            ast_push(stmts, emit_stmt(vec_get(sl.children, i)));
            i = i + 1;
        }
    }
    return ast_block(stmts);
}

// ============================================================
// Declarations
// ============================================================

// c_ptype/c_rettype = anytype c_stars  ->  children [anytype, stars_star]. Each
// star wraps the base in a (type_ptr ...). anytype is either a base-type keyword
// atom (kind 2) or a c_structtype = ['struct', Name] (kind 4). char -> u8 so
// `char*` is `*u8` (lang's string type); int -> i64; void -> void; struct N -> N.
func emit_type(t *PNode) *u8 {
    if t == nil { return ast_type("i64"); }
    var anytype *PNode = vec_get(t.children, 0);
    var stars *PNode = vec_get(t.children, 1);
    var n i64 = vec_len(stars.children);
    var base *u8 = nil;
    if anytype.kind == 4 {                        // c_structtype or c_enumtype = [kw, Name]
        var head *PNode = vec_get(anytype.children, 0);
        if streq(head.text, "enum") {
            base = ast_type("i64");               // `enum Name` is just an int
        } else {                                  // c_structtype = ['struct', Name]
            var nm *PNode = vec_get(anytype.children, 1);
            base = ast_type(nm.text);
        }
    } else if streq(anytype.text, "void") {
        base = ast_type("void");
    } else if streq(anytype.text, "char") {
        base = ast_type("u8");
    } else {
        base = ast_type("i64");
    }
    var i i64 = 0;
    while i < n { base = ast_type_ptr(base); i = i + 1; }
    return base;
}

// topvar = c_rettype symbol c_topvartail  ->  children [rettype, name, tail].
// For a function the tail is c_functail = '(' c_params ')' c_block.
func emit_func(tv *PNode) *u8 {
    var rettype *PNode = vec_get(tv.children, 0);
    var name *PNode = vec_get(tv.children, 1);
    var tail *PNode = vec_get(tv.children, 2);     // c_functail = ['(', params, ')', block]
    var params *PNode = vec_get(tail.children, 1);
    var body *PNode = vec_get(tail.children, 3);
    return ast_func(name.text, emit_params(params), emit_type(rettype), emit_block(body));
}

// topvar whose tail is c_globaltail = c_arrdim c_initopt ';'  ->  a global (var ...).
func emit_global(tv *PNode) *u8 {
    var rettype *PNode = vec_get(tv.children, 0);
    var name *PNode = vec_get(tv.children, 1);
    var tail *PNode = vec_get(tv.children, 2);     // c_globaltail = [arrdim, initopt, ';']
    return emit_var(name, rettype, vec_get(tail.children, 0), vec_get(tail.children, 1));
}

// params = paramitem* ; paramitem = param | ',' ; param = type symbol
// Returns a vec of (param name type) for ast_func.
func emit_params(params *PNode) *u8 {
    var pv *u8 = ast_vec();
    if params == nil { return pv; }
    var items *u8 = params.children;
    var n i64 = vec_len(items);
    var i i64 = 0;
    while i < n {
        var it *PNode = vec_get(items, i);
        if it.kind == 4 {                  // a param (kind-0 = ',' marker)
            var pkids *u8 = it.children;
            var pname *PNode = vec_get(pkids, 1);   // bind before .text: vec_get is *u8
            var ptype *PNode = vec_get(pkids, 0);
            ast_push(pv, ast_param(pname.text, emit_type(ptype)));
        }
        i = i + 1;
    }
    return pv;
}

// Parse a non-negative decimal integer from text (enum value literals).
func c_atoi(s *u8) i64 {
    var n i64 = 0;
    var i i64 = 0;
    while *(s + i) != 0 {
        var c i64 = *(s + i);
        if c >= 48 {
            if c <= 57 { n = n * 10 + (c - 48); }
        }
        i = i + 1;
    }
    return n;
}

// c_enumdef = 'enum' tag '{' c_enumitems '}' ';'  ->  children [enum, tag, '{',
// items, '}', ';'].  Each member becomes a global int constant (var NAME i64 V);
// implicit values count up from 0 (or from the last explicit value + 1), so
// `enum { A, B, C }` is 0/1/2 and `enum { X = 10, Y }` is 10/11. The tag name is
// cosmetic (the kernel has no enum type; `enum Tag` lowers to i64 in emit_type).
func emit_enumdef(d *PNode, decls *u8) void {
    var items *PNode = vec_get(d.children, 3);     // c_enumitems = c_enumitem*
    var n i64 = vec_len(items.children);
    var counter i64 = 0;
    var i i64 = 0;
    while i < n {
        var it *PNode = vec_get(items.children, i);   // c_enumitem = member | ','
        if it.kind == 4 {                              // a member (',' is a kind-0 marker)
            var namep *PNode = vec_get(it.children, 0);    // bind before .text: vec_get is *u8
            var valopt *PNode = vec_get(it.children, 1);   // c_enumvalopt = c_enumval*
            var value i64 = counter;
            if vec_len(valopt.children) > 0 {
                var ev *PNode = vec_get(valopt.children, 0);   // c_enumval = ['=', number]
                var numn *PNode = vec_get(ev.children, 1);
                value = c_atoi(numn.text);
            }
            ast_push(decls, ast_var(namep.text, ast_type_i64(), ast_int(value)));
            counter = value + 1;
        }
        i = i + 1;
    }
}

// c_structdef = 'struct' Name '{' c_fields '}' ';'  ->  children [struct, Name,
// '{', fields, '}', ';'].  Each c_field = c_ptype symbol ';'.
func emit_structdef(sd *PNode) *u8 {
    var name *PNode = vec_get(sd.children, 1);
    var fields *PNode = vec_get(sd.children, 3);
    var fv *u8 = ast_vec();
    var n i64 = vec_len(fields.children);
    var i i64 = 0;
    while i < n {
        var fld *PNode = vec_get(fields.children, i);     // c_field = [ptype, name, ';']
        var fname *PNode = vec_get(fld.children, 1);      // bind before .text: vec_get is *u8
        var ftype *PNode = vec_get(fld.children, 0);
        ast_push(fv, ast_field_decl(fname.text, emit_type(ftype)));
        i = i + 1;
    }
    return ast_struct(name.text, fv);
}

// program = topdecl+ ; topdecl = structdef | topvar. A structdef leads with the
// 'struct' keyword (kind-2 atom); a topvar leads with its c_rettype (kind-4 list).
// A topvar's tail picks func vs global: c_functail leads with a '(' marker
// (kind 0), c_globaltail leads with c_arrdim (a kind-4 star list).
func emit_program(prog *PNode) *u8 {
    var decls *u8 = ast_vec();
    if prog != nil {
        var dl *u8 = prog.children;
        var n i64 = vec_len(dl);
        var i i64 = 0;
        while i < n {
            var d *PNode = vec_get(dl, i);
            var head *PNode = vec_get(d.children, 0);
            if head.kind == 2 && streq(head.text, "struct") {
                ast_push(decls, emit_structdef(d));
            } else if head.kind == 2 && streq(head.text, "enum") {
                emit_enumdef(d, decls);                     // pushes one global per member
            } else {
                var tail *PNode = vec_get(d.children, 2);   // c_topvartail
                var t0 *PNode = vec_get(tail.children, 0);
                if t0.kind == 0 {                           // '(' marker -> function
                    ast_push(decls, emit_func(d));
                } else {                                    // c_arrdim -> global var
                    ast_push(decls, emit_global(d));
                }
            }
            i = i + 1;
        }
    }
    return ast_program(decls);
}

reader c(text *u8) *u8 {
    var t *Tokenizer = tok_new(text);
    var prog *PNode = parse_c_program(t);
    return emit_program(prog);
}
