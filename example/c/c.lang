// ============================================================
// c - A C-subset reader (capture real C, compile to native)
// ============================================================
//
// Proves the reader-authorship thesis on a REAL language: a subset of C
// maps almost 1:1 onto lang's C-like AST. Built with #parser{} (the crown
// jewel, Level 3) for parsing, plus a converter that lowers the parse tree to
// lang AST via the std/ast.lang builder API (Level 1) - NO hand-written S-expr
// strings. The converter does operator precedence-climbing.
//
//   #c{ int factorial(int n) { if (n < 2) return 1; return n * factorial(n - 1); } }
//
// Then factorial() is a normal native function, callable from lang.
//
// SUBSET (deliberately bounded - no typedef/preprocessor/declarators):
//   types:      int, char, void (int/char->i64/u8), pointers (T*), struct Name
//   decls:      structs (struct N { ... };), funcs, local decls (init optional)
//   statements: return, if/else, while, for, assignment, blocks, expr statements
//   operators:  + - * / %  < > <= >= == != && ||, unary - ! ~ * &, ternary ?:,
//               calls f(a,b), member access p.f and (*p).f  (-> lexed as .)
//   strings:    "..." literals (char*); funcs may return non-struct types only
//
// rdgen handles ordered alternatives transactionally. This grammar still uses
// keyword-led named statement rules because that shape is easy to inspect and
// produces smaller parse trees. Operator precedence is flat in the grammar and
// resolved here.

// require (not include) so the -r composition path can filter them: the kernel
// already carries std/core and std/tok, and this lets `kernel -r c c.ast`
// build a standalone C compiler without duplicating their declarations.
require "std/core"
require "std/tok"
include "std/parser_reader.lang"
include "std/ast.lang"
include "std/prec.lang"

// All rules are c_-prefixed: bare names like program/type/block/primary would
// generate parse_program/parse_type/... which COLLIDE with the compiler's own
// parser functions (pulled in transitively via lang_reader).
#parser{
    c_program    = c_topdecl+
    c_topdecl    = struct:c_structdef | enum:c_enumdef | var:c_topvar
    c_topvar     = type:c_rettype name:symbol tail:c_topvartail
    c_topvartail = func:c_functail | global:c_globaltail
    c_functail   = '(' params:c_params ')' body:c_block
    c_globaltail = dims:c_arrdim init:c_initopt ';'
    c_structdef  = 'struct' name:symbol '{' fields:c_fields '}' ';'
    c_fields     = c_field*
    c_field      = type:c_ptype name:symbol ';'
    c_enumdef    = 'enum' c_enumtag '{' items:c_enumitems '}' ';'
    c_enumtag    = c_tagname*
    c_tagname    = symbol
    c_enumitems  = c_enumitem*
    c_enumitem   = member:c_enummember | ','
    c_enummember = name:symbol value:c_enumvalopt
    c_enumvalopt = c_enumval*
    c_enumval    = '=' value:number
    c_rettype    = type:c_basetype stars:c_stars
    c_ptype      = type:c_anytype stars:c_stars
    c_anytype    = base:c_basetype | struct:c_structtype | enum:c_enumtype
    c_basetype   = 'int' | 'char' | 'void'
    c_structtype = 'struct' name:symbol
    c_enumtype   = 'enum' name:symbol
    c_stars      = c_star*
    c_star       = '*'
    c_params     = c_paramitem*
    c_paramitem  = param:c_param | ','
    c_param      = type:c_ptype name:symbol
    c_block     = '{' stmts:c_stmt* '}'
    c_stmt      = ret:c_retstmt | if:c_ifstmt | while:c_whilestmt | for:c_forstmt | switch:c_switchstmt | break:c_breakstmt | continue:c_continuestmt | decl:c_decl | block:c_block | expr:c_exprstmt
    c_switchstmt = 'switch' '(' scrut:c_expr ')' '{' items:c_switchitems '}'
    c_switchitems = c_switchitem*
    c_switchitem = case:c_caseval | default:c_defaultlabel | c_stmt
    c_caseval    = 'case' value:c_expr ':'
    c_defaultlabel = 'default' ':'
    c_breakstmt = 'break' ';'
    c_continuestmt = 'continue' ';'
    c_retstmt   = 'return' value:c_expr ';'
    c_ifstmt    = 'if' '(' cond:c_expr ')' then:c_stmt elses:c_elses
    c_elses     = c_elsepart*
    c_elsepart  = 'else' body:c_stmt
    c_whilestmt = 'while' '(' cond:c_expr ')' body:c_stmt
    c_forstmt   = 'for' '(' init:c_forinit cond:c_expr ';' step:c_expr ')' body:c_stmt
    c_forinit   = decl:c_decl | expr:c_exprstmt
    c_decl      = type:c_ptype name:symbol dims:c_arrdim init:c_initopt ';'
    c_arrdim    = c_dim*
    c_dim       = '[' size:number ']'
    c_initopt   = c_initval*
    c_initval   = '=' value:c_expr
    c_exprstmt  = value:c_expr ';'
    c_expr      = bin:c_binexpr tern:c_terntail*
    c_terntail  = '?' then:c_expr ':' alt:c_expr
    c_binexpr   = first:c_unary rest:c_oprest*
    c_oprest    = op:operator right:c_unary?
    c_unary     = neg:c_neg | postfix:c_postfix
    c_neg       = op:operator operand:c_postfix
    c_postfix   = primary:c_primary ops:c_postfixop*
    c_postfixop = call:c_callargs | member:c_member | index:c_index
    c_callargs  = '(' args:c_args ')'
    c_member    = '.' name:symbol | '->' name:symbol
    c_index     = '[' index:c_expr ']'
    c_args      = c_argitem*
    c_argitem   = arg:c_expr | ','
    c_primary   = num:number | str:string | sym:symbol | paren:c_parenexpr
    c_parenexpr = '(' inner:c_expr ')'
}

// PNode kinds: 1=number, 2=symbol, 3=string, 4=list/sequence, 5=operator, 0=literal marker

// ============================================================
// Operator precedence (higher binds tighter)
// ============================================================

// C's binary ladder, loosest level first. The tokenizer already lexes the
// 2-char operators (==, !=, <=, >=, &&, ||, <<, >>) and carries their text, so
// they only need a level here. '=' and the compound assignments are absent on
// purpose: they are peeled off as statements, never climbed, and an operator
// with no declared level is refused rather than guessed at.
func c_table() *PrecTable {
    var t *PrecTable = prec_new();
    prec_left(t, "||");
    prec_left(t, "&&");
    prec_left(t, "|");
    prec_left(t, "^");
    prec_left(t, "&");
    prec_left(t, "== !=");
    prec_left(t, "< > <= >=");
    prec_left(t, "<< >>");
    prec_left(t, "+ -");
    prec_left(t, "* / %");
    return t;
}

// ============================================================
// Expression emission (precedence climbing over a flat operand/op list)
// ============================================================

// c_binexpr = first:c_unary rest:c_oprest*. Push operands and operators in
// source order and let the table shape the tree; `from` lets the assignment
// path start past the leading '='.
//
// One thing cannot go into the table: a postfix ++/-- in value position. The
// grammar makes c_oprest's right operand optional so `i++` can be a statement,
// and an operator with no right operand is not a binary operator. It is dropped
// here, its side effect honoured only at statement level, rather than given a
// binding power it does not have.
func c_emit_flat(first *PNode, rest *PNode, from i64) *u8 {
    var expr *PrecExpr = prec_expr(c_table());
    prec_operand(expr, emit_operand_str(first));

    var n i64 = vec_len(rest.children);
    var i i64 = from;
    while i < n {
        var item *PNode = vec_get(rest.children, i);
        var right *PNode = pnode_get(item, "right");
        if right != nil {
            var op *PNode = pnode_require(item, "op");
            prec_op(expr, op.text);
            prec_operand(expr, emit_operand_str(right));
        }
        i = i + 1;
    }
    return prec_build(expr);
}

// A c_expr is `c_binexpr c_terntail*`: emit the binexpr value, then fold any
// ternary tail around it.
func emit_expr_str(e *PNode) *u8 {
    var binexpr *PNode = pnode_require(e, "bin");
    var terntail *PNode = pnode_require(e, "tern");
    var base *u8 = c_emit_flat(pnode_require(binexpr, "first"),
                               pnode_require(binexpr, "rest"), 0);
    if vec_len(terntail.children) > 0 {
        return emit_ternary(base, vec_get(terntail.children, 0));
    }
    return base;
}

// Per-node-unique temp name (block/block_expr vars leak to the enclosing scope,
// so ternary temps and switch scrutinees each need their own; derive it from the
// node's address). Distinct prefixes + distinct node pointers => no collisions.
func c_gensym(prefix *u8, node *PNode) *u8 {
    var sb *StringBuilder = sb_new();
    sb_str(sb, prefix);
    var addr i64 = node;
    sb_int(sb, addr);
    return sb_finish(sb);
}

func ternary_tmp(node *PNode) *u8 {
    return c_gensym("__ct", node);
}

// `cond ? a : b` -> a value-returning block_expr (only the taken branch runs):
//   { var t = 0; if (cond) { t = a; } else { t = b; }  t }
// tt is a c_terntail. The temp is i64, which covers the bounded subset's int
// and pointer values.
func emit_ternary(cond *u8, tt *PNode) *u8 {
    var t *u8 = ternary_tmp(tt);
    var thenexpr *u8 = emit_expr_str(pnode_require(tt, "then"));
    var elseexpr *u8 = emit_expr_str(pnode_require(tt, "alt"));
    var stmts *u8 = ast_vec();
    ast_push(stmts, ast_var(t, ast_type_i64(), ast_int(0)));
    ast_push(stmts, ast_if(cond,
                           ast_block1(ast_assign(ast_ident(t), thenexpr)),
                           ast_block1(ast_assign(ast_ident(t), elseexpr))));
    return ast_block_expr(stmts, ast_ident(t));
}

// A branch the grammar can produce but this converter does not handle is a
// reader bug. Name it and stop: emitting a placeholder is how a reader turns its
// own gap into a mystery in the generated program.
func c_unhandled(what *u8, node *PNode) *u8 {
    eprint("c: unhandled ");
    eprint(what);
    var label *u8 = pnode_branch(node);
    if label == nil {
        eprintln(" (the grammar left this alternative unlabeled)");
    } else {
        eprint(" branch '");
        eprint(label);
        eprintln("'");
    }
    exit(1);
    return nil;
}

// c_unary = neg:c_neg | postfix:c_postfix. The grammar names the alternative
// that matched, so lowering asks it instead of inspecting the first child's kind.
func emit_operand_str(node *PNode) *u8 {
    if pnode_is(node, "neg") {
        var f *PNode = pnode_require(node, "op");
        var operand *u8 = emit_postfix_str(pnode_require(node, "operand"));
        if streq(f.text, "~") {               // ~x == x ^ -1 (kernel has no unary ~)
            return ast_binop("^", operand, ast_unop("-", ast_int(1)));
        }
        return ast_unop(f.text, operand);
    }
    if pnode_is(node, "postfix") { return emit_postfix_str(node); }
    return c_unhandled("operand", node);
}

// If `primary` is a parenthesized lone deref `(*X)`, return the c_postfix node X
// being dereferenced; else nil. Used to peel C's explicit deref before a member
// access (see emit_postfix_str).
func deref_paren_inner(primary *PNode) *PNode {
    if !pnode_is(primary, "paren") { return nil; }
    var inner *PNode = pnode_require(primary, "inner");
    if vec_len(pnode_require(inner, "tern").children) != 0 { return nil; }  // not a lone deref
    var binexpr *PNode = pnode_require(inner, "bin");
    if vec_len(pnode_require(binexpr, "rest").children) != 0 { return nil; } // lone unary only
    var u *PNode = pnode_require(binexpr, "first");
    if !pnode_is(u, "neg") { return nil; }
    var u0 *PNode = pnode_require(u, "op");
    if streq(u0.text, "*") {
        return pnode_require(u, "operand");           // the c_postfix being deref'd
    }
    return nil;
}

// postfix = primary postfixop*  ->  fold the chain left-to-right. Each op is a
// call (c_callargs = ['(', args, ')'], so children[1] is the args list, kind 4)
// or a member access (c_member = ['.', name], so children[1] is the name, kind 2).
func emit_postfix_str(pf *PNode) *u8 {
    var primary *PNode = pnode_require(pf, "primary");
    var ops *PNode = pnode_require(pf, "ops");
    var nops i64 = vec_len(ops.children);

    // C's (*p).field is lang's auto-deref p.field. When a member access follows a
    // parenthesized lone deref, peel the '*' and emit (field p ...): the kernel
    // auto-derefs pointer.field, whereas (field (unop * p) ...) would load a
    // struct value and crash.
    var base *u8 = nil;
    var peeled *PNode = nil;
    if nops > 0 {
        if pnode_is(vec_get(ops.children, 0), "member") {
            peeled = deref_paren_inner(primary);
        }
    }
    if peeled != nil {
        base = emit_postfix_str(peeled);
    } else {
        base = emit_primary_str(primary);
    }

    var oi i64 = 0;
    while oi < nops {
        var op *PNode = vec_get(ops.children, oi);
        if pnode_is(op, "member") {               // p.f / p->f -> (field base name)
            base = ast_field(base, pnode_require(op, "name").text);
        } else if pnode_is(op, "index") {         // a[i] -> (index base idx)
            base = ast_index(base, emit_expr_str(pnode_require(op, "index")));
        } else if pnode_is(op, "call") {          // f(a, b) -> (call base args...)
            var args *u8 = ast_vec();
            var items *u8 = pnode_require(op, "args").children;
            var n i64 = vec_len(items);
            var i i64 = 0;
            while i < n {
                var it *PNode = vec_get(items, i);
                if pnode_is(it, "arg") {          // ',' separators carry no label
                    ast_push(args, emit_expr_str(it));
                }
                i = i + 1;
            }
            base = ast_call(base, args);
        } else {
            return c_unhandled("postfix operator", op);
        }
        oi = oi + 1;
    }
    return base;
}

func emit_primary_str(p *PNode) *u8 {
    if pnode_is(p, "num") { return ast_number(p.text); }
    if pnode_is(p, "sym") { return ast_ident(p.text); }
    if pnode_is(p, "str") {         // one token covers "..." and '...'
        if *(p.text) == 39 {        // leading ' -> C char literal, an integer value
            return ast_int(char_literal_value(p.text));
        }
        return ast_string_raw(p.text);  // "..." string; text keeps its quotes for the kernel
    }
    if pnode_is(p, "paren") {
        return emit_expr_str(pnode_require(p, "inner"));
    }
    return c_unhandled("primary", p);
}

// Value of a C char literal token (text includes the single quotes, e.g. 'a' or
// '\n'). Handles the common backslash escapes.
func char_literal_value(text *u8) i64 {
    var c i64 = *(text + 1);       // first char after the opening quote
    if c == 92 {                   // backslash escape
        var e i64 = *(text + 2);
        if e == 110 { return 10; }     // \n
        if e == 116 { return 9; }      // \t
        if e == 114 { return 13; }     // \r
        if e == 48 { return 0; }       // \0
        if e == 92 { return 92; }      // \\
        if e == 39 { return 39; }      // \'
        return e;                      // \<other> -> literal char
    }
    return c;
}

// ============================================================
// Statement emission
// ============================================================

// c_stmt names its alternatives, so the statement says what it is. This used to
// be re-derived from a leading keyword's text and, for the two keyword-less
// forms, from how deep a 'struct' sat under the first child - which is how
// telling a declaration from an expression statement ended up being a question
// about parse-tree shape rather than about C.
//
// c_forinit labels its two alternatives `decl` and `expr` as well, so a for
// loop's initializer arrives here answering the same two questions.
func emit_stmt(s *PNode) *u8 {
    if pnode_is(s, "block") { return emit_block(s); }
    if pnode_is(s, "break") { return ast_break(nil); }
    if pnode_is(s, "continue") { return ast_continue(nil); }
    if pnode_is(s, "ret") { return ast_return(emit_expr_str(pnode_require(s, "value"))); }
    if pnode_is(s, "if") {
        var cond *u8 = emit_expr_str(pnode_require(s, "cond"));
        var then_b *u8 = emit_stmt_as_block(pnode_require(s, "then"));
        var elses *PNode = pnode_require(s, "elses");
        var else_b *u8 = nil;
        if vec_len(elses.children) > 0 {
            var elsepart *PNode = vec_get(elses.children, 0);
            else_b = emit_stmt_as_block(pnode_require(elsepart, "body"));
        }
        return ast_if(cond, then_b, else_b);
    }
    if pnode_is(s, "while") {
        return ast_while(emit_expr_str(pnode_require(s, "cond")),
                         emit_stmt_as_block(pnode_require(s, "body")));
    }
    if pnode_is(s, "for") { return emit_for(s); }
    if pnode_is(s, "switch") { return emit_switch(s); }
    if pnode_is(s, "decl") { return emit_decl(s); }
    if pnode_is(s, "expr") {
        return emit_exprstmt_from_expr(pnode_require(s, "value"));
    }
    return c_unhandled("statement", s);
}

// Base operator for a compound-assignment op ("+=" -> "+", ...); nil otherwise.
func compound_base(op *u8) *u8 {
    if streq(op, "+=") { return "+"; }
    if streq(op, "-=") { return "-"; }
    if streq(op, "*=") { return "*"; }
    if streq(op, "/=") { return "/"; }
    if streq(op, "%=") { return "%"; }
    return nil;
}

// Base operator for an increment/decrement op ("++" -> "+", "--" -> "-"); nil otherwise.
func incdec_base(op *u8) *u8 {
    if streq(op, "++") { return "+"; }
    if streq(op, "--") { return "-"; }
    return nil;
}

// Emit `lv = lv <base> 1` for a ++/-- statement (lvnode is a c_unary/c_postfix).
func emit_incdec(lvnode *PNode, base *u8) *u8 {
    var lv *u8 = emit_operand_str(lvnode);
    return ast_assign(lv, ast_binop(base, lv, ast_int(1)));
}

// Handle ++/-- used as a whole statement (or for-step): postfix `i++` / `i--`
// (one oprest that is a bare op) or prefix `++i` / `--i` (a c_neg with op ++/--).
// Returns the assign string if handled, else nil. ++/-- in value position is NOT
// handled here (see climb).
func try_incdec(expr *PNode) *u8 {
    var u *PNode = pnode_require(expr, "first");
    var star *PNode = pnode_require(expr, "rest");
    var ns i64 = vec_len(star.children);
    if ns == 1 {                                     // postfix: lvalue ++ / --
        var orn *PNode = vec_get(star.children, 0);
        if pnode_get(orn, "right") == nil {          // bare op, no right operand
            var opn *PNode = pnode_require(orn, "op");
            var base *u8 = incdec_base(opn.text);
            if base != nil { return emit_incdec(u, base); }
        }
    }
    if ns == 0 {                                     // prefix: ++ / -- lvalue
        if pnode_is(u, "neg") {
            var base *u8 = incdec_base(pnode_require(u, "op").text);
            if base != nil { return emit_incdec(pnode_require(u, "operand"), base); }
        }
    }
    return nil;
}

// Lower a bare c_expr as a statement: ++/-- desugar to an assignment, a leading
// '=' is a plain assignment, a leading compound op (+=, ...) desugars to
// `lv = lv op rhs`, otherwise an expression statement. Shared by exprstmt and the
// for-loop step (a bare expr with no trailing ';').
func emit_exprstmt_from_expr(expr *PNode) *u8 {
    var binexpr *PNode = pnode_require(expr, "bin");
    var terntail *PNode = pnode_require(expr, "tern");
    var ntt i64 = vec_len(terntail.children);
    if ntt == 0 {                                     // ++/-- only on a bare lvalue
        var inc *u8 = try_incdec(binexpr);
        if inc != nil { return inc; }
    }
    var lv *PNode = pnode_require(binexpr, "first");
    var rest *PNode = pnode_require(binexpr, "rest");
    if vec_len(rest.children) > 0 {
        // The leading operator decides the statement. Both assignment forms peel
        // it off and climb what follows, so '=' and '+=' never reach the table.
        var item0 *PNode = vec_get(rest.children, 0);
        var op0 *PNode = pnode_require(item0, "op");
        if streq(op0.text, "=") {
            var rhs *u8 = c_emit_flat(pnode_require(item0, "right"), rest, 1);
            if ntt > 0 { rhs = emit_ternary(rhs, vec_get(terntail.children, 0)); }  // ... incl. ?:
            return ast_assign(emit_operand_str(lv), rhs);
        }
        var cbase *u8 = compound_base(op0.text);                  // x op= rhs -> x = x op (rhs)
        if cbase != nil {
            var lvs *u8 = emit_operand_str(lv);
            var rhs *u8 = c_emit_flat(pnode_require(item0, "right"), rest, 1);
            if ntt > 0 { rhs = emit_ternary(rhs, vec_get(terntail.children, 0)); }
            return ast_assign(lvs, ast_binop(cbase, lvs, rhs));
        }
    }
    var base *u8 = c_emit_flat(lv, rest, 0);
    if ntt > 0 { base = emit_ternary(base, vec_get(terntail.children, 0)); }
    return ast_expr_stmt(base);
}

// c_forstmt = 'for' '(' c_forinit c_expr ';' c_expr ')' c_stmt
//   children: [for, (, init, cond, ;, step, ), body]   (init consumes its ';')
// Desugar to a block: { init; while (cond) { body; step; } }.  (continue inside
// the body skips step - an accepted limitation of this bounded subset.)
func emit_for(s *PNode) *u8 {
    var init *PNode = pnode_require(s, "init");
    var cond *PNode = pnode_require(s, "cond");
    var step *PNode = pnode_require(s, "step");
    var body *PNode = pnode_require(s, "body");
    var inner *u8 = ast_vec();
    ast_push(inner, emit_stmt(body));
    ast_push(inner, emit_exprstmt_from_expr(step));
    var outer *u8 = ast_vec();
    ast_push(outer, emit_stmt(init));                       // decl or assignment (handles both)
    ast_push(outer, ast_while(emit_expr_str(cond), ast_block(inner)));
    return ast_block(outer);
}

// A c_switchitem is a 'case' label, a 'default' label, or a statement. Return
// 1=case, 2=default, 0=statement. The statement alternative is deliberately
// unlabeled: c_stmt labels its own alternatives, and one node cannot carry two
// branch names - so a statement arrives here still answering to its own label.
func switch_label_kind(it *PNode) i64 {
    if pnode_is(it, "case") { return 1; }
    if pnode_is(it, "default") { return 2; }
    return 0;
}

func switch_is_break(it *PNode) i64 {
    if pnode_is(it, "break") { return 1; }
    return 0;
}

// Finalize one case group: build its condition (svname == v1 || svname == v2 ...,
// or nil for `default`) and body block, appending both to the parallel conds/bodies.
func switch_finalize(conds *u8, bodies *u8, svname *u8, vals *u8, is_default i64, body *u8) void {
    var cond *u8 = nil;
    if is_default == 0 {
        var nv i64 = vec_len(vals);
        var j i64 = 0;
        while j < nv {
            var eq *u8 = ast_binop("==", ast_ident(svname), vec_get(vals, j));
            if cond == nil { cond = eq; }
            else { cond = ast_binop("||", cond, eq); }
            j = j + 1;
        }
    }
    vec_push(conds, cond);          // nil marks the default group
    vec_push(bodies, ast_block(body));
}

// switch (E) { case V: ... } -> evaluate E once into a temp, then an if/else-if
// chain (one arm per case group; `default` is the final else). BOUNDED: each
// case is independent - there is NO fall-through (a case body without break does
// not flow into the next). Stacked empty labels (case 2: case 3:) share one body.
// A top-level break just terminates its case (it is the idiomatic terminator).
//   c_switchstmt = ['switch','(',expr,')','{', items, '}']  -> children[2]=expr, [5]=items
func emit_switch(s *PNode) *u8 {
    var svname *u8 = c_gensym("__sw", s);
    var scrut *u8 = emit_expr_str(pnode_require(s, "scrut"));
    var items *PNode = pnode_require(s, "items");
    var n i64 = vec_len(items.children);

    var conds *u8 = vec_new(8);     // per group: condition string (nil = default)
    var bodies *u8 = vec_new(8);    // per group: body block string

    var pend_vals *u8 = ast_vec();  // case-value expr strings for the current stacked labels
    var pend_default i64 = 0;
    var pend_body *u8 = ast_vec();
    var have_body i64 = 0;          // current group has started collecting body statements?
    var have_group i64 = 0;         // any label seen for the current group?

    var i i64 = 0;
    while i < n {
        var it *PNode = vec_get(items.children, i);
        var lab i64 = switch_label_kind(it);
        if lab != 0 {
            if have_body != 0 {     // a label after a body => finalize the previous group
                switch_finalize(conds, bodies, svname, pend_vals, pend_default, pend_body);
                pend_vals = ast_vec(); pend_default = 0; pend_body = ast_vec(); have_body = 0;
            }
            have_group = 1;
            if lab == 2 { pend_default = 1; }
            else { ast_push(pend_vals, emit_expr_str(pnode_require(it, "value"))); }
        } else {
            if switch_is_break(it) == 0 {       // drop the case-terminating break
                ast_push(pend_body, emit_stmt(it));
            }
            have_body = 1;
        }
        i = i + 1;
    }
    if have_group != 0 {
        switch_finalize(conds, bodies, svname, pend_vals, pend_default, pend_body);
    }

    // Assemble: default body is the innermost else; case arms wrap it (reverse order).
    var else_branch *u8 = nil;
    var ng i64 = vec_len(conds);
    var k i64 = 0;
    while k < ng {
        if vec_get(conds, k) == nil { else_branch = vec_get(bodies, k); }
        k = k + 1;
    }
    var idx i64 = ng - 1;
    while idx >= 0 {
        var c *u8 = vec_get(conds, idx);
        if c != nil { else_branch = ast_if(c, vec_get(bodies, idx), else_branch); }
        idx = idx - 1;
    }

    var stmts *u8 = ast_vec();
    ast_push(stmts, ast_var(svname, ast_type_i64(), scrut));
    if else_branch != nil { ast_push(stmts, else_branch); }
    return ast_block(stmts);
}

// (var NAME TYPE INIT?). arrdim is a c_dim* (zero = scalar; one c_dim =
// ['[', number, ']'] = 1-D array `T[N]` -> (type_array N ELEM), no initializer).
// initopt is the stable-slot optional init for scalars (absent -> no store, as in
// C / a top-level zero). Shared by local decls and globals.
func emit_var(name *PNode, typenode *PNode, arrdim *PNode, initopt *PNode) *u8 {
    if vec_len(arrdim.children) > 0 {
        var dim0 *PNode = vec_get(arrdim.children, 0);
        var sizenode *PNode = pnode_require(dim0, "size");
        return ast_var(name.text, ast_type_array(sizenode.text, emit_type(typenode)), nil);
    }
    if vec_len(initopt.children) > 0 {
        var initval *PNode = vec_get(initopt.children, 0);
        return ast_var(name.text, emit_type(typenode),
                       emit_expr_str(pnode_require(initval, "value")));
    }
    return ast_var(name.text, emit_type(typenode), nil);
}

func emit_decl(d *PNode) *u8 {
    return emit_var(pnode_require(d, "name"), pnode_require(d, "type"),
                    pnode_require(d, "dims"), pnode_require(d, "init"));
}

// A control-flow body must be a block; wrap a single statement if needed.
func emit_stmt_as_block(s *PNode) *u8 {
    if pnode_is(s, "block") { return emit_block(s); }
    return ast_block1(emit_stmt(s));
}

func emit_block(block *PNode) *u8 {
    var stmts *u8 = ast_vec();
    if block != nil {
        var sl *PNode = pnode_require(block, "stmts");
        var n i64 = vec_len(sl.children);
        var i i64 = 0;
        while i < n {
            ast_push(stmts, emit_stmt(vec_get(sl.children, i)));
            i = i + 1;
        }
    }
    return ast_block(stmts);
}

// ============================================================
// Declarations
// ============================================================

// c_ptype/c_rettype = anytype c_stars  ->  children [anytype, stars_star]. Each
// star wraps the base in a (type_ptr ...). c_anytype names which of its three
// alternatives matched. char -> u8 so `char*` is `*u8` (lang's string type);
// int -> i64; void -> void; struct N -> N; `enum Name` is just an int.
func emit_type(t *PNode) *u8 {
    if t == nil { return ast_type("i64"); }
    var anytype *PNode = pnode_require(t, "type");
    var stars *PNode = pnode_require(t, "stars");
    var n i64 = vec_len(stars.children);
    var base *u8 = nil;
    if pnode_is(anytype, "enum") {                // `enum Name` is just an int
        base = ast_type("i64");
    } else if pnode_is(anytype, "struct") {
        base = ast_type(pnode_require(anytype, "name").text);
    } else if streq(anytype.text, "void") {
        base = ast_type("void");
    } else if streq(anytype.text, "char") {
        base = ast_type("u8");
    } else {
        base = ast_type("i64");
    }
    var i i64 = 0;
    while i < n { base = ast_type_ptr(base); i = i + 1; }
    return base;
}

// A c_topvar whose tail is a c_functail is a function definition.
func emit_func(tv *PNode) *u8 {
    var tail *PNode = pnode_require(tv, "tail");
    return ast_func(pnode_require(tv, "name").text,
                    emit_params(pnode_require(tail, "params")),
                    emit_type(pnode_require(tv, "type")),
                    emit_block(pnode_require(tail, "body")));
}

// A c_topvar whose tail is a c_globaltail is a global (var ...).
func emit_global(tv *PNode) *u8 {
    var tail *PNode = pnode_require(tv, "tail");
    return emit_var(pnode_require(tv, "name"), pnode_require(tv, "type"),
                    pnode_require(tail, "dims"), pnode_require(tail, "init"));
}

// params = paramitem* ; paramitem = param | ',' ; param = type symbol
// Returns a vec of (param name type) for ast_func.
func emit_params(params *PNode) *u8 {
    var pv *u8 = ast_vec();
    if params == nil { return pv; }
    var items *u8 = params.children;
    var n i64 = vec_len(items);
    var i i64 = 0;
    while i < n {
        var it *PNode = vec_get(items, i);
        if pnode_is(it, "param") {         // ',' separators carry no label
            var pname *PNode = pnode_require(it, "name");
            ast_push(pv, ast_param(pname.text, emit_type(pnode_require(it, "type"))));
        }
        i = i + 1;
    }
    return pv;
}

// Parse a non-negative decimal integer from text (enum value literals).
func c_atoi(s *u8) i64 {
    var n i64 = 0;
    var i i64 = 0;
    while *(s + i) != 0 {
        var c i64 = *(s + i);
        if c >= 48 {
            if c <= 57 { n = n * 10 + (c - 48); }
        }
        i = i + 1;
    }
    return n;
}

// c_enumdef = 'enum' tag '{' c_enumitems '}' ';'  ->  children [enum, tag, '{',
// items, '}', ';'].  Each member becomes a global int constant (var NAME i64 V);
// implicit values count up from 0 (or from the last explicit value + 1), so
// `enum { A, B, C }` is 0/1/2 and `enum { X = 10, Y }` is 10/11. The tag name is
// cosmetic (the kernel has no enum type; `enum Tag` lowers to i64 in emit_type).
func emit_enumdef(d *PNode, decls *u8) void {
    var items *PNode = pnode_require(d, "items");
    var n i64 = vec_len(items.children);
    var counter i64 = 0;
    var i i64 = 0;
    while i < n {
        var it *PNode = vec_get(items.children, i);   // c_enumitem = member:... | ','
        if pnode_is(it, "member") {
            var namep *PNode = pnode_require(it, "name");
            var valopt *PNode = pnode_require(it, "value");   // c_enumvalopt = c_enumval*
            var value i64 = counter;
            if vec_len(valopt.children) > 0 {
                var ev *PNode = vec_get(valopt.children, 0);
                value = c_atoi(pnode_require(ev, "value").text);
            }
            ast_push(decls, ast_var(namep.text, ast_type_i64(), ast_int(value)));
            counter = value + 1;
        }
        i = i + 1;
    }
}

// c_structdef = 'struct' Name '{' c_fields '}' ';'  ->  children [struct, Name,
// '{', fields, '}', ';'].  Each c_field = c_ptype symbol ';'.
func emit_structdef(sd *PNode) *u8 {
    var name *PNode = pnode_require(sd, "name");
    var fields *PNode = pnode_require(sd, "fields");
    var fv *u8 = ast_vec();
    var n i64 = vec_len(fields.children);
    var i i64 = 0;
    while i < n {
        var fld *PNode = vec_get(fields.children, i);
        var fname *PNode = pnode_require(fld, "name");
        ast_push(fv, ast_field_decl(fname.text, emit_type(pnode_require(fld, "type"))));
        i = i + 1;
    }
    return ast_struct(name.text, fv);
}

// program = topdecl+. c_topdecl names struct/enum/var, and a var's c_topvartail
// names func/global - the two questions that used to be answered by whether a
// keyword sat at children[0] and whether the tail began with a '(' marker.
func emit_program(prog *PNode) *u8 {
    var decls *u8 = ast_vec();
    if prog != nil {
        var dl *u8 = prog.children;
        var n i64 = vec_len(dl);
        var i i64 = 0;
        while i < n {
            var d *PNode = vec_get(dl, i);
            if pnode_is(d, "struct") {
                ast_push(decls, emit_structdef(d));
            } else if pnode_is(d, "enum") {
                emit_enumdef(d, decls);                     // pushes one global per member
            } else if pnode_is(d, "var") {
                var tail *PNode = pnode_require(d, "tail");
                if pnode_is(tail, "func") {
                    ast_push(decls, emit_func(d));
                } else if pnode_is(tail, "global") {
                    ast_push(decls, emit_global(d));
                } else {
                    return c_unhandled("top-level declarator", tail);
                }
            } else {
                return c_unhandled("top-level declaration", d);
            }
            i = i + 1;
        }
    }
    return ast_program(decls);
}

reader c(text *u8) *u8 {
    var t *Tokenizer = tok_new(text);
    var prog *PNode = parse_c_program(t);
    return emit_program(prog);
}
