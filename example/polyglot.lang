// Polyglot: three syntaxes compiled into ONE native binary.
//   - C        (#c{...})        -> example/c/c.lang
//   - minilisp (#minilisp{...}) -> example/minilisp/minilisp.lang
//   - lang                      -> main()
//
// This is the forge thesis made concrete: many readers in one program, linked
// and calling each other. Two #parser{}-based readers used to collide on the
// generated PNode constructors (pnode_new/atom/list); this program guards that.
include "std/core.lang"
include "example/c/c.lang"
include "example/minilisp/minilisp.lang"

#c{
    int c_square(int x) { return x * x; }
    int c_sum_to(int n) {
        int s = 0;
        int i;
        for (i = 1; i <= n; i++) { s += i; }
        return s;
    }
}

#minilisp{ (defun ml_double (n) (+ n n)) }
#minilisp{ (defun ml_inc (n) (+ n 1)) }

func main() i64 {
    // lang composes functions authored in two different syntaxes.
    print("c_square(7)            = "); print_int(c_square(7));                print("\n"); // 49
    print("ml_double(7)           = "); print_int(ml_double(7));               print("\n"); // 14
    print("c_square(ml_double(3)) = "); print_int(c_square(ml_double(3)));     print("\n"); // 36
    print("ml_inc(c_sum_to(5))    = "); print_int(ml_inc(c_sum_to(5)));        print("\n"); // 16

    if c_square(7) != 49 { return 1; }
    if ml_double(7) != 14 { return 1; }
    if c_square(ml_double(3)) != 36 { return 1; }
    if c_sum_to(5) != 15 { return 1; }
    if ml_inc(c_sum_to(5)) != 16 { return 1; }

    print("POLYGLOT PASS\n");
    return 0;
}
