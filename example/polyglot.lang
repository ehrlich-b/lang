// THREE real languages, composed into ONE native binary, calling each other at
// the ABI level - no FFI, no VM. The forge thesis made concrete:
//
//   - C        (#c{...})        -> imperative: loops, ints           (raw i64)
//   - minilisp (#minilisp{...}) -> functional: lists, closures       (boxed *LispObj)
//   - flow     (#flow{...})     -> coroutines: generators over effects (raw i64)
//   - lang                      -> main(), the glue
//
// Each language says something the others can't: flow's `gen` SUSPENDS and
// RESUMES mid-loop (algebraic effects - C and Lisp can't); Lisp has first-class
// lists/closures; C is plain imperative. They meet at the i64 ABI, marshalling
// boxed Lisp values with lisp_int(...) / lisp_to_int(...).
//
// Uses effects (via flow), so compile with clang, not the lli JIT:
//   LANGBE=llvm out/lang example/polyglot.lang -o p.ll && clang -O0 p.ll -o p && ./p
include "std/core.lang"
include "example/minilisp/lisp_runtime.lang"
include "example/flow/flow_runtime.lang"
include "example/c/c.lang"
include "example/minilisp/minilisp.lang"
include "example/flow/flow.lang"

#c{
    int c_square(int x) { return x * x; }
    int c_sum_to(int n) {
        int s = 0;
        for (int i = 1; i <= n; i++) { s += i; }
        return s;
    }
}

#minilisp{ (defun ml_double (n) (+ n n)) }
#minilisp{ (defun ml_inc (n) (+ n 1)) }

#flow{
    // a stateful coroutine: carries a, b across each yield
    gen fib(n) {
        var a = 0;
        var b = 1;
        var i = 0;
        while i < n {
            yield a;
            var t = a + b;
            a = b;
            b = t;
            i = i + 1;
        }
    }
    // a driver: runs the generator and sums what it yields
    func sum_fib(n) {
        var total = 0;
        for x in fib(n) {
            total = total + x;
        }
        return total;
    }
}

func main() i64 {
    // A single value flows through all THREE languages in turn:
    //   flow sums the first 7 Fibonacci numbers, C squares it, Lisp increments it.
    var a i64 = sum_fib(7);                              // flow:  0+1+1+2+3+5+8 = 20
    var b i64 = c_square(a);                             // C:     20 * 20       = 400
    var c i64 = lisp_to_int(ml_inc(lisp_int(b)));        // Lisp:  400 + 1       = 401

    print("flow  sum_fib(7)           = "); print_int(a); print("\n");
    print("C     c_square(20)         = "); print_int(b); print("\n");
    print("Lisp  ml_inc(400)          = "); print_int(c); print("\n");

    // And the other direction: C feeds Lisp feeds nothing, flow stands alone.
    print("C->Lisp ml_double(c_sum_to(4)) = ");
    print_int(lisp_to_int(ml_double(lisp_int(c_sum_to(4)))));         // (1+2+3+4)*2 = 20
    print("\n");

    if a != 20 { return 1; }
    if b != 400 { return 2; }
    if c != 401 { return 3; }
    if lisp_to_int(ml_double(lisp_int(c_sum_to(4)))) != 20 { return 4; }
    if sum_fib(10) != 88 { return 5; }

    print("POLYGLOT PASS\n");
    return 0;
}
