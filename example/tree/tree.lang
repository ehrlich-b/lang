include "std/parser_runtime.lang"
include "std/ast.lang"

// Change ':' to '+' and right to result (including the lookup below),
// then try 10+42. Source-only edits reuse the compiled reader.
#parser{
    debug_program = left:number ':' right:number
}

reader pdebug(text *u8) *u8 {
    var tokens *Tokenizer = tok_new(text);
    var tree *PNode = parse_debug_program(tokens);
    if tree == nil || !tok_eof(tokens) {
        tok_print_error(tokens, "source.read"); return nil;
    }
    pnode_dump(tree);
    var right *PNode = pnode_require(tree, "right");
    if right == nil { return nil; }
    return ast_main_i64(ast_span(ast_number(right.text), right.start, right.end));
}
