// ============================================================
// flow - a tiny generator/coroutine language (the effects DSL)
// ============================================================
//
// The third polyglot language. Where C is imperative and minilisp is functional,
// flow is about CONTROL: generators that suspend and resume. It lowers to lang's
// algebraic effects (perform/handle/resume) - something neither C nor our Lisp
// can express. Built with #parser{} (Level 3) + the std/ast.lang builder (L1).
//
//   #flow{
//     gen fib(n) {                 // a stateful generator
//       var a = 0; var b = 1; var i = 0;
//       while i < n { yield a; var t = a + b; a = b; b = t; i = i + 1; }
//     }
//     func sum_fib(n) {            // a driver: runs the generator, sums the values
//       var total = 0;
//       for x in fib(n) { total = total + x; }
//       return total;
//     }
//   }
//
// `yield e` performs Yield(e); `for x in g(...) {body}` lowers to a handle that
// binds each yielded value to x, runs body, and resumes the generator. Both
// `gen` and `func` become ordinary i64 functions, callable from lang and C.
//
// Conditions are unparenthesized (`if c {}`, `while c {}`) - flow is its own
// little language, not C. Everything is i64. Requires:
//   include "example/flow/flow_runtime.lang"   (declares `effect Yield`)
//
// Converter helpers are fl_-prefixed so flow composes with the C and minilisp
// readers in one binary (no symbol collisions).

include "std/core.lang"
include "std/tok.lang"
include "std/parser_reader.lang"
include "std/ast.lang"
include "std/prec.lang"

#parser{
    flow_program  = flow_decl+
    flow_decl     = flow_gendecl | flow_funcdecl
    flow_gendecl  = 'gen' name:symbol '(' params:flow_params ')' body:flow_block
    flow_funcdecl = 'func' name:symbol '(' params:flow_params ')' body:flow_block
    flow_params   = flow_paramitem*
    flow_paramitem = name:symbol | ','
    flow_block    = '{' stmts:flow_stmt* '}'
    flow_stmt     = var:flow_var | yield:flow_yield | send:flow_send | return:flow_return | if:flow_if | while:flow_while | for:flow_forin | expr:flow_exprstmt
    flow_var      = 'var' name:symbol '=' value:flow_expr ';'
    flow_yield    = 'yield' value:flow_expr ';'
    flow_send     = 'send' value:flow_expr ';'
    flow_return   = 'return' value:flow_expr ';'
    flow_if       = 'if' cond:flow_expr then:flow_block elses:flow_elses
    flow_elses    = flow_elsepart*
    flow_elsepart = 'else' body:flow_block
    flow_while    = 'while' cond:flow_expr body:flow_block
    flow_forin    = 'for' name:symbol 'in' call:flow_call body:flow_block
    flow_call     = name:symbol '(' args:flow_args ')'
    flow_exprstmt = value:flow_expr ';'
    flow_expr     = first:flow_unary rest:flow_oprest*
    flow_oprest   = op:operator right:flow_unary
    flow_unary    = neg:flow_neg | postfix:flow_postfix
    flow_neg      = op:operator operand:flow_postfix
    flow_postfix  = primary:flow_primary calls:flow_callopt*
    flow_callopt  = '(' args:flow_args ')'
    flow_args     = flow_argitem*
    flow_argitem  = arg:flow_expr | ','
    flow_primary  = yieldexpr:flow_yieldexpr | num:number | sym:symbol | paren:flow_paren
    flow_yieldexpr = 'yield' value:flow_expr
    flow_paren    = '(' inner:flow_expr ')'
}

// PNode kinds: 1=number, 2=symbol, 4=list/seq, 5=operator, 0=literal marker

// ============================================================
// Expressions (a flat operand/op list resolved by std/prec.lang)
// ============================================================

// Loosest level first. `=` leads, because assignment binds looser than every
// operator and associates to the right; prec_build refuses it outside statement
// position, which is what makes `f(a = b)` an error rather than a tree the
// kernel cannot lower.
func fl_table() *PrecTable {
    var t *PrecTable = prec_new();
    prec_assign(t, "=");
    prec_left(t, "||");
    prec_left(t, "&&");
    prec_left(t, "== !=");
    prec_left(t, "< > <= >=");
    prec_left(t, "+ -");
    prec_left(t, "* / %");
    return t;
}

// flow_expr = first:flow_unary rest:flow_oprest*. Push operands and operators
// in source order; the table decides the shape of the tree.
func fl_push_flat(expr *PrecExpr, e *PNode) void {
    prec_operand(expr, fl_emit_operand(pnode_require(e, "first")));

    var rest *PNode = pnode_require(e, "rest");
    var n i64 = vec_len(rest.children);
    var i i64 = 0;
    while i < n {
        var item *PNode = vec_get(rest.children, i);   // op:operator right:flow_unary
        var op *PNode = pnode_require(item, "op");
        prec_op(expr, op.text);
        prec_operand(expr, fl_emit_operand(pnode_require(item, "right")));
        i = i + 1;
    }
}

// std/prec.lang already named the operator it refused; a reader that carried on
// would turn that into a mystery further down the pipeline.
func fl_checked(value *u8) *u8 {
    if value == nil {
        eprintln("flow: this expression is not in the flow subset");
        exit(1);
    }
    return value;
}

func fl_emit_expr(e *PNode) *u8 {
    var expr *PrecExpr = prec_expr(fl_table());
    fl_push_flat(expr, e);
    return fl_checked(prec_build(expr));
}

// A branch the grammar can produce but this converter does not handle is a
// reader bug. Name it and stop - emitting a placeholder is how a reader turns
// its own gap into a mystery in the generated program.
func fl_unhandled(what *u8, node *PNode) *u8 {
    eprint("flow: unhandled ");
    eprint(what);
    var label *u8 = pnode_branch(node);
    if label == nil {
        eprintln(" (the grammar left this alternative unlabeled)");
    } else {
        eprint(" branch '");
        eprint(label);
        eprintln("'");
    }
    exit(1);
    return nil;
}

// flow_unary = neg:flow_neg | postfix:flow_postfix. The grammar says which
// alternative matched, so lowering never has to sniff kinds or child order.
func fl_emit_operand(node *PNode) *u8 {
    if pnode_is(node, "neg") {
        var op *PNode = pnode_require(node, "op");
        return ast_unop(op.text, fl_emit_postfix(pnode_require(node, "operand")));
    }
    if pnode_is(node, "postfix") { return fl_emit_postfix(node); }
    return fl_unhandled("operand", node);
}

// flow_postfix = flow_primary flow_callopt*  ->  fold calls left-to-right.
func fl_emit_postfix(pf *PNode) *u8 {
    var base *u8 = fl_emit_primary(pnode_require(pf, "primary"));
    var ops *PNode = pnode_require(pf, "calls");
    var n i64 = vec_len(ops.children);
    var i i64 = 0;
    while i < n {
        var op *PNode = vec_get(ops.children, i);
        base = ast_call(base, fl_emit_args(pnode_require(op, "args")));
        i = i + 1;
    }
    return base;
}

func fl_emit_primary(p *PNode) *u8 {
    if pnode_is(p, "num") { return ast_number(p.text); }
    if pnode_is(p, "sym") { return ast_ident(p.text); }
    if pnode_is(p, "yieldexpr") {
        // yield as an expression: its value is what the driver resumed with.
        return ast_perform1("Yield", fl_emit_expr(pnode_require(p, "value")));
    }
    if pnode_is(p, "paren") {
        return fl_emit_expr(pnode_require(p, "inner"));
    }
    return fl_unhandled("expression", p);
}

// flow_args = flow_argitem* ; argitem = arg:flow_expr | ','. Build an arg vec.
func fl_emit_args(args *PNode) *u8 {
    var av *u8 = ast_vec();
    var items *u8 = args.children;
    var n i64 = vec_len(items);
    var i i64 = 0;
    while i < n {
        var it *PNode = vec_get(items, i);
        if pnode_is(it, "arg") { ast_push(av, fl_emit_expr(it)); }
        i = i + 1;
    }
    return av;
}

// ============================================================
// Statements
// ============================================================

// Per-node-unique name (handler bindings + block vars; derive from node address).
func fl_gensym(prefix *u8, node *PNode) *u8 {
    var sb *StringBuilder = sb_new();
    sb_str(sb, prefix);
    var addr i64 = node;
    sb_int(sb, addr);
    return sb_finish(sb);
}

// send_target = the enclosing for-in's send-register name (nil if none), so a
// `send` nested inside an if/while still targets the right driver's resume value.
func fl_emit_block(block *PNode, send_target *u8) *u8 {
    var stmts *u8 = ast_vec();
    var sl *PNode = pnode_require(block, "stmts");
    var n i64 = vec_len(sl.children);
    var i i64 = 0;
    while i < n {
        ast_push(stmts, fl_emit_stmt(vec_get(sl.children, i), send_target));
        i = i + 1;
    }
    return ast_block(stmts);
}

func fl_emit_stmt(s *PNode, send_target *u8) *u8 {
    if pnode_is(s, "var") {
        var name *PNode = pnode_require(s, "name");
        return ast_var(name.text, ast_type_i64(), fl_emit_expr(pnode_require(s, "value")));
    }
    if pnode_is(s, "yield") {        // perform Yield(expr)
        return ast_expr_stmt(ast_perform1("Yield", fl_emit_expr(pnode_require(s, "value"))));
    }
    if pnode_is(s, "send") {         // set the resume value
        var sexpr *u8 = fl_emit_expr(pnode_require(s, "value"));
        if send_target == nil {
            return ast_expr_stmt(sexpr);   // defensive: `send` outside a for-in body
        }
        return ast_assign(ast_ident(send_target), sexpr);
    }
    if pnode_is(s, "return") { return ast_return(fl_emit_expr(pnode_require(s, "value"))); }
    if pnode_is(s, "if") {
        var cond *u8 = fl_emit_expr(pnode_require(s, "cond"));
        var then_b *u8 = fl_emit_block(pnode_require(s, "then"), send_target);
        var elses *PNode = pnode_require(s, "elses");
        var else_b *u8 = nil;
        if vec_len(elses.children) > 0 {
            var ep *PNode = vec_get(elses.children, 0);
            else_b = fl_emit_block(pnode_require(ep, "body"), send_target);
        }
        return ast_if(cond, then_b, else_b);
    }
    if pnode_is(s, "while") {
        return ast_while(fl_emit_expr(pnode_require(s, "cond")),
                         fl_emit_block(pnode_require(s, "body"), send_target));
    }
    if pnode_is(s, "for") { return fl_emit_forin(s); }
    if pnode_is(s, "expr") { return fl_emit_exprstmt(pnode_require(s, "value")); }
    return fl_unhandled("statement", s);
}

// A bare expression statement is the one place assignment is legal, so it is
// the one place that builds the same flat list as a statement.
func fl_emit_exprstmt(e *PNode) *u8 {
    var expr *PrecExpr = prec_expr(fl_table());
    fl_push_flat(expr, e);
    return fl_checked(prec_build_stmt(expr));
}

// for X in GEN(args) { body }  ->  drive the generator with a handle:
//   handle { GEN(args); } with {
//     return(__rv) => 0,
//     Yield(X, __k) => { var __send = 0; body; resume __k(__send); }
//   }
// The handler binds the yielded value to X and the continuation to __k; resuming
// runs the generator on to its next yield (carrying its locals across the gap).
// __send starts at 0 each value and is overwritten by any `send E;` in the body,
// so it flows back as the result of the generator's `yield` expression - making
// the channel bidirectional (a one-way generator simply never sends, resuming 0).
func fl_emit_forin(s *PNode) *u8 {
    var xvar *PNode = pnode_require(s, "name");
    var call *PNode = pnode_require(s, "call");
    var block *PNode = pnode_require(s, "body");

    var gname *PNode = pnode_require(call, "name");
    var gcall *u8 = ast_call_named(gname.text, fl_emit_args(pnode_require(call, "args")));

    var kname *u8 = fl_gensym("__k", s);
    var rvname *u8 = fl_gensym("__rv", s);
    var sname *u8 = fl_gensym("__send", s);

    // handler body = init send register, the for-body statements (with `send`
    // targeting this loop's register), then resume the generator with it.
    var hstmts *u8 = ast_vec();
    ast_push(hstmts, ast_var(sname, ast_type_i64(), ast_int(0)));
    var sl *PNode = pnode_require(block, "stmts");
    var n i64 = vec_len(sl.children);
    var i i64 = 0;
    while i < n {
        ast_push(hstmts, fl_emit_stmt(vec_get(sl.children, i), sname));
        i = i + 1;
    }
    ast_push(hstmts, ast_expr_stmt(ast_resume(ast_ident(kname), ast_ident(sname))));

    var eh *u8 = ast_effect_handler("Yield", xvar.text, kname, ast_block(hstmts));
    var ehs *u8 = ast_vec();
    ast_push(ehs, eh);
    var body *u8 = ast_block1(ast_expr_stmt(gcall));
    return ast_expr_stmt(ast_handle(body, ast_return_handler(rvname, ast_int(0)), ehs));
}

// ============================================================
// Declarations
// ============================================================

// flow_params = paramitem* ; paramitem = name:symbol | ','. All params are i64.
func fl_emit_params(params *PNode) *u8 {
    var pv *u8 = ast_vec();
    var items *u8 = params.children;
    var n i64 = vec_len(items);
    var i i64 = 0;
    while i < n {
        var it *PNode = vec_get(items, i);
        if pnode_is(it, "name") { ast_push(pv, ast_param(it.text, ast_type_i64())); }
        i = i + 1;
    }
    return pv;
}

// Does the statement list end in a `return`? (If not, the function needs an
// implicit one - generators fall off the end and an i64 fn must terminate.)
func fl_ends_in_return(sl *PNode) i64 {
    var n i64 = vec_len(sl.children);
    if n == 0 { return 0; }
    var last *PNode = vec_get(sl.children, n - 1);
    if pnode_is(last, "return") { return 1; }
    return 0;
}

// gen/func decl = [KW, name, '(', params, ')', block]. Both become (func name
// (params) i64 block) - the only difference is that a `gen` body uses `yield`
// and a `func` body uses `for-in`, but the lowering is identical. A trailing
// `return 0` is appended when the body doesn't end in a return (a generator just
// yields and falls off the end; its return value is the handle's ignored result).
// `gen` and `func` declare the same shape, so one lowering serves both: the two
// rules name their parts identically and flow_decl leaves them unlabeled.
func fl_emit_func(d *PNode) *u8 {
    var name *PNode = pnode_require(d, "name");
    var params *PNode = pnode_require(d, "params");
    var sl *PNode = pnode_require(pnode_require(d, "body"), "stmts");
    var stmts *u8 = ast_vec();
    var n i64 = vec_len(sl.children);
    var i i64 = 0;
    while i < n {
        ast_push(stmts, fl_emit_stmt(vec_get(sl.children, i), nil));
        i = i + 1;
    }
    if fl_ends_in_return(sl) == 0 {
        ast_push(stmts, ast_return(ast_int(0)));
    }
    return ast_func(name.text, fl_emit_params(params), ast_type_i64(), ast_block(stmts));
}

func fl_emit_program(prog *PNode) *u8 {
    var decls *u8 = ast_vec();
    var dl *u8 = prog.children;
    var n i64 = vec_len(dl);
    var i i64 = 0;
    while i < n {
        ast_push(decls, fl_emit_func(vec_get(dl, i)));
        i = i + 1;
    }
    return ast_program(decls);
}

reader flow(text *u8) *u8 {
    var t *Tokenizer = tok_new(text);
    var prog *PNode = parse_flow_program(t);
    return fl_emit_program(prog);
}
