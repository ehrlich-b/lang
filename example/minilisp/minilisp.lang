// ============================================================
// minilisp - a small Lisp that compiles to a native binary
// ============================================================
//
// Reads s-expression syntax via #parser{} and lowers it to lang AST with the
// std/ast.lang builder API (ast_binop, ast_if, ...) - NO hand-written S-expr
// strings. All values are i64. That's the "mini" part.
//
// EXPRESSIONS:
//   #minilisp{ (+ 1 2) }         => 3
//   #minilisp{ (* 2 (+ 3 4)) }   => 14
//   #minilisp{ (if (< x 0) 0 x) }
//   #minilisp{ (add 1 2) }
//
// DEFINITIONS:
//   #minilisp{ (defun add (a b) (+ a b)) }

include "std/core.lang"
include "std/tok.lang"
include "std/parser_reader.lang"
include "std/ast.lang"

// #parser{} generates a recursive descent parser from this grammar
#parser{
    sexp = number | symbol | operator | list
    list = '(' sexp* ')'
}

// PNODE kinds: 1=number, 2=symbol, 4=list, 5=operator

// ============================================================
// Parse tree helpers
// ============================================================

func list_inner(node *PNode) *PNode {
    return vec_get(node.children, 1);
}

func list_get(node *PNode, i i64) *PNode {
    return vec_get(list_inner(node).children, i);
}

func list_len(node *PNode) i64 {
    return vec_len(list_inner(node).children);
}

func is_sym(node *PNode, name *u8) bool {
    if node == nil { return false; }
    if node.kind != 2 { return false; }
    return streq(node.text, name);
}

func is_cmp(name *u8) bool {
    return streq(name, "<") || streq(name, ">") ||
           streq(name, "<=") || streq(name, ">=") ||
           streq(name, "=") || streq(name, "!=");
}

func is_arith(name *u8) bool {
    return streq(name, "+") || streq(name, "-") ||
           streq(name, "*") || streq(name, "/") || streq(name, "%");
}

func fix_op(name *u8) *u8 {
    if streq(name, "=") { return "=="; }
    return name;
}

// Per-node-unique temp name, derived from the node's address (each `if` node is
// distinct). Avoids a module-global counter: the reader-build path drops globals
// declared in the reader's OWN file - only included-file globals survive.
func lisp_tmp(node *PNode) *u8 {
    var sb *StringBuilder = sb_new();
    sb_str(sb, "__lt");
    var addr i64 = node;
    sb_int(sb, addr);
    return sb_finish(sb);
}

// ============================================================
// Lowering: parse tree (PNode) -> lang AST (via std/ast.lang)
// ============================================================

// Left-fold operands 1..hi of a list into a binop chain:
// (op a b c) with hi=3 -> ast_binop(op, ast_binop(op, a, b), c)
func lisp_binop_chain(op *u8, node *PNode, hi i64) *u8 {
    if hi == 1 {
        return lisp_expr(list_get(node, 1));
    }
    return ast_binop(op, lisp_binop_chain(op, node, hi - 1), lisp_expr(list_get(node, hi)));
}

// Emit a body in return (tail) position. A tail `if` becomes real control flow
// with a return in each branch, so recursive base cases actually stop.
func lisp_return(node *PNode) *u8 {
    if node != nil && node.kind == 4 {
        var first *PNode = list_get(node, 0);
        if is_sym(first, "if") {
            return ast_if(lisp_expr(list_get(node, 1)),
                          ast_block1(lisp_return(list_get(node, 2))),
                          ast_block1(lisp_return(list_get(node, 3))));
        }
    }
    return ast_return(lisp_expr(node));
}

// Lower one minilisp node to lang AST. A top-level (defun ...) becomes a
// (program (func ...)); everything else lowers to an expression.
func lisp_expr(node *PNode) *u8 {
    if node == nil { return ast_int(0); }

    if node.kind == 1 { return ast_number(node.text); }   // number literal
    if node.kind == 2 { return ast_ident(node.text); }    // symbol -> ident
    if node.kind == 5 { return ast_int(0); }              // bare operator (n/a)
    if node.kind != 4 { return ast_int(0); }              // only lists remain

    var count i64 = list_len(node);
    if count == 0 { return ast_int(0); }
    var first *PNode = list_get(node, 0);

    // (defun name (params) body) -> (program (func name (params) i64 (block ...)))
    if is_sym(first, "defun") {
        var name *PNode = list_get(node, 1);
        var params *PNode = list_get(node, 2);
        var body *PNode = list_get(node, 3);
        var pvec *u8 = ast_vec();
        var pc i64 = list_len(params);
        var pi i64 = 0;
        while pi < pc {
            ast_push(pvec, ast_param(list_get(params, pi).text, ast_type_i64()));
            pi = pi + 1;
        }
        return ast_program1(ast_func(name.text, pvec, ast_type_i64(),
                                     ast_block1(lisp_return(body))));
    }

    // (if cond then else) -> value-returning block_expr:
    //   { var t = 0; if (cond) { t = then; } else { t = else; } t }
    // Only the taken branch is evaluated. The old branchless (c*t)+(!c*e) form
    // ran BOTH arms - breaking side effects and looping forever on any recursion
    // whose recursive call sat in a non-tail branch.
    if is_sym(first, "if") {
        var t *u8 = lisp_tmp(node);
        var stmts *u8 = ast_vec();
        ast_push(stmts, ast_var(t, ast_type_i64(), ast_int(0)));
        ast_push(stmts, ast_if(lisp_expr(list_get(node, 1)),
                               ast_block1(ast_assign(ast_ident(t), lisp_expr(list_get(node, 2)))),
                               ast_block1(ast_assign(ast_ident(t), lisp_expr(list_get(node, 3))))));
        return ast_block_expr(stmts, ast_ident(t));
    }

    if is_sym(first, "and") { return ast_and(lisp_expr(list_get(node, 1)), lisp_expr(list_get(node, 2))); }
    if is_sym(first, "or")  { return ast_or(lisp_expr(list_get(node, 1)), lisp_expr(list_get(node, 2))); }
    if is_sym(first, "not") { return ast_not(lisp_expr(list_get(node, 1))); }

    // Operator form: (+ a b c), (- x), (< a b), ...
    var op *u8 = nil;
    if first.kind == 5 || (first.kind == 2 && (is_arith(first.text) || is_cmp(first.text))) {
        op = fix_op(first.text);
    }
    if op != nil {
        if count == 2 {
            // Unary: (- x) -> (binop - 0 x)
            return ast_binop(op, ast_int(0), lisp_expr(list_get(node, 1)));
        }
        return lisp_binop_chain(op, node, count - 1);
    }

    // Function call: (f a b) -> (call (ident f) a b)
    if first.kind == 2 {
        var args *u8 = ast_vec();
        var ai i64 = 1;
        while ai < count {
            ast_push(args, lisp_expr(list_get(node, ai)));
            ai = ai + 1;
        }
        return ast_call_named(first.text, args);
    }

    return ast_int(0);
}

reader minilisp(text *u8) *u8 {
    var t *Tokenizer = tok_new(text);
    var node *PNode = parse_sexp(t);
    return lisp_expr(node);
}
