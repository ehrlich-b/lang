extern func malloc(n i64) *u8;
extern func free(p *u8) void;
extern func atol(s *u8) i64;
extern func printf(fmt *u8, value i64) i64;
func main(argc i64, argv **u8) i64 {
    var n i64 = 1000;
    if argc > 1 { n = atol(argv[1]); }
    var result i64 = 0;
    var y i64 = 0;
    while y < n {
        var x i64 = 0;
        while x < n {
            var cr f64 = cast(f64, x) * 3.0 / cast(f64, n) - 2.0;
            var ci f64 = cast(f64, y) * 2.0 / cast(f64, n) - 1.0;
            var zr f64 = 0.0;
            var zi f64 = 0.0;
            var k i64 = 0;
            while k < 200 && zr * zr + zi * zi <= 4.0 {
                var next f64 = zr * zr - zi * zi + cr;
                zi = 2.0 * zr * zi + ci;
                zr = next;
                k = k + 1;
            }
            result = result + k;
            x = x + 1;
        }
        y = y + 1;
    }
    printf("%lld\n", result);
    return 0;
}
